---
// The flagship offer, presented as a contained feature block on the homepage and Services page.
import Button from './Button.astro';
import { FACTORY_FIX } from '../data/services.ts';

interface Props {
  headingLevel?: 'h2' | 'h3';
  showDetailsLink?: boolean;
}
const { headingLevel = 'h2', showDetailsLink = true } = Astro.props;
const Heading = headingLevel;
---

<div class="ff">
  <div class="ff__main">
    <p class="ff__eyebrow">Flagship offer</p>
    <Heading class="ff__title">{FACTORY_FIX.name}</Heading>
    <p class="ff__price">{FACTORY_FIX.price}</p>
    <p class="ff__summary">{FACTORY_FIX.summary}</p>
    <div class="ff__actions">
      <Button href="/contact/?service=factory-fix" arrow data-cta="factory-fix-enquiry">Discuss a Factory Fix</Button>
      {showDetailsLink && <Button href="/factory-fix/" variant="secondary">How it works</Button>}
    </div>
    <p class="ff__terms">{FACTORY_FIX.terms}</p>
  </div>
  <div class="ff__side">
    <p class="ff__list-title">Typical deliverables</p>
    <ul class="ff__list">{FACTORY_FIX.deliverables.map((d) => <li>{d}</li>)}</ul>
  </div>
</div>

<style>
  .ff {
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 2rem 4rem;
    padding: clamp(1.75rem, 4vw, 3.25rem); border: 1px solid var(--line-strong); border-radius: var(--radius);
    background: var(--surface); position: relative; overflow: hidden;
  }
  .ff::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--brand-orange); }
  .ff__eyebrow { margin: 0 0 0.75rem; font-size: 0.78rem; font-weight: 560; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .ff__title { font-size: var(--step-3); font-weight: 540; letter-spacing: -0.035em; line-height: 1.05; }
  .ff__price { margin: 0.75rem 0 0; font-size: var(--step-2); font-weight: 560; letter-spacing: -0.02em; }
  .ff__summary { margin: 1rem 0 0; max-width: 54ch; color: var(--ink-2); font-size: var(--step-1); line-height: 1.5; }
  .ff__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .ff__terms { margin: 1rem 0 0; font-size: 0.88rem; color: var(--muted); }
  .ff__list-title { margin: 0 0 0.75rem; font-size: 0.78rem; font-weight: 560; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .ff__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .ff__list li { position: relative; padding: 0.7rem 0 0.7rem 1.6rem; border-bottom: 1px solid var(--line); color: var(--ink-2); }
  .ff__list li::before { content: ''; position: absolute; left: 0; top: 1.15rem; width: 0.65rem; height: 1px; background: var(--accent); }
  @media (max-width: 860px) { .ff { grid-template-columns: 1fr; } }
</style>
