---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import MotionVisual from '../../components/MotionVisual.astro';
import '../../styles/tools.css';

const description = 'Use KEVOS calculators to compare costs, plan capacity, prepare quotes and assess projects. Calculations run in your browser without an account or installation.';
---

<BaseLayout title="Free Tools" description={description} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }]}>
  <section class="tools-shell">
    <Container>
      <div class="tools-intro">
        <div class="tools-intro__story">
          <div class="tools-intro__copy">
        <p class="eyebrow">KEVOS Tools</p>
        <h1>Tools for better decisions.</h1>
        <p class="lead">Compare costs, check capacity and work through project decisions. These engineering and business calculators run in your browser and are free to use.</p>
        <div class="tools-meta" aria-label="Tool collection features"><span class="tools-pill free">57 free tools and 5 Pro</span><span class="tools-pill">No account</span><span class="tools-pill">Mobile friendly</span><span class="tools-pill">Calculate in your browser</span></div>
          </div>
          <div class="tools-intro__visual"><MotionVisual page="tools" priority /></div>
        </div>
        <div class="tools-search"><input id="tool-search" type="search" placeholder="What are you trying to work out?" aria-label="Search KEVOS tools" autocomplete="off" /><span class="tools-count" id="tool-count">62 tools</span></div>
        <div class="chips" aria-label="Filter tools by category">
          <button class="chip active" type="button" data-cat="All">All</button><button class="chip" type="button" data-cat="Decide">Decide</button><button class="chip" type="button" data-cat="Money">Money</button><button class="chip" type="button" data-cat="Projects">Projects</button><button class="chip" type="button" data-cat="Operations">Operations</button><button class="chip" type="button" data-cat="Manufacturing">Manufacturing</button><button class="chip" type="button" data-cat="Quoting">Quoting</button><button class="chip" type="button" data-cat="Inventory">Inventory</button><button class="chip" type="button" data-cat="Improvement">Improvement</button><button class="chip" type="button" data-cat="Planning">Planning</button><button class="chip" type="button" data-cat="Business">Business</button>
        </div>
      </div>
      <section class="featured-tools" aria-labelledby="featured-tools-title"><div class="featured-head"><div><p class="eyebrow">KEVOS Pro</p><h2 id="featured-tools-title">Work through the costs and trade-offs.</h2><p>Compare production costs, sourcing options, equipment effectiveness, capacity and improvement savings. Report features are planned for a later release.</p></div><span class="pro-label">5 Pro tools</span></div><div class="featured-grid" id="featured-grid"></div></section>
      <div id="tool-directory"><div class="tool-grid" id="tool-grid"><p class="tools-empty" id="tools-empty" hidden>No matching tool yet. Try another term or category.</p></div></div>
      <section class="workspace" id="tool-workspace" hidden aria-live="polite">
        <div class="workspace-head"><div><p class="eyebrow" id="tool-category">Free tool</p><h2 id="tool-name">Tool</h2><p class="lead" id="tool-question"></p><p id="tool-description"></p></div><button class="btn secondary back-button" type="button" id="back-tools">← All tools</button></div>
        <div class="tool-layout">
          <form id="tool-form" class="panel" autocomplete="off"></form>
          <div class="panel sticky"><div id="result" aria-live="polite"></div><div class="tool-actions"><button class="btn secondary" id="copy-result" type="button">Copy result</button><button class="btn secondary" id="print-result" type="button">Print or save as PDF</button><button class="btn secondary" id="share-tool" type="button">Share tool</button></div><p class="formula-note">KEVOS tools are screening and decision-support utilities. Verify important financial, engineering, safety, legal or operational decisions using appropriate professional standards and your organisation’s approved data.</p></div>
        </div>
        <aside class="custom-cta"><div><h2>Need a tool for your own calculation?</h2><p>If your business uses a spreadsheet, repeated formula or manual decision process, KEVOS can help turn it into a focused browser tool.</p></div><a href="/contact/">Discuss a custom tool →</a></aside>
      </section>
    </Container>
  </section>
  <script is:inline src="/tools/data-1.js"></script><script is:inline src="/tools/data-2.js"></script><script is:inline src="/tools/data-3.js"></script><script is:inline src="/tools/data-4.js"></script><script is:inline src="/tools/data-5.js"></script><script is:inline src="/tools/data-6.js"></script><script is:inline src="/tools/data-7.js"></script>
  <script is:inline src="/tools/core.js"></script><script is:inline src="/tools/calc-1.js"></script><script is:inline src="/tools/calc-2.js"></script><script is:inline src="/tools/calc-3.js"></script><script is:inline src="/tools/calc-4.js"></script><script is:inline src="/tools/calc-5.js"></script><script is:inline src="/tools/calc-6.js"></script><script is:inline src="/tools/calc-7.js"></script><script is:inline src="/tools/ui.js"></script>
</BaseLayout>
