---
// Engineering Problem Assessment enquiry form. It reuses the REACHOS delivery path (SITE.contact):
// Web3Forms with hCaptcha today, or the Worker endpoint /api/assessment once Worker mail is configured.
// It never takes payment, accepts files or confirms a booking; it only asks KEVOS® to check suitability.
import { SITE } from '../../config/site.ts';
import { ASSESSMENT, MATERIALS, PROBLEM_CATEGORIES, STATES } from '../../config/assessment.ts';
import { ASSESSMENT_LIMITS as L } from '../../lib/assessment.ts';
import { CONTACT_METHODS, HONEYPOT_FIELD } from '../../lib/contact.ts';
import Button from '../Button.astro';

const { provider, web3formsAccessKey, web3formsEndpoint } = SITE.contact;
const action = provider === 'web3forms' ? web3formsEndpoint : '/api/assessment';
---

<form class="af" action={action} method="post" novalidate data-assessment-form>
  {
    provider === 'web3forms' && (
      <Fragment>
        <input type="hidden" name="access_key" value={web3formsAccessKey} />
        <input type="hidden" name="subject" value="KEVOS® assessment enquiry" />
        <input type="hidden" name="from_name" value="KEVOS® website: assessment" />
        <input type="hidden" name="redirect" value={new URL('/assessment/received/', SITE.url).href} />
      </Fragment>
    )
  }
  <fieldset class="af__group">
    <legend class="af__legend"><span>01</span> About you</legend>
    <div class="af__row">
      <div class="field">
        <label for="af-name">Full name</label>
        <input id="af-name" name="name" type="text" autocomplete="name" required minlength={L.name.min} maxlength={L.name.max} aria-describedby="af-name-error" />
        <p class="field__error" id="af-name-error" data-error-for="name"></p>
      </div>
      <div class="field">
        <label for="af-company">Company name</label>
        <input id="af-company" name="company" type="text" autocomplete="organization" required maxlength={L.company.max} aria-describedby="af-company-error" />
        <p class="field__error" id="af-company-error" data-error-for="company"></p>
      </div>
    </div>
    <div class="af__row">
      <div class="field">
        <label for="af-email">Business email</label>
        <input id="af-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength={L.email.max} aria-describedby="af-email-error" />
        <p class="field__error" id="af-email-error" data-error-for="email"></p>
      </div>
      <div class="field">
        <label for="af-phone">Phone <span class="field__optional">(optional)</span></label>
        <input id="af-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength={L.phone.max} aria-describedby="af-phone-error" />
        <p class="field__error" id="af-phone-error" data-error-for="phone"></p>
      </div>
    </div>
    <div class="af__row">
      <div class="field">
        <label for="af-state">State or territory</label>
        <select id="af-state" name="state" required aria-describedby="af-state-error">
          <option value="">Choose a state or territory</option>
          {STATES.map((s) => <option value={s}>{s}</option>)}
        </select>
        <p class="field__error" id="af-state-error" data-error-for="state"></p>
      </div>
      <div class="field">
        <label for="af-industry">Industry <span class="field__optional">(optional)</span></label>
        <input id="af-industry" name="industry" type="text" maxlength={L.industry.max} placeholder="For example, fabrication or food equipment" />
      </div>
    </div>
  </fieldset>

  <fieldset class="af__group">
    <legend class="af__legend"><span>02</span> The problem</legend>
    <div class="field">
      <label for="af-category">Engineering problem category</label>
      <select id="af-category" name="category" required aria-describedby="af-category-error">
        <option value="">Choose a category</option>
        {PROBLEM_CATEGORIES.map((c) => <option value={c}>{c}</option>)}
      </select>
      <p class="field__error" id="af-category-error" data-error-for="category"></p>
    </div>
    <div class="field">
      <label for="af-description">Description of the problem</label>
      <textarea id="af-description" name="description" rows="5" required minlength={L.description.min} maxlength={L.description.max} aria-describedby="af-description-hint af-description-error" placeholder="What happens, where in the product or process, and how often."></textarea>
      <p class="field__hint" id="af-description-hint">Please don’t include confidential information here. Drawings and photographs can be shared after KEVOS® replies.</p>
      <p class="field__error" id="af-description-error" data-error-for="description"></p>
    </div>
    <div class="af__row">
      <div class="field">
        <label for="af-impact">Current issue or impact</label>
        <textarea id="af-impact" name="impact" rows="4" required maxlength={L.impact.max} aria-describedby="af-impact-error" placeholder="For example, rework, delays, scrap, safety or customer complaints."></textarea>
        <p class="field__error" id="af-impact-error" data-error-for="impact"></p>
      </div>
      <div class="field">
        <label for="af-outcome">Desired outcome</label>
        <textarea id="af-outcome" name="outcome" rows="4" required maxlength={L.outcome.max} aria-describedby="af-outcome-error" placeholder="What would a good result look like?"></textarea>
        <p class="field__error" id="af-outcome-error" data-error-for="outcome"></p>
      </div>
    </div>
    <fieldset class="field field--choices" aria-describedby="af-materials-hint af-materials-error">
      <legend>Information you could share</legend>
      <p class="field__hint" id="af-materials-hint">Choose all that apply. Nothing is uploaded now.</p>
      <div class="choices">
        {
          MATERIALS.map((m) => (
            <label class="choice">
              <input type="checkbox" name="materials" value={m} />
              <span>{m}</span>
            </label>
          ))
        }
      </div>
      <p class="field__error" id="af-materials-error" data-error-for="materials"></p>
    </fieldset>
  </fieldset>

  <fieldset class="af__group">
    <legend class="af__legend"><span>03</span> Contact and consent</legend>
    <fieldset class="field field--choices" aria-describedby="af-method-error">
      <legend>Preferred contact method</legend>
      <div class="choices">
        {
          CONTACT_METHODS.map((m, i) => (
            <label class="choice">
              <input type="radio" name="contactMethod" value={m} checked={i === 0} />
              <span>{m}</span>
            </label>
          ))
        }
      </div>
      <p class="field__error" id="af-method-error" data-error-for="contactMethod"></p>
    </fieldset>

    <div class="af__hp" aria-hidden="true">
      <label for="af-hp">Leave this field empty</label>
      <input id="af-hp" name={HONEYPOT_FIELD} type="checkbox" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field field--check">
      <input id="af-consent" name="consent" type="checkbox" required aria-describedby="af-consent-error" />
      <label for="af-consent">
        I have read the <a href="#terms">assessment conditions</a> and the <a href="/privacy/">privacy policy</a>. I understand this is an enquiry: it is not a booking or a purchase, and KEVOS® will first confirm whether the problem is suitable.
      </label>
      <p class="field__error" id="af-consent-error" data-error-for="consent"></p>
    </div>

    <div class="field">
      <p class="field__hint">A quick spam check protects this form.</p>
      <div class="captcha" data-captcha></div>
      <p class="field__error" data-captcha-error></p>
    </div>
    <noscript><p class="field__hint">This form needs JavaScript for its spam check. If it is turned off, please use REACHOS at /contact/ to book a meeting instead.</p></noscript>
  </fieldset>

  <div class="af__status" role="status" aria-live="polite" tabindex="-1" data-status></div>

  <div class="af__actions">
    <Button type="submit" arrow data-submit data-cta="assessment-submit">Send assessment enquiry</Button>
    <p class="af__fine">No payment is taken. {ASSESSMENT.priceLabel} is requested only after the scope is confirmed in writing.</p>
  </div>
</form>

<script>
  import { HONEYPOT_FIELD } from '../../lib/contact.ts';
  import { normaliseAssessment, validateAssessment, type AssessmentErrors } from '../../lib/assessment.ts';
  import { submitAssessment } from '../../lib/assessment-client.ts';
  import { mountCaptcha, type Captcha } from '../../lib/captcha.ts';

  const form = document.querySelector<HTMLFormElement>('[data-assessment-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const captchaEl = form.querySelector<HTMLElement>('[data-captcha]')!;
    const captchaError = form.querySelector<HTMLElement>('[data-captcha-error]')!;
    let startedAt = Date.now();
    let captcha: Promise<Captcha | null> | null = null;
    const ensureCaptcha = () => (captcha ??= mountCaptcha(captchaEl));
    form.addEventListener('focusin', ensureCaptcha, { once: true });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((en) => en.isIntersecting)) {
          ensureCaptcha();
          io.disconnect();
        }
      }, { rootMargin: '200px' });
      io.observe(captchaEl);
    }

    const read = () => {
      const data = new FormData(form);
      const fields: Record<string, unknown> = Object.fromEntries(data);
      fields.materials = data.getAll('materials').map(String);
      return { fields, input: normaliseAssessment(fields) };
    };
    const setStatus = (kind: 'success' | 'error' | 'pending', text: string) => {
      status.dataset.kind = kind;
      status.textContent = text;
    };
    const fieldFor = (name: string) => {
      const el = form.elements.namedItem(name);
      return el instanceof RadioNodeList ? (el[0] as HTMLElement) : (el as HTMLElement | null);
    };
    const showErrors = (errors: AssessmentErrors) => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        const name = el.dataset.errorFor as keyof AssessmentErrors;
        const message = errors[name] ?? '';
        el.textContent = message;
        fieldFor(name)?.setAttribute('aria-invalid', message ? 'true' : 'false');
      });
      const first = Object.keys(errors)[0];
      if (first) fieldFor(first)?.focus();
    };

    form.addEventListener('focusout', (e) => {
      const target = e.target as HTMLInputElement;
      const errorEl = form.querySelector<HTMLElement>(`[data-error-for="${target.name}"]`);
      if (!errorEl || !errorEl.textContent) return;
      const errors = validateAssessment(read().input);
      errorEl.textContent = errors[target.name as keyof AssessmentErrors] ?? '';
      target.setAttribute('aria-invalid', errorEl.textContent ? 'true' : 'false');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const { fields, input } = read();
      const errors = validateAssessment(input);
      showErrors(errors);
      if (Object.keys(errors).length) {
        setStatus('error', 'Please check the highlighted fields.');
        return;
      }
      const check = await ensureCaptcha();
      const token = check?.token() ?? '';
      captchaError.textContent = check ? (token ? '' : 'Please complete the spam check above.') : 'The spam check could not load. Please refresh the page and try again.';
      if (!token) {
        setStatus('error', captchaError.textContent);
        return;
      }
      submit.disabled = true;
      setStatus('pending', 'Sending your assessment enquiry');
      try {
        const result = await submitAssessment({ ...input, honeypot: fields[HONEYPOT_FIELD] ? 'yes' : '', startedAt, captcha: token });
        check?.reset();
        if (result.ok) {
          form.reset();
          startedAt = Date.now();
          setStatus('success', result.message ?? '');
        } else {
          if (result.errors) showErrors(result.errors);
          setStatus('error', result.message ?? 'Your enquiry could not be sent.');
        }
      } finally {
        submit.disabled = false;
        status.focus();
      }
    });
  }
</script>

<style>
  .af { display: grid; gap: 1.75rem; }
  .af__group { display: grid; gap: 1.35rem; margin: 0; padding: 0; border: 0; min-width: 0; }
  .af__legend { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.25rem; padding: 0; font-family: var(--font-display); font-size: var(--step-1); font-weight: 700; color: var(--ink); }
  .af__legend span { font-family: var(--font-mono); font-size: 0.78rem; font-weight: 500; color: var(--accent); }
  .af__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.35rem; }
  .field { display: grid; gap: 0.45rem; align-content: start; min-width: 0; }
  .field label, .field legend { font-size: 0.92rem; font-weight: 540; color: var(--ink); }
  .field__optional, .field__hint { font-weight: 400; color: var(--muted); }
  .field__hint { margin: 0; font-size: 0.84rem; }
  .field input[type='text'], .field input[type='email'], .field input[type='tel'], .field select, .field textarea {
    width: 100%; min-height: 50px; padding: 0.75rem 0.9rem; background: var(--surface); color: var(--ink);
    border: 1px solid var(--line-strong); border-radius: var(--radius); font: inherit; font-size: 1rem; line-height: 1.5;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .field select { appearance: none; padding-right: 2.5rem; background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%); background-position: calc(100% - 1.15rem) 50%, calc(100% - 0.8rem) 50%; background-size: 0.35rem 0.35rem; background-repeat: no-repeat; }
  .field textarea { min-height: 120px; resize: vertical; }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: var(--muted); }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px var(--accent-soft); }
  .field [aria-invalid='true'] { border-color: var(--danger); }
  .field__error { margin: 0; font-size: 0.86rem; color: var(--danger); }
  .field__error:empty { display: none; }
  .captcha { min-height: 78px; }
  .field--choices { margin: 0; padding: 0; border: 0; }
  .field--choices legend { margin-bottom: 0.4rem; padding: 0; }
  .choices { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .choice { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.55rem 0.95rem; border: 1px solid var(--line-strong); border-radius: 999px; cursor: pointer; font-weight: 450; }
  .choice:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
  .choice:has(input:focus-visible) { box-shadow: 0 0 0 3px var(--accent-soft); }
  .choice input { width: 16px; height: 16px; margin: 0; accent-color: var(--accent); }
  .field--check { grid-template-columns: auto 1fr; column-gap: 0.75rem; align-items: start; }
  .field--check input { width: 20px; height: 20px; margin: 0.15rem 0 0; accent-color: var(--accent); }
  .field--check label { font-weight: 400; color: var(--ink-2); line-height: 1.5; }
  .field--check .field__error { grid-column: 2; }
  .af__hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .af__status { padding: 0.9rem 1rem; border-radius: var(--radius); border: 1px solid var(--line); font-size: 0.97rem; }
  .af__status:empty { display: none; }
  .af__status:focus { outline: none; }
  .af__status[data-kind='success'] { border-color: var(--success); color: var(--success); }
  .af__status[data-kind='error'] { border-color: var(--danger); color: var(--danger); }
  .af__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
  .af__fine { margin: 0; font-size: 0.86rem; color: var(--muted); max-width: 40ch; }
  @media (max-width: 640px) { .af__row { grid-template-columns: 1fr; } }
</style>
