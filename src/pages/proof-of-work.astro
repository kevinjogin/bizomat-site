---
// /proof-of-work/: evidence that BIZOMAT builds and runs working software. Every item is marked as what it is: a
// product screen (captured from the running application with example data), an illustration (how something works,
// drawn), a diagram, or a test result (a suite that was run, with its date). No testimonials, customer logos, revenue,
// user counts or performance figures are shown: none have been verified.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import AiToCad from '../components/visuals/AiToCad.astro';
import CommandFlow from '../components/visuals/CommandFlow.astro';
import ProjectFlow from '../components/visuals/ProjectFlow.astro';
import WorkflowPipeline from '../components/visuals/WorkflowPipeline.astro';
import SearchScan from '../components/visuals/SearchScan.astro';
import PlatformArchitecture from '../components/visuals/PlatformArchitecture.astro';
import ProofOfWork from '../components/ProofOfWork.astro';
import '../styles/product.css';
import { SITE } from '../config/site.ts';
import { CAD, WORK } from '../data/platform-catalog.ts';
import { CAD_TOOL_GROUPS } from '../data/cad-tools.ts';
import { VERIFICATION } from '../data/verification.ts';
import { screenshots } from '../data/screenshots.ts';
import { PROJECTS } from '../data/projects.ts';
import { HOME_FEATURED_TOOLS } from '../config/home.ts';
import { loadWorkosTools, hasStandaloneGuide, toolPageHref, toolAppHref } from '../utils/workos-tools.ts';
import { subcategoryLabel } from '../utils/workos-topics.ts';
import { buildReadosLibrary } from '../utils/reados-library.ts';

const { tools, guides } = loadWorkosTools();
const subjects = await buildReadosLibrary();
const books = subjects.reduce((n, s) => n + s.entries.length, 0);
const chapters = subjects.reduce((n, s) => n + s.entries.reduce((m, e) => m + e.chapters.length, 0), 0);
const fmt = (n: number) => n.toLocaleString('en-AU');
const featured = HOME_FEATURED_TOOLS.map((id) => tools.find((t) => t.id === id)).filter((t): t is NonNullable<typeof t> => Boolean(t)).slice(0, 6);
const toolHref = (id: string) => (hasStandaloneGuide(guides[id]) ? toolPageHref(id) : toolAppHref(id));
const cadShots = screenshots('cad');
const workShots = screenshots('work');
const toolCount = CAD_TOOL_GROUPS.reduce((n, g) => n + g.tools.length, 0);

const stats = [
  { n: String(toolCount), t: 'CAD Automation tools an assistant can call' },
  { n: String(WORK.views.length), t: 'Project Management views on one data model' },
  { n: String(WORK.columnTypes), t: 'column types for boards' },
  { n: fmt(tools.length), t: 'calculators and tools in Resources' },
  { n: fmt(books), t: 'Library books' },
  { n: fmt(chapters), t: 'Library chapters' },
];
const technologies = [
  { area: 'Website and AI search', list: 'Astro static site, TypeScript, Node.js 22, Pagefind, an AI model for search terms with a keyword fallback' },
  { area: 'Project Management', list: 'React 19, Hono, TypeScript, SQLite (Cloudflare D1 or Node), file storage, WebSockets for live boards' },
  { area: 'CAD Automation', list: 'Python 3.12, FastAPI, MCP (Streamable HTTP), OAuth 2.1 with PKCE, build123d and OpenCascade, a sketch constraint solver' },
  { area: 'On the Windows PC', list: '.NET Framework 4.8 add-in for SOLIDWORKS (COM), the Companion tray app, ES256-signed commands, a WiX installer' },
  { area: 'Platform', list: 'One Fly.io app in Sydney with a host-routing proxy, separate processes and volumes per product, GitHub Actions' },
];
const integrations = [
  { t: 'AI assistants (MCP)', x: 'Claude, ChatGPT where custom connectors are allowed, and any client of remote MCP servers over Streamable HTTP.' },
  { t: 'SOLIDWORKS', x: 'A native add-in: tab, menu and task pane, built against the SOLIDWORKS 2022 API.' },
  { t: 'Slack and Microsoft Teams', x: 'Incoming webhooks from Project Management, marked connected only after a delivery succeeds.' },
  { t: 'Webhooks and API tokens', x: 'Signed outgoing webhooks and personal API tokens in Project Management.' },
  { t: 'Google sign-in', x: 'In both applications, when it is configured.' },
];
const description = 'Proof of Work: how BIZOMAT CAD Automation, Project Management and Resources are built, real product screens, test results and the platform architecture. Illustrations are marked as such.';
---
<BaseLayout title="Proof of Work" description={description} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Proof of Work', href: '/proof-of-work/' }]}
  schema={[{ '@type': 'CollectionPage', name: 'BIZOMAT Proof of Work', url: `${SITE.url}/proof-of-work/`, description, about: { '@id': `${SITE.url}/#organization` } }]}>
  <section class="pp-hero" aria-labelledby="pow-title">
    <Container class="pp-hero__inner">
      <div>
        <p class="bz-eyebrow">Proof of Work</p>
        <h1 id="pow-title">Working software, shown working.</h1>
        <p class="pp-hero__lead">BIZOMAT builds and runs real software. This page shows what exists, how it connects and how it has been tested.</p>
        <ul class="legend" role="list" aria-label="How to read this page">
          <li><span class="viz__tag viz__tag--real">Product screen</span> captured from the running application, with example data</li>
          <li><span class="viz__tag">Illustration</span> how something works, drawn; tool names and steps are real</li>
          <li><span class="viz__tag viz__tag--demo">Diagram</span> the system as it is built</li>
        </ul>
      </div>
      <PlatformArchitecture id="pow-arch" />
    </Container>
  </section>

  <section class="pp-section" aria-labelledby="glance-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">At a glance</p>
        <h2 id="glance-title">Counted from the products when this page was built</h2>
      </div>
      <dl class="pow-stats">{stats.map((s) => <div class="bz-stat"><dt>{s.t}</dt><dd>{s.n}</dd></div>)}</dl>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="cad" aria-labelledby="cad-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Engineering automation</p>
        <h2 id="cad-title">An AI instruction becomes a SOLIDWORKS operation</h2>
        <p>CAD Automation turns a request into checked, native features on the customer's own computer. These two scenes use the real tool names and the real command states.</p>
      </div>
      <div class="pow-pair">
        <AiToCad id="pow-ai2cad" />
        <CommandFlow id="pow-cmd" />
      </div>
      {cadShots.length > 0 && (
        <div class="pp-shots pow-shots">
          {cadShots.map((s) => (
            <figure class="pp-shot">
              <img src={s.src} alt={`${s.title}. ${s.caption}`} width="1440" height="900" loading="lazy" decoding="async" />
              <figcaption><span>{s.title}. {s.caption}</span><span class="viz__tag viz__tag--real">Product screen</span></figcaption>
            </figure>
          ))}
        </div>
      )}
      <div class="bz-alert bz-alert--info pp-status" role="note"><strong>Status</strong><span>{CAD.status}</span></div>
      <p class="pow-more"><a href="/cad/">CAD Automation in detail <span aria-hidden="true">→</span></a></p>
    </Container>
  </section>

  <section class="pp-section" id="work" aria-labelledby="work-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Project management</p>
        <h2 id="work-title">A project created, tasks assigned, work moving on its own</h2>
        <p>Project Management runs projects, tasks and teams today. The scenes show a board being set up and an automation rule running.</p>
      </div>
      <div class="pow-pair">
        <ProjectFlow id="pow-proj" />
        <WorkflowPipeline id="pow-flow" />
      </div>
      {workShots.length > 0 && (
        <div class="pp-shots pow-shots">
          {workShots.map((s) => (
            <figure class="pp-shot">
              <img src={s.src} alt={`${s.title}. ${s.caption}`} width="1440" height="900" loading="lazy" decoding="async" />
              <figcaption><span>{s.title}. {s.caption}</span><span class="viz__tag viz__tag--real">Product screen</span></figcaption>
            </figure>
          ))}
        </div>
      )}
      <p class="pow-more"><a href="/work/">Project Management in detail <span aria-hidden="true">→</span></a></p>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="resources" aria-labelledby="res-title">
    <Container class="pp-split">
      <div>
        <p class="bz-eyebrow">Resources</p>
        <h2 id="res-title">Real calculators and books, found by AI search</h2>
        <p class="pow-lead">{fmt(tools.length)} tools that show their method, and {fmt(books)} books in {fmt(chapters)} chapters. Try some:</p>
        <ul class="pow-tools" role="list">
          {featured.map((t) => <li><a href={toolHref(t.id)}>{t.name}</a><span>{subcategoryLabel(t.category)}</span></li>)}
        </ul>
        <div class="pp-hero__actions"><Button href="/resources/" variant="secondary" arrow>All resources</Button></div>
      </div>
      <SearchScan id="pow-search" />
    </Container>
  </section>

  <section class="pp-section" id="technical" aria-labelledby="tech-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Technical proof</p>
        <h2 id="tech-title">How the applications connect, and what they are built with</h2>
        <p>Each product keeps its own process and its own data; the website holds no customer data. CAD work always runs on the customer's computer.</p>
      </div>
      <div class="bz-table-wrap">
        <table class="bz-table">
          <caption class="visually-hidden">Technologies by area</caption>
          <thead><tr><th scope="col">Area</th><th scope="col">Built with</th></tr></thead>
          <tbody>{technologies.map((t) => <tr><th scope="row">{t.area}</th><td>{t.list}</td></tr>)}</tbody>
        </table>
      </div>
      <h3 class="pow-subhead" id="integrations">Integrations that exist today</h3>
      <ul class="pp-cards" role="list">{integrations.map((i) => <li class="pp-card"><h3>{i.t}</h3><p>{i.x}</p></li>)}</ul>
      <h3 class="pow-subhead" id="tests">Test record</h3>
      <div class="bz-table-wrap">
        <table class="bz-table">
          <caption class="visually-hidden">Automated test results</caption>
          <thead><tr><th scope="col">Product</th><th scope="col">Suite</th><th scope="col">Result</th><th scope="col">Run</th></tr></thead>
          <tbody>{VERIFICATION.map((v) => <tr><td>{v.product}</td><td>{v.suite}<br /><span class="pow-how">{v.how}</span></td><td>{v.result}</td><td>{v.date}</td></tr>)}</tbody>
        </table>
      </div>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="engineering-record" aria-labelledby="record-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Engineering record</p>
        <h2 id="record-title">{PROJECTS.length} engineering projects behind BIZOMAT</h2>
        <p>The founder's engineering record since 2010, in employed, contract and consulting roles: coke plants, mine-site trucks, production machinery, door and window hardware, rail interiors, bridges, food plants and patient-specific devices. Each record shows where the work happened, the role, what was delivered and how far it went.</p>
      </div>
      <ProofOfWork />
    </Container>
  </section>

  <section class="pp-section" aria-labelledby="claims-title">
    <Container class="pp-split">
      <div>
        <p class="bz-eyebrow">What this page does not claim</p>
        <h2 id="claims-title">No borrowed credibility</h2>
      </div>
      <ul class="pp-list">
        <li>No customer testimonials, logos, revenue, user numbers or performance statistics: none are published until they can be verified.</li>
        <li>Illustrations explain how the software works; they are not screenshots of customer work.</li>
        <li>Where a product has not yet been tested in a setting, such as the CAD installer on every Windows and SOLIDWORKS combination, this page says so.</li>
      </ul>
    </Container>
  </section>

  <section class="pp-section pp-section--inverse" aria-labelledby="pow-cta">
    <Container class="pp-band">
      <h2 id="pow-cta">See it on your own work.</h2>
      <div class="pp-band__actions">
        <Button href="/cad/" variant="accent" data-cta="pow-cad">Explore CAD Automation</Button>
        <Button href="/work/" variant="secondary" data-cta="pow-work">Explore Project Management</Button>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .legend { display: grid; gap: .55rem; margin: 1.6rem 0 0; padding: 0; list-style: none; color: var(--ink-2); font-size: .92rem; }
  .legend li { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
  .pow-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 0; }
  .pow-stats :global(dd) { order: -1; }
  .pow-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; align-items: start; }
  .pow-shots { margin-top: 1rem; }
  .pow-more { margin: 1.6rem 0 0; }
  .pow-more a { color: var(--accent); font-weight: 600; text-decoration: none; }
  .pow-lead { margin: .9rem 0 1rem; font-size: var(--step-1); color: var(--ink-2); }
  .pow-tools { display: grid; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .pow-tools li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .2rem 1rem; padding: .7rem 0; border-bottom: 1px solid var(--line); }
  .pow-tools a { color: var(--ink); font-weight: 600; text-decoration: none; }
  .pow-tools a:hover { color: var(--accent); }
  .pow-tools span { color: var(--muted); font-size: .86rem; }
  .pow-subhead { margin: clamp(2rem, 4vw, 2.75rem) 0 1rem; font-size: var(--step-1); }
  .pow-how { color: var(--muted); font: 500 .8rem/1.4 var(--font-mono); }
  @media (max-width: 1000px) { .pow-pair { grid-template-columns: 1fr; } .pow-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .pow-stats { grid-template-columns: 1fr; } }
</style>
