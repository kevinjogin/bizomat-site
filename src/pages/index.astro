---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CallToAction from '../components/CallToAction.astro';
import TechDrawing from '../components/TechDrawing.astro';
import FactoryFixFeature from '../components/FactoryFixFeature.astro';
import PackageGrid from '../components/PackageGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SoftwareNote from '../components/SoftwareNote.astro';
import { SERVICE_GROUPS, INDUSTRIES, SERVICE_AREA } from '../data/services.ts';
import { BACKGROUND, PRINCIPLES } from '../data/brand.ts';
import { SITE } from '../config/site.ts';
import { getInsights } from '../utils/content.ts';

const latest = (await getInsights()).slice(0, 3);
const capabilities = ['CAD & SolidWorks', 'Manufacturing Support', 'Process Improvement', 'Project Delivery'];
const serviceSchema = {
  '@type': 'ItemList',
  name: 'GoCore services',
  itemListElement: SERVICE_GROUPS.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: { '@type': 'Service', name: g.title, description: g.short, url: `${SITE.url}/services/#${g.id}`, provider: { '@id': `${SITE.url}/#organization` } },
  })),
};
---

<BaseLayout description={SITE.description} schema={[serviceSchema]}>
  <section class="home-hero" aria-labelledby="home-title">
    <Container class="home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow">GoCore · Engineering • Manufacturing • Operations</p>
        <h1 id="home-title" class="home-hero__title">Engineering support that gets manufacturing work <em>moving</em>.</h1>
        <p class="home-hero__lead">
          Practical CAD, manufacturing, process-improvement and project support for businesses that need engineering capability without adding unnecessary permanent overhead.
        </p>
        <div class="home-hero__actions">
          <Button href="/contact/" arrow data-cta="hero-quote">Get a Quote</Button>
          <Button href="/services/" variant="secondary" data-cta="hero-services">View Services</Button>
        </div>
        <ul class="home-hero__caps" aria-label="Capabilities">{capabilities.map((c) => <li>{c}</li>)}</ul>
      </div>
      <TechDrawing class="home-hero__drawing" />
    </Container>
  </section>

  <Section index="01" label="Services" labelledby="services-title">
    <div class="section-head">
      <h2 id="services-title">Four ways GoCore moves work forward.</h2>
      <Button href="/services/" variant="text" arrow>All services</Button>
    </div>
    <ul class="service-grid">
      {
        SERVICE_GROUPS.map((g, i) => (
          <li class="service-card">
            <span class="service-card__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="service-card__title"><a href={`/services/#${g.id}`}>{g.title}</a></h3>
            <p class="service-card__text">{g.short}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section index="02" label="Factory Fix" tone="alt" labelledby="factory-fix-title">
    <h2 id="factory-fix-title" class="visually-hidden">GoCore Factory Fix</h2>
    <FactoryFixFeature headingLevel="h3" />
  </Section>

  <Section index="03" label="Indicative pricing" labelledby="pricing-title">
    <div class="section-head">
      <div>
        <h2 id="pricing-title">Defined work, quoted clearly.</h2>
        <p class="section-head__lead">Typical starting points for common jobs. Every assignment is scoped and confirmed in writing before work begins.</p>
      </div>
      <Button href="/services/#pricing" variant="text" arrow>See all packages</Button>
    </div>
    <PackageGrid limit={4} />
  </Section>

  <Section index="04" label="How it works" labelledby="process-title">
    <div class="section-head">
      <h2 id="process-title">A simple, scoped process.</h2>
      <Button href="/how-it-works/" variant="text" arrow>How engagements work</Button>
    </div>
    <ProcessSteps />
  </Section>

  <Section index="05" label="Who GoCore helps" tone="alt" labelledby="industries-title">
    <div class="split">
      <div class="split__intro">
        <h2 id="industries-title">Built for businesses that make things.</h2>
        <p class="muted">Capability is problem-based rather than tied to one industry. {SERVICE_AREA}</p>
        <Button href="/industries/" variant="text" arrow>Industries</Button>
      </div>
      <ul class="industry-list">{INDUSTRIES.map((ind) => <li>{ind.title}</li>)}</ul>
    </div>
  </Section>

  <Section index="06" label="Why GoCore" labelledby="why-title">
    <div class="split">
      <div class="split__intro">
        <h2 id="why-title">Hands-on, engineering-led and commercially aware.</h2>
        <p class="muted">GoCore is a professional small technical-services business. Its founder’s practical background spans:</p>
        <ul class="background-list">{BACKGROUND.map((b) => <li>{b}</li>)}</ul>
        <Button href="/about/" variant="text" arrow>About GoCore</Button>
      </div>
      <ol class="principles">
        {
          PRINCIPLES.slice(0, 4).map((p, i) => (
            <li class="principle">
              <span class="principle__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="principle__title">{p.title}</h3>
              <p class="principle__text">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="sw-wrap">
      <SoftwareNote headingLevel="h3" />
    </div>
  </Section>

  {
    latest.length > 0 && (
      <Section index="07" label="Insights" labelledby="insights-title">
        <div class="section-head">
          <h2 id="insights-title">Practical reading for business owners.</h2>
          <Button href="/insights/" variant="text" arrow>All Insights</Button>
        </div>
        <div class="insight-grid">
          {latest.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>
      </Section>
    )
  }

  <CallToAction
    title="Have a job that needs moving forward?"
    text="Describe the problem, the drawing or the project. GoCore will help define the scope and come back with a clear proposal."
    label="Get a Quote"
  />
</BaseLayout>

<style>
  .home-hero { padding-block: clamp(3.5rem, 7vw, 7rem) clamp(3.5rem, 6vw, 6rem); }
  :global(.home-hero__inner) { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr); gap: 3rem 4rem; align-items: center; }
  .home-hero .eyebrow { margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem); }
  .home-hero__title { max-width: 16ch; font-size: clamp(2.5rem, 1.5rem + 3.9vw, 5rem); font-weight: 540; line-height: 1.0; letter-spacing: -0.045em; }
  .home-hero__title em { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.02em; color: var(--accent); }
  .home-hero__lead { max-width: 50ch; margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0; font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); }
  .home-hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: clamp(1.75rem, 3vw, 2.5rem); }
  .home-hero__caps { display: flex; flex-wrap: wrap; gap: 0.4rem 0; margin: 2rem 0 0; padding: 0; list-style: none; font-size: 0.9rem; font-weight: 520; color: var(--ink-2); }
  .home-hero__caps li:not(:last-child)::after { content: '•'; margin: 0 0.7rem; color: var(--accent); }
  :global(.home-hero__drawing) { max-width: 560px; justify-self: end; }
  @media (max-width: 960px) {
    :global(.home-hero__inner) { grid-template-columns: 1fr; }
    :global(.home-hero__drawing) { justify-self: start; max-width: 460px; }
  }

  .section-head { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .section-head h2 { max-width: 20ch; }
  .section-head__lead { margin: 0.9rem 0 0; color: var(--ink-2); max-width: 56ch; }

  .service-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .service-card { position: relative; padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2vw, 1.75rem) clamp(1.5rem, 3vw, 2.25rem) 0; border-bottom: 1px solid var(--line); }
  .service-card:not(:first-child) { padding-left: clamp(1rem, 2vw, 1.75rem); border-left: 1px solid var(--line); }
  .service-card__num { display: block; margin-bottom: 2rem; font-size: 0.85rem; font-variant-numeric: tabular-nums; color: var(--accent); }
  .service-card__title { font-size: var(--step-1); font-weight: 560; letter-spacing: -0.02em; line-height: 1.2; }
  .service-card__title a { color: inherit; text-decoration: none; }
  .service-card__title a::after { content: ''; position: absolute; inset: 0; }
  .service-card:hover .service-card__title a { color: var(--accent); }
  .service-card:focus-within { outline: 2px solid var(--accent); outline-offset: -2px; }
  .service-card__title a:focus-visible { outline: none; }
  .service-card__text { margin: 0.75rem 0 0; color: var(--ink-2); font-size: 0.98rem; line-height: 1.55; }
  @media (max-width: 960px) {
    .service-grid { grid-template-columns: 1fr 1fr; }
    .service-card:nth-child(3) { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 560px) {
    .service-grid { grid-template-columns: 1fr; }
    .service-card, .service-card:not(:first-child) { padding-left: 0; border-left: 0; }
    .service-card__num { margin-bottom: 0.75rem; }
  }

  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 2.5rem 5rem; }
  .split__intro h2 { margin-bottom: 1.1rem; max-width: 16ch; }
  .split__intro p { max-width: 42ch; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }

  .industry-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2rem; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); align-self: start; }
  .industry-list li { padding: 0.95rem 0; border-bottom: 1px solid var(--line); font-weight: 520; }
  @media (max-width: 560px) { .industry-list { grid-template-columns: 1fr; } }

  .background-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 1.5rem; padding: 0; list-style: none; }
  .background-list li { padding: 0.35rem 0.75rem; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.88rem; color: var(--ink-2); }

  .principles { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); align-self: start; }
  .principle { padding: 1.5rem 1.5rem 1.75rem 0; border-bottom: 1px solid var(--line); }
  .principle:nth-child(even) { padding-left: 1.5rem; border-left: 1px solid var(--line); }
  .principle__num { display: block; margin-bottom: 1rem; font-size: 0.85rem; color: var(--accent); font-variant-numeric: tabular-nums; }
  .principle__title { font-size: 1.12rem; font-weight: 560; letter-spacing: -0.015em; }
  .principle__text { margin: 0.5rem 0 0; color: var(--ink-2); font-size: 0.97rem; line-height: 1.55; }
  @media (max-width: 560px) { .principles { grid-template-columns: 1fr; } .principle:nth-child(even) { padding-left: 0; border-left: 0; } }
  .sw-wrap { margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--line); }

  .insight-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem 2rem; }
  @media (max-width: 960px) { .insight-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .insight-grid { grid-template-columns: 1fr; } }
</style>
