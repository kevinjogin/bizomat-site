---
// WORKOS → READOS: the readings connected to a tool (the reverse of ApplyInPractice; same approved links).
import type { ReadingConnection } from '../../utils/knowledge.ts';

interface Props { items: ReadingConnection[]; id?: string }
const { items, id = 'learn-concepts' } = Astro.props;
---

{items.length > 0 && (
  <section class="kl" aria-labelledby={id} data-pagefind-ignore>
    <h2 id={id}>Learn the Concepts Behind This Tool</h2>
    <p class="kl__lead">These KEVOS® Library readings explain the method this tool uses, with worked examples.</p>
    <ul class="kl__list">
      {items.map((x) => (
        <li class="kl__card">
          <p class="kl__label">{x.label} · {x.book.kind}</p>
          <h3 class="kl__title"><a href={x.chapters[0]?.href ?? x.book.href}>{x.chapters[0]?.title ?? x.book.title}</a></h3>
          {x.chapters[0] && <p class="kl__book">In <a href={x.book.href}>{x.book.title}</a></p>}
          <p class="kl__learn"><span class="kl__learn-label">What it covers:</span> {x.learn}</p>
          {x.chapters.length > 1 && <p class="kl__more">Also in {x.chapters.slice(1).map((c, i) => <>{i > 0 && ', '}<a href={c.href}>{c.title}</a></>)}</p>}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .kl { margin: 2.5rem 0; }
  .kl h2 { margin: 0 0 .5rem; }
  .kl__lead { margin: 0 0 1.25rem; color: var(--ink-2); font-size: .95rem; max-width: 46rem; }
  .kl__list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .kl__card { padding: 1.1rem 1.2rem; border: 1px solid var(--line); border-radius: 10px; background: var(--paper-2); }
  .kl__label { margin: 0 0 .35rem; color: var(--muted); font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .kl__title { margin: 0 0 .3rem; font-size: 1.02rem; line-height: 1.3; }
  .kl__title a { color: var(--ink); text-decoration: none; }
  .kl__title a:hover, .kl__title a:focus-visible { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .kl__book, .kl__more { margin: 0 0 .5rem; color: var(--muted); font-size: .84rem; }
  .kl__book a, .kl__more a { color: var(--ink-2); }
  .kl__learn { margin: 0; color: var(--ink-2); font-size: .9rem; line-height: 1.5; }
  .kl__learn-label { font-weight: 600; color: var(--ink); }
  .kl a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }
  @media print { .kl { display: none; } }
</style>
