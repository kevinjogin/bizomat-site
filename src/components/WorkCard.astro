---
import { Picture } from 'astro:assets';
import type { Work } from '../utils/content.ts';
import { hasWorkDetail } from '../utils/content.ts';
import StatusBadge from './StatusBadge.astro';

interface Props {
  entry: Work;
  headingLevel?: 'h2' | 'h3';
}
const { entry, headingLevel: H = 'h3' } = Astro.props;
const { title, summary, type, status, image, imageAlt, externalUrl, date } = entry.data;
const href = hasWorkDetail(entry) ? `/work/${entry.id}/` : externalUrl;
const external = !hasWorkDetail(entry) && Boolean(externalUrl);
---

<article class:list={['work-card', { 'has-image': image, 'is-draft': entry.data.draft }]}>
  <div class="work-card__media">
    {
      image ? (
        <Picture src={image} alt={imageAlt ?? ''} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" />
      ) : (
        <div class="work-card__placeholder" aria-hidden="true">
          <span>{type}</span>
          <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="44" /><circle cx="60" cy="60" r="28" /><circle class="core" cx="60" cy="60" r="7" /></svg>
          <span>{date.getFullYear()}</span>
        </div>
      )
    }
  </div>
  <div class="work-card__body">
    <p class="work-card__meta">
      <span>{type}</span>
      <StatusBadge status={status} />
    </p>
    <H class="work-card__title">
      {href ? <a href={href} rel={external ? 'noopener' : undefined}>{title}{external && <span aria-hidden="true"> ↗</span>}</a> : title}
    </H>
    <p class="work-card__summary">{summary}</p>
  </div>
</article>

<style>
  .work-card { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; padding-block: clamp(1.75rem, 3vw, 2.5rem); border-top: 1px solid var(--line-strong); }
  .work-card__media { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); background: var(--paper-2); }
  .work-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .work-card:hover .work-card__media :global(img) { transform: scale(1.02); }
  .work-card__placeholder { height: 100%; display: grid; grid-template-rows: auto 1fr auto; padding: 1.1rem 1.25rem; font-size: 0.78rem; font-weight: 560; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .work-card__placeholder span:last-child { justify-self: end; }
  .work-card__placeholder svg { width: min(46%, 180px); place-self: center; fill: none; stroke: var(--line-strong); stroke-width: 1; }
  .work-card__placeholder .core { fill: var(--accent); stroke: none; }
  .work-card__meta { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 1rem; font-size: 0.78rem; font-weight: 560; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .work-card__title { font-size: var(--step-3); font-weight: 540; letter-spacing: -0.035em; line-height: 1.05; }
  .work-card__title a { text-decoration: none; }
  .work-card__title a::after { content: ''; position: absolute; inset: 0; }
  .work-card__summary { margin: 1rem 0 0; max-width: 46ch; color: var(--ink-2); font-size: var(--step-1); line-height: 1.5; }
  @media (max-width: 760px) { .work-card { grid-template-columns: 1fr; } }
</style>
