---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Container from '../../../../components/Container.astro';
import ReadOSBookHero from '../../../../components/ReadOSBookHero.astro';
import ReadOSChapterList from '../../../../components/ReadOSChapterList.astro';
import { getChapters } from '../../../../utils/content.ts';
import { buildReadOSBooks, readosBookHref, readosChapterHref, type ReadOSBook } from '../../../../utils/reados.ts';

export async function getStaticPaths() {
  const books = buildReadOSBooks(await getChapters());
  return books.map((book) => ({params:{book:book.slug},props:{book}}));
}
interface Props { book: ReadOSBook }
const { book } = Astro.props;
const href = readosBookHref(book);
---
<BaseLayout title={`${book.title} (READOS)`} description={`${book.description} Read the full KEVOS® collection in structured chapters.`}
  breadcrumbs={[{label:'Home',href:'/'},{label:'READOS',href:'/reados/'},{label:book.title,href}]}>
  <ReadOSBookHero crumbs={[{label:'READOS',href:'/reados/'},{label:book.category,href:`/reados/#${book.category.toLowerCase()}`}]}
    eyebrow={`READOS / ${book.category}`} title={book.title} description={book.description}
    meta={[`${book.chapters.length} chapters`,`About ${book.minutes} minutes`,'Free to read']}
    startHref={readosChapterHref(book,book.chapters[0])} cover={{title:book.title,category:book.category,slug:book.slug,publicationLabel:'READOS VOLUME',chapters:book.chapters.length}} />
  <section class="contents"><Container>
    <ReadOSChapterList items={book.chapters.map((chapter,index)=>({href:readosChapterHref(book,chapter),number:index+1,title:chapter.data.title,description:chapter.data.description,body:chapter.body,id:chapter.id}))}>
      <p class="note">The reading collection is grouped by subject and presented in alphabetical order; chapter order does not imply a prerequisite learning sequence.</p>
    </ReadOSChapterList>
    <a class="back" href="/reados/">← All READOS books</a>
  </Container></section>
</BaseLayout>
<style>
.contents{padding:clamp(3rem,6vw,5rem) 0 var(--space-section)}
.note{color:var(--muted);font-size:.9rem;margin:2rem 0}
.back{font-size:.9rem;color:var(--accent)}
</style>
