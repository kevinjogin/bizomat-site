---
// /crm-platform/: BIZOMAT Customer Relationship Management (CRM). Introduces the product and opens the application at
// bizomat.ai/crm (sign-in required; the same accounts as Project Management). The page cannot be /crm/: that path is
// the application (tests/worker.test.ts). Facts come from src/data/platform-catalog.ts (CRM), which records its sources
// in apps/work; tests/platform-catalog.test.ts compares them with the application's code. The guide is
// /crm-platform/guide/.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import CrmPipeline from '../components/visuals/CrmPipeline.astro';
import '../styles/product.css';
import { screenshots } from '../data/screenshots.ts';
import { SITE } from '../config/site.ts';
import { APP_LINKS } from '../config/platform.ts';
import { CRM } from '../data/platform-catalog.ts';

const GUIDE = '/crm-platform/guide/';
const show = ['crm-overview', 'crm-board', 'crm-deal', 'crm-contact', 'crm-leads', 'crm-report'];
const shots = screenshots('crm').filter((s) => show.some((n) => s.src.endsWith(`/${n}.webp`)));
const description = 'BIZOMAT Customer Relationship Management (CRM): contacts, companies, leads, deals and follow-ups for your team, with a pipeline board, reports and automations.';
const records = [
  { t: 'Capture leads', x: `Record each enquiry with its source and estimated value. Statuses run ${CRM.leadStatuses.join(', ').replace(/, ([^,]+)$/, ' and $1')}, and you can change them.` },
  { t: 'Score and qualify', x: 'Each lead gets a score from its details and its activity, and the lead shows how the score was reached. Set it by hand when you know better.' },
  { t: 'Convert in one step', x: 'Turn a qualified lead into a contact, a company and a deal at once, new or existing. Its activities move with it, and a lead converts only once.' },
  { t: 'One history per customer', x: 'Every record has a timeline of changes, activities, notes and documents, newest first. A company\'s timeline includes its contacts and deals.' },
  { t: 'Duplicates flagged', x: 'While you type, the CRM warns you when an email address, phone number, name or website matches a record you already have.' },
  { t: 'Your own fields and lists', x: `Add custom fields of ${CRM.customFieldTypes.length} types, tags, and your own lists of statuses, sources, industries and lost reasons.` },
];
const activities = [
  { t: `${CRM.activityTypes.length} activity types`, x: `${CRM.activityTypes.join(', ').replace(/, ([^,]+)$/, ' and $1')}. Rename them or add your own.` },
  { t: 'Your day in one list', x: 'My activities, Overdue, Upcoming, Team activities and Completed. Tick an activity to complete it, and record the outcome.' },
  { t: 'A calendar, and yours', x: 'A month calendar of activities, a calendar file for any activity, and a private address your own calendar app can subscribe to.' },
  { t: 'Notes, comments and documents', x: 'Notes, internal comments and meeting notes on any record, with @mentions that notify a colleague. Proposals, quotes and contracts are kept with their versions.' },
];
const data = [
  { t: 'Search everything', x: 'One search across contacts, companies, leads, deals, activities and notes.' },
  { t: 'Filters and saved views', x: 'Filter on any field, tag or custom field, choose and sort the columns, and save the view. Managers and administrators can share a view with the whole team.' },
  { t: 'Bulk changes', x: 'Select records to assign them, change their status or priority, tag, archive, delete or restore them at once.' },
  { t: 'Import and export', x: 'Bring contacts, companies and leads in from a CSV file, matching its columns and deciding what happens to duplicates. Export what you can see.' },
];
const security = [
  'One BIZOMAT account for Project Management and the CRM, with the same protected sign-in.',
  'People outside an organisation cannot see it, or even tell that it exists.',
  'Every list, search and report is limited to your organisation, and the database itself refuses links between two organisations.',
  'The server checks every permission; the screens only hide what you cannot use.',
  'Documents are served only to people who can see the record they belong to.',
  'An audit trail records changes, imports and exports. Archived and deleted records can be restored.',
];
const steps = [
  { t: 'Sign in', x: 'Use your BIZOMAT account (the same email and password as Project Management), or create one on the sign-in page.' },
  { t: 'Create your organisation', x: `Give it a name and a currency. It starts with a ${CRM.stages.length}-stage sales pipeline and ${CRM.automations.length} automations, and no sample records.` },
  { t: 'Invite your team', x: 'Invite colleagues by email and choose each person\'s role.' },
  { t: 'Add your customers', x: 'Create contacts, companies and leads, or import them from a CSV file.' },
  { t: 'Work your pipeline', x: 'Add deals, move them across the board, plan follow-ups, and watch the dashboard.' },
];
---
<BaseLayout title="Customer Relationship Management (CRM)" description={description} imageAlt="BIZOMAT Customer Relationship Management: customers, leads and deals in one shared place" breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Customer Relationship Management', href: '/crm-platform/' }]}
  schema={[{ '@type': 'SoftwareApplication', name: 'BIZOMAT Customer Relationship Management', alternateName: 'BIZOMAT CRM', url: `${SITE.url}/crm-platform/`, applicationCategory: 'BusinessApplication', operatingSystem: 'Web browser', description, publisher: { '@id': `${SITE.url}/#organization` } }]}>
  <section class="pp-hero" aria-labelledby="crm-title">
    <Container class="pp-hero__inner">
      <div>
        <p class="bz-eyebrow">BIZOMAT Customer Relationship Management<span class="pp-hero__formerly">CRM for short</span></p>
        <h1 id="crm-title">{CRM.headline}</h1>
        <p class="pp-hero__lead">{CRM.summary}</p>
        <div class="pp-hero__actions">
          <Button href={APP_LINKS.crm.signIn} variant="accent" rel="noopener" data-cta="crm-start">Open the CRM</Button>
          <Button href={GUIDE} variant="secondary" data-cta="crm-guide">Read the user guide</Button>
        </div>
        <p class="pp-hero__note">Sign-in required. It uses your BIZOMAT account: the same email and password as Project Management. New to BIZOMAT? Create an account on the sign-in page.</p>
      </div>
      <CrmPipeline id="crm-hero" />
    </Container>
  </section>

  <section class="pp-section" id="features" aria-labelledby="features-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">What it does</p>
        <h2 id="features-title">Every customer, and every conversation with them, in one place</h2>
        <p>Customer relationship management (CRM) is how a business keeps track of the people it sells to and everything said and agreed with them. BIZOMAT keeps contacts, companies, leads, deals and activities on shared records, so anyone on the team can pick up where a colleague left off.</p>
      </div>
      <ul class="pp-cards" role="list">
        {CRM.capabilities.map((c) => <li class="pp-card"><span class="pp-card__mark"></span><h3>{c.title}</h3><p>{c.text}</p></li>)}
      </ul>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="pipeline" aria-labelledby="pipeline-title">
    <Container class="pp-split">
      <div>
        <p class="bz-eyebrow">Pipelines and deals</p>
        <h2 id="pipeline-title">A pipeline you can see and move</h2>
        <p class="pp-head-lead">A new organisation starts with a sales pipeline of {CRM.stages.length} stages. Rename them, add your own, set each stage's probability, or add more pipelines.</p>
        <p class="pp-body">Drag a deal to the next stage, or onto Won or Lost; a menu on each card does the same from the keyboard. A deal keeps its value, products and services, contacts, competitors and the time it spent in each stage. Its weighted value (value times probability) feeds the forecast.</p>
      </div>
      <ol class="pp-steps" aria-label="The stages a new pipeline starts with">
        {CRM.stages.map((s) => <li><h3>{s.name}</h3><p>{s.probability}% probability</p></li>)}
        <li><h3>Won or Lost</h3><p>Closed deals leave the board and count in the reports. A lost deal records why.</p></li>
      </ol>
    </Container>
  </section>

  {shots.length > 0 && (
    <section class="pp-section" id="screens" aria-labelledby="screens-title">
      <Container>
        <div class="pp-head">
          <p class="bz-eyebrow">What it looks like</p>
          <h2 id="screens-title">The real product</h2>
          <p>Captured from the running application with a fictional organisation and example data. More screens are in the <a href={GUIDE}>user guide</a>.</p>
        </div>
        <div class="pp-shots">
          {shots.map((s) => (
            <figure class="pp-shot">
              <img src={s.src} alt={`${s.title}. ${s.caption}`} width="1440" height="900" loading="lazy" decoding="async" />
              <figcaption><span>{s.title.replace(/^[^:]+: /, '').replace(/^a /, 'A ')}. {s.caption}</span><span class="viz__tag viz__tag--real">Product screen</span></figcaption>
            </figure>
          ))}
        </div>
      </Container>
    </section>
  )}

  <section class="pp-section pp-section--tint" id="records" aria-labelledby="records-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Leads, contacts and companies</p>
        <h2 id="records-title">From first enquiry to loyal customer</h2>
      </div>
      <ul class="pp-cards" role="list">
        {records.map((r) => <li class="pp-card"><h3>{r.t}</h3><p>{r.x}</p></li>)}
      </ul>
    </Container>
  </section>

  <section class="pp-section" id="activities" aria-labelledby="activities-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Activities and follow-ups</p>
        <h2 id="activities-title">Follow-ups that do not slip</h2>
        <p>Plan every call, meeting and visit against the customer and the deal, assign it with a due date and a priority, and see what is overdue.</p>
      </div>
      <ul class="pp-cards pp-cards--2" role="list">
        {activities.map((a) => <li class="pp-card"><h3>{a.t}</h3><p>{a.x}</p></li>)}
      </ul>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="reports" aria-labelledby="reports-title">
    <Container class="pp-split">
      <div>
        <p class="bz-eyebrow">Dashboard and reports</p>
        <h2 id="reports-title">Know what is closing, and why deals are won or lost</h2>
        <p class="pp-head-lead">The dashboard shows open pipeline, weighted forecast, value won, win rate, new leads, lead conversion, contacts and companies, and overdue follow-ups.</p>
        <p class="pp-body">Charts show revenue by month, open deals by stage, the conversion funnel, lead sources and completed activities per week. Filter by dates, owner, team and pipeline. Everything is computed from your records when you open it.</p>
      </div>
      <div>
        <h3 class="pp-subhead">{CRM.reports.length} reports</h3>
        <ul class="pp-list pp-list--cols">{CRM.reports.map((r) => <li>{r}</li>)}</ul>
        <p class="pp-table-note">Each report has its figures, a chart, a table and CSV export.</p>
      </div>
    </Container>
  </section>

  <section class="pp-section" id="automations" aria-labelledby="auto-title">
    <Container class="pp-split">
      <div>
        <p class="bz-eyebrow">Automations</p>
        <h2 id="auto-title">Routine follow-ups happen by themselves</h2>
        <p class="pp-head-lead">An automation is a trigger, conditions and actions.</p>
        <p class="pp-body">Triggers include a new or reassigned lead, a lead changing status, a new contact, a deal being created, entering a stage, won, lost or close to its expected close date, and an activity being assigned or becoming overdue. Actions notify people, create a follow-up, set a priority, flag a deal or assign an owner. Each event runs an automation once, and every run is kept in its history.</p>
      </div>
      <div>
        <h3 class="pp-subhead">Every new organisation starts with these {CRM.automations.length}</h3>
        <ul class="pp-list">{CRM.automations.map((a) => <li>{a}</li>)}</ul>
        <p class="pp-table-note">Switch any of them off, change them, or add your own.</p>
      </div>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="roles" aria-labelledby="roles-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Organisations, roles and permissions</p>
        <h2 id="roles-title">The right access for everyone on the team</h2>
        <p>Create an organisation for each business you run, belong to several, and switch between them. Invite colleagues, group them into teams and give each a role. Owners and administrators can fine-tune what the other roles may view, create, edit, delete, import and export.</p>
      </div>
      <ul class="pp-cards" role="list">
        {CRM.roles.map((r) => <li class="pp-card"><h3>{r.name}</h3><p>{r.text}</p></li>)}
      </ul>
    </Container>
  </section>

  <section class="pp-section" id="data" aria-labelledby="data-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Search, views and your data</p>
        <h2 id="data-title">Find anything, and take your data with you</h2>
      </div>
      <ul class="pp-cards pp-cards--2" role="list">
        {data.map((d) => <li class="pp-card"><h3>{d.t}</h3><p>{d.x}</p></li>)}
      </ul>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="integrations" aria-labelledby="int-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Email, calendar and other tools</p>
        <h2 id="int-title">What connects today, and what does not yet</h2>
      </div>
      <div class="pp-tools">
        <section aria-labelledby="int-works">
          <h3 id="int-works">Works today</h3>
          <dl>
            <div><dt>Logging emails</dt><dd>Write to a contact from a template; the CRM opens your own mail program with it filled in and logs the email on the record.</dd></div>
            <div><dt>Invitations and notifications</dt><dd>Sent by email when the platform's email service is set up. Otherwise the CRM gives you an invitation link to share, and notifications appear in the app.</dd></div>
            <div><dt>Calendar</dt><dd>A calendar file (.ics) for any activity, and a private subscription address for your calendar app, which you can replace or stop at any time.</dd></div>
            <div><dt>Project Management</dt><dd>Turn any activity into a task in a Project Management project; the task links back to the customer.</dd></div>
            <div><dt>CSV</dt><dd>Import contacts, companies and leads; export lists and reports.</dd></div>
          </dl>
        </section>
        <section aria-labelledby="int-not">
          <h3 id="int-not">Not available yet</h3>
          <dl>
            <div><dt>Gmail and Microsoft 365</dt><dd>Mailbox synchronisation is not switched on: the CRM does not read your mailbox or send from it. Settings, Integrations in the app says the same.</dd></div>
            <div><dt>Email to customers from BIZOMAT</dt><dd>Emails to customers go from your own mail program, and the CRM logs them as logged, never as sent.</dd></div>
          </dl>
        </section>
      </div>
    </Container>
  </section>

  <section class="pp-section" id="security" aria-labelledby="sec-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Accounts and security</p>
        <h2 id="sec-title">Your customers are visible only to your organisation</h2>
      </div>
      <ul class="pp-list">{security.map((s) => <li>{s}</li>)}</ul>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="start" aria-labelledby="start-title">
    <Container class="pp-split">
      <div>
        <p class="bz-eyebrow">Getting started</p>
        <h2 id="start-title">Start in five steps</h2>
        <p class="pp-head-lead">The <a href={GUIDE}>user guide</a> walks through each step, and everything after it, screen by screen.</p>
      </div>
      <ol class="pp-steps">
        {steps.map((s) => <li><h3>{s.t}</h3><p>{s.x}</p></li>)}
      </ol>
    </Container>
  </section>

  <section class="pp-section pp-section--inverse" aria-labelledby="crm-cta">
    <Container class="pp-band">
      <h2 id="crm-cta">Bring your customers and your sales team into one place.</h2>
      <div class="pp-band__actions">
        <Button href={APP_LINKS.crm.signIn} variant="accent" rel="noopener" data-cta="crm-band-start">Open the CRM</Button>
        <Button href={GUIDE} variant="secondary" data-cta="crm-band-guide">Read the user guide</Button>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .pp-head-lead { margin: .9rem 0 0; font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); }
  .pp-body { margin: .9rem 0 0; color: var(--ink-2); }
  .pp-subhead { font-size: var(--step-1); margin-bottom: .9rem; }
  .pp-list--cols { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; }
  @media (max-width: 640px) { .pp-list--cols { grid-template-columns: 1fr; } }
</style>
