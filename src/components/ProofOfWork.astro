---
// Homepage proof of work: sector filters and expandable case studies (data in src/data/projects.ts).
// Without JavaScript every project is listed; with it, the list starts at nine and can be filtered.
import { NAMED_ORGANISATIONS, PROJECTS, PROJECT_SECTORS, PROJECT_SERVICES, projectEnquiryHref } from '../data/projects.ts';
const INITIAL = 9;
const sectorLabel = Object.fromEntries(PROJECT_SECTORS.map((s) => [s.id, s.label]));
const sectors = PROJECT_SECTORS.map((s) => ({ ...s, count: PROJECTS.filter((p) => p.sector === s.id).length }));
const earliest = PROJECTS[PROJECTS.length - 1].years.slice(0, 4);
const latest = PROJECTS[0].years.slice(-4);
---
<div class="work" data-work data-initial={INITIAL}>
  <dl class="work-stats">
    <div><dt>Project records</dt><dd>{PROJECTS.length}</dd></div>
    <div><dt>Years</dt><dd>{earliest}–{latest}</dd></div>
    <div><dt>Sectors</dt><dd>{sectors.length}</dd></div>
    <div><dt>Named organisations</dt><dd>{NAMED_ORGANISATIONS.length}</dd></div>
  </dl>

  <div class="work-filter" role="group" aria-label="Filter projects by sector" data-work-filter hidden>
    <button type="button" data-sector="all" data-label="projects" aria-pressed="true">All <span>{PROJECTS.length}</span></button>
    {sectors.map((s) => <button type="button" data-sector={s.id} data-label={s.label.toLowerCase()} aria-pressed="false">{s.label} <span>{s.count}</span></button>)}
  </div>
  <p class="work-count" aria-live="polite" data-work-count></p>

  <ol class="work-list">
    {PROJECTS.map((p) => (
      <li class="work-card" data-sector={p.sector}>
        <article aria-labelledby={`work-${p.id}`}>
          <div class="work-card__top">
            <div class="work-card__lead">
              <p class="work-card__meta"><span>{p.years}</span><span>{sectorLabel[p.sector]}</span></p>
              <h3 id={`work-${p.id}`}>{p.headline}</h3>
              <p class="work-card__name">{p.title}</p>
              <p class="work-card__client">{p.client} <span>· {p.industry}{p.location && ` · ${p.location}`}</span></p>
              <p class="work-card__summary">{p.summary}</p>
            </div>
            <div class="work-card__aside">
              <p class:list={['work-status', `work-status--${p.status}`]}>{p.statusLabel}</p>
              <ul class="work-card__skills" aria-label="Capabilities">{p.skills.map((s) => <li>{s}</li>)}</ul>
            </div>
          </div>

          <details class="case">
            <summary><span>Read the full case study</span></summary>
            <div class="case__body">
              <div class="case__main">
                <section>
                  <h4>The brief</h4>
                  <p>{p.brief}</p>
                </section>
                <section>
                  <h4>How the work was approached</h4>
                  <ol class="case__steps">
                    {p.approach.map((step) => <li><strong>{step.title}</strong><p>{step.text}</p></li>)}
                  </ol>
                </section>
                <section>
                  <h4>Outcome</h4>
                  <p>{p.outcome}</p>
                  <p class="case__value"><span>Why it matters</span>{p.value}</p>
                  {p.note && <p class="case__note">{p.note}</p>}
                </section>
              </div>
              <aside class="case__side" aria-label={`${p.title}: client snapshot and deliverables`}>
                <section class="case__panel">
                  <h4>Client snapshot</h4>
                  <dl class="case__facts">
                    <div><dt>Organisation</dt><dd>{p.client}</dd></div>
                    <div><dt>About</dt><dd>{p.about}</dd></div>
                    <div><dt>Industry</dt><dd>{p.industry}</dd></div>
                    {p.location && <div><dt>Location</dt><dd>{p.location}</dd></div>}
                    <div><dt>Period</dt><dd>{p.years}</dd></div>
                    <div><dt>Role</dt><dd>{p.role}</dd></div>
                    <div><dt>Status</dt><dd>{p.statusLabel}</dd></div>
                  </dl>
                </section>
                <section class="case__panel">
                  <h4>Deliverables</h4>
                  <ul class="case__deliverables">{p.deliverables.map((d) => <li>{d}</li>)}</ul>
                </section>
                <section class="case__panel case__cta">
                  <h4>Planning something similar?</h4>
                  <p>This experience is directly relevant if:</p>
                  <ul>{p.relevantIf.map((r) => <li>{r}</li>)}</ul>
                  <a class="case__button" href={projectEnquiryHref(p)}>Discuss a similar project <span aria-hidden="true">→</span></a>
                  <a class="case__service" href={`#${p.service}`}>Explore {PROJECT_SERVICES[p.service]} →</a>
                </section>
              </aside>
            </div>
          </details>
        </article>
      </li>
    ))}
  </ol>
  <button class="work-more" type="button" data-work-more hidden>Show all {PROJECTS.length} projects</button>

  <div class="work-invite">
    <div>
      <h3>Have a project like these?</h3>
      <p>Send a drawing, photos or a short description. KEVOS® will come back with a clear scope, deliverables and an appropriate next step before any substantial work begins.</p>
    </div>
    <a class="case__button" href="/contact/">Start with REACHOS <span aria-hidden="true">→</span></a>
  </div>

  <p class="work-note">Organisation names show where the work took place and do not imply endorsement of KEVOS®. Organisation descriptions are general background. Engineering calculations, certification and statutory approvals remained with the responsible engineers and authorities. Projects that ended at concept or design stage are labelled that way. Only information already published in the KEVOS® project records is shown.</p>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-work]')) {
    const cards = [...root.querySelectorAll<HTMLElement>('.work-card')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-work-filter] button')];
    const filter = root.querySelector<HTMLElement>('[data-work-filter]');
    const more = root.querySelector<HTMLButtonElement>('[data-work-more]');
    const count = root.querySelector<HTMLElement>('[data-work-count]');
    const initial = Number(root.dataset.initial) || 9;
    let sector = 'all';
    let expanded = false;
    const render = () => {
      const matches = cards.filter((card) => sector === 'all' || card.dataset.sector === sector);
      const limit = sector === 'all' && !expanded ? initial : matches.length;
      cards.forEach((card) => { card.hidden = true; });
      matches.forEach((card, i) => { card.hidden = i >= limit; });
      if (more) more.hidden = limit >= matches.length;
      const active = buttons.find((b) => b.dataset.sector === sector);
      if (count) count.textContent = `Showing ${Math.min(limit, matches.length)} of ${matches.length} ${sector === 'all' ? 'projects' : `${active?.dataset.label ?? ''} projects`}`;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sector === sector)));
    };
    if (filter) filter.hidden = false;
    buttons.forEach((b) => b.addEventListener('click', () => { sector = b.dataset.sector ?? 'all'; render(); }));
    more?.addEventListener('click', () => {
      expanded = true;
      render();
      cards[initial]?.querySelector<HTMLElement>('summary')?.focus();
    });
    render();
  }
</script>

<style>
  .work-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;margin:0 0 2rem;background:var(--line);border:1px solid var(--line)}
  .work-stats div{background:var(--surface);padding:1.1rem 1.25rem}
  .work-stats dt{font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .work-stats dd{margin:.35rem 0 0;font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2.2rem);font-weight:700;color:var(--ink);line-height:1.1}
  .work-filter{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:.9rem}
  .work-filter[hidden]{display:none}
  .work-filter button{font:inherit;font-size:.84rem;font-weight:600;color:var(--ink-2);background:var(--surface);border:1px solid var(--line-strong);padding:.5rem .85rem;cursor:pointer;display:inline-flex;gap:.45rem;align-items:center}
  .work-filter button span{color:var(--muted);font-weight:500}
  .work-filter button:hover{border-color:var(--accent);color:var(--accent)}
  .work-filter button[aria-pressed="true"]{border-color:var(--accent);color:var(--accent);background:var(--accent-soft)}
  .work-filter button[aria-pressed="true"] span{color:var(--accent)}
  .work-filter button:focus-visible,.work-more:focus-visible,.case summary:focus-visible,.case__button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .work-count{font-size:.85rem;color:var(--muted);margin:0 0 1.2rem;min-height:1.2em}

  .work-list{display:grid;gap:1px;padding:0;margin:0;list-style:none;background:var(--line);border:1px solid var(--line)}
  .work-card{background:var(--surface);min-width:0}
  .work-card[hidden]{display:none}
  .work-card article{padding:clamp(1.3rem,2.6vw,2rem)}
  .work-card__top{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,15rem);gap:1rem 2.5rem;align-items:start}
  .work-card__meta{display:flex;flex-wrap:wrap;gap:.4rem 1rem;margin:0 0 .55rem;font-size:.76rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .work-card__meta span:first-child{color:var(--accent);font-weight:650}
  .work-card h3{font-size:clamp(1.18rem,2vw,1.45rem);line-height:1.25;margin:0;max-width:34ch}
  .work-card__name{margin:.45rem 0 0;font-size:.9rem;font-weight:600;color:var(--ink-2)}
  .work-card__client{margin:.2rem 0 0;font-size:.86rem;font-weight:600;color:var(--ink)}
  .work-card__client span{font-weight:400;color:var(--muted)}
  .work-card__summary{margin:.7rem 0 0;font-size:.94rem;color:var(--ink-2);max-width:70ch}
  .work-card__aside{display:flex;flex-direction:column;gap:.8rem;align-items:flex-start}
  .work-card__skills{display:flex;flex-wrap:wrap;gap:.35rem;list-style:none;padding:0;margin:0}
  .work-card__skills li{border:1px solid var(--line-strong);padding:.2rem .5rem;font-size:.74rem;color:var(--ink-2)}
  .work-status{margin:0;font-size:.75rem;font-weight:650;letter-spacing:.04em;padding:.22rem .55rem;border:1px solid var(--line-strong);color:var(--ink-2)}
  .work-status--delivered{border-color:var(--accent);color:var(--accent)}
  .work-status--paused{border-style:dashed;color:var(--muted)}

  .case{margin-top:1.1rem;border-top:1px solid var(--line);padding-top:.9rem}
  .case summary{cursor:pointer;list-style:none;display:inline-flex;align-items:center;gap:.6rem;font-size:.9rem;font-weight:650;color:var(--accent)}
  .case summary::-webkit-details-marker{display:none}
  .case summary::before{content:'+';display:inline-grid;place-items:center;width:1.4rem;height:1.4rem;border:1px solid var(--accent);font-weight:700;line-height:1}
  .case[open] summary::before{content:'−'}
  .case[open] summary span::after{content:' (close)';color:var(--muted);font-weight:500}
  .case__body{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:2rem 3rem;margin-top:1.4rem}
  .case h4{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin:0 0 .6rem}
  .case__main section+section{margin-top:1.6rem}
  .case__main p{margin:0;color:var(--ink-2);font-size:.95rem;line-height:1.65}
  .case__steps{counter-reset:step;list-style:none;padding:0;margin:0;display:grid;gap:.9rem}
  .case__steps li{counter-increment:step;display:grid;grid-template-columns:2rem 1fr;gap:0 .8rem}
  .case__steps li::before{content:counter(step,decimal-leading-zero);grid-row:span 2;font-family:var(--font-display);font-weight:700;color:var(--accent);font-size:.95rem}
  .case__steps strong{font-size:.97rem;color:var(--ink)}
  .case__steps p{margin:.2rem 0 0;font-size:.92rem}
  .case__main .case__value{margin-top:.9rem;padding:.85rem 1rem;border-left:3px solid var(--accent);background:var(--accent-soft);color:var(--ink)}
  .case__value span{display:block;font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);font-weight:650;margin-bottom:.2rem}
  .case__main .case__note{margin-top:.8rem;font-size:.85rem;color:var(--muted)}
  .case__side{display:grid;gap:1rem;align-content:start}
  .case__panel{border:1px solid var(--line-strong);padding:1.1rem 1.2rem;background:var(--paper)}
  .case__facts{margin:0;display:grid;gap:.6rem}
  .case__facts div{display:grid;grid-template-columns:6.5rem 1fr;gap:.6rem;font-size:.86rem}
  .case__facts dt{color:var(--muted)}
  .case__facts dd{margin:0;color:var(--ink)}
  .case__deliverables{margin:0;padding-left:1.1rem;font-size:.88rem;color:var(--ink-2);display:grid;gap:.3rem}
  .case__cta{border-color:var(--accent)}
  .case__cta p{margin:0 0 .4rem;font-size:.86rem;color:var(--muted)}
  .case__cta ul{margin:0 0 1rem;padding-left:1.1rem;font-size:.88rem;color:var(--ink-2);display:grid;gap:.3rem}
  .case__button{display:inline-flex;align-items:center;gap:.5rem;background:var(--accent);color:var(--paper);font-weight:650;font-size:.9rem;padding:.7rem 1.1rem;text-decoration:none}
  .case__button:hover{filter:brightness(1.08)}
  .case__service{display:block;margin-top:.75rem;font-size:.86rem;color:var(--accent);text-decoration:none}
  .case__service:hover{text-decoration:underline}

  .work-more{display:block;margin:1.5rem auto 0;font:inherit;font-size:.9rem;font-weight:650;color:var(--ink);background:transparent;border:1px solid var(--line-strong);padding:.75rem 1.4rem;cursor:pointer}
  .work-more:hover{border-color:var(--accent);color:var(--accent)}
  .work-more[hidden]{display:none}
  .work-invite{display:flex;justify-content:space-between;align-items:center;gap:1.5rem 3rem;margin-top:2.5rem;padding:clamp(1.3rem,3vw,2rem);border:1px solid var(--accent);background:var(--accent-soft)}
  .work-invite h3{font-size:var(--step-1);margin:0}
  .work-invite p{margin:.5rem 0 0;color:var(--ink-2);max-width:62ch;font-size:.94rem}
  .work-invite .case__button{flex:none}
  .work-note{color:var(--muted);font-size:.86rem;margin:1.75rem 0 0;max-width:90ch}
  @media(max-width:1050px){.work-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:860px){.work-card__top,.case__body{grid-template-columns:1fr}.work-invite{flex-direction:column;align-items:flex-start}}
</style>
