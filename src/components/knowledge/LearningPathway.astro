---
// A guided Learn → Apply → Verify → Improve pathway (src/data/learning-pathways.json). Every step points at something
// that exists: a Library chapter, a BIZOMAT tool, that tool's own checks and stated limitations, and its report and
// share features. Nothing is saved: the reader keeps a record with the tool's report download.
import type { Pathway } from '../../utils/knowledge.ts';

interface Props { pathway: Pathway; headingLevel?: 2 | 3 }
const { pathway: p, headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const S = `h${headingLevel + 1}` as 'h3' | 'h4';
const id = `pathway-${p.id}`;
---

<section class="kp" aria-labelledby={id} data-pagefind-ignore>
  <p class="kp__kicker">Learning pathway</p>
  <H id={id} class="kp__title">{p.title}</H>
  <p class="kp__summary">{p.summary}</p>
  <ol class="kp__steps">
    <li class="kp__step">
      <S class="kp__step-title"><span class="kp__n">1</span> Learn</S>
      <p>Read <a href={p.learn.href}>{p.learn.title}</a> in <em>{p.learn.book}</em>.</p>
      <p class="kp__detail">{p.learn.description}</p>
    </li>
    <li class="kp__step">
      <S class="kp__step-title"><span class="kp__n">2</span> Apply</S>
      <p>Open <a href={p.apply.href}>{p.apply.name}</a> and enter your own figures.</p>
      <p class="kp__detail">{p.apply.question}</p>
    </li>
    <li class="kp__step">
      <S class="kp__step-title"><span class="kp__n">3</span> Verify</S>
      <p>Read the tool’s feasibility and verification checks under the result, and test your answer against its stated limitations:</p>
      {p.verify.limitations.length > 0 && <ul class="kp__limits">{p.verify.limitations.map((l) => <li>{l}</li>)}</ul>}
    </li>
    <li class="kp__step">
      <S class="kp__step-title"><span class="kp__n">4</span> Improve</S>
      <p>Download the decision report or copy the link with your inputs to keep a record, then change one assumption at a time and compare.</p>
      {p.next && <p class="kp__detail">Next reading: <a href={p.next.href}>{p.next.title}</a> in <em>{p.next.book}</em>.</p>}
    </li>
  </ol>
</section>

<style>
  .kp { margin: 2.5rem 0; padding: clamp(1.1rem, 3vw, 1.6rem); border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 0 10px 10px 0; background: var(--surface); }
  .kp__kicker { margin: 0 0 .3rem; color: var(--accent); font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .kp__title { margin: 0 0 .4rem; font-size: var(--step-1, 1.3rem); }
  .kp__summary { margin: 0 0 1.1rem; color: var(--ink-2); font-size: .95rem; }
  .kp__steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .kp__step { padding: .9rem 1rem; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); }
  .kp__step-title { display: flex; align-items: center; gap: .5rem; margin: 0 0 .5rem; font-size: 1rem; }
  .kp__n { display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-size: .85rem; font-weight: 700; }
  .kp__step p { margin: 0 0 .45rem; color: var(--ink-2); font-size: .88rem; line-height: 1.5; }
  .kp__step a { color: var(--accent); font-weight: 600; }
  .kp__detail { color: var(--muted) !important; font-size: .83rem !important; }
  .kp__limits { margin: 0; padding-left: 1.1rem; color: var(--muted); font-size: .82rem; line-height: 1.45; }
  .kp__limits li { margin-bottom: .25rem; }
  .kp a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }
  @media print { .kp { display: none; } }
</style>
