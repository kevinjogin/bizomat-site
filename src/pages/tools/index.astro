---
import { CRUMB } from '../../config/site.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import LearningPlanner from '../../components/discovery/LearningPlanner.astro';
import DiscoveryResults from '../../components/discovery/DiscoveryResults.astro';
import { PLANNER_EXAMPLES } from '../../config/home.ts';
import '../../styles/discovery.css';
import '../../styles/learning.css';
import LibraryHero from '../../components/library/LibraryHero.astro';
import LibraryBrowser from '../../components/library/LibraryBrowser.astro';
import LibrarySection from '../../components/library/LibrarySection.astro';
import ToolCard from '../../components/library/ToolCard.astro';
import '../../styles/library.css';
import '../../styles/tools.css';
import { loadWorkosTools, hasStandaloneGuide, toolPageHref, toolAppHref } from '../../utils/workos-tools.ts';
import { groupToolsByTopic, subcategoryLabel, subcategorySlug } from '../../utils/workos-topics.ts';

// Tool data, calculations and guides are plain browser scripts in public/tools/ (see tests/tools-calculators.test.ts).
// The directory cards are also rendered here at build time so the tool names are crawlable and indexed by site search.
const { tools, guides, fileOf } = loadWorkosTools() as unknown as { tools: Array<Record<string, any>>; guides: Record<string, any>; fileOf: Record<string, string> };
// Cards link to each tool's own page where one exists, so search engines can find it; a plain click still
// opens the calculator in place (ui.js intercepts it), exactly as before.
const cardHref = (id: string) => (hasStandaloneGuide(guides[id]) ? toolPageHref(id) : toolAppHref(id));
// Every tool is rendered in its topic; cards after the first PREVIEW of a topic start hidden until the topic is opened.
const PREVIEW = 6;
const topics = groupToolsByTopic(tools as any, PREVIEW);
const collectionOf = (t: Record<string, any>) => (t.collection === 'MAKEOS' ? 'MAKEOS' : 'WORKOS');
const tagsOf = (t: Record<string, any>, topicName: string) => [t.category, subcategoryLabel(t.category), topicName, collectionOf(t), ...(t.keywords || [])].join(' ');
const bodyOf = (t: Record<string, any>) => [t.description, ...(guides[t.id]?.uses || []), ...(guides[t.id]?.users || [])].join(' ');
const description =
  'KEVOS® Tools engineering, manufacturing, operations and commercial decision tools with feasibility checks, sensitivity analysis and exportable decision reports.';
---

<BaseLayout title="Engineering and business calculators and decision tools" description={description} breadcrumbs={[{ label: 'Home', href: '/' }, { label: CRUMB.tools, href: '/tools/' }]}>
  {/* A calculator link (?tool=) shows the loading workspace, not the directory, before any tool script arrives. */}
  <script is:inline>if (/[?&]tool=/.test(location.search)) document.documentElement.classList.add('workos-tool-link');</script>
  <LibraryHero
    title="Tools"
    description="Practical engineering, manufacturing and business tools to calculate, analyse and make better decisions."
    action="/tools/"
    placeholder="Search KEVOS® tools..."
    label="Search KEVOS® tools"
    total={tools.length}
    noun="tool"
  >
    <LearningPlanner slot="planner" title="Not sure which tool you need?" lead="Describe what you want to learn or work out. KEVOS® builds a step-by-step path: what to read first, which tools to use and in what order." placeholder="e.g. I need to understand machine hour rates and use the right tools to cost a job." examples={PLANNER_EXAMPLES.tools} />
  </LibraryHero>
  <DiscoveryResults />
  <LibraryBrowser id="tool-directory" name="WORKOS" label={CRUMB.tools} searchAll="Search all tools" base="/tools/" noun="tool" preview={PREVIEW} topics={topics.map((t) => ({ slug: t.slug, name: t.name, description: t.description, icon: t.icon, count: t.items.length }))}>
    {topics.map((topic) => (
      <LibrarySection slug={topic.slug} name={topic.name} description={topic.description} count={topic.items.length} noun="tool" base="/tools/" preview={PREVIEW} subs={topic.subs}>
        {topic.items.map((t: Record<string, any>) => (
          <ToolCard id={t.id} href={cardHref(t.id)} name={t.name} purpose={t.question} category={subcategoryLabel(t.category)} topic={topic.slug} sub={subcategorySlug(t.category)} collection={collectionOf(t)} tags={tagsOf(t, topic.name)} body={bodyOf(t)} hidden={!topic.preview.has(t.id)} />
        ))}
      </LibrarySection>
    ))}
    <details class="lib-about" slot="after">
      <summary>About Tools</summary>
      <div class="lib-about__body">
        <p>Tools covers the engineering, manufacturing, operations and commercial decisions a team makes every day. Each tool shows its method, checks what could go wrong, tests how sensitive the answer is and gives you a report you can share with confidence.</p>
        <p><strong>MAKEOS engineering toolkit</strong> is the KEVOS® collection of calculators built on established engineering methods. It covers machining, mechanical design, fasteners and gears, power transmission, fluid power, fabrication, quality and maintenance. Every result shows its working and tells you what to verify before you rely on it. <a href="/tools/?collection=makeos">Browse the MAKEOS toolkit →</a></p>
        <ul>
          <li>Methods shown in full, with feasibility and verification checks.</li>
          <li>Sensitivity analysis and decision reports you can download, print or share.</li>
          <li>No account needed. Calculations run in your browser.</li>
        </ul>
      </div>
    </details>
  </LibraryBrowser>
  <Container>
    <section class="workspace" id="tool-workspace" hidden>
      <p class="tool-loading" id="tool-loading" role="status">Loading the calculator…</p>
      <div class="tool-loading tool-loading--failed" id="tool-loading-failed" role="alert" hidden><p>This calculator could not load. Check your connection and try again.</p><p><button class="btn" type="button" id="tool-loading-retry">Try again</button> <a class="btn secondary" href="/tools/">Back to all tools</a></p></div>
      <div class="workspace-head"><div><p class="eyebrow" id="tool-category">KEVOS® Tools</p><h2 id="tool-name">Tool</h2><p class="lead" id="tool-question"></p><p id="tool-description"></p></div><button class="btn secondary back-button" type="button" id="back-tools">← All tools</button></div>
      <div class="tool-layout">
        <form id="tool-form" class="panel" autocomplete="off"></form>
        <div class="panel sticky">
          <div id="result" aria-live="polite"></div>
          <div class="tool-actions">
            <button class="btn" id="download-report" type="button">Download report</button>
            <button class="btn secondary" id="print-result" type="button">Print or save as PDF</button>
            <button class="btn secondary" id="copy-result" type="button">Copy summary</button>
            <button class="btn secondary" id="share-tool" type="button">Share with inputs</button>
          </div>
          <p class="tool-flash" id="tool-flash" role="status"></p>
          <p class="formula-note">KEVOS® tools are screening and decision-support utilities. Verify important financial, engineering, safety, legal or operational decisions using appropriate professional standards and your organisation’s approved data.</p>
        </div>
      </div>
      <div class="tool-analysis" id="tool-analysis"></div>
      <div class="tool-guide" id="tool-guide"></div>
      <div class="tool-learn" id="tool-learn"></div>
      <aside class="custom-cta"><div><h2>Need a tool for your own calculation?</h2><p>If your business uses a spreadsheet, repeated formula or manual decision process, KEVOS® can help turn it into a focused browser tool.</p></div><a href="/contact/">Discuss a custom tool →</a></aside>
    </section>
  </Container>
  <div class="print-report" id="print-report" hidden></div>
  {/* Each tool's data-, guides-, inputs- and calc-<file>.js load when it opens (ui.js); this map says which file. */}
  <script is:inline type="application/json" id="workos-tool-files" set:html={JSON.stringify(fileOf)}></script>
  <script is:inline src="/tools/core.js"></script>
  <script is:inline src="/tools/input-guides.js"></script>
  <script is:inline src="/tools/ui.js"></script>
</BaseLayout>

<script>
  // The learning-path box in the header (LearningPlanner.astro): same pipeline as the homepage question box.
  import '../../scripts/discovery.ts';
</script>
