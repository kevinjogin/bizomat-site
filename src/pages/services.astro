---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import CallToAction from '../components/CallToAction.astro';
import FactoryFixFeature from '../components/FactoryFixFeature.astro';
import PackageGrid from '../components/PackageGrid.astro';
import SoftwareNote from '../components/SoftwareNote.astro';
import { SERVICE_GROUPS, PACKAGES, FACTORY_FIX, ENGAGEMENT_MODELS, SERVICE_AREA } from '../data/services.ts';
import { SITE } from '../config/site.ts';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
];
const priced = (min?: number) => (min ? { priceSpecification: { '@type': 'PriceSpecification', minPrice: min, priceCurrency: 'AUD' } } : {});
const catalog = {
  '@type': 'OfferCatalog',
  name: 'GoCore services and indicative packages',
  url: `${SITE.url}/services/`,
  itemListElement: [
    { '@type': 'Offer', name: FACTORY_FIX.name, description: FACTORY_FIX.summary, url: `${SITE.url}/factory-fix/`, ...priced(FACTORY_FIX.minPrice) },
    ...PACKAGES.map((p) => ({ '@type': 'Offer', name: p.title, description: p.description, ...priced(p.minPrice) })),
  ],
};
---

<BaseLayout
  title="Services"
  description="Engineering and CAD support, manufacturing support, operations improvement and engineering project support for businesses in Sydney, NSW and across Australia."
  breadcrumbs={crumbs}
  schema={[catalog]}
>
  <Hero
    eyebrow="Services"
    title="Engineering, manufacturing, operations and <em>project</em> support."
    lead="Defined, practical technical work for businesses that need drawings, processes, production problems or projects moved forward, without adding permanent engineering headcount."
  >
    <Breadcrumb items={crumbs} slot="before" />
    <Fragment slot="actions">
      <Button href="/contact/" arrow data-cta="services-hero-quote">Get a Quote</Button>
      <Button href="#pricing" variant="secondary">Indicative pricing</Button>
    </Fragment>
  </Hero>

  <nav class="service-jump" aria-label="Service groups">
    <ul>
      {SERVICE_GROUPS.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}
      <li><a href="#factory-fix">Factory Fix</a></li>
      <li><a href="#pricing">Pricing</a></li>
    </ul>
  </nav>

  {
    SERVICE_GROUPS.map((g, i) => (
      <Section index={String(i + 1).padStart(2, '0')} label="Service group" id={g.id} labelledby={`${g.id}-title`} tone={i % 2 ? 'alt' : 'default'}>
        <div class="group">
          <div class="group__intro">
            <h2 id={`${g.id}-title`}>{g.title}</h2>
            <p class="group__summary">{g.summary}</p>
            <Button href={`/contact/?service=${g.id}`} arrow data-cta={`service-${g.id}`}>
              Request a quote
            </Button>
          </div>
          <div class="group__detail">
            <h3 class="group__label">Includes</h3>
            <ul class="group__items">{g.items.map((item) => <li>{item}</li>)}</ul>
            <h3 class="group__label">Typical deliverables</h3>
            <ul class="group__deliverables">{g.deliverables.map((d) => <li>{d}</li>)}</ul>
          </div>
        </div>
      </Section>
    ))
  }

  <Section index="05" label="Flagship offer" id="factory-fix" labelledby="ff-section-title">
    <h2 id="ff-section-title" class="visually-hidden">GoCore Factory Fix</h2>
    <FactoryFixFeature headingLevel="h3" />
  </Section>

  <Section index="06" label="Indicative pricing" id="pricing" tone="alt" labelledby="pricing-title">
    <div class="section-head">
      <h2 id="pricing-title">Common packages and starting points.</h2>
      <p class="section-head__lead">Use these as a guide. Every assignment is scoped, and the final price is confirmed in a written proposal before work begins. Online checkout is not offered; send an enquiry for a quote.</p>
    </div>
    <PackageGrid />
  </Section>

  <Section index="07" label="Ways to engage" labelledby="engage-title">
    <div class="section-head">
      <h2 id="engage-title">Pricing that suits the job.</h2>
      <Button href="/how-it-works/" variant="text" arrow>How engagements work</Button>
    </div>
    <ul class="models">
      {
        ENGAGEMENT_MODELS.map((m) => (
          <li>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="scope-note">
      {SERVICE_AREA} Some assignments, such as statutory approvals or work that must be certified by a registered professional engineer, may require other appropriately qualified professionals. See the <a href="/disclaimer/">disclaimer</a>.
    </p>
  </Section>

  <Section index="08" label="Capability" tone="alt" labelledby="sw-title">
    <h2 id="sw-title" class="visually-hidden">Software and delivery capability</h2>
    <SoftwareNote headingLevel="h3" />
  </Section>

  <CallToAction title="Not sure which service fits?" text="Describe the problem and GoCore can help define the scope, the deliverables and the best way to price the work." label="Get a Quote" />
</BaseLayout>

<style>
  .service-jump { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--paper); }
  .service-jump ul { display: flex; gap: 0.25rem 1.5rem; max-width: var(--max); margin: 0 auto; padding: 0.9rem var(--gutter); list-style: none; overflow-x: auto; white-space: nowrap; scrollbar-width: thin; }
  .service-jump a { font-size: 0.92rem; font-weight: 520; color: var(--ink-2); text-decoration: none; }
  .service-jump a:hover { color: var(--accent); }

  .group { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 2.5rem 5rem; }
  .group__intro h2 { font-size: var(--step-3); max-width: 14ch; }
  .group__summary { margin: 1.1rem 0 1.75rem; color: var(--ink-2); font-size: var(--step-1); line-height: 1.5; max-width: 44ch; }
  @media (min-width: 861px) { .group__intro { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; } }
  .group__label { margin: 0 0 0.75rem; font-size: 0.78rem; font-weight: 560; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .group__items { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2rem; margin: 0 0 2.25rem; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .group__items li { padding: 0.8rem 0; border-bottom: 1px solid var(--line); font-weight: 500; }
  .group__deliverables { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .group__deliverables li { padding: 0.4rem 0.8rem; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.9rem; color: var(--ink-2); }
  @media (max-width: 860px) { .group { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .group__items { grid-template-columns: 1fr; } }

  .section-head { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .section-head h2 { max-width: 20ch; }
  .section-head__lead { margin: 0; color: var(--ink-2); max-width: 56ch; }

  .models { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .models li { padding: 1.5rem 1.5rem 1.75rem 0; border-bottom: 1px solid var(--line); }
  .models li:not(:first-child) { padding-left: 1.5rem; border-left: 1px solid var(--line); }
  .models h3 { font-size: 1.12rem; letter-spacing: -0.015em; }
  .models p { margin: 0.5rem 0 0; color: var(--ink-2); font-size: 0.97rem; line-height: 1.55; }
  @media (max-width: 960px) { .models { grid-template-columns: 1fr 1fr; } .models li:nth-child(3) { padding-left: 0; border-left: 0; } }
  @media (max-width: 560px) { .models { grid-template-columns: 1fr; } .models li, .models li:not(:first-child) { padding-left: 0; border-left: 0; } }
  .scope-note { margin: 2rem 0 0; max-width: 80ch; color: var(--muted); font-size: 0.95rem; }
</style>
