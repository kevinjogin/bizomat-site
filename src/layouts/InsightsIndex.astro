---
// The /insights/ landing page and its paginated continuations (/insights/page/2/ …).
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MotionVisual from '../components/MotionVisual.astro';
import Container from '../components/Container.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ArticleCard from '../components/ArticleCard.astro';
import InsightsListing from '../components/InsightsListing.astro';
import CallToAction from '../components/CallToAction.astro';
import { getInsights, paginate } from '../utils/content.ts';

interface Props {
  page: number;
}
const { page } = Astro.props;
const all = await getInsights();
const featuredPost = all.find((p) => p.data.featured);
// The featured article is shown on its own above the list on page 1 and is left out of the paginated
// list on every page, so page counts here match getStaticPaths in pages/insights/page/[page].astro.
const featured = page === 1 ? featuredPost : undefined;
const listed = featuredPost ? all.filter((p) => p.id !== featuredPost.id) : all;
const { items, pages } = paginate(listed, page);
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Insights', href: '/insights/' },
  ...(page > 1 ? [{ label: `Page ${page}`, href: `/insights/page/${page}/` }] : []),
];
---

<BaseLayout
  title={page > 1 ? `Insights, page ${page}` : 'Insights'}
  description="KEVOS® Insights: practical articles on operations, manufacturing, engineering, decision making, finance and business, organised by subject."
  breadcrumbs={crumbs}
>
  <Hero eyebrow="KEVOS® Insights" title="Practical insight for <em>better decisions</em>." lead="Perspectives on engineering, manufacturing, operations and business, organised by topic to help you evaluate challenges, understand methods and make informed decisions.">
    <MotionVisual page="insights" slot="visual" priority />
    <Breadcrumb items={crumbs} slot="before" />
  </Hero>
  <Container class="insights-body">
    {
      featured && (
        <section class="featured" aria-labelledby="featured-label">
          <p id="featured-label" class="eyebrow">
            Featured
          </p>
          <ArticleCard post={featured} variant="feature" headingLevel="h2" />
        </section>
      )
    }
    <h2 class="visually-hidden">All articles</h2>
    <InsightsListing posts={items} all={all} page={page} pages={pages} base="/insights/" />
  </Container>
  <CallToAction title="Need help applying this in your business?" text="KEVOS® provides practical engineering, manufacturing, operations and project support. Describe the problem and get a clear proposal." label="Get a Quote" />
</BaseLayout>

<style>
  :global(.insights-body) { padding-bottom: var(--space-section); }
  .featured { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .featured .eyebrow { margin-bottom: 1rem; }
</style>
