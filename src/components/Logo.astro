---
interface Props {
  class?: string;
  height?: number;
  label?: string;
}
const { class: className, height = 20, label = 'KEVOS' } = Astro.props;
const sizeClass =
  height <= 18
    ? 'kevos-logo--hero'
    : height <= 26
      ? 'kevos-logo--compact'
      : height >= 38
        ? 'kevos-logo--large'
        : 'kevos-logo--default';
---
<span
  class:list={['kevos-logo', sizeClass, className]}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <img
    class="kevos-logo__image kevos-logo__image--light"
    src="/brand/kevos-logo-light-full.png"
    alt=""
    width="600"
    height="78"
    decoding="async"
  />
  <img
    class="kevos-logo__image kevos-logo__image--dark"
    src="/brand/kevos-logo-dark-full.png"
    alt=""
    width="600"
    height="78"
    decoding="async"
  />
</span>

<style>
  .kevos-logo {
    --kevos-logo-height: 30px;
    display: inline-grid;
    place-items: center;
    max-width: 100%;
    line-height: 0;
    overflow: visible;
    white-space: nowrap;
  }
  .kevos-logo--hero { --kevos-logo-height: 18px; }
  .kevos-logo--compact { --kevos-logo-height: 26px; }
  .kevos-logo--default { --kevos-logo-height: 30px; }
  .kevos-logo--large { --kevos-logo-height: 38px; }

  .kevos-logo__image {
    grid-area: 1 / 1;
    display: block;
    width: auto;
    height: var(--kevos-logo-height);
    max-width: 100%;
    object-fit: contain;
    object-position: center;
  }
  .kevos-logo__image--dark { display: none; }

  :global(:root[data-theme='dark']) .kevos-logo__image--light { display: none; }
  :global(:root[data-theme='dark']) .kevos-logo__image--dark { display: block; }
  :global(:root[data-theme='light']) .kevos-logo__image--light { display: block; }
  :global(:root[data-theme='light']) .kevos-logo__image--dark { display: none; }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .kevos-logo__image--light { display: none; }
    :global(:root:not([data-theme='light'])) .kevos-logo__image--dark { display: block; }
  }
</style>
