<Project Sdk="Microsoft.NET.Sdk">
  <!-- The SOLIDWORKS add-in: one DLL (shared Core sources compiled in), loaded by SOLIDWORKS 2022 through COM.
       SOLIDWORKS interop types are embedded (NoPIA), so no interop DLL ships and any 2022 service pack binds. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>OpenSketch.Sw</AssemblyName>
    <RootNamespace>OpenSketch.Sw</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ComVisible>false</ComVisible>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Core/**/*.cs" LinkBase="Core" />
    <Compile Include="**/*.cs" Exclude="obj/**;bin/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="SolidWorks.Interop.sldworks" Version="30.5.1" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="SolidWorks.Interop.swconst" Version="30.5.1" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="SolidWorks.Interop.swpublished" Version="30.5.1" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <Target Name="SwInterop" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <SwDll Include="$(PkgSolidWorks_Interop_sldworks)/**/SolidWorks.Interop.sldworks.dll" />
      <SwDll Include="$(PkgSolidWorks_Interop_swconst)/**/SolidWorks.Interop.swconst.dll" />
      <SwDll Include="$(PkgSolidWorks_Interop_swpublished)/**/SolidWorks.Interop.swpublished.dll" />
      <Reference Include="@(SwDll)">
        <EmbedInteropTypes>true</EmbedInteropTypes>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
