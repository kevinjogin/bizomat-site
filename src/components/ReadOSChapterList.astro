---
// The chapter list shown on every READOS book page: one heading, and one row design with a
// number, a featured figure from the chapter, its title and excerpt. Books, collections,
// authored publications and the library guide all use it, so the experience stays the same.
import ReadOSChapterThumb from './ReadOSChapterThumb.astro';
import KevosFigureMotion from './KevosFigureMotion.astro';

export interface ChapterListItem { href: string; number: number; title: string; description?: string; body?: string; id: string }
interface Props { items: ChapterListItem[] }
const { items } = Astro.props;
---
<section class="chapter-list" aria-labelledby="chapters">
  <p class="eyebrow">Inside this book</p>
  <h2 id="chapters">Chapters</h2>
  <ol>{items.map((item) =>
    <li><a href={item.href}>
      <span class="chapter-no">{String(item.number).padStart(2, '0')}</span>
      <ReadOSChapterThumb body={item.body} id={item.id} />
      <span class="chapter-text"><strong>{item.title}</strong>{item.description && <small>{item.description}</small>}</span>
      <span class="chapter-arrow" aria-hidden="true">↗</span>
    </a></li>)}</ol>
  <slot />
</section>
<KevosFigureMotion />
<style>
.chapter-list h2{font-size:var(--step-3);margin:.7rem 0 2rem}
.chapter-list ol{list-style:none;margin:0;padding:0;border-top:1px solid var(--line-strong)}
.chapter-list li{margin:0}
.chapter-list li a{display:grid;grid-template-columns:2.5rem clamp(7.5rem,20vw,10.5rem) minmax(0,1fr) 1rem;gap:1rem 1.25rem;padding:1.1rem .2rem;border-bottom:1px solid var(--line);align-items:center;color:inherit;text-decoration:none}
.chapter-no{font-variant-numeric:tabular-nums;color:var(--muted);font-size:.86rem}
.chapter-text strong{display:block;font-weight:650;transition:color .2s ease}
.chapter-text small{display:block;margin-top:.3rem;color:var(--muted);font-size:.85rem;line-height:1.5}
.chapter-arrow{color:var(--muted)}
.chapter-list li a:hover .chapter-text strong,.chapter-list li a:focus-visible .chapter-text strong{color:var(--accent)}
.chapter-list li a:hover :global(.toc-thumb),.chapter-list li a:focus-visible :global(.toc-thumb){border-color:var(--accent);box-shadow:0 6px 18px -10px var(--accent)}
@media(max-width:560px){
  .chapter-list li a{grid-template-columns:1.6rem minmax(0,1fr);gap:.7rem .75rem;align-items:start}
  .chapter-no{grid-row:span 2;padding-top:.1rem}
  .chapter-list li a>:global(.toc-thumb){aspect-ratio:2/1}
  .chapter-arrow{display:none}
}
</style>
