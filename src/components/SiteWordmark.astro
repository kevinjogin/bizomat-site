---
// The BIZOMAT logo for the header and footer: the mark (the B with its teal forward arrow on a navy tile) and the
// wordmark (shared/brand: navy on light, white on a lifted tile on dark). Drawn from SVG paths, never typeset, so it is
// sharp at every size.
import { LOCKUP_VIEWBOX } from '../data/bizomat-brand.ts';
const [, , lockupW, lockupH] = LOCKUP_VIEWBOX.split(' ').map(Number);
interface Props {
  class?: string;
  height?: number;
  label?: string;
}
const { class: className, height = 22, label = 'BIZOMAT' } = Astro.props;
const sizeClass = height >= 28 ? 'site-wordmark--footer' : height <= 18 ? 'site-wordmark--compact' : 'site-wordmark--header';
---
<span
  class:list={['site-wordmark', sizeClass, className]}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <img class="site-wordmark__image site-wordmark__image--light" src="/brand/bizomat-lockup-light.svg" alt="" width={lockupW} height={lockupH} decoding="async" />
  <img class="site-wordmark__image site-wordmark__image--dark" src="/brand/bizomat-lockup-dark.svg" alt="" width={lockupW} height={lockupH} decoding="async" />
</span>

<style>
  .site-wordmark {
    --wordmark-h: 22px;
    display: inline-grid;
    align-items: center;
    line-height: 0;
    overflow: visible;
    max-width: 100%;
  }
  .site-wordmark--compact { --wordmark-h: 28px; }
  .site-wordmark--header { --wordmark-h: 36px; }
  .site-wordmark--footer { --wordmark-h: 44px; }
  .site-wordmark__image { display: block; width: auto; height: var(--wordmark-h); max-width: 100%; object-fit: contain; }
  /* One variant per theme, each with the right contrast for its background. */
  .site-wordmark__image--dark { display: none; }
  :global(:root[data-theme='dark']) .site-wordmark__image--light { display: none; }
  :global(:root[data-theme='dark']) .site-wordmark__image--dark { display: block; }
</style>
