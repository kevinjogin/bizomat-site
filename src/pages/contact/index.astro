---
// REACHOS: the BIZOMAT connection gateway for enquiries, feedback, ideas and collaboration.
// The form, spam check, booking link and assistant are the site's existing ones (ContactForm, BookingCard,
// ChatWidget); this page arranges them. Pathway links preselect the form's category with ?service=<slug>.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ContactForm from '../../components/ContactForm.astro';
import BookingCard from '../../components/BookingCard.astro';
import { SITE } from '../../config/site.ts';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact/' },
];
const pathways: { slug: string; name: string; title: string; text: string; examples: string[]; explore?: { href: string; label: string } }[] = [
  {
    slug: 'cad-automation', name: 'CAD Automation', title: 'CAD Automation for SOLIDWORKS',
    text: 'Questions about connecting an AI assistant to SOLIDWORKS, installing the add-in or what it can build.',
    examples: ['Installation and pairing', 'Supported commands', 'Licensing and access', 'Feature requests'],
    explore: { href: '/cad-automation/', label: 'About CAD Automation' },
  },
  {
    slug: 'project-management', name: 'Project Management', title: 'Projects, tasks and teams',
    text: 'Questions about workspaces, boards, automations, dashboards or bringing your team on board.',
    examples: ['Getting started', 'Workspaces and permissions', 'Automations and integrations', 'Feature requests'],
    explore: { href: '/work/', label: 'About Project Management' },
  },
  {
    slug: 'engineering-project', name: 'Engineering', title: 'Engineering and technical projects',
    text: 'A design, manufacturing or operations problem you want to discuss, like those in the engineering record.',
    examples: ['Design and CAD', 'Manufacturing support', 'Operations improvement', 'Project support'],
    explore: { href: '/engine-room/#engineering-record', label: 'The engineering record' },
  },
  {
    slug: 'collaboration', name: 'Collaboration', title: 'Collaboration and business enquiries',
    text: 'Interested in working together, exploring a partnership or discussing a technical or business opportunity?',
    examples: ['Business collaboration', 'Partnerships', 'Development opportunities', 'Commercial enquiries'],
  },
];
const next = [
  'BIZOMAT reviews your enquiry.',
  'You receive a reply through the contact details you provide.',
  'Where it helps, a conversation is arranged to agree the next step.',
];
const description = 'Contact BIZOMAT about CAD Automation, Project Management, an engineering project or a collaboration. Send an enquiry or book a meeting.';
---

<BaseLayout
  title="Contact"
  description={description}
  breadcrumbs={crumbs}
  canonical="/contact/"
  schema={[{ '@type': 'ContactPage', name: 'Contact BIZOMAT', description, url: `${SITE.url}/contact/`, about: { '@id': `${SITE.url}/#organization` } }]}
>
  <Hero eyebrow="Contact" title="Talk to <em>BIZOMAT.</em>" lead="Questions about a product, an engineering problem or an opportunity. Send an enquiry or book a meeting.">
    <Breadcrumb items={crumbs} slot="before" />
    <Fragment slot="actions">
      <Button href="#enquiry" arrow data-cta="contact-hero-enquiry">Start an Enquiry</Button>
      <Button href={SITE.booking.url} variant="secondary" target="_blank" rel="noopener noreferrer" data-cta="contact-hero-meeting">Book a Meeting <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens Proton Calendar in a new tab)</span></Button>
    </Fragment>
  </Hero>

  <Section index="01" label="Enquiry pathways" id="pathways" labelledby="pathways-title">
    <div class="reach-head">
      <h2 id="pathways-title">How can we <em>help?</em></h2>
      <div>
        <p class="reach-intro">Choose the subject closest to your question, or go straight to the form below.</p>
      </div>
    </div>
    <ul class="pathways" role="list">
      {pathways.map((p) => (
        <li class="pathway">
          <div class="pathway__head">
            <div>
              <p class="pathway__name">{p.name}</p>
              <h3>{p.title}</h3>
            </div>
          </div>
          <p class="pathway__text">{p.text}</p>
          <ul class="pathway__examples">{p.examples.map((e) => <li>{e}</li>)}</ul>
          <div class="pathway__actions">
            <a class="pathway__cta" href={`/contact/?service=${p.slug}#enquiry`} data-enquiry-category={p.slug} data-cta={`contact-pathway-${p.slug}`}>Start this enquiry<span class="visually-hidden">: {p.title}</span> <span aria-hidden="true">→</span></a>
            {p.explore && <a class="pathway__link" href={p.explore.href}>{p.explore.label}</a>}
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section index="02" label="Enquiries" id="enquiry" labelledby="enquiry-title">
    <div class="reach-layout">
      <div class="reach-form">
        <h2 id="enquiry-title">Start a conversation.</h2>
        <p class="reach-intro reach-intro--small">Tell us a little about what you need. We’ll review your enquiry and respond through the contact details you provide.</p>
        <div class="reach-form__card"><ContactForm /></div>
      </div>
      <aside class="reach-aside" aria-label="Other ways to connect">
        <BookingCard id="meeting-title" title="Prefer to talk?" text="Arrange a conversation to discuss your requirements, ideas or potential opportunities." label="Book a Meeting" />
        <div class="reach-card">
          <h2 class="reach-card__title">What happens next</h2>
          <ol class="reach-next">{next.map((r) => <li>{r}</li>)}</ol>
        </div>
        <div class="reach-card">
          <h2 class="reach-card__title">Where BIZOMAT is</h2>
          <p>BIZOMAT is based in New South Wales, Australia. Enquiries are welcome from anywhere, and suitable remote opportunities can be considered.</p>
          {SITE.email && <p>Prefer email? <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>}
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>

<style>
  :global(#pathways), :global(#enquiry) { scroll-margin-top: calc(var(--header-h) + 1rem); }
  .reach-head { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1fr); gap: 1.5rem 5rem; margin-bottom: 2.2rem; }
  .reach-head h2 { max-width: 14ch; }
  .reach-intro { margin: 0; max-width: 64ch; font-size: var(--step-1); color: var(--ink-2); }
  .reach-intro--small { margin-top: .9rem; font-size: 1rem; color: var(--muted); }
  .pathways { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin: 0; padding: 0; list-style: none; }
  .pathway { display: flex; flex-direction: column; gap: .85rem; min-width: 0; padding: clamp(1.2rem, 3vw, 1.6rem); border: 1px solid var(--line); border-radius: 12px; background: var(--surface); transition: border-color .2s var(--ease); }
  .pathway:hover { border-color: var(--line-strong); }
  .pathway__head { display: grid; grid-template-columns: minmax(0, 1fr); gap: .85rem; align-items: center; }
  .pathway__name { margin: 0 0 .15rem; font-size: .72rem; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .pathway h3 { font-size: var(--step-1); }
  .pathway__text { margin: 0; color: var(--ink-2); font-size: .95rem; }
  .pathway__examples { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; padding: 0; list-style: none; }
  .pathway__examples li { padding: .28rem .65rem; border: 1px solid var(--line-strong); border-radius: 999px; font-size: .8rem; color: var(--ink-2); }
  .pathway__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.25rem; margin-top: auto; padding-top: .9rem; border-top: 1px solid var(--line); }
  .pathway__cta { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; color: var(--accent); font-weight: 600; text-decoration: none; }
  .pathway__cta:hover, .pathway__link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .pathway__link { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-2); font-size: .9rem; text-decoration: none; }
  .reach-layout { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 2.5rem 4rem; align-items: start; }
  .reach-form h2 { margin-bottom: .25rem; }
  .reach-form__card { margin-top: 1.75rem; padding: clamp(1.25rem, 3.5vw, 2.5rem); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .reach-aside { display: grid; gap: 1rem; }
  .reach-card { padding: clamp(1.25rem, 3vw, 1.6rem); border: 1px solid var(--line); border-radius: var(--radius); }
  .reach-card__title { margin-bottom: .75rem; font-family: var(--font-sans); font-size: .78rem; font-weight: 560; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .reach-card p { margin: 0; color: var(--ink-2); font-size: .95rem; }
  .reach-card p + p { margin-top: .6rem; }
  .reach-next { margin: 0; padding: 0; list-style: none; counter-reset: next; }
  .reach-next li { counter-increment: next; display: grid; grid-template-columns: 2rem 1fr; padding: .6rem 0; border-top: 1px solid var(--line); color: var(--ink-2); font-size: .95rem; }
  .reach-next li::before { content: counter(next, decimal-leading-zero); padding-top: .1rem; color: var(--accent); font-size: .85rem; }
  @media (max-width: 1000px) { .reach-layout { grid-template-columns: 1fr; } .reach-aside { grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); } }
  @media (max-width: 860px) { .reach-head { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .pathways { grid-template-columns: 1fr; } }
</style>
