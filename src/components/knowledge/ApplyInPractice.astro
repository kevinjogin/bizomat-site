---
// Library → Tools: the tools connected to a book or chapter (src/data/knowledge-links.json, approved links only).
// "Apply This in Practice" lists tools that apply or illustrate the reading; "Related Tools and Examples" lists the
// ones that are useful alongside it. With no connections, a book page may offer a BIZOMAT topic to browse instead.
import type { ToolConnection } from '../../utils/knowledge.ts';
import { toolAppHref } from '../../utils/workos-tools.ts';

interface Props {
  items: ToolConnection[];
  /** Show the chapters each tool is used in (book pages), or not (a chapter page). */
  showChapters?: boolean;
  /** Tools topic to suggest when there are no connections (book pages only). */
  discover?: { slug: string; name: string } | null;
  id?: string;
}
const { items, showChapters = false, discover = null, id = 'apply-in-practice' } = Astro.props;
const primary = items.filter((x) => x.type !== 'complements');
const related = items.filter((x) => x.type === 'complements');
---

{items.length > 0 ? (
  <section class="ka" aria-labelledby={id} data-pagefind-ignore>
    {primary.length > 0 && <>
      <h2 id={id}>Apply This in Practice</h2>
      <p class="ka__lead">Use these BIZOMAT tools to try the method from this reading with your own numbers.</p>
      <ul class="ka__list">
        {primary.map((x) => (
          <li class="ka__card">
            <p class="ka__label">{x.label}</p>
            <h3 class="ka__title"><a href={x.tool.href}>{x.tool.name}</a></h3>
            <p class="ka__note">{x.note}</p>
            {showChapters && x.chapters.length > 0 && <p class="ka__where">Used in {x.chapters.map((c, i) => <>{i > 0 && ', '}<a href={c.href}>{c.title}</a></>)}</p>}
            <p class="ka__open"><a href={toolAppHref(x.tool.id)}>Open the calculator <span aria-hidden="true">→</span></a></p>
          </li>
        ))}
      </ul>
    </>}
    {related.length > 0 && <>
      <h2 id={primary.length ? `${id}-related` : id}>Related Tools and Examples</h2>
      <ul class="ka__list">
        {related.map((x) => (
          <li class="ka__card">
            <p class="ka__label">{x.label}</p>
            <h3 class="ka__title"><a href={x.tool.href}>{x.tool.name}</a></h3>
            <p class="ka__note">{x.note}</p>
            {showChapters && x.chapters.length > 0 && <p class="ka__where">Related to {x.chapters.map((c, i) => <>{i > 0 && ', '}<a href={c.href}>{c.title}</a></>)}</p>}
            <p class="ka__open"><a href={toolAppHref(x.tool.id)}>Open the calculator <span aria-hidden="true">→</span></a></p>
          </li>
        ))}
      </ul>
    </>}
  </section>
) : discover ? (
  <section class="ka ka--discover" aria-labelledby={id} data-pagefind-ignore>
    <h2 id={id}>Apply This in Practice</h2>
    <p class="ka__lead">No tool has been matched to this book yet. Browse the related tools: <a href={`/tools/?topic=${discover.slug}`}>{discover.name} tools <span aria-hidden="true">→</span></a></p>
  </section>
) : null}

<style>
  .ka { padding: 2.5rem 0; border-top: 1px solid var(--line); }
  .ka h2 { margin: 0 0 .5rem; font-size: var(--step-1, 1.35rem); }
  .ka h2 + .ka__list { margin-top: 1rem; }
  .ka__list + h2 { margin-top: 2.25rem; }
  .ka__lead { margin: 0 0 1.25rem; color: var(--ink-2); font-size: .95rem; max-width: 46rem; }
  .ka__lead a { color: var(--accent); font-weight: 600; }
  .ka__list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .ka__card { display: flex; flex-direction: column; padding: 1.1rem 1.2rem; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
  .ka__label { margin: 0 0 .35rem; color: var(--muted); font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .ka__title { margin: 0 0 .5rem; font-size: 1.02rem; line-height: 1.3; }
  .ka__title a { color: var(--ink); text-decoration: none; }
  .ka__title a:hover, .ka__title a:focus-visible { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .ka__note { margin: 0 0 .6rem; color: var(--ink-2); font-size: .9rem; line-height: 1.5; }
  .ka__where { margin: 0 0 .6rem; color: var(--muted); font-size: .82rem; line-height: 1.45; }
  .ka__where a { color: var(--ink-2); }
  .ka__open { margin: auto 0 0; padding-top: .3rem; font-size: .86rem; font-weight: 600; }
  .ka__open a { color: var(--accent); }
  .ka a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }
  @media print { .ka { display: none; } }
</style>
