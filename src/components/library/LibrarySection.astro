---
// One topic of a library: heading, optional subcategory filter (shown when the topic is open) and its cards.
// Cards beyond the preview are rendered hidden, so every link stays in the HTML for crawlers.
interface Props {
  slug: string;
  name: string;
  description: string;
  count: number;
  noun: string;
  base: string;
  preview: number;
  subs?: { slug: string; name: string; count: number }[];
}
const { slug, name, description, count, noun, base, preview, subs = [] } = Astro.props;
const label = `${count} ${noun}${count === 1 ? '' : 's'}`;
---

<section class="lib-section" id={`topic-${slug}`} aria-labelledby={`topic-${slug}-title`} data-lib-section={slug}>
  <header class="lib-section__head">
    <div class="lib-section__heading">
      <h2 class="lib-section__title" id={`topic-${slug}-title`} tabindex="-1">{name}</h2>
      <p class="lib-section__desc">{description}</p>
    </div>
    {count > preview
      ? <a class="lib-section__more" href={`${base}?topic=${slug}`} data-lib-topic-link={slug} data-lib-more>View all {label} <span aria-hidden="true">→</span></a>
      : <span class="lib-section__count">{label}</span>}
  </header>
  {subs.length > 1 && (
    <div class="lib-subs" role="group" aria-label={`Filter ${name}`} hidden data-lib-subs>
      <button class="lib-sub" type="button" aria-pressed="true" data-lib-sub="">All <span>{count}</span></button>
      {subs.map((s) => <button class="lib-sub" type="button" aria-pressed="false" data-lib-sub={s.slug}>{s.name} <span>{s.count}</span></button>)}
    </div>
  )}
  <div class="lib-grid" data-lib-grid>
    <slot />
  </div>
</section>
