---
// /finance-platform/: BIZOMAT Finance. Introduces the product and opens the application at bizomat.ai/finance (sign-in
// required; the same accounts as Project Management and the CRM). The page cannot be /finance/: that path is the
// application (tests/worker.test.ts). Facts come from src/data/platform-catalog.ts (FINANCE), which records its sources
// in apps/work; tests/platform-catalog.test.ts compares them with the application's code. The guide is
// /finance-platform/guide/.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import FinanceLedger from '../components/visuals/FinanceLedger.astro';
import '../styles/product.css';
import { screenshots } from '../data/screenshots.ts';
import { SITE } from '../config/site.ts';
import { APP_LINKS } from '../config/platform.ts';
import { FINANCE } from '../data/platform-catalog.ts';

const GUIDE = '/finance-platform/guide/';
const show = ['finance-dashboard', 'finance-transactions', 'finance-statement', 'finance-invoice', 'finance-report', 'finance-budget'];
const shots = screenshots('finance').filter((s) => show.some((n) => s.src.endsWith(`/${n}.webp`)));
const description = 'BIZOMAT Finance: accounts, transactions, invoices, bills, budgets and reports for personal, household and business money, on a double-entry ledger.';
const list = (xs: readonly string[]) => xs.join(', ').replace(/, ([^,]+)$/, ' and $1');
const workspaces = [
  { t: 'Personal', x: 'Your own accounts, spending, budgets and savings goals, with everyday categories such as Groceries and Fuel. Private to you unless you invite someone.' },
  { t: 'Household', x: 'Money shared at home. Everyone you invite sees the household accounts, budgets and reports, adds their own spending, and can see it by person or together.' },
  { t: 'Business', x: 'A chart of accounts with codes, GST, customers and suppliers, quotes, invoices, credit notes, bills, purchase orders, expense claims and financial reports. Run as many businesses as you need.' },
];
const ledger = [
  { t: 'Every entry balances', x: 'Each transaction, invoice, bill and payment writes a journal whose debits equal its credits. The database itself refuses to post one that does not.' },
  { t: 'Posted means posted', x: 'A posted entry is never edited or deleted. Changing it reverses it and posts the new version, so the history shows both.' },
  { t: 'Lock a period', x: 'Set a lock date when a month or year is closed. Nothing dated on or before it can be posted; corrections go in a later period.' },
  { t: 'Categories are accounts', x: 'Income and expense categories, with subcategories, are accounts in the chart. Rename, reorder, give them codes, archive them, and add departments, projects and cost centres.' },
];
const banking = [
  { t: 'Money in, out and between accounts', x: 'Record income, spending and transfers. Split one payment across several categories, add GST, a note and a receipt.' },
  { t: 'Import your statement', x: `Download a statement from your bank and upload it: ${list(FINANCE.statementFormats)}. A CSV file shows its columns so you can match them; lines already imported are skipped.` },
  { t: 'Match and reconcile', x: 'Each line finds the transaction or payment it matches. Confirm it, or turn it into a new transaction in one step and let Finance remember the category. Then compare the statement balance with the ledger.' },
  { t: 'Approvals and duplicates', x: 'In a business, a contributor\'s spending waits for approval. Finance warns about a likely duplicate before you save it.' },
];
const docs = [
  { t: 'Quotes', x: 'Headings, optional items and a discount on the whole quote. The customer opens a secure link and accepts or declines; each version sent is kept. An accepted quote becomes invoices, in full or in parts.' },
  { t: 'Invoices', x: 'Numbered automatically, with due dates from your terms, line discounts and GST. A live A4 preview that is the PDF itself, a secure online copy, part payments and what is overdue.' },
  { t: 'Credit notes', x: 'Credit all or part of an invoice. Approving one lowers income and GST; the credit is applied to the customer\'s invoices or recorded as refunded.' },
  { t: 'Bills and purchase orders', x: 'Record bills as they arrive and pay them in part or in full. Approve a purchase order and turn it into a bill when the goods arrive.' },
  { t: 'Expense claims', x: 'Staff claim what they paid for the business, with receipts. Approve and reimburse; the claim records who is owed.' },
  { t: 'Recurring', x: `Rent, subscriptions and regular invoices repeat ${list(FINANCE.frequencies.map((f) => f.toLowerCase()))}, posted automatically or left as drafts to check.` },
];
const security = [
  'One BIZOMAT account for Project Management, the CRM and Finance, with the same protected sign-in.',
  'People outside a workspace cannot see it, or even tell that it exists. A personal workspace is private until you invite someone.',
  'Every list, report and file is limited to its workspace, and the database refuses links between two workspaces.',
  'The server checks every permission for every financial operation; the screens only hide what you cannot use.',
  'Receipts and documents are served only to people who can see the record they belong to.',
  'An audit trail records changes, approvals, imports, exports and permission changes. Your data is backed up with the rest of BIZOMAT.',
];
const steps = [
  { t: 'Sign in', x: 'Use your BIZOMAT account (the same email and password as Project Management and the CRM), or create one on the sign-in page.' },
  { t: 'Create a workspace', x: 'Choose personal, household or business. It starts with a chart of accounts and no sample records; a business also starts with the standard GST tax codes, used once it is registered for GST.' },
  { t: 'Set up your accounts', x: 'Add your bank accounts and cards with their opening balances, and adjust the categories.' },
  { t: 'Bring in your transactions', x: 'Import a statement or record transactions by hand, then match and reconcile.' },
  { t: 'Invoice, budget and report', x: 'Send invoices, record bills, set budgets, and read the reports. Invite the people who should share the work.' },
];
---
<BaseLayout title="Finance: accounts, invoices, budgets and reports" description={description} imageAlt="BIZOMAT Finance: personal, household and business money on a proper ledger" breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Finance', href: '/finance-platform/' }]}
  schema={[{ '@type': 'SoftwareApplication', name: 'BIZOMAT Finance', url: `${SITE.url}/finance-platform/`, applicationCategory: 'FinanceApplication', operatingSystem: 'Web browser', description, publisher: { '@id': `${SITE.url}/#organization` } }]}>
  <section class="pp-hero" aria-labelledby="fin-title">
    <Container class="pp-hero__inner">
      <div>
        <p class="bz-eyebrow">BIZOMAT Finance</p>
        <h1 id="fin-title">{FINANCE.headline}</h1>
        <p class="pp-hero__lead">{FINANCE.summary}</p>
        <div class="pp-hero__actions">
          <Button href={APP_LINKS.finance.signIn} variant="accent" rel="noopener" data-cta="finance-start">Open Finance</Button>
          <Button href={GUIDE} variant="secondary" data-cta="finance-guide">Read the user guide</Button>
        </div>
        <p class="pp-hero__note">Sign-in required. It uses your BIZOMAT account: the same email and password as Project Management and the CRM. New to BIZOMAT? Create an account on the sign-in page.</p>
      </div>
      <FinanceLedger id="fin-hero" />
    </Container>
  </section>

  <section class="pp-section" id="features" aria-labelledby="features-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">What it does</p>
        <h2 id="features-title">Your money, in order, in one place</h2>
        <p>Finance records where money comes from and where it goes, what you are owed and what you owe, and what you planned. Everything sits on a double-entry ledger, the method accountants use, so the reports always add up.</p>
      </div>
      <ul class="pp-cards" role="list">
        {FINANCE.capabilities.map((c) => <li class="pp-card"><span class="pp-card__mark"></span><h3>{c.title}</h3><p>{c.text}</p></li>)}
      </ul>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="workspaces" aria-labelledby="ws-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Workspaces</p>
        <h2 id="ws-title">Keep personal, household and business money apart</h2>
        <p>Each workspace has its own accounts, records, members and settings. Switch between them from the top of the screen.</p>
      </div>
      <ul class="pp-cards" role="list">
        {workspaces.map((w) => <li class="pp-card"><h3>{w.t}</h3><p>{w.x}</p></li>)}
      </ul>
    </Container>
  </section>

  {shots.length > 0 && (
    <section class="pp-section" id="screens" aria-labelledby="screens-title">
      <Container>
        <div class="pp-head">
          <p class="bz-eyebrow">What it looks like</p>
          <h2 id="screens-title">The real product</h2>
          <p>Captured from the running application with a fictional business and example data. More screens are in the <a href={GUIDE}>user guide</a>.</p>
        </div>
        <div class="pp-shots">
          {shots.map((s) => (
            <figure class="pp-shot">
              <img src={s.src} alt={`${s.title}. ${s.caption}`} width="1440" height="900" loading="lazy" decoding="async" />
              <figcaption><span>{s.title.replace(/^[^:]+: /, '').replace(/^a /, 'A ')}. {s.caption}</span><span class="viz__tag viz__tag--real">Product screen</span></figcaption>
            </figure>
          ))}
        </div>
      </Container>
    </section>
  )}

  <section class="pp-section pp-section--tint" id="ledger" aria-labelledby="ledger-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">The ledger underneath</p>
        <h2 id="ledger-title">Double-entry, so the books always balance</h2>
      </div>
      <ul class="pp-cards pp-cards--2" role="list">
        {ledger.map((l) => <li class="pp-card"><h3>{l.t}</h3><p>{l.x}</p></li>)}
      </ul>
    </Container>
  </section>

  <section class="pp-section" id="banking" aria-labelledby="banking-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Transactions and bank statements</p>
        <h2 id="banking-title">From your bank statement to categorised transactions</h2>
        <p>Finance never connects to your bank and never asks for your internet banking password. You download the statement and upload it.</p>
      </div>
      <ul class="pp-cards pp-cards--2" role="list">
        {banking.map((b) => <li class="pp-card"><h3>{b.t}</h3><p>{b.x}</p></li>)}
      </ul>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="invoices" aria-labelledby="inv-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Quotes, invoices, bills and claims</p>
        <h2 id="inv-title">Know who owes you, and whom you owe</h2>
        <p>Recording a payment records money you have already received or paid. Finance does not take or send payments.</p>
      </div>
      <ul class="pp-cards pp-cards--2" role="list">
        {docs.map((d) => <li class="pp-card"><h3>{d.t}</h3><p>{d.x}</p></li>)}
      </ul>
    </Container>
  </section>

  <section class="pp-section" id="reports" aria-labelledby="reports-title">
    <Container class="pp-split">
      <div>
        <p class="bz-eyebrow">Reports and budgets</p>
        <h2 id="reports-title">Reports computed from the ledger when you open them</h2>
        <p class="pp-head-lead">Filter by dates, department, project or cost centre; in a household, by person. Compare with the previous period or year. Export CSV or PDF, or schedule a report each month or quarter.</p>
        <p class="pp-body">Budgets are set by category and month, for the whole workspace or a department or project, and can start from last year's figures. Savings goals track an account or an amount you enter. The dashboard brings income, spending, cash, what is owed, budgets and upcoming payments together.</p>
      </div>
      <div>
        <h3 class="pp-subhead">{FINANCE.reports.length} reports</h3>
        <ul class="pp-list pp-list--cols">{FINANCE.reports.map((r) => <li>{r}</li>)}</ul>
      </div>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="gst" aria-labelledby="gst-title">
    <Container class="pp-split">
      <div>
        <p class="bz-eyebrow">Australian GST and BAS</p>
        <h2 id="gst-title">GST worked out on every line</h2>
        <p class="pp-head-lead">Australian dollars and a July to June financial year by default. Prices can include or exclude GST, and each line has a tax code: GST, GST-free, input-taxed or excluded.</p>
        <p class="pp-body">The GST and BAS worksheet adds up labels G1, 1A and 1B (and G2, G3, G10 and G11 for full reporting) on the cash or accrual basis. It is a worksheet to check against your records before you or your agent lodge with the ATO: BIZOMAT does not lodge, and is not a certified tax, payroll or statutory accounting product.</p>
      </div>
      <div>
        <h3 class="pp-subhead">The tax codes a GST-registered business starts with</h3>
        <ul class="pp-list">{FINANCE.taxCodes.map((t) => <li><span class="bz-mono">{t.code}</span> {t.name}</li>)}</ul>
        <p class="pp-table-note">Add your own codes or change their rates and BAS labels.</p>
      </div>
    </Container>
  </section>

  <section class="pp-section" id="roles" aria-labelledby="roles-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Members, roles and permissions</p>
        <h2 id="roles-title">Share the work, not more than you choose</h2>
        <p>Invite your partner, bookkeeper, accountant or staff by email and give each a role. Owners and administrators can change what the other roles may view, create, edit, delete, approve, import and export, module by module.</p>
      </div>
      <ul class="pp-cards" role="list">
        {FINANCE.roles.map((r) => <li class="pp-card"><h3>{r.name}</h3><p>{r.text}</p></li>)}
      </ul>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="security" aria-labelledby="sec-title">
    <Container class="pp-split">
      <div>
        <p class="bz-eyebrow">Accounts and security</p>
        <h2 id="sec-title">Your financial records stay in your workspace</h2>
        <ul class="pp-list">{security.map((s) => <li>{s}</li>)}</ul>
      </div>
      <div>
        <h3 class="pp-subhead" id="limits">What Finance does not do</h3>
        <p class="pp-body">{FINANCE.limits}</p>
        <p class="pp-body">Category suggestions come from your own rules and history. Every posted entry and every figure is calculated by the application's own checked logic.</p>
      </div>
    </Container>
  </section>

  <section class="pp-section" id="start" aria-labelledby="start-title">
    <Container class="pp-split">
      <div>
        <p class="bz-eyebrow">Getting started</p>
        <h2 id="start-title">Start in five steps</h2>
        <p class="pp-head-lead">The <a href={GUIDE}>user guide</a> walks through each step, and everything after it, screen by screen.</p>
      </div>
      <ol class="pp-steps">
        {steps.map((s) => <li><h3>{s.t}</h3><p>{s.x}</p></li>)}
      </ol>
    </Container>
  </section>

  <section class="pp-section pp-section--inverse" aria-labelledby="fin-cta">
    <Container class="pp-band">
      <h2 id="fin-cta">Put your accounts, invoices and budgets in one place.</h2>
      <div class="pp-band__actions">
        <Button href={APP_LINKS.finance.signIn} variant="accent" rel="noopener" data-cta="finance-band-start">Open Finance</Button>
        <Button href={GUIDE} variant="secondary" data-cta="finance-band-guide">Read the user guide</Button>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .pp-head-lead { margin: .9rem 0 0; font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); }
  .pp-body { margin: .9rem 0 0; color: var(--ink-2); }
  .pp-subhead { font-size: var(--step-1); margin-bottom: .9rem; }
  .pp-list--cols { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; }
  @media (max-width: 640px) { .pp-list--cols { grid-template-columns: 1fr; } }
</style>
