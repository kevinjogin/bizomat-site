---
// The assessment journey as an infographic: four phases, twelve steps, who acts at each step, and the two
// gates that protect customers (payment only after scope approval; a booking only once the calendar confirms it).
import { JOURNEY } from '../../config/assessment.ts';

const gates: Record<string, string> = {
  '05': 'Payment is requested only after the scope is approved.',
  '09': 'A booking exists only once the calendar confirmation arrives.',
};
---

<ol class="jr">
  {
    JOURNEY.map((phase, p) => (
      <li class="jr__phase">
        <div class="jr__phase-head">
          <span class="jr__phase-num">Phase {p + 1}</span>
          <h3 class="jr__phase-title">{phase.title}</h3>
        </div>
        <ol class="jr__steps">
          {phase.steps.map((s) => (
            <li class:list={['jr__step', s.actor === 'You' ? 'jr__step--you' : 'jr__step--kevos']}>
              <span class="jr__marker" aria-hidden="true">{s.number}</span>
              <div class="jr__body">
                <p class="jr__actor">
                  <span class="visually-hidden">Step {Number(s.number)}, </span>
                  {s.actor}
                </p>
                <p class="jr__title">{s.title}</p>
                <p class="jr__text">{s.text}</p>
                {gates[s.number] && <p class="jr__gate">{gates[s.number]}</p>}
              </div>
            </li>
          ))}
        </ol>
      </li>
    ))
  }
</ol>
<p class="jr__legend" aria-hidden="true">
  <span class="jr__key jr__key--you">You</span>
  <span class="jr__key jr__key--kevos">BIZOMAT</span>
</p>

<style>
  .jr { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0; padding: 0; list-style: none; border-top: 2px solid var(--brand-orange); }
  .jr__phase { padding: 1.5rem 1.25rem 0 0; position: relative; }
  .jr__phase:not(:first-child) { padding-left: 1.25rem; border-left: 1px solid var(--line); }
  .jr__phase::before { content: ''; position: absolute; top: -7px; left: 0; width: 12px; height: 12px; border-radius: 50%; background: var(--brand-orange); }
  .jr__phase:not(:first-child)::before { left: -6px; }
  .jr__phase-num { display: block; font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .jr__phase-title { margin: 0.35rem 0 1.1rem; font-size: var(--step-1); }
  .jr__steps { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .jr__step { display: grid; grid-template-columns: 2.3rem 1fr; gap: 0.7rem; align-items: start; }
  .jr__marker {
    display: grid; place-items: center; width: 2.3rem; height: 2.3rem; border-radius: 50%;
    font-family: var(--font-mono); font-size: 0.78rem; font-variant-numeric: tabular-nums; border: 1px solid var(--line-strong); color: var(--ink);
  }
  .jr__step--kevos .jr__marker { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .jr__step--you .jr__marker { border-color: var(--accent); color: var(--accent); }
  .jr__body { padding-bottom: 0.75rem; border-bottom: 1px solid var(--line); min-width: 0; }
  .jr__actor { margin: 0; font-size: 0.72rem; font-weight: 560; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .jr__title { margin: 0.1rem 0 0.15rem; font-weight: 620; color: var(--ink); }
  .jr__text { margin: 0; font-size: 0.92rem; line-height: 1.5; color: var(--ink-2); }
  .jr__gate { margin: 0.55rem 0 0; padding: 0.45rem 0.65rem; font-size: 0.84rem; line-height: 1.4; color: var(--ink); background: var(--accent-soft); border-left: 2px solid var(--accent); }
  .jr__legend { display: flex; gap: 1.25rem; margin: 1.5rem 0 0; font-size: 0.85rem; color: var(--muted); }
  .jr__key { display: inline-flex; align-items: center; gap: 0.45rem; }
  .jr__key::before { content: ''; width: 0.85rem; height: 0.85rem; border-radius: 50%; border: 1px solid var(--accent); }
  .jr__key--kevos::before { background: var(--ink); border-color: var(--ink); }
  @media (max-width: 1050px) {
    .jr { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .jr__phase:nth-child(3) { padding-left: 0; border-left: 0; }
    .jr__phase:nth-child(3)::before { left: 0; }
    .jr__phase:nth-child(n + 3) { margin-top: 1.5rem; border-top: 2px solid var(--brand-orange); }
  }
  @media (max-width: 600px) {
    .jr { grid-template-columns: 1fr; }
    .jr__phase, .jr__phase:not(:first-child) { padding-left: 0; border-left: 0; }
    .jr__phase:not(:first-child) { margin-top: 1.5rem; border-top: 2px solid var(--brand-orange); }
    .jr__phase:not(:first-child)::before { left: 0; }
  }
</style>
