---
// The one chapter reader used by every READOS and Library book: back links, a chapter
// dropdown, medium/large text, the chapter heading with book progress, and previous/next links.
import Container from './Container.astro';
import KevosFigureMotion from './KevosFigureMotion.astro';

interface ReaderChapter { href: string; title: string }
interface ReaderLink { href: string; label: string }
interface Props {
  bookTitle: string;
  bookHref: string;
  home: ReaderLink;
  chapters: ReaderChapter[];
  index: number;
  title: string;
  description?: string;
  minutes?: number;
  note?: string;
  searchable?: boolean;
  filter?: string;
  finish?: ReaderLink & { small: string };
}
const { bookTitle, bookHref, home, chapters, index, title, description, minutes, note, searchable = false, filter, finish } = Astro.props;
const previous = chapters[index - 1], next = chapters[index + 1];
const end = finish ?? { href: bookHref, label: 'All chapters', small: 'Back to the book →' };
---
<Container size="narrow" class="chapter-reader">
  <nav class="reader-nav" aria-label="Book navigation"><a href={bookHref}>← All chapters</a><a href={home.href}>{home.label}</a></nav>
  <div class="reader-controls" data-pagefind-ignore>
    <label for="reader-chapter">Chapter</label>
    <select id="reader-chapter" data-reader-chapter>{chapters.map((ch, i) => <option value={ch.href} selected={i === index}>{i + 1}. {ch.title}</option>)}</select>
    <div class="reader-size" role="group" aria-label="Text size">
      <button type="button" data-reader-size="medium" aria-pressed="true">Medium text</button>
      <button type="button" data-reader-size="large" aria-pressed="false">Large text</button>
    </div>
  </div>
  <article data-pagefind-body={searchable || undefined} data-pagefind-filter={searchable && filter ? filter : undefined}>
    <header class="reader-heading">
      <p class="eyebrow"><a href={bookHref}>{bookTitle}</a></p>
      <p>Chapter {index + 1} of {chapters.length}{minutes ? ` · ${minutes} min read` : ''}</p>
      {note && <p>{note}</p>}
      <h1>{title}</h1>
      {description && <p class="chapter-description">{description}</p>}
      <progress value={index + 1} max={chapters.length} aria-label={`Chapter ${index + 1} of ${chapters.length}`}></progress>
    </header>
    <div class="prose reader-prose" data-reader-text="medium"><slot /></div>
  </article>
  <slot name="after" />
  <nav class="chapter-links" aria-label="Previous and next chapters" data-pagefind-ignore>
    {previous ? <a rel="prev" href={previous.href}><small>← Previous chapter</small>{previous.title}</a> : <a href={bookHref}><small>← Book overview</small>All chapters</a>}
    {next ? <a rel="next" href={next.href}><small>Next chapter →</small>{next.title}</a> : <a href={end.href}><small>{end.small}</small>{end.label}</a>}
  </nav>
</Container>
<KevosFigureMotion />
<script>
  const KEY = 'kevos-reader-text';
  const picker = document.querySelector<HTMLSelectElement>('[data-reader-chapter]');
  picker?.addEventListener('change', () => { if (picker.value.startsWith('/')) location.assign(picker.value); });
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-reader-size]')];
  const apply = (size: string) => {
    document.querySelectorAll<HTMLElement>('[data-reader-text]').forEach((el) => { el.dataset.readerText = size; });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.readerSize === size)));
  };
  let saved = 'medium';
  try { saved = localStorage.getItem(KEY) === 'large' ? 'large' : 'medium'; } catch {}
  apply(saved);
  buttons.forEach((b) => b.addEventListener('click', () => {
    const size = b.dataset.readerSize === 'large' ? 'large' : 'medium';
    apply(size);
    try { localStorage.setItem(KEY, size); } catch {}
  }));
</script>
<style>
  :global(.chapter-reader){padding-top:1.5rem;padding-bottom:5rem}
  .reader-nav{display:flex;justify-content:space-between;gap:1rem;font-size:.85rem}
  .reader-controls{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem;margin:1.5rem 0;padding:1rem 0;border-block:1px solid var(--line);font-size:.85rem}
  .reader-controls select{flex:1;min-width:150px;max-width:100%;background:var(--surface);border:1px solid var(--line-strong);padding:.55rem}
  .reader-size{display:flex}
  .reader-size button{padding:.55rem .8rem;background:var(--surface);border:1px solid var(--line-strong)}
  .reader-size button+button{border-left:0}
  .reader-size button[aria-pressed=true]{border-color:var(--accent);background:var(--accent-soft)}
  .reader-size button[aria-pressed=true]+button{border-left:1px solid var(--accent)}
  .reader-heading{margin:3rem 0 2rem}
  .reader-heading h1{font-size:clamp(2rem,4vw,3.4rem);line-height:1.15;max-width:24ch}
  .reader-heading>p:not(.eyebrow){color:var(--muted)}
  .chapter-description{font-size:1.1rem}
  .reader-heading progress{display:block;width:100%;height:4px;border:0;appearance:none;background:var(--line);margin:1rem 0}
  .reader-heading progress::-webkit-progress-bar{background:var(--line)}
  .reader-heading progress::-webkit-progress-value{background:var(--accent)}
  .reader-heading progress::-moz-progress-bar{background:var(--accent)}
  .reader-prose[data-reader-text=large]{font-size:1.4rem}
  .chapter-links{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:4rem}
  .chapter-links a{display:grid;gap:.5rem;text-decoration:none;border-top:1px solid var(--line-strong);padding-top:1rem}
  .chapter-links a:last-child{text-align:right}
  .chapter-links small{color:var(--muted)}
  @media(max-width:560px){.reader-controls select{flex-basis:100%}.chapter-links{grid-template-columns:1fr}.chapter-links a:last-child{text-align:left}}
  @media print{.reader-controls,.reader-nav,.chapter-links{display:none}}
</style>
