---
// Shown after a failed submission when JavaScript is unavailable.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Button from '../../components/Button.astro';
import { SITE } from '../../config/site.ts';
---

<BaseLayout title="Message not sent" description="Your message to KevOS could not be sent. Please check the form and try again, or use another way to get in touch." noindex>
  <Hero
    eyebrow="Not sent"
    title="Sorry, that didn’t go through."
    lead={`Please check that every required field is complete and try again${SITE.email ? `, or email ${SITE.email}` : ''}.`}
  >
    <Fragment slot="actions">
      <Button href="/contact/" arrow>Back to the form</Button>
    </Fragment>
  </Hero>
</BaseLayout>
