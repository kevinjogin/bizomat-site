---
interface Props { title: string; category: string; slug: string; compact?: boolean }
const { title, category, slug, compact = false } = Astro.props;
const palette: Record<string, [string,string,string]> = {
 Engineering:['#142d43','#3287b9','#a7d9f5'], Manufacturing:['#3a221c','#d66d35','#f3c08e'],
 Operations:['#18372f','#3c9a72','#b2e5ca'], Projects:['#282442','#7868cc','#d5cfff'],
 Technology:['#172445','#3577cf','#b6d9ff'], Business:['#3d3020','#b88937','#f7d88a'],
 Ideas:['#2d2841','#8d6aba','#e1cef6'], Products:['#263640','#459caa','#a5e4e3'],
 'Finance & Business':['#3d3020','#b88937','#f7d88a']
};
const colors=palette[category] ?? palette.Business;
const hash=[...slug].reduce((n,c)=>(n*31+c.charCodeAt(0))>>>0,2166136261);
const words=title.split(/\s+/);
const lines:string[]=[];let line='';
for(const word of words){if((line+' '+word).trim().length>20&&line){lines.push(line);line=word}else line=(line+' '+word).trim()}
if(line)lines.push(line);
const heading=lines.slice(0,5);
const dots=Array.from({length:16},(_,i)=>({x:38+((hash+i*113)%280),y:310+((hash+i*79)%200),r:3+((hash+i*13)%10)}));
---
<svg class="reados-cover" viewBox="0 0 360 490" role="img" aria-label={`Cover artwork for ${title}`} xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={`g-${slug}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color={colors[0]}/><stop offset="1" stop-color={colors[1]}/></linearGradient>
  </defs>
  <rect width="360" height="490" fill={colors[0]}/>
  <rect x="0" y="0" width="360" height="490" fill={`url(#g-${slug})`}/>
  <path d="M0 275 L360 208 L360 490 L0 490 Z" fill="#050e19" opacity=".45"/>
  <g fill="none" stroke={colors[2]} opacity=".48" stroke-width="2">
    {Array.from({length:7},(_,i)=><circle cx={175+(hash%35)} cy={379} r={32+i*25} />)}
    {Array.from({length:8},(_,i)=><path d={`M${i*53-80} 490 L${i*39+40} 275`}/>)}
  </g>
  <g fill={colors[2]} opacity=".85">{dots.map(dot=><circle cx={dot.x} cy={dot.y} r={dot.r}/>)}</g>
  <path d="M27 38 H333" stroke={colors[2]} opacity=".6"/>
  <text x="27" y="27" fill="white" font-size="16" font-family="Arial, sans-serif" font-weight="700" letter-spacing="2">KEVOS / READOS</text>
  <text x="27" y="68" fill={colors[2]} font-size="15" font-family="Arial, sans-serif" letter-spacing="2">{category.toUpperCase()}</text>
  <rect x="20" y="91" width="320" height={Math.max(105,heading.length*38+35)} rx="4" fill="#0d1522" opacity=".85"/>
  {heading.map((s,i)=><text x="32" y={132+i*38} fill="#ffffff" font-family="Arial, sans-serif" font-size="27" font-weight="700">{s}</text>)}
  <path d="M27 455 H333" stroke={colors[2]} opacity=".65"/>
  <text x="27" y="478" fill="white" font-size="13" letter-spacing="2" font-family="Arial, sans-serif">PRACTICAL KNOWLEDGE</text>
</svg>
<style>.reados-cover{width:100%;height:auto;display:block;aspect-ratio:360/490;box-shadow:0 12px 28px rgb(0 0 0 / .18);border-radius:3px}</style>