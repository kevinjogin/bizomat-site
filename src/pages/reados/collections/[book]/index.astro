---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Container from '../../../../components/Container.astro';
import ReadOSAnimatedCover from '../../../../components/ReadOSAnimatedCover.astro';
import { getChapters } from '../../../../utils/content.ts';
import { buildReadOSCollections, readosCollectionHref, readosCollectionChapterHref, type ReadOSCollection } from '../../../../utils/reados-collections.ts';

export async function getStaticPaths() {
  const books = buildReadOSCollections(await getChapters());
  return books.map((book) => ({params:{book:book.slug},props:{book}}));
}
interface Props { book: ReadOSCollection }
const { book } = Astro.props;
const href = readosCollectionHref(book);
---
<BaseLayout title={`${book.title} (READOS)`} description={`${book.description} Read the full KEVOS® collection in structured chapters.`}
  breadcrumbs={[{label:'Home',href:'/'},{label:'READOS',href:'/reados/'},{label:book.title,href}]}>
  <section class="heading"><Container size="narrow"><div class="book-intro"><div class="book-copy">
    <p class="eyebrow">READOS / {book.category}</p>
    <h1>{book.title}</h1>
    <p class="lead">{book.description}</p>
    <p class="metadata">{book.chapters.length} chapters · About {book.minutes} minutes · Free to read</p>
    <a class="start" href={readosCollectionChapterHref(book,book.chapters[0])}>Start reading →</a></div><div class="book-art"><ReadOSAnimatedCover title={book.title} category={book.category} slug={book.slug} chapters={book.chapters.length}/></div></div>
  </Container></section>
  <section class="contents"><Container size="narrow">
    <h2>Contents</h2>
    <ol>{book.chapters.map((chapter,index)=>
      <li><a href={readosCollectionChapterHref(book,chapter)}>
        <span class="number">{String(index+1).padStart(2,'0')}</span>
        <span><strong>{chapter.data.title}</strong><small>{chapter.data.description}</small></span>
        <span aria-hidden="true">↗</span>
      </a></li>)}</ol>
    <p class="note">These topic-based reading collections are organised alphabetically; chapters may be read in any order.</p>
    <a href="/reados/">← All books</a>
  </Container></section>
</BaseLayout>
<style>
.book-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(190px,270px);gap:clamp(2rem,5vw,5rem);align-items:center}.book-art{width:100%}@media(max-width:680px){.book-intro{grid-template-columns:1fr}.book-art{max-width:220px;order:-1}}

.heading{padding:clamp(3rem,6vw,6rem) 0;border-bottom:1px solid var(--line)}
.heading h1{margin:1rem 0}.metadata{color:var(--muted)}.start{display:inline-block;margin-top:1rem;color:var(--accent);font-weight:700}
.contents{padding:clamp(3rem,6vw,5rem) 0}.contents h2{margin-bottom:1.5rem}.contents ol{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}
.contents li a{display:grid;grid-template-columns:2.5rem 1fr 1rem;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line);text-decoration:none;align-items:start}
.contents li strong{display:block;font-weight:650}.contents li small{display:block;color:var(--muted);margin-top:.3rem;font-size:.85rem}
.number,.note{color:var(--muted)}.note{font-size:.9rem;margin:2rem 0}
</style>
