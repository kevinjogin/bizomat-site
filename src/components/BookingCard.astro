---
// "Book a meeting" option: links to BIZOMAT's Proton Calendar booking page in a new tab.
// Deliberately a link rather than an embed, so no third-party scripts or cookies load on BIZOMAT pages.
import { SITE } from '../config/site.ts';

interface Props {
  class?: string;
  title?: string;
  text?: string;
  label?: string;
  /** Heading id, so a surrounding section can be labelled by it. */
  id?: string;
}
const {
  class: className,
  title = 'Book a meeting',
  text = 'Prefer to talk it through? Choose a time that suits you from BIZOMAT’s calendar and discuss the job before sending details.',
  label = 'Choose a time',
  id,
} = Astro.props;
const { url } = SITE.booking;
---

<div class:list={['booking', className]}>
  <div class="booking__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <rect x="3.5" y="5" width="17" height="15.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" />
      <path d="M3.5 9.5h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="M8.5 14.5l2.2 2.2 4.8-4.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
  <div class="booking__body">
    <h2 class="booking__title" id={id}>{title}</h2>
    <p class="booking__text">{text}</p>
    <a class="booking__button" href={url} target="_blank" rel="noopener noreferrer" data-cta="book-meeting">
      {label}
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 16 16 8M10 8h6v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span class="visually-hidden">(opens Proton Calendar booking in a new tab)</span>
    </a>
    <p class="booking__note">Opens Proton Calendar’s booking page in a new tab.</p>
  </div>
</div>

<style>
  .booking {
    display: grid; grid-template-columns: auto 1fr; gap: 1rem 1.1rem; align-items: start;
    padding: clamp(1.25rem, 3vw, 1.6rem); border: 1px solid var(--line-strong); border-radius: var(--radius);
    background: var(--surface); position: relative; overflow: hidden;
  }
  .booking::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; background: linear-gradient(90deg, var(--brand-blue), var(--brand-orange)); }
  .booking__icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 10px; background: var(--paper-2); color: var(--accent); }
  .booking__icon svg { width: 1.5rem; height: 1.5rem; }
  .booking__title { font-size: var(--step-1); font-weight: 700; letter-spacing: -0.01em; line-height: 1.2; }
  .booking__text { margin: 0.4rem 0 1rem; color: var(--ink-2); line-height: 1.55; }
  .booking__button {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 46px; padding: 0 1.25rem;
    background: var(--ink); color: var(--paper); border-radius: 999px; font-weight: 560; text-decoration: none;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .booking__button:hover { background: var(--accent); color: var(--on-accent); }
  .booking__button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .booking__button svg { width: 1.05rem; height: 1.05rem; }
  .booking__note { margin: 0.6rem 0 0; font-size: 0.82rem; color: var(--muted); }
  @media (max-width: 420px) { .booking { grid-template-columns: 1fr; } }
</style>
