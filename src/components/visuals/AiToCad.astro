---
// Scene: an instruction in plain language becomes native SOLIDWORKS features. The tool names are the real CAD
// Automation tools (apps/cad/opensketch/sw_tools.py); the plate, holes and numbers are an example, not a customer's
// model. 60 x 40 x 8 mm plate, four 5.5 mm clearance holes for M5: 4 x pi x 2.75^2 x 8 = 760 mm^3 removed.
import '../../styles/visuals.css';

interface Props { id?: string }
const { id = 'ai2cad' } = Astro.props;
const calls = [
  { c: 's2', tool: 'sw_status', note: 'connected' },
  { c: 's3', tool: 'sw_body_topology', note: '6 faces read' },
  { c: 's4', tool: 'sw_add_features', note: '4 holes checked' },
  { c: 's5', tool: 'kernel prediction', note: '-0.76 cm³' },
  { c: 's7', tool: 'sw_preview', note: 'isometric' },
];
// Isometric plate (60 x 40 x 8 mm at 1.9 px/mm): top, right and front faces, and the four hole centres.
const holes = [[540, 106.2], [619, 151.8], [572.9, 178.4], [493.9, 132.8]];
---
<figure class="viz" aria-labelledby={`${id}-cap`}>
  <svg viewBox="0 0 660 300" role="img" aria-labelledby={`${id}-title`}>
    <title id={`${id}-title`}>An AI assistant asks for four M5 clearance holes in a plate. BIZOMAT CAD Automation reads the part, checks the four holes on its own kernel, and SOLIDWORKS adds them as a native cut feature.</title>
    <text class="v-sub" x="20" y="24">Your AI assistant</text>
    <text class="v-sub" x="244" y="24">BIZOMAT CAD Automation</text>
    <text class="v-sub" x="462" y="24">SOLIDWORKS on your PC</text>

    <g class="seq s1">
      <rect class="v-card" x="20" y="38" width="200" height="88" rx="10" />
      <text class="v-text" x="34" y="62">Add four M5 clearance holes,</text>
      <text class="v-text" x="34" y="80">6 mm in from each corner of</text>
      <text class="v-text" x="34" y="98">the 60 x 40 mm plate.</text>
    </g>
    <path class="v-edge" d="M220 82 H 244" />
    <path class="v-pulse d1" d="M220 82 H 244" pathLength="100" />

    {calls.map((c, i) => (
      <g class:list={['seq', c.c]}>
        <rect class="v-card" x="244" y={38 + i * 42} width="198" height="34" rx="8" />
        <text class="v-mono" x="256" y={53 + i * 42}>{c.tool}</text>
        <text class="v-accent-text" x="256" y={66 + i * 42}>{c.note}</text>
        <circle class="v-ok" cx="426" cy={55 + i * 42} r="5" />
        <path d={`M423.4 ${55 + i * 42} l1.9 1.9 l3.2 -3.6`} fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    ))}
    <path class="v-edge" d="M442 143 C 452 143, 452 150, 470 150" />
    <path class="v-pulse d3" d="M442 143 C 452 143, 452 150, 470 150" pathLength="100" />

    <g class="seq s2">
      <path class="v-face-top" d="M540 94.8 L638.7 151.8 L572.9 189.8 L474.2 132.8 Z" />
      <path class="v-face-side" d="M638.7 151.8 L572.9 189.8 L572.9 205 L638.7 167 Z" />
      <path class="v-face-front" d="M474.2 132.8 L572.9 189.8 L572.9 205 L474.2 148 Z" />
      <text class="v-mono" x="618" y="196">60</text>
      <text class="v-mono" x="500" y="182">40</text>
    </g>
    {holes.map(([cx, cy], i) => <ellipse class:list={['v-hole', 'seq', i < 2 ? 's5' : 's6']} cx={cx} cy={cy} rx="6.4" ry="3.7" />)}
    <g class="seq s8">
      <rect class="v-card v-card--accent" x="470" y="226" width="172" height="44" rx="8" />
      <text class="v-mono" x="482" y="244">Plate.SLDPRT</text>
      <text class="v-accent-text" x="482" y="260">+ Cut-Extrude1, 4 holes</text>
    </g>

    <g class="seq s9">
      <rect class="v-card v-card--accent" x="20" y="190" width="200" height="62" rx="10" />
      <text class="v-text" x="34" y="214">Done: four holes added.</text>
      <text class="v-text" x="34" y="232">Volume matches the check.</text>
    </g>
  </svg>
  <figcaption class="viz__caption" id={`${id}-cap`}><span>An instruction becomes native features. Real tool names; the plate is an example.</span><span class="viz__tag">Illustration</span></figcaption>
</figure>
