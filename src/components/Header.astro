---
// Global header: the BIZOMAT wordmark (home), the three other sections (CAD Automation, Project Management, The Engine
// Room), the theme switch and a Sign in menu with one entry per application.
// The Sign in menu is a <details> element, so it opens without JavaScript; the script below adds Escape and
// outside-click closing, and the phone/tablet menu button. Without JavaScript the phone layout shows the links as a
// wrapped row instead of a collapsed menu.
import { NAV, SIGN_IN } from '../config/site.ts';
import Container from './Container.astro';
import SiteWordmark from './SiteWordmark.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const inSection = (href: string) => href !== '/' && path.startsWith(href);
---
<header class="site-header" data-header>
  <Container class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="BIZOMAT home">
      <SiteWordmark class="site-header__logo" height={21} />
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main" data-site-nav>
      <ul class="site-nav__list">
        {NAV.map((item) => (
          <li class="site-nav__item">
            <a class:list={['site-nav__link', { 'is-current': inSection(item.href) }]} href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="site-nav__mobile-action">
        <p class="site-nav__signin-label">Sign in</p>
        <ul class="site-nav__signin">
          {SIGN_IN.map((s) => <li><a href={s.href} rel="noopener" data-cta={`header-sign-in-mobile-${s.label.toLowerCase().replace(/\s+/g, '-')}`}>{s.label}</a></li>)}
        </ul>
      </div>
    </nav>

    <div class="site-header__tools">
      <ThemeToggle />
      <details class="nav-menu signin-menu" data-nav-menu>
        <summary class="site-header__cta" data-cta="header-sign-in">Sign in</summary>
        <div class="nav-menu__panel nav-menu__panel--right">
          <ul class="nav-menu__list">
            {SIGN_IN.map((s) => (
              <li>
                <a class="nav-menu__link" href={s.href} rel="noopener">
                  <span class="nav-menu__title">{s.label}<span class="nav-menu__ext" aria-hidden="true">↗</span></span>
                  <span class="nav-menu__description">{s.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
      <button class="site-header__toggle" type="button" aria-controls="site-nav" aria-expanded="false" data-nav-toggle hidden>
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-open" d="M4 7h16M4 12h16M4 17h16" /><path class="i-close" d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </Container>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    header.classList.add('has-js');
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 4);
    window.addEventListener('scroll', update, { passive: true });
    update();

    const menus = [...header.querySelectorAll<HTMLDetailsElement>('[data-nav-menu]')];
    const toggle = header.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const closeMenus = (except?: HTMLDetailsElement) => menus.forEach((m) => { if (m !== except) m.open = false; });
    const setPanel = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      toggle?.querySelector('.visually-hidden')?.replaceChildren(open ? 'Close menu' : 'Menu');
      if (!open) closeMenus();
    };
    menus.forEach((m) => {
      // Close the others as soon as a menu is chosen (the toggle event alone arrives a moment later).
      m.querySelector('summary')?.addEventListener('click', () => { if (!m.open) closeMenus(m); });
      m.addEventListener('toggle', () => { if (m.open) closeMenus(m); });
    });
    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener('click', () => setPanel(!header.classList.contains('is-open')));
    }
    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) { closeMenus(); setPanel(false); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = menus.find((m) => m.open);
      if (open) { open.open = false; open.querySelector('summary')?.focus(); return; }
      if (header.classList.contains('is-open')) { setPanel(false); toggle?.focus(); }
    });
    // A menu link to a place on the current page (for example /#ask on the homepage) closes the menus.
    header.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((a) => a.addEventListener('click', () => setPanel(false)));
    // Back to the wide layout: the phone menu state no longer applies.
    matchMedia('(min-width: 761px)').addEventListener('change', (e) => { if (e.matches) setPanel(false); });
  }
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--paper); background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid transparent; transition: border-color .2s var(--ease); }
  .site-header.is-scrolled, .site-header.is-open { border-bottom-color: var(--line); }
  :global(.site-header__inner) { display: flex; align-items: center; gap: 1.25rem; min-height: var(--header-h); }
  .site-header__brand { display: inline-flex; align-items: center; flex: none; text-decoration: none; border-radius: 4px; }
  .site-header__brand :global(.site-wordmark) { --wordmark-h: 36px; }

  .site-nav { display: flex; align-items: center; flex: 1; min-width: 0; margin-left: 1rem; }
  .site-nav__list { display: flex; align-items: center; gap: .15rem; margin: 0; padding: 0; list-style: none; }
  .site-nav__item { position: relative; }
  .site-nav__link {
    display: inline-flex; align-items: center; gap: .3rem; min-height: 40px; padding: 0 .75rem; border-radius: 8px;
    color: var(--ink-2); font-size: .94rem; font-weight: 540; text-decoration: none; 
    transition: color .15s var(--ease), background .15s var(--ease);
  }
  .site-nav__link:hover { color: var(--ink); background: var(--paper-2); }
  .site-nav__link.is-current { color: var(--ink); }
  .site-nav__link.is-current::after { content: ''; position: absolute; left: .75rem; right: .75rem; bottom: 2px; height: 2px; border-radius: 2px; background: var(--brand-orange); }

  .nav-menu__panel {
    position: absolute; left: 0; top: calc(100% + .5rem); z-index: 60; width: 320px; padding: .45rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow-menu);
  }
  .nav-menu__list { display: grid; gap: .1rem; margin: 0; padding: 0; list-style: none; }
  .nav-menu__link { display: grid; gap: .15rem; padding: .7rem .8rem; border-radius: 8px; color: var(--ink); text-decoration: none; }
  a.nav-menu__link:hover, a.nav-menu__link:focus-visible, a.nav-menu__link[aria-current='page'] { background: var(--paper-2); color: var(--ink); }
  .nav-menu__title { display: inline-flex; align-items: center; gap: .45rem; font-size: .94rem; font-weight: 600; }
  .nav-menu__ext { color: var(--muted); font-size: .8rem; font-weight: 400; }
  .nav-menu__description { color: var(--muted); font-size: .84rem; line-height: 1.4; }

  .site-header__tools { display: flex; align-items: center; gap: .5rem; margin-left: auto; flex: none; }
  .site-header__cta {
    display: inline-flex; align-items: center; min-height: 38px; padding: 0 1rem; border-radius: 8px;
    background: var(--accent); color: var(--on-accent); font-size: .92rem; font-weight: 600; text-decoration: none; white-space: nowrap;
    transition: background .15s var(--ease);
  }
  .site-header__cta:hover { background: var(--accent-strong); color: var(--on-accent); }
  .site-nav__mobile-action { display: none; }
  .signin-menu { position: relative; }
  .signin-menu > summary { list-style: none; cursor: pointer; }
  .signin-menu > summary::-webkit-details-marker { display: none; }
  .nav-menu__panel--right { left: auto; right: 0; }
  .site-nav__signin-label { margin: 1.25rem 0 .25rem; color: var(--muted); font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .site-nav__signin { display: grid; gap: .1rem; margin: 0; padding: 0; list-style: none; }
  .site-nav__signin a { display: block; padding: .6rem .25rem; color: var(--ink); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--line); }
  .site-header__toggle { display: none; place-items: center; width: 40px; height: 40px; padding: 0; background: transparent; color: var(--ink); border: 1px solid var(--line); border-radius: 8px; }
  .site-header__toggle svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
  .site-header__toggle .i-close { display: none; }
  .is-open .site-header__toggle .i-open { display: none; }
  .is-open .site-header__toggle .i-close { display: inline; }

  /* Tablet and phone: the links move into a panel under the header, opened by the menu button. The `js` class is set on
     <html> by the inline script in BaseLayout's head, before the first paint, so the header never renders expanded and
     then collapses when this component's script runs (that was a layout shift of the whole page on slow phones). */
  @media (max-width: 760px) {
    :global(.js) .site-header .site-header__toggle { display: inline-grid; }
    :global(.js) .site-header .site-nav {
      display: none; position: absolute; left: 0; right: 0; top: 100%; margin: 0;
      max-height: calc(100dvh - var(--header-h)); overflow-y: auto; overscroll-behavior: contain;
      padding: .75rem var(--gutter) 1.5rem; background: var(--paper); border-bottom: 1px solid var(--line); box-shadow: var(--shadow-menu);
    }
    :global(.js) .site-header.is-open .site-nav { display: block; }
    :global(.js) .site-header .site-nav__list { flex-direction: column; align-items: stretch; gap: 0; }
    :global(.js) .site-header .site-nav__item { border-bottom: 1px solid var(--line); }
    :global(.js) .site-header .site-nav__link { display: flex; justify-content: space-between; width: 100%; min-height: 52px; padding: 0 .25rem; font-size: 1.02rem; border-radius: 0; background: none; }
    :global(.js) .site-header .site-nav__link.is-current::after { display: none; }
    :global(.js) .site-header .site-nav__link.is-current { color: var(--accent); }
    :global(.js) .site-header .site-nav__mobile-action { display: block; margin: 1.25rem 0 0; }
  }
  @media (max-width: 560px) {
    :global(.js) .site-header .signin-menu { display: none; }
  }
  /* Without JavaScript on small screens: keep every link reachable as a wrapped row. */
  @media (max-width: 760px) {
    :global(html:not(.js)) .site-header :global(.site-header__inner) { flex-wrap: wrap; padding-block: .5rem; }
    :global(html:not(.js)) .site-header .site-nav { order: 3; flex: 1 0 100%; margin: 0; }
    :global(html:not(.js)) .site-header .site-nav__list { flex-wrap: wrap; }
    :global(html:not(.js)) .site-header .site-nav__link { padding: 0 .5rem; font-size: .9rem; }
  }
</style>
