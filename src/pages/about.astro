---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MotionVisual from '../components/MotionVisual.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CallToAction from '../components/CallToAction.astro';
import SoftwareNote from '../components/SoftwareNote.astro';
import ProofOfWork from '../components/ProofOfWork.astro';
import { PROJECTS } from '../data/projects.ts';
import { BACKGROUND, FUTURE, PRINCIPLES } from '../data/brand.ts';
import { SERVICE_AREA } from '../data/services.ts';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
];
---

<BaseLayout
  title="About"
  description="KEVOS® is a small technical services business helping with engineering, manufacturing, operations and project delivery, drawing on practical production experience."
  breadcrumbs={crumbs}
>
  <Hero eyebrow="About KEVOS®" title="Practical engineering support, <em>without</em> the overhead.">
    <MotionVisual page="about" slot="visual" priority />
    <Breadcrumb items={crumbs} slot="before" />
  </Hero>

  <Section index="01" label="Who we are" labelledby="who-title">
    <div class="about-grid">
      <h2 id="who-title" class="about-grid__heading">A small business built for defined technical work</h2>
      <div class="prose about-grid__body">
        <p class="about-lede">
          KEVOS® helps businesses move drawings, processes, production problems and engineering projects forward when they need capable technical support but not another permanent role.
        </p>
        <p>
          KEVOS® takes on defined assignments such as drawing changes, fixture concepts, work instructions, process reviews and project documentation. Each job starts with an agreed scope and finishes with the deliverables checked and handed over.
        </p>
        <p>{SERVICE_AREA}</p>
      </div>
    </div>
  </Section>

  <Section index="02" label="Background" tone="alt" labelledby="background-title">
    <div class="about-grid">
      <h2 id="background-title" class="about-grid__heading">Experience from the floor up</h2>
      <div class="about-grid__body">
        <div class="prose">
          <p>
            KEVOS® is led by its founder, whose practical background spans making parts through to delivering projects. That experience informs how each production problem is assessed, considering design, tooling, processes, people and documentation together.
          </p>
        </div>
        <ul class="background">{BACKGROUND.map((b) => <li>{b}</li>)}</ul>
        <p class="muted small">
          KEVOS® does not use or disclose information belonging to any current or former employer, client or supplier. Examples on this website are general or independently created.
        </p>
      </div>
    </div>
  </Section>

  <Section index="03" label="How we work" id="principles" labelledby="principles-title">
    <h2 id="principles-title" class="principles-title">Principles KEVOS® works by</h2>
    <dl class="principle-list">
      {
        PRINCIPLES.map((p, i) => (
          <div class="principle-row">
            <dt>
              <span>{String(i + 1).padStart(2, '0')}</span>
              {p.title}
            </dt>
            <dd>{p.text}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section index="04" label="Capability" tone="alt" labelledby="capability-title">
    <h2 id="capability-title" class="visually-hidden">Software and delivery capability</h2>
    <SoftwareNote headingLevel="h3" />
  </Section>

  <Section index="05" label="Scope and limits" labelledby="limits-title">
    <div class="about-grid">
      <h2 id="limits-title" class="about-grid__heading">Clear about what is and isn’t included</h2>
      <div class="prose about-grid__body">
        <p>
          KEVOS® provides practical engineering, documentation, improvement and project support within an agreed scope. Not every assignment includes professional engineering certification or statutory approval. Where regulated or specialist work needs a registered or appropriately qualified professional, KEVOS® will say so, so the right people can be involved.
        </p>
        <p><a href="/disclaimer/">Read the full disclaimer</a></p>
      </div>
    </div>
  </Section>

  <Section index="06" label="Proof of work" tone="alt" id="work" labelledby="work-title">
    <div class="work-head">
      <h2 id="work-title">From steelworks to medical devices: {PROJECTS.length} Australian engineering projects worth sharing.</h2>
      <p class="work-intro">The engineering record behind KEVOS®, built since 2010 on a career that started on the toolroom floor. Coke plants, mine-site trucks, production machinery, window and door hardware taken from 3D print to production, rail interiors, bridges, food plants and patient-specific devices, carried out by its founder in employed, contract and consulting roles. Each record shows where the work happened, the role, what was delivered and, honestly, how far it went.</p>
    </div>
    <ProofOfWork />
  </Section>

  <Section index="07" label={FUTURE.title} labelledby="future-title">
    <div class="about-grid">
      <h2 id="future-title" class="about-grid__heading">Services first</h2>
      <div class="prose about-grid__body">
        <p>{FUTURE.text}</p>
        <p>KEVOS® also publishes practical reading in its <a href="/reados/">Library</a> of edited books.</p>
      </div>
    </div>
  </Section>

  <CallToAction title="Have work that needs moving forward?" text="Describe the problem or project. KEVOS® will help define the scope and send a clear proposal." label="Get a Quote" />
</BaseLayout>

<style>
  .about-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 1.5rem 5rem; }
  .about-grid__heading { font-size: var(--step-3); max-width: 14ch; }
  @media (min-width: 861px) { .about-grid__heading { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; } }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; } }
  .about-lede { font-size: 1.25em; line-height: 1.5; color: var(--ink); }
  .background { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2rem; margin: 1.5rem 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .background li { padding: 0.85rem 0; border-bottom: 1px solid var(--line); font-weight: 520; }
  @media (max-width: 520px) { .background { grid-template-columns: 1fr; } }
  .small { font-size: 0.9rem; max-width: 60ch; }
  .principles-title { margin-bottom: clamp(2rem, 4vw, 3rem); max-width: 16ch; }
  .principle-list { margin: 0; border-top: 1px solid var(--line-strong); }
  .principle-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 0.5rem 5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .principle-row dt { display: flex; gap: 1rem; font-size: var(--step-2); font-weight: 530; letter-spacing: -0.03em; line-height: 1.15; }
  .principle-row dt span { flex: none; width: 2.5rem; padding-top: 0.45rem; font-size: 0.85rem; font-weight: 400; letter-spacing: 0; color: var(--accent); font-variant-numeric: tabular-nums; }
  .principle-row dd { margin: 0; font-family: var(--font-serif); font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); }
  @media (max-width: 860px) { .principle-row { grid-template-columns: 1fr; } .principle-row dd { padding-left: 3.5rem; } }
  :global(#work) { scroll-margin-top: calc(var(--header-h) + 1.5rem); }
  .work-head { margin-bottom: 2.2rem; }
  .work-head h2 { max-width: 24ch; }
  .work-intro { margin: 1rem 0 0; max-width: 74ch; font-size: var(--step-1); color: var(--ink-2); }
</style>
