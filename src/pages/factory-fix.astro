---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import CallToAction from '../components/CallToAction.astro';
import { FACTORY_FIX, PRICING_NOTE } from '../data/services.ts';
import { SITE } from '../config/site.ts';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Factory Fix', href: '/factory-fix/' },
];
const steps = [
  { title: 'Enquiry', text: 'You describe the problem: what happens, how often, what it costs you and what has already been tried.' },
  { title: 'Scope confirmed', text: 'KEVOS® confirms the problem boundary, the deliverables, any site visit, timing and price in writing before starting.' },
  { title: 'Review', text: 'The problem is examined through information you provide, discussion with the people involved and, where agreed, a visit to see the work.' },
  { title: 'Action plan', text: 'You receive the observations, improvement opportunities and a practical, prioritised action plan, plus one agreed supporting document where appropriate.' },
];
const faq = [
  { q: 'What does “from A$990” cover?', a: 'It is the starting point for a single, well-defined problem. Larger, less defined or multi-site problems are quoted to scope. The final price is confirmed before any work begins.' },
  { q: 'Is the implementation included?', a: 'The Factory Fix produces a clear action plan and, where agreed, one supporting document. Implementation support can be quoted separately if you would like help carrying out the plan.' },
  { q: 'Do I need to share confidential information?', a: 'Only what is needed to understand the problem. If you need a confidentiality agreement before sharing drawings or information, say so in your enquiry.' },
  { q: 'Does it include engineering certification?', a: 'No. A Factory Fix is practical improvement and documentation work. Work that requires statutory approval or certification by a registered professional engineer is outside its scope.' },
];
const offer = {
  '@type': 'Offer',
  name: FACTORY_FIX.name,
  description: FACTORY_FIX.summary,
  url: `${SITE.url}/factory-fix/`,
  priceSpecification: { '@type': 'PriceSpecification', minPrice: FACTORY_FIX.minPrice, priceCurrency: 'AUD' },
  seller: { '@id': `${SITE.url}/#organization` },
};
---

<BaseLayout
  title="Factory Fix"
  description="KEVOS® Factory Fix: one defined production, workflow, documentation or engineering problem reviewed, documented and turned into a practical action plan, from A$990."
  breadcrumbs={crumbs}
  schema={[offer]}
>
  <Hero eyebrow="KEVOS® Factory Fix · From A$990" title="One problem. A <em>practical</em> plan to fix it." lead={FACTORY_FIX.summary}>
    <Breadcrumb items={crumbs} slot="before" />
    <Fragment slot="actions">
      <Button href="/contact/?service=factory-fix" arrow data-cta="factory-fix-hero">Discuss a Factory Fix</Button>
      <Button href="#how" variant="secondary">How it works</Button>
    </Fragment>
  </Hero>

  <Section index="01" label="Good candidates" labelledby="examples-title">
    <div class="split">
      <div class="split__intro">
        <h2 id="examples-title">Problems that suit a Factory Fix.</h2>
        <p class="muted">The best candidates are specific, recurring and costly enough to be worth solving properly.</p>
      </div>
      <ul class="check-list">{FACTORY_FIX.examples.map((e) => <li>{e}</li>)}</ul>
    </div>
  </Section>

  <Section index="02" label="What you receive" tone="alt" labelledby="deliverables-title">
    <div class="split">
      <div class="split__intro">
        <h2 id="deliverables-title">Clear findings and a plan you can act on.</h2>
        <p class="muted">Deliverables are confirmed in the written scope before work starts.</p>
      </div>
      <div>
        <ul class="check-list">{FACTORY_FIX.deliverables.map((d) => <li>{d}</li>)}</ul>
        <h3 class="docs-title">The supporting document may be, for example:</h3>
        <ul class="pill-list">{FACTORY_FIX.documents.map((d) => <li>{d}</li>)}</ul>
      </div>
    </div>
  </Section>

  <Section index="03" label="How it works" id="how" labelledby="how-title">
    <h2 id="how-title" class="how-title">Four steps from enquiry to action plan.</h2>
    <ol class="ff-steps">
      {
        steps.map((s, i) => (
          <li>
            <span>{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="terms">{FACTORY_FIX.terms} {PRICING_NOTE}</p>
  </Section>

  <Section index="04" label="Questions" tone="alt" labelledby="faq-title">
    <h2 id="faq-title" class="how-title">Factory Fix questions.</h2>
    <dl class="faq">
      {
        faq.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <CallToAction title="Have one problem that keeps coming back?" text="Tell KEVOS® what is happening. You will get a clear scope and price before any work begins." href="/contact/?service=factory-fix" label="Discuss a Factory Fix" />
</BaseLayout>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 2.5rem 5rem; }
  .split__intro h2 { margin-bottom: 1.1rem; max-width: 16ch; }
  .split__intro p { max-width: 40ch; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }
  .check-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .check-list li { position: relative; padding: 0.95rem 0 0.95rem 2rem; border-bottom: 1px solid var(--line); font-weight: 500; }
  .check-list li::before { content: ''; position: absolute; left: 0.1rem; top: 1.25rem; width: 0.9rem; height: 0.5rem; border-left: 2px solid var(--accent); border-bottom: 2px solid var(--accent); transform: rotate(-45deg); }
  .docs-title { font-family: var(--font-sans); margin: 2rem 0 0.75rem; font-size: 0.78rem; font-weight: 560; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .pill-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .pill-list li { padding: 0.4rem 0.8rem; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.9rem; color: var(--ink-2); }
  .how-title { margin-bottom: clamp(2rem, 4vw, 3rem); max-width: 20ch; }
  .ff-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .ff-steps li { padding: 1.5rem 1.5rem 1.75rem 0; }
  .ff-steps li:not(:first-child) { padding-left: 1.5rem; border-left: 1px solid var(--line); }
  .ff-steps span { display: block; margin-bottom: 1.25rem; font-size: 0.85rem; color: var(--accent); font-variant-numeric: tabular-nums; }
  .ff-steps h3 { font-size: var(--step-1); letter-spacing: -0.02em; }
  .ff-steps p { margin: 0.5rem 0 0; color: var(--ink-2); font-size: 0.97rem; line-height: 1.55; }
  @media (max-width: 960px) { .ff-steps { grid-template-columns: 1fr 1fr; } .ff-steps li:nth-child(3) { padding-left: 0; border-left: 0; } .ff-steps li:nth-child(n + 3) { border-top: 1px solid var(--line); } }
  @media (max-width: 560px) { .ff-steps { grid-template-columns: 1fr; } .ff-steps li, .ff-steps li:not(:first-child) { padding-left: 0; border-left: 0; } .ff-steps li:not(:first-child) { border-top: 1px solid var(--line); } }
  .terms { margin: 2rem 0 0; max-width: 80ch; color: var(--muted); font-size: 0.95rem; }
  .faq { margin: 0; border-top: 1px solid var(--line-strong); }
  .faq div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 0.5rem 4rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line); }
  .faq dt { font-weight: 560; font-size: 1.08rem; }
  .faq dd { margin: 0; color: var(--ink-2); line-height: 1.6; }
  @media (max-width: 760px) { .faq div { grid-template-columns: 1fr; } }
</style>
