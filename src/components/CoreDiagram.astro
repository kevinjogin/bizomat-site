---
// The GoCore "core" diagram: concentric rings around a single point, with the four areas of
// interest placed on the outer orbit. Decorative; hidden from assistive technology.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const ticks = Array.from({ length: 72 }, (_, i) => {
  const a = (i / 72) * Math.PI * 2;
  const long = i % 6 === 0;
  const r1 = 236;
  const r2 = long ? 224 : 230;
  return { x1: 260 + Math.cos(a) * r1, y1: 260 + Math.sin(a) * r1, x2: 260 + Math.cos(a) * r2, y2: 260 + Math.sin(a) * r2, long };
});
const labels = [
  { text: 'PRODUCTS', x: 260, y: 64, anchor: 'middle' },
  { text: 'TECHNOLOGY', x: 462, y: 264, anchor: 'end' },
  { text: 'SYSTEMS', x: 260, y: 464, anchor: 'middle' },
  { text: 'IDEAS', x: 58, y: 264, anchor: 'start' },
];
---

<div class:list={['core-diagram', className]} aria-hidden="true">
  <svg viewBox="0 0 520 520" focusable="false">
    <g class="core-diagram__ticks">
      {ticks.map((t) => <line x1={t.x1.toFixed(1)} y1={t.y1.toFixed(1)} x2={t.x2.toFixed(1)} y2={t.y2.toFixed(1)} class={t.long ? 'long' : undefined} />)}
    </g>
    <circle class="core-diagram__ring" cx="260" cy="260" r="210" />
    <circle class="core-diagram__ring core-diagram__ring--dash" cx="260" cy="260" r="160" />
    <circle class="core-diagram__ring" cx="260" cy="260" r="104" />
    <circle class="core-diagram__ring core-diagram__ring--strong" cx="260" cy="260" r="52" />
    <path class="core-diagram__cross" d="M260 30v120M260 370v120M30 260h120M370 260h120" />
    <g class="core-diagram__nodes">
      <circle cx="260" cy="50" r="4" />
      <circle cx="470" cy="260" r="4" />
      <circle cx="260" cy="470" r="4" />
      <circle cx="50" cy="260" r="4" />
    </g>
    <g class="core-diagram__labels">
      {labels.map((l) => <text x={l.x} y={l.y} text-anchor={l.anchor}>{l.text}</text>)}
    </g>
    <circle class="core-diagram__halo" cx="260" cy="260" r="22" />
    <circle class="core-diagram__core" cx="260" cy="260" r="12" />
  </svg>
</div>

<style>
  .core-diagram svg { width: 100%; height: auto; overflow: visible; }
  .core-diagram__ticks line { stroke: var(--line-strong); stroke-width: 1; }
  .core-diagram__ticks line.long { stroke: var(--muted); }
  .core-diagram__ring { fill: none; stroke: var(--line-strong); stroke-width: 1; }
  .core-diagram__ring--dash { stroke-dasharray: 2 6; }
  .core-diagram__ring--strong { stroke: var(--brand-blue); stroke-opacity: 0.7; stroke-width: 1.5; }
  .core-diagram__cross { stroke: var(--line); stroke-width: 1; }
  .core-diagram__nodes circle { fill: var(--paper); stroke: var(--ink); stroke-width: 1.2; }
  .core-diagram__labels text { font-family: var(--font-sans); font-size: 11px; font-weight: 560; letter-spacing: 0.16em; fill: var(--muted); }
  .core-diagram__core { fill: var(--brand-orange); }
  .core-diagram__halo { fill: var(--accent-soft); }
  @media (prefers-reduced-motion: no-preference) {
    .core-diagram__ticks { transform-origin: 260px 260px; animation: turn 120s linear infinite; }
    .core-diagram__halo { transform-origin: 260px 260px; animation: breathe 4.8s var(--ease) infinite; }
  }
  @keyframes turn { to { transform: rotate(360deg); } }
  @keyframes breathe { 50% { transform: scale(1.5); opacity: 0.4; } }
</style>
