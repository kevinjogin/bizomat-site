---
/**
 * KEVOS motion design system.
 * Services / Insights / About share the SAME Home orbit component and geometry.
 * The remaining scenes use purpose-built HTML/CSS layouts within the same
 * blueprint panel, orange palette, square-card radii and reduced-motion contract.
 * No scripts, external assets or fabricated business metrics.
 */
import ServiceMap from './ServiceMap.astro';
import Logo from './Logo.astro';
import { INDUSTRIES, PROCESS } from '../data/services.ts';

type Page = 'services' | 'how-it-works' | 'industries' | 'insights' | 'about' | 'contact' | 'tools';
interface Props { page: Page; priority?: boolean; class?: string; }
const { page, class: className } = Astro.props;
const sharedOrbit = page === 'services' || page === 'insights' || page === 'about';

const sectors = INDUSTRIES.slice(0, 6).map((item, i) => ({
  number: String(i + 1).padStart(2, '0'),
  name: item.title,
  discipline: ['Production', 'Tooling', 'Documentation', 'Manufacture', 'Components', 'Standard work'][i],
}));
const stages = PROCESS.map((item, i) => ({
  number: String(i + 1).padStart(2, '0'),
  name: item.title,
  label: ['DISCOVER', 'DEFINE', 'EXECUTE', 'HANDOVER'][i],
}));
const toolStages = [
  { number: '01', name: 'Input', note: 'Project data' },
  { number: '02', name: 'Analyse', note: 'Clear method' },
  { number: '03', name: 'Decide', note: 'Useful output' },
];
const contactPaths = [
  { number: '01', title: 'Describe the requirement', note: 'Share the problem, drawing or project' },
  { number: '02', title: 'Book a discussion', note: 'Clarify scope with KEVOS' },
];
const copy = {
  industries: {
    eyebrow: 'PRODUCTION SECTORS',
    description: 'Six representative production sectors supported by one practical engineering approach.',
    footer: 'SHARED ENGINEERING CAPABILITY',
  },
  'how-it-works': {
    eyebrow: 'ENGINEERING DELIVERY PATHWAY',
    description: 'Four clear engagement stages: tell us the problem, scope the work, complete the work, and deliver and close out.',
    footer: 'DEFINED SCOPE  →  PRACTICAL DELIVERY',
  },
  tools: {
    eyebrow: 'PRACTICAL DECISION SUPPORT',
    description: 'Illustrative data workflow: enter project values, analyse them, then use the output to make a decision.',
    footer: 'INPUT  →  ANALYSE  →  DECIDE',
  },
  contact: {
    eyebrow: 'START AN ENGINEERING ENQUIRY',
    description: 'Two enquiry options, either share the requirements or book a discussion, leading to the next agreed step.',
    footer: 'ONE CLEAR NEXT STEP',
  },
} as const;
const scene = !sharedOrbit ? copy[page as keyof typeof copy] : null;
---

{sharedOrbit ? (
  <ServiceMap variant={page as 'services' | 'insights' | 'about'} />
) : (
  <figure class:list={['mv', 'mv--' + page, className]} aria-labelledby={'mv-caption-' + page}>
    <figcaption id={'mv-caption-' + page} class="visually-hidden">{scene?.description}</figcaption>
    <div class="mv__panel">
      <div class="mv__top" aria-hidden="true">
        <span class="mv__eyebrow">{scene?.eyebrow}</span>
        <span class="mv__top-mark"><span></span><span></span><span></span></span>
      </div>

      {page === 'industries' && (
        <div class="mv__sectors mv__content" role="list" aria-label="Production sectors">
          {sectors.map((sector) => (
            <div class="mv__sector" role="listitem">
              <div class="mv__sector-top">
                <span class="mv__num">{sector.number}</span>
                <span class="mv__sector-symbol" aria-hidden="true">
                  <svg viewBox="0 0 28 28" focusable="false"><path d="M4 23V10l7-5 7 5 6-3v16H4Z M9 14v4 M15 14v4 M21 13v5"/></svg>
                </span>
              </div>
              <strong class="mv__sector-name">{sector.name}</strong>
              <span class="mv__sub">{sector.discipline}</span>
            </div>
          ))}
        </div>
      )}

      {page === 'how-it-works' && (
        <div class="mv__pathway mv__content">
          <div class="mv__rail" aria-hidden="true"><span class="mv__rail-packet"></span></div>
          <ol class="mv__steps">
            {stages.map((stage) => (
              <li class="mv__step">
                <span class="mv__step-num">{stage.number}</span>
                <span class="mv__step-copy">
                  <span class="mv__sub">{stage.label}</span>
                  <strong>{stage.name}</strong>
                </span>
                <span class="mv__step-check" aria-hidden="true">↗</span>
              </li>
            ))}
          </ol>
        </div>
      )}

      {page === 'tools' && (
        <div class="mv__tool-scene mv__content">
          <div class="mv__tool-stages">
            {toolStages.map((stage) => (
              <div class="mv__tool-card">
                <span class="mv__num">{stage.number}</span>
                <strong>{stage.name}</strong>
                <span class="mv__sub">{stage.note}</span>
                <span class="mv__tool-bars" aria-hidden="true">
                  <span></span><span></span><span></span>
                </span>
              </div>
            ))}
          </div>
          <div class="mv__flowline" aria-hidden="true"><span class="mv__flowpacket"></span></div>
          <div class="mv__tool-output">
            <span class="mv__output-title">APPLICATION AREAS</span>
            <span>Costing</span><span>Capacity</span><span>Planning</span><span>Operations</span>
          </div>
          <p class="mv__tool-note">Clear inputs. Transparent calculations. Useful decisions.</p>
        </div>
      )}

      {page === 'contact' && (
        <div class="mv__contact-scene mv__content">
          <div class="mv__contact-choices">
            {contactPaths.map((item) => (
              <div class="mv__contact-option">
                <span class="mv__num">{item.number}</span>
                <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
                  <path d="M10 7h15l5 5v21H10V7Z M25 7v6h5 M15 20h11 M15 26h11"/>
                </svg>
                <strong>{item.title}</strong>
                <span class="mv__sub">{item.note}</span>
              </div>
            ))}
          </div>
          <div class="mv__contact-lines" aria-hidden="true"><span></span><span></span></div>
          <div class="mv__contact-outcome">
            <Logo label="" height={26} />
            <span class="mv__contact-outcome-name">Defined next step</span>
            <span class="mv__sub">Clear scope · Practical response</span>
          </div>
        </div>
      )}

      <div class="mv__bottom" aria-hidden="true">
        <span>{scene?.footer}</span>
        <span class="mv__bottom-line"></span>
      </div>
    </div>
  </figure>
)}

<style>
  .mv {
    --m-panel:#ffffff;
    --m-card:rgb(255 255 255 / .91);
    --m-line:rgb(18 18 17 / .14);
    --m-grid:rgb(255 106 19 / .075);
    --m-ink:#121211;
    --m-muted:#67645d;
    --m-orange:#c2410c;
    --m-bright:#ff6a13;
    --m-soft:rgb(255 106 19 / .08);
    display:block;
    margin:0;
    width:100%;
    max-width:540px;
    color:var(--m-ink);
  }
  :global(:root[data-theme='dark']) .mv {
    --m-panel:#131412;
    --m-card:rgb(28 29 27 / .91);
    --m-line:rgb(238 236 230 / .17);
    --m-grid:rgb(255 140 71 / .08);
    --m-ink:#f1efea;
    --m-muted:#a9a49c;
    --m-orange:#ff8c47;
    --m-bright:#ff8c47;
    --m-soft:rgb(255 140 71 / .10);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .mv {
      --m-panel:#131412;
      --m-card:rgb(28 29 27 / .91);
      --m-line:rgb(238 236 230 / .17);
      --m-grid:rgb(255 140 71 / .08);
      --m-ink:#f1efea;
      --m-muted:#a9a49c;
      --m-orange:#ff8c47;
      --m-bright:#ff8c47;
      --m-soft:rgb(255 140 71 / .10);
    }
  }
  .mv__panel {
    position:relative;
    aspect-ratio:1;
    width:100%;
    border:1px solid var(--m-line);
    border-radius:20px;
    overflow:hidden;
    isolation:isolate;
    background-color:var(--m-panel);
    background-image:linear-gradient(var(--m-grid) 1px,transparent 1px),
      linear-gradient(90deg,var(--m-grid) 1px,transparent 1px);
    background-size:24px 24px;
  }
  .mv__top,.mv__bottom {
    position:absolute;left:5%;right:5%;display:flex;align-items:center;justify-content:space-between;
    font-family:var(--font-mono);font-size:clamp(.48rem,.36rem + .4vw,.65rem);
    font-weight:550;letter-spacing:.09em;line-height:1.3;color:var(--m-muted);
    z-index:3;pointer-events:none;
  }
  .mv__top{top:5%;}
  .mv__bottom{bottom:4.3%;}
  .mv__top-mark{display:inline-flex;align-items:center;gap:3px;}
  .mv__top-mark span{display:block;width:16px;height:2px;background:var(--m-orange);opacity:.35;}
  .mv__top-mark span:first-child{opacity:.95;}
  .mv__bottom-line{display:block;width:18%;height:1px;background:var(--m-orange);opacity:.7;}
  .mv__content{position:absolute;inset:13.5% 4.2% 12%;z-index:2;}
  .mv__num{font-family:var(--font-mono);font-size:.68rem;font-weight:650;letter-spacing:.06em;color:var(--m-orange);}
  .mv__sub{font-family:var(--font-mono);font-size:clamp(.47rem,.3rem + .42vw,.68rem);line-height:1.45;color:var(--m-muted);}
  .mv strong{font-family:var(--font-sans);color:var(--m-ink);letter-spacing:-.022em;line-height:1.22;}

  /* INDUSTRIES: six generous sector panels connected by a quiet central spine. */
  .mv__sectors{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));gap:clamp(8px,2.4%,13px);}
  .mv__sectors::before{
    content:'';position:absolute;z-index:-1;top:0;bottom:0;left:50%;width:2px;transform:translateX(-50%);
    background:linear-gradient(transparent,var(--m-orange),transparent);opacity:.55;
  }
  .mv__sector{
    display:flex;flex-direction:column;justify-content:space-between;min-width:0;
    padding:clamp(10px,3%,17px);background:var(--m-card);border:1px solid var(--m-line);
    border-radius:14px;animation:mv-sector 9s ease-in-out infinite;
  }
  .mv__sector:nth-child(2){animation-delay:-7.5s;}
  .mv__sector:nth-child(3){animation-delay:-6s;}
  .mv__sector:nth-child(4){animation-delay:-4.5s;}
  .mv__sector:nth-child(5){animation-delay:-3s;}
  .mv__sector:nth-child(6){animation-delay:-1.5s;}
  .mv__sector-top{display:flex;justify-content:space-between;align-items:start;gap:.4rem;}
  .mv__sector-symbol{color:var(--m-orange);}
  .mv__sector-symbol svg{width:clamp(22px,5vw,32px);height:auto;max-width:100%;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}
  .mv__sector-name{font-size:clamp(.78rem,.55rem + .72vw,1.06rem);}
  @keyframes mv-sector{0%,13%{border-color:var(--m-bright);background:var(--m-soft);}24%,100%{border-color:var(--m-line);background:var(--m-card);}}

  /* HOW IT WORKS: a vertical, four-stage delivery system, not a generic orbit. */
  .mv__pathway{display:block;}
  .mv__rail{position:absolute;top:6%;bottom:6%;left:5%;width:2px;background:var(--m-line);}
  .mv__rail-packet{
    position:absolute;top:0;left:50%;width:10px;height:10px;border-radius:50%;
    background:var(--m-bright);box-shadow:0 0 0 4px var(--m-soft);
    animation:mv-descend 8s linear infinite;
  }
  .mv__steps{display:grid;grid-template-rows:repeat(4,minmax(0,1fr));gap:clamp(8px,2.3%,13px);height:100%;margin:0;padding:0 0 0 7%;list-style:none;}
  .mv__step{
    display:flex;align-items:center;gap:clamp(10px,3%,18px);padding:clamp(10px,3%,16px);
    min-width:0;border:1px solid var(--m-line);border-radius:14px;background:var(--m-card);
    animation:mv-sector 8s ease-in-out infinite;
  }
  .mv__step:nth-child(2){animation-delay:-6s;}
  .mv__step:nth-child(3){animation-delay:-4s;}
  .mv__step:nth-child(4){animation-delay:-2s;}
  .mv__step-num{color:var(--m-orange);font-family:var(--font-mono);font-size:clamp(.9rem,.6rem + .9vw,1.35rem);font-weight:650;flex:none;}
  .mv__step-copy{display:flex;flex-direction:column;gap:.4rem;min-width:0;}
  .mv__step-copy strong{font-size:clamp(.82rem,.55rem + .65vw,1.05rem);}
  .mv__step-check{margin-left:auto;color:var(--m-orange);font-size:1.2rem;opacity:.5;}
  @keyframes mv-descend{from{transform:translate(-50%,0);}to{transform:translate(-50%,calc(400px - 10px));}}
  /* Use relative motion so the indicator scales with the responsive square. */
  .mv__rail-packet{top:0;bottom:auto;}
  @supports (top: calc(100% - 10px)) {
    .mv__rail-packet{animation:mv-rail-travel 8s linear infinite;}
    @keyframes mv-rail-travel{0%{top:0;transform:translate(-50%,-50%);}100%{top:100%;transform:translate(-50%,-50%);}}
  }

  /* TOOLS: input, calculation and decision, with a restrained live signal. */
  .mv__tool-scene{display:flex;flex-direction:column;justify-content:center;gap:5%;}
  .mv__tool-stages{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(7px,2%,12px);height:49%;}
  .mv__tool-card{
    display:flex;flex-direction:column;gap:6%;align-items:flex-start;min-width:0;
    padding:clamp(10px,3%,18px);border:1px solid var(--m-line);border-radius:14px;background:var(--m-card);
  }
  .mv__tool-card strong{font-size:clamp(.82rem,.6rem + .75vw,1.1rem);}
  .mv__tool-bars{display:grid;gap:7px;margin-top:auto;width:100%;}
  .mv__tool-bars span{display:block;height:5px;border-radius:5px;background:var(--m-orange);opacity:.7;transform-origin:left center;animation:mv-meter 3.2s ease-in-out infinite alternate;}
  .mv__tool-bars span:nth-child(1){width:88%;}
  .mv__tool-bars span:nth-child(2){width:60%;animation-delay:-1s;}
  .mv__tool-bars span:nth-child(3){width:75%;animation-delay:-2s;}
  .mv__flowline{position:relative;width:86%;height:2px;background:var(--m-line);align-self:center;}
  .mv__flowpacket{position:absolute;top:-5px;left:0;width:12px;height:12px;border-radius:50%;background:var(--m-bright);box-shadow:0 0 0 4px var(--m-soft);animation:mv-signal 6s linear infinite;}
  .mv__tool-output{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;}
  .mv__output-title{grid-column:1/-1;font-family:var(--font-mono);font-size:.62rem;letter-spacing:.08em;color:var(--m-orange);}
  .mv__tool-output>span:not(.mv__output-title){padding:.65rem .35rem;text-align:center;border:1px solid var(--m-line);border-radius:9px;background:var(--m-card);font-size:clamp(.58rem,.42rem + .3vw,.76rem);color:var(--m-ink);}
  .mv__tool-note{margin:0;color:var(--m-muted);font-size:clamp(.68rem,.49rem + .35vw,.85rem);line-height:1.4;text-align:center;}
  @keyframes mv-meter{from{transform:scaleX(.5);opacity:.35;}to{transform:scaleX(1);opacity:.9;}}
  @keyframes mv-signal{from{left:0;}to{left:100%;}}

  /* CONTACT: two clearly differentiated ways in, converging on a response. */
  .mv__contact-scene{display:flex;flex-direction:column;justify-content:space-between;}
  .mv__contact-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(10px,3%,17px);height:58%;}
  .mv__contact-option{
    display:flex;flex-direction:column;align-items:flex-start;gap:.6rem;
    min-width:0;padding:clamp(10px,3.1%,18px);border:1px solid var(--m-line);
    border-radius:14px;background:var(--m-card);animation:mv-contact 8s ease-in-out infinite;
  }
  .mv__contact-option:nth-child(2){animation-delay:-4s;}
  .mv__contact-option svg{width:clamp(26px,7vw,40px);height:auto;fill:none;stroke:var(--m-orange);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}
  .mv__contact-option strong{font-size:clamp(.8rem,.56rem + .65vw,1.08rem);}
  .mv__contact-option .mv__sub{margin-top:auto;}
  .mv__contact-lines{
    position:relative;width:52%;height:7%;margin:0 auto;border:1px dashed var(--m-orange);
    border-top:0;border-radius:0 0 20px 20px;opacity:.55;
  }
  .mv__contact-lines::after{content:'';position:absolute;width:2px;height:100%;top:100%;left:50%;background:var(--m-orange);}
  .mv__contact-outcome{
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:.35rem;height:29%;padding:.6rem 1rem;border:1px solid var(--m-line);
    border-radius:14px;background:var(--m-card);
  }
  .mv__contact-outcome-name{font-family:var(--font-sans);font-weight:700;font-size:clamp(.85rem,.6rem + .55vw,1rem);}
  @keyframes mv-contact{0%,29%{border-color:var(--m-orange);box-shadow:inset 0 0 0 1px var(--m-soft);}50%,100%{border-color:var(--m-line);box-shadow:none;}}

  @media (prefers-reduced-motion: reduce){
    .mv__sector,.mv__step,.mv__rail-packet,.mv__tool-bars span,.mv__flowpacket,.mv__contact-option{animation:none!important;}
    .mv__rail-packet{display:none;}
    .mv__flowpacket{left:50%;}
  }
  @media (max-width:420px){
    .mv__sector{padding:8px;}
    .mv__sector-symbol svg{width:22px;}
    .mv__top,.mv__bottom{font-size:.46rem;}
    .mv__content{inset:13% 3% 11%;}
    .mv__step{padding:8px;}
    .mv__contact-option{gap:.35rem;padding:8px;}
    .mv__tool-card{padding:8px;}
  }
</style>
