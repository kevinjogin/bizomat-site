---
// Scene: one bank statement line in BIZOMAT Finance. The line is matched as a categorised expense with GST, the
// transaction writes a balanced journal (debits equal credits), and the reports follow. Fictional example content;
// the account codes and the GST split are those of a new business workspace (apps/work/src/shared/fin/charts.ts and
// tax.ts: 1/11 of a GST-inclusive price).
import '../../styles/visuals.css';

interface Props { id?: string }
const { id = 'finledger' } = Astro.props;
---
<figure class="viz" aria-labelledby={`${id}-cap`}>
  <svg viewBox="0 0 660 290" role="img" aria-labelledby={`${id}-title`}>
    <title id={`${id}-title`}>A bank statement line of 330 dollars to Paperbark Office is matched as office expenses with GST. The transaction posts a balanced journal: office expenses debit 300, GST debit 30, bank credit 330. The profit and loss and the balance sheet update, and the balance sheet still balances.</title>
    <g class="seq s1">
      <rect class="v-panel" x="14" y="14" width="200" height="262" rx="12" />
      <text class="v-title" x="30" y="42">Bank statement</text>
      <text class="v-sub" x="30" y="62">Imported from a CSV file</text>
      <rect class="v-card" x="26" y="74" width="176" height="40" rx="7" />
      <text class="v-text" x="36" y="92">Client payment</text>
      <text class="v-mono" x="36" y="106">+$2,200.00 · matched</text>
      <rect class="v-card v-card--accent" x="26" y="122" width="176" height="40" rx="7" />
      <text class="v-text" x="36" y="140">Paperbark Office</text>
      <text class="v-mono" x="36" y="154">-$330.00</text>
      <rect class="v-card" x="26" y="170" width="176" height="40" rx="7" />
      <text class="v-text" x="36" y="188">Fuel</text>
      <text class="v-mono" x="36" y="202">-$88.00 · to match</text>
    </g>
    <g class="seq s3">
      <path class="v-edge" d="M202 142 H 228" />
      <rect class="v-panel" x="228" y="14" width="206" height="128" rx="12" />
      <text class="v-title" x="244" y="42">Transaction</text>
      <rect class="v-pill v-pill--done" x="356" y="28" width="62" height="18" rx="9" />
      <text class="v-pill-text" x="387" y="40.5" text-anchor="middle">Posted</text>
      <text class="v-text" x="244" y="68">453 Office expenses</text>
      <text class="v-mono" x="418" y="68" text-anchor="end">$300.00</text>
      <text class="v-text" x="244" y="88">GST on expenses (1/11)</text>
      <text class="v-mono" x="418" y="88" text-anchor="end">$30.00</text>
      <path class="v-edge" d="M244 100 H 418" />
      <text class="v-text" x="244" y="122">Paid from the bank</text>
      <text class="v-mono" x="418" y="122" text-anchor="end">$330.00</text>
    </g>
    <g class="seq s5">
      <rect class="v-panel" x="228" y="152" width="206" height="124" rx="12" />
      <text class="v-title" x="244" y="178">Journal</text>
      <text class="v-sub" x="378" y="178" text-anchor="end">Debit</text><text class="v-sub" x="426" y="178" text-anchor="end">Credit</text>
      <text class="v-text" x="244" y="200">Office</text><text class="v-mono" x="378" y="200" text-anchor="end">300.00</text>
      <text class="v-text" x="244" y="218">GST</text><text class="v-mono" x="378" y="218" text-anchor="end">30.00</text>
      <text class="v-text" x="244" y="236">Business bank</text><text class="v-mono" x="426" y="236" text-anchor="end">330.00</text>
      <path class="v-edge" d="M244 246 H 426" />
      <text class="v-accent-text" x="244" y="264">Balanced: 330.00 = 330.00</text>
    </g>
    <g class="seq s7">
      <text class="v-sub" x="450" y="40">Reports</text>
      <rect class="v-panel" x="450" y="50" width="196" height="102" rx="10" />
      <text class="v-text" x="464" y="74">Profit and loss</text>
      <text class="v-text" x="464" y="98">Expenses</text><text class="v-mono" x="632" y="98" text-anchor="end">+$300.00</text>
      <text class="v-text" x="464" y="118">Net profit</text><text class="v-mono" x="632" y="118" text-anchor="end">-$300.00</text>
      <text class="v-sub" x="464" y="140">From posted journals</text>
    </g>
    <g class="seq s8">
      <rect class="v-panel" x="450" y="162" width="196" height="114" rx="10" />
      <text class="v-text" x="464" y="186">Balance sheet</text>
      <text class="v-text" x="464" y="208">GST to claim</text><text class="v-mono" x="632" y="208" text-anchor="end">$30.00</text>
      <text class="v-text" x="464" y="228">Bank</text><text class="v-mono" x="632" y="228" text-anchor="end">-$330.00</text>
      <rect class="v-pill v-pill--done" x="464" y="244" width="168" height="18" rx="9" />
      <text class="v-pill-text" x="548" y="256.5" text-anchor="middle">Assets = liabilities + equity</text>
    </g>
  </svg>
  <figcaption class="viz__caption" id={`${id}-cap`}><span>A statement line becomes a categorised expense with GST, a balanced journal, and updated reports. Example content; the account codes are a new business workspace's.</span><span class="viz__tag">Illustration</span></figcaption>
</figure>
