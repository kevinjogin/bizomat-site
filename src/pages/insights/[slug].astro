---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import Tag from '../../components/Tag.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Button from '../../components/Button.astro';
import { INSIGHTS, SITE } from '../../config/site.ts';
import { categorySlug } from '../../config/taxonomy.ts';
import { categoriesWithPosts, getInsights, insightUrl, readingTime, relatedInsights, tagsWithPosts, insightAuthor, type Insight } from '../../utils/content.ts';

export async function getStaticPaths() {
  const posts = await getInsights();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // Posts are newest first, so the "next" (newer) article is the previous item.
    props: { post, newer: posts[i - 1], older: posts[i + 1], all: posts },
  }));
}

interface Props {
  post: Insight;
  newer?: Insight;
  older?: Insight;
  all: Insight[];
}
const { post, newer, older, all } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, publishDate, updatedDate, category, tags, author, image, imageAlt, canonicalURL, draft } = post.data;
const minutes = readingTime(post.body);
const displayAuthor = insightAuthor(author);
const showToc = headings.filter((h) => h.depth === 2).length >= INSIGHTS.minHeadingsForToc;
const related = relatedInsights(post, all);
const linkedTags = new Set(tagsWithPosts(all).map((t) => t.slug));
const categoryHasPage = categoriesWithPosts(all).some((c) => c.slug === categorySlug(category));
const ogImage = image ? (await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : undefined;
const url = `${SITE.url}${insightUrl(post)}`;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Insights', href: '/insights/' },
  { label: category, href: `/insights/category/${categorySlug(category)}/` },
  { label: title, href: insightUrl(post) },
];
const schema = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: title,
    description,
    datePublished: publishDate.toISOString(),
    dateModified: (updatedDate ?? publishDate).toISOString(),
    author: displayAuthor === SITE.name ? { '@id': `${SITE.url}/#organization` } : { '@type': 'Person', name: displayAuthor },
    publisher: { '@id': `${SITE.url}/#organization` },
    mainEntityOfPage: url,
    articleSection: category,
    keywords: tags.join(', '),
    wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length,
    inLanguage: SITE.locale,
    ...(ogImage ? { image: new URL(ogImage, SITE.url).href } : {}),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={ogImage}
  imageAlt={imageAlt}
  canonical={canonicalURL}
  publishedTime={publishDate}
  modifiedTime={updatedDate}
  breadcrumbs={crumbs}
  schema={schema}
  noindex={draft}
>
  <article class="article" data-pagefind-body>
    <header class="article__header">
      <Container size="narrow">
        <div data-pagefind-ignore>
          <Breadcrumb items={crumbs} />
        </div>
        <div class="article__category" data-pagefind-filter="category">
          <CategoryBadge name={category} link={categoryHasPage} />
          {draft && <span class="article__draft">Draft: not visible in production</span>}
        </div>
        <h1 class="article__title">{title}</h1>
        <p class="article__description">{description}</p>
        <dl class="article__meta" data-pagefind-ignore>
          <div><dt>Author</dt><dd>{displayAuthor}</dd></div>
          <div><dt>Reading time</dt><dd>{minutes} min</dd></div>
        </dl>
      </Container>
    </header>

    {
      image && (
        <Container size="wide" class="article__image">
          <figure>
            <Picture src={image} alt={imageAlt ?? ''} formats={['avif', 'webp']} widths={[640, 1024, 1600, 2200]} sizes="(min-width: 1440px) 1440px, 100vw" loading="eager" fetchpriority="high" />
          </figure>
        </Container>
      )
    }

    <Container class:list={['article__layout', { 'has-toc': showToc }]}>
      {showToc && <aside class="article__toc" data-pagefind-ignore><TableOfContents headings={headings} /></aside>}
      <div class="article__body">
        <div class="prose">
          <Content />
        </div>
        <footer class="article__footer" data-pagefind-ignore>
          <div class="article__tags" aria-label="Tags">
            {tags.map((t) => <Tag slug={t} link={linkedTags.has(t)} />)}
          </div>
        </footer>
      </div>
    </Container>
  </article>

  <section class="after" aria-label="More Insights" data-pagefind-ignore>
    <Container>
      {
        (newer || older) && (
          <nav class="prev-next" aria-label="Previous and next articles">
            {older ? (
              <a href={insightUrl(older)} rel="prev">
                <span>Previous</span>
                {older.data.title}
              </a>
            ) : <span />}
            {newer ? (
              <a href={insightUrl(newer)} rel="next" class="prev-next__next">
                <span>Next</span>
                {newer.data.title}
              </a>
            ) : <span />}
          </nav>
        )
      }
      {
        related.length > 0 && (
          <div class="related">
            <h2>Related Insights</h2>
            <div class="related__grid">
              {related.map((p) => (
                <ArticleCard post={p} />
              ))}
            </div>
          </div>
        )
      }
      <div class="explore">
        <p>Need practical engineering, manufacturing or process support? KEVOS® can help move the work forward.</p>
        <div class="explore__actions">
          <Button href="/contact/" arrow data-cta="article-quote">Get a Quote</Button>
          <Button href="/insights/" variant="secondary">More Insights</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .article__header { padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3rem); }
  .article__category { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin: clamp(2rem, 4vw, 3rem) 0 1.25rem; }
  .article__draft { font-size: 0.78rem; font-weight: 600; color: var(--paper); background: var(--danger); padding: 0.15rem 0.5rem; border-radius: 3px; }
  .article__title { font-size: clamp(2rem, 1.4rem + 2.8vw, 4.1rem); letter-spacing: -0.02em; line-height: 1.04; }
  .article__description { margin: 1.5rem 0 0; font-family: var(--font-serif); font-size: var(--step-2); line-height: 1.35; color: var(--ink-2); }
  .article__meta { display: flex; flex-wrap: wrap; gap: 0.75rem 2.25rem; margin: 2rem 0 0; padding-top: 1.25rem; border-top: 1px solid var(--line); font-size: 0.9rem; }
  .article__meta dt { color: var(--muted); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .article__meta dd { margin: 0.15rem 0 0; color: var(--ink); }
  :global(.article__image) { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  :global(.article__image figure) { margin: 0; }
  :global(.article__image img) { width: 100%; max-height: 72vh; object-fit: cover; border-radius: var(--radius); }
  :global(.article__layout) { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; padding-bottom: clamp(3rem, 6vw, 5rem); }
  :global(.article__layout.has-toc) { grid-template-columns: 220px minmax(0, 1fr); gap: 4rem; justify-items: start; }
  :global(.article__layout.has-toc) .article__body { justify-self: center; }
  .article__toc { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
  .article__body { width: min(100%, var(--measure)); }
  .article__footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .article__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 1080px) {
    :global(.article__layout.has-toc) { grid-template-columns: minmax(0, 1fr); justify-items: center; }
    .article__toc { position: static; width: min(100%, var(--measure)); margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
  }

  .after { padding-block: clamp(3rem, 6vw, 5rem) var(--space-section); border-top: 1px solid var(--line); }
  .prev-next { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .prev-next a { display: grid; gap: 0.4rem; padding: 1.25rem 0; border-top: 1px solid var(--line-strong); font-size: var(--step-1); font-weight: 520; letter-spacing: -0.015em; line-height: 1.3; text-decoration: none; }
  .prev-next a span { font-size: 0.78rem; font-weight: 560; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .prev-next__next { text-align: right; }
  .related h2 { font-size: var(--step-2); margin-bottom: 2rem; }
  .related__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .explore { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem 2rem; margin-top: clamp(3rem, 6vw, 4.5rem); padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .explore p { margin: 0; font-size: var(--step-1); max-width: 40ch; }
  .explore__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (max-width: 900px) { .related__grid { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .prev-next { grid-template-columns: 1fr; } .prev-next__next { text-align: left; } }
</style>
