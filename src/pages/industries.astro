---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MotionVisual from '../components/MotionVisual.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import CallToAction from '../components/CallToAction.astro';
import { INDUSTRIES, SERVICE_AREA } from '../data/services.ts';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Industries', href: '/industries/' },
];
const problems = [
  { title: 'Documentation gaps', text: 'Drawings that are out of date, missing or inconsistent, so the floor relies on memory and phone calls.' },
  { title: 'Unstable processes', text: 'Jobs that run differently depending on who does them, with rework, delays or quality escapes.' },
  { title: 'Production bottlenecks', text: 'One step, machine or approval that keeps holding everything else up.' },
  { title: 'Setup and handling waste', text: 'Time lost to setups, searching, double handling or awkward workholding on every run.' },
  { title: 'Projects without bandwidth', text: 'Improvements, RFQs or equipment projects that matter but never get the engineering time they need.' },
  { title: 'Knowledge held by one person', text: 'Critical know-how that needs to be captured in SOPs and work instructions before it walks out the door.' },
];
---

<BaseLayout
  title="Industries"
  description="KEVOS supports manufacturers, fabricators, industrial equipment and building-product makers, plastics and component producers, assembly operations and small to medium OEMs."
  breadcrumbs={crumbs}
>
  <Hero
    eyebrow="Industries"
    title="For businesses that <em>make</em> things."
    lead="KEVOS’s capability is problem-based rather than limited to one industry. If your business designs, makes, assembles or supplies physical products, the same practical engineering and improvement methods apply."
  >
    <MotionVisual page="industries" slot="visual" priority />
    <Breadcrumb items={crumbs} slot="before" />
    <Fragment slot="actions">
      <Button href="/contact/" arrow data-cta="industries-hero-quote">Get a Quote</Button>
      <Button href="/services/" variant="secondary">View Services</Button>
    </Fragment>
  </Hero>

  <Section index="01" label="Sectors" labelledby="sectors-title">
    <h2 id="sectors-title" class="block-title">Where KEVOS typically helps.</h2>
    <ul class="sectors">
      {
        INDUSTRIES.map((ind) => (
          <li>
            <h3>{ind.title}</h3>
            <p>{ind.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="note">{SERVICE_AREA}</p>
  </Section>

  <Section index="02" label="Common problems" tone="alt" labelledby="problems-title">
    <div class="split">
      <div class="split__intro">
        <h2 id="problems-title">The problems matter more than the sector.</h2>
        <p class="muted">These patterns appear across very different businesses. Each one has practical, well-tested ways to improve it.</p>
        <Button href="/factory-fix/" variant="text" arrow>Fix one problem with a Factory Fix</Button>
      </div>
      <dl class="problems">
        {
          problems.map((p) => (
            <div>
              <dt>{p.title}</dt>
              <dd>{p.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <CallToAction title="Don’t see your industry?" text="If your problem involves drawings, production, processes or an engineering project, it is probably a good fit. Describe it and KEVOS will tell you honestly." label="Get a Quote" />
</BaseLayout>

<style>
  .block-title { margin-bottom: clamp(2rem, 4vw, 3rem); max-width: 20ch; }
  .sectors { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .sectors li { padding: clamp(1.25rem, 2.5vw, 1.75rem); background: var(--surface); }
  .sectors h3 { font-size: 1.12rem; letter-spacing: -0.015em; }
  .sectors p { margin: 0.5rem 0 0; color: var(--ink-2); font-size: 0.97rem; line-height: 1.55; }
  @media (max-width: 900px) { .sectors { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .sectors { grid-template-columns: 1fr; } }
  .note { margin: 1.5rem 0 0; color: var(--muted); font-size: 0.95rem; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 2.5rem 5rem; }
  .split__intro h2 { margin-bottom: 1.1rem; max-width: 16ch; }
  .split__intro p { max-width: 40ch; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }
  .problems { margin: 0; border-top: 1px solid var(--line-strong); }
  .problems div { padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
  .problems dt { font-weight: 560; font-size: 1.08rem; }
  .problems dd { margin: 0.35rem 0 0; color: var(--ink-2); }
</style>
