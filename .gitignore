# build output
dist/
.astro/

# dependencies
node_modules/

# local secrets and Cloudflare state
.env
.env.*
!.env.example
.dev.vars
.wrangler/

# logs and OS files
*.log
.DS_Store
Thumbs.db

# local upload bundles
*.zip

# real assessment data and reports (customer information): never commit
assessment-private/

# AutoSEO working data (snapshots, reports, IndexNow manifest); kept in Actions cache and artifacts, never committed.
.seo-data/
.seo-build/

# BIZOMAT brand build output (regenerated by shared/brand/build.mjs; the copies in each app are committed)
shared/brand/dist/

# Node server bundle for the BIZOMAT web process (built by npm run build:server)
dist-server/

# Agent worktrees (local only)
.claude/worktrees/
