---
// /systems/crm/: BIZOMAT CRM, the Customer Management System (formerly BIZOMAT Customer Relationship Management).
// Introduces the system and opens it inside BIZOMAT ERP (Sales and CRM, sign-in required; the same accounts as Finance
// and Projects). The page cannot be /crm/: that path is the application (tests/worker.test.ts). Facts come from
// src/data/platform-catalog.ts (CRM), which records its sources in apps/work; tests/platform-catalog.test.ts compares
// them with the application's code. The links to Finance and Projects are apps/work/src/worker/company/links.ts
// (docs/company/README.md); the ERP is docs/system/README.md. The guide is /systems/crm/guide/.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Button from '../../../components/Button.astro';
import CrmPipeline from '../../../components/visuals/CrmPipeline.astro';
import StatusLabel from '../../../components/StatusLabel.astro';
import StatusLegend from '../../../components/StatusLegend.astro';
import '../../../styles/product.css';
import '../../../styles/visuals.css';
import { screenshots } from '../../../data/screenshots.ts';
import { SITE } from '../../../config/site.ts';
import { APP_LINKS } from '../../../config/platform.ts';
import { SYSTEMS, SYSTEMS_HOME, STATUS_LABEL, systemById, type FeatureStatus } from '../../../config/systems.ts';
import { CRM } from '../../../data/platform-catalog.ts';

const sys = systemById('crm');
const access = sys.access!;
const GUIDE = sys.guide!;
const finance = systemById('finance');
const projects = systemById('projects');
const erp = systemById('erp');
const related = SYSTEMS.filter((s) => s.id !== sys.id);
const list = (xs: readonly string[]) => xs.join(', ').replace(/, ([^,]+)$/, ' and $1');

const show = ['crm-overview', 'crm-board', 'crm-deal', 'crm-contact', 'crm-leads', 'crm-report'];
const shots = screenshots('crm').filter((s) => show.some((n) => s.src.endsWith(`/${n}.webp`)));
const erpShot = screenshots('erp').find((s) => s.src.endsWith('/erp-crm.webp'));
const description = 'BIZOMAT CRM is CRM software for small business: contacts, companies, leads, a sales pipeline board, follow-ups, reports and automations, linked to quotes and invoices in Finance.';

const audiences = [
  { t: 'Business owners', x: 'See every customer, every open deal and every follow-up in one place, and what is likely to close.' },
  { t: 'Sales people', x: 'Work your own leads and deals, plan calls and meetings, and keep a record of what was said. The Sales Executive role is made for this.' },
  { t: 'Sales managers', x: 'Set up pipelines, lists and automations, and read the forecast, win rate and each person\'s results, by person and by team.' },
  { t: 'Account and service staff', x: 'Keep notes, meeting notes and documents on each customer, so whoever picks up the next call knows the history.' },
  { t: 'Administrators', x: 'Invite people, choose each person\'s role, and adjust what each role may view, create, edit, delete, import and export.' },
  { t: 'Companies on BIZOMAT', x: `A company that also runs ${finance.name} and ${projects.name} turns deals into quotes, invoices and projects without typing them again.` },
];
const problems: { s: FeatureStatus; t: string; x: string }[] = [
  { s: 'live', t: 'Customer details are spread across inboxes, spreadsheets and phones', x: 'Contacts, companies, leads and deals sit on shared records. Each has one timeline of changes, activities, notes and documents, newest first.' },
  { s: 'live', t: 'Follow-ups slip', x: 'Every call, meeting and visit is an activity with an owner and a due date. Overdue follow-ups show on the Overview and in their own list, and an automation reminds people.' },
  { s: 'live', t: 'Nobody knows what will close', x: 'The pipeline board shows the deals and their value at each stage. The weighted forecast multiplies each deal\'s value by its probability.' },
  { s: 'live', t: 'The same customer is entered twice', x: 'While you type, the CRM warns you when an email address, phone number, name or website matches a record you already have.' },
  { s: 'live', t: 'Work is lost when someone leaves', x: 'When you remove a member, you can hand their records and open activities to a colleague. The timeline keeps the history.' },
  { s: 'connected', t: 'Quotes and invoices are typed again', x: `In a company that also runs ${finance.name}, the CRM company becomes the Finance customer once, and a deal starts a quote or, once won, a draft invoice.` },
];
const records = [
  { t: 'Capture leads', x: `Record each enquiry with its source and estimated value. Statuses run ${list(CRM.leadStatuses)}, and you can change them.` },
  { t: 'Score and qualify', x: 'Each lead gets a score from its details and its activity, and the lead shows how the score was reached. Set it by hand when you know better.' },
  { t: 'Convert in one step', x: 'Turn a qualified lead into a contact, a company and a deal at once, new or existing. Its activities move with it, and a lead converts only once.' },
  { t: 'One history per customer', x: 'Every record has a timeline of changes, activities, notes and documents, newest first. A company\'s timeline includes its contacts and deals.' },
  { t: 'Duplicates flagged', x: 'While you type, the CRM warns you when an email address, phone number, name or website matches a record you already have.' },
  { t: 'Your own fields and lists', x: `Add custom fields of ${CRM.customFieldTypes.length} types, tags, and your own lists of statuses, sources, industries and lost reasons.` },
];
const activities = [
  { t: `${CRM.activityTypes.length} activity types`, x: `${list(CRM.activityTypes)}. Rename them or add your own.` },
  { t: 'Your day in one list', x: 'My activities, Overdue, Upcoming, Team activities and Completed. Tick an activity to complete it, and record the outcome.' },
  { t: 'A calendar, and yours', x: 'A month calendar of activities, a calendar file for any activity, and a private address your own calendar app can subscribe to.' },
  { t: 'Notes, comments and documents', x: 'Notes, internal comments and meeting notes on any record, with @mentions that notify a colleague. Proposals, quotes and contracts are kept with their versions.' },
];
const data = [
  { t: 'Search everything', x: 'One search across contacts, companies, leads, deals, activities and notes.' },
  { t: 'Filters and saved views', x: 'Filter on any field, tag or custom field, choose and sort the columns, and save the view. Managers and administrators can share a view with the whole team.' },
  { t: 'Bulk changes', x: 'Select records to assign them, change their status or priority, tag, archive, delete or restore them at once.' },
  { t: 'Import and export', x: 'Bring contacts, companies and leads in from a CSV file, matching its columns and deciding what happens to duplicates. Export what you can see.' },
];
const works = [
  { t: 'Logging emails', x: 'Write to a contact from a template; the CRM opens your own mail program with it filled in and logs the email on the record.' },
  { t: 'Invitations and notifications', x: 'Sent by email when the platform\'s email service is set up. Otherwise the CRM gives you an invitation link to share, and notifications appear in the app.' },
  { t: 'Calendar', x: 'A calendar file (.ics) for any activity, and a private subscription address for your calendar app, which you can replace or stop at any time.' },
  { t: 'CSV', x: 'Import contacts, companies and leads; export lists and reports.' },
];
const planned = [
  { t: 'Gmail and Microsoft 365', x: 'Mailbox synchronisation, and sending from your own mailbox, are not built: the CRM does not read your mailbox or send from it. Settings, Integrations in the app says the same. Until then, emails to customers go from your own mail program and the CRM logs them as logged, never as sent.' },
  { t: 'Sales orders', x: 'Sales orders made from accepted quotes or won deals, as an ERP module.' },
  { t: 'Deliveries', x: 'Deliveries with picking and packing, and their history on the CRM timeline.' },
  { t: 'Pricing rules and rebates', x: 'Not built. Today a deal\'s products and services carry a price, a quantity and a discount.' },
  { t: 'Credit management', x: 'Not built. What a customer owes is shown from Finance on the CRM company (Connected).' },
  { t: 'Service contracts', x: 'Not built.' },
];
const security = [
  `One BIZOMAT account for ${sys.name}, ${finance.name} and ${projects.name}, with the same protected sign-in.`,
  'People outside an organisation cannot see it, or even tell that it exists.',
  'Every list, search and report is limited to your organisation, and the database itself refuses links between two organisations.',
  'The server checks every permission; the screens only hide what you cannot use.',
  'Documents are served only to people who can see the record they belong to.',
  'An audit trail records changes, imports and exports. Archived and deleted records can be restored.',
];
const figures = [
  { t: 'Open pipeline', x: 'The value of every open deal, and how many there are.' },
  { t: 'Weighted forecast', x: 'Each open deal\'s value times its probability (the deal\'s own, or its stage\'s), added up.' },
  { t: 'Won', x: 'The value of the deals won in the period, and how many.' },
  { t: 'Win rate', x: 'Deals won as a share of the deals won or lost in the period. Below it: how many were lost, and their value.' },
  { t: 'New leads', x: 'Leads created in the period, with the number of leads in total and how many are qualified.' },
  { t: 'Lead conversion', x: 'The share of the period\'s new leads that have been converted.' },
  { t: 'Contacts and companies', x: 'How many active contacts and companies the organisation has.' },
  { t: 'Overdue follow-ups', x: 'Open activities past their due date, marked as a warning when there are any.' },
];
const charts = [
  { t: 'Revenue by month', x: 'The value of the deals won each month, over the last twelve months.' },
  { t: 'Open deals by stage', x: 'How many open deals each stage of the pipeline holds, and their value.' },
  { t: 'Conversion funnel', x: 'For the period: new leads, qualified, converted, deals created and deals won.' },
  { t: 'Lead sources', x: 'Where the period\'s new leads came from.' },
  { t: 'Completed activities per week', x: 'The last twelve weeks of finished calls, meetings and other activities.' },
  { t: 'Team performance', x: 'For each person in the period: deals won, revenue, deals lost, win rate, open pipeline and activities done.' },
  { t: 'Upcoming meetings and calls', x: 'Meetings, calls, visits and demonstrations due in the next 14 days.' },
];
const screens = [
  { t: 'Overview', see: 'The figures and charts above, for the period you choose.', do: 'Pick dates, a person, a team or a pipeline. Click a figure to open the list or report behind it.' },
  { t: 'Leads', see: 'Open leads with their source, status, lead score and estimated value.', do: 'Add a lead, import a CSV file, move leads through their statuses, then Convert.' },
  { t: 'Contacts and Companies', see: 'Everyone you deal with and the businesses they work for, in lists you can filter, sort and save as views.', do: 'Add or import records, tag them, open one to see its timeline.' },
  { t: 'Deals', see: 'Board: each stage with its deals and their value. List: the same deals as a table.', do: 'Add a deal, drag it to the next stage, or onto Won or Lost.' },
  { t: 'A record', see: 'A deal\'s stage path, or a contact\'s details, with notes, activities, documents and the timeline.', do: 'Edit it, write a note, plan an activity, upload a document, or archive it.' },
  { t: 'Activities', see: 'My activities, Today\'s follow-ups, Overdue, Upcoming, Team activities and Completed.', do: 'Plan an activity, tick it to complete it, or log an email.' },
  { t: 'Calendar and Tasks', see: 'Activities by month, and the tasks and follow-ups for you and your colleagues.', do: 'Open an activity, or add one on a day.' },
  { t: 'Reports', see: `${CRM.reports.length} reports, each with its figures, a chart and a table.`, do: 'Filter by dates, person, team and pipeline, then Export CSV if your role allows it.' },
  { t: 'Automations', see: 'Each automation with its trigger and whether it is on, and its execution history.', do: 'Switch one on or off, edit it, or build your own.' },
  { t: 'Team', see: 'Members, Invitations and Teams.', do: 'Invite people, change roles, group people into teams, or hand over records.' },
  { t: 'Settings', see: 'Organisation, pipelines and stages, custom fields, statuses and lists, tags, products, email templates, permissions, notifications, calendar feed and audit trail.', do: 'Set the CRM up for the way your business sells.' },
];
const steps = [
  { t: 'Sign in to BIZOMAT ERP', x: `Go to ${APP_LINKS.erp.signIn.replace('https://', '')} and sign in with your BIZOMAT account, or create one on the sign-in page.` },
  { t: `Choose ${sys.module}`, x: `In the module rail at the left of the ERP (a bar along the bottom on a phone), choose ${sys.module}.` },
  { t: 'Create your organisation', x: `Give it a name and a currency. It starts with a ${CRM.stages.length}-stage sales pipeline and ${CRM.automations.length} automations, and no sample records. A company registered in BIZOMAT already has one.` },
  { t: 'Set it up', x: 'In Settings, adjust the pipeline stages, statuses, lists and custom fields to the way you sell.' },
  { t: 'Add your customers', x: 'Create contacts, companies and leads, or import them from a CSV file.' },
  { t: 'Invite your team', x: 'In Team, invite colleagues by email and choose each person\'s role.' },
  { t: 'Work your pipeline', x: 'Add deals, move them across the board, plan follow-ups, and watch the Overview.' },
];
const workflows: { s: FeatureStatus; t: string; steps: string[] }[] = [
  {
    s: 'connected', t: 'From first enquiry to an invoice',
    steps: [
      'Record the enquiry as a lead, with its source and estimated value.',
      'Plan a call as an activity, and move the lead to Contacted, then Engaged.',
      'When it is Qualified, choose Convert: a contact, a company and a deal at once.',
      `On the deal, Start a quote makes a draft quote in ${finance.name} for the deal's company.`,
      'Price the quote in detail in Finance and send it. The customer accepts it online, and the deal shows its status.',
      'Move the deal across the board. When it is won, drag it onto Won.',
      'Create the invoice from the accepted quote in Finance, or choose Make a draft invoice on the won deal.',
      'Check the amount, GST and account in Finance and approve it. What is owed shows on the CRM company.',
    ],
  },
  {
    s: 'live', t: 'A week of follow-ups',
    steps: [
      'Each morning, open Activities: My activities and Today\'s follow-ups.',
      'Tick each activity as you finish it, and record the outcome.',
      'Plan the next step straight away, against the same contact or deal.',
      'Check Overdue. The automation "Remind about overdue follow-ups" does the same for everyone.',
      'Subscribe your calendar app to your calendar feed, so the week shows there too.',
    ],
  },
  {
    s: 'connected', t: 'From a won deal to a project',
    steps: [
      `On the won deal, Start a project creates a project board named after it in the company's ${projects.name} workspace.`,
      'Turn the activities that belong to delivery into project tasks with Create a project task.',
      'Each task links back to the CRM, so the team can see the customer\'s history.',
      `To follow the project's costs, track it in ${finance.name} from the company's Projects page.`,
    ],
  },
  {
    s: 'live', t: 'Bringing in your existing customers',
    steps: [
      'Export your contacts, companies or leads from your spreadsheet or old system as a CSV file.',
      'On Contacts, Companies or Leads, choose Import and pick the file.',
      'Match each column to a field, and choose whether duplicates are skipped, updated or created.',
      'Select the new records to tag them or assign them to people in one step.',
      'Save the filters you use most as a view.',
    ],
  },
];
const integrations: { t: string; href: string | null; s: FeatureStatus | null; items: { s?: FeatureStatus; t: string; x: string }[] }[] = [
  {
    t: finance.name, href: finance.url, s: 'connected',
    items: [
      { t: 'One customer record', x: 'On a CRM company, In Finance shows the Finance customer it is billed as. Add as a customer in Finance creates it once, from the company\'s name, email, phone and address. Finance\'s From the CRM uses the same link, so a customer is never entered twice.' },
      { t: 'What the customer owes', x: 'The company\'s open invoices and the amount owed show on the CRM company, to people whose Finance role can see sales.' },
      { t: 'A deal starts a quote', x: 'Start a quote on a deal makes a draft quote in Finance for the deal\'s company, with the deal\'s value to price in detail there. The deal lists its quotes and their status, and its timeline records each step.' },
      { t: 'A won deal becomes a draft invoice', x: 'Make a draft invoice puts one line with the deal\'s title and value on a draft invoice, once per deal. Finance\'s own approval posts it, after someone checks the amount, GST and account.' },
      { t: 'What it needs', x: 'The CRM and Finance run by the same company, a company on the deal, the same currency in both, and a Finance role that may create quotes and invoices.' },
    ],
  },
  {
    t: projects.name, href: projects.url, s: 'connected',
    items: [
      { t: 'A deal starts a project', x: 'Start a project on a deal creates a project board named after it in the company\'s Projects workspace, once per deal. It needs a Projects role of member or above.' },
      { t: 'An activity becomes a task', x: 'Create a project task puts any CRM activity in a project you can add tasks to, with a link back to the CRM.' },
    ],
  },
  {
    t: 'Company accounts', href: null, s: 'live',
    items: [
      { t: 'One company, one of each tool', x: `A company registered in BIZOMAT runs one CRM organisation, one ${finance.short} business workspace and one ${projects.short} workspace.` },
      { t: 'A role in each tool', x: 'Each person has a company role and a role in each tool. No role in the CRM means no access to it.' },
      { t: 'Departments in every tool', x: 'Departments are made once for the company. In the CRM, each one is a team, led by the department\'s head.' },
    ],
  },
  {
    t: erp.name, href: erp.url, s: null,
    items: [
      { s: 'live', t: 'Opens inside the ERP', x: `${sys.name} opens as ${sys.module} in ${erp.name}, with the module rail beside it. The CRM's old address, bizomat.ai/crm, forwards there.` },
      { s: 'connected', t: 'Dashboard and Reports', x: 'The ERP Dashboard shows the CRM\'s open deals, deals won in 30 days, open leads and follow-ups due, to people who may see every deal. Its Reports page opens the CRM\'s reports.' },
      { s: 'live', t: 'Permissions stay in the CRM', x: 'The ERP gives no extra access: it lists only the tools you belong to, with the role you have in each.' },
    ],
  },
];
const questions = [
  { q: 'What is a CRM?', a: 'A Customer Relationship Management (CRM) system keeps track of the people and businesses you sell to, and everything said and agreed with them. BIZOMAT CRM keeps contacts, companies, leads, deals and follow-ups on records your team shares.' },
  { q: 'How do I create an organisation?', a: `Sign in to ${erp.name} and choose ${sys.module} in the module rail. The first time, the CRM asks you to create an organisation: enter its name and currency (industry, website and country if you like), then choose Create organisation. Later, use Create or join an organisation in the organisation menu. A company registered in BIZOMAT gets its CRM organisation when it registers.` },
  { q: 'Can I invite team members?', a: 'Yes. In Team, then Invitations, enter the person\'s email address, choose their role and choose Send invitation. Owners, administrators and managers can invite. The invitation is emailed when email is set up; otherwise copy the invitation link and send it yourself. It works once and expires after 14 days. In a registered company, its administrators can also invite people with a role in each tool at once.' },
  { q: 'How do I manage sales opportunities (deals)?', a: `Open Deals. The board shows each stage with its deals and their value. Add a deal with its value, company and expected close date, drag it from stage to stage, and drag it onto Won or Lost when it closes; a lost deal records why. A new organisation starts with ${CRM.stages.length} stages that you can rename, add to and give your own probabilities, and you can add more pipelines.` },
  { q: 'Can CRM customers be used in Finance?', a: `Yes, when the CRM organisation and the ${finance.short} business workspace belong to the same company. A CRM company becomes one Finance customer, made from its name, email, phone and address and linked so it is never entered twice. A deal can start a draft quote, and a won deal can become a draft invoice. The customer's open invoices and amount owed then show on the CRM company, to people whose Finance role can see sales.` },
  { q: 'Does the CRM send emails to my customers?', a: 'No. You send them from your own mail program and the CRM logs them. BIZOMAT only sends its own invitations and notifications.' },
  { q: 'Can I bring my data from another CRM?', a: 'Yes, for contacts, companies and leads: export them from the other system as a CSV file and use Import. Deals and activities are added in the CRM itself.' },
  { q: 'Who can see my organisation\'s customers?', a: 'Only its members, as their roles allow. People outside the organisation cannot see it or tell that it exists.' },
  { q: 'Do I need a separate account?', a: `No. One BIZOMAT account signs you in to ${erp.name}, and with it to ${sys.name}, ${finance.name} and ${projects.name}. Each keeps its own data and its own roles.` },
