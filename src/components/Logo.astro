---
interface Props {
  class?: string;
  height?: number;
  label?: string;
}
const { class: className, height = 30, label = 'KevOS' } = Astro.props;
const fontSize = Math.round(height * 0.82);
---
<span
  class:list={['logo', className]}
  style={`--logo-height:${height}px;--logo-size:${fontSize}px`}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <span aria-hidden="true"><span class="logo__kev">Kev</span><span class="logo__os">OS</span></span>
</span>

<style>
  .logo { display:inline-flex; align-items:center; height:var(--logo-height); max-width:100%; font-family:var(--font-sans); font-size:var(--logo-size); font-weight:760; letter-spacing:-0.055em; line-height:1; white-space:nowrap; }
  .logo__kev { color:var(--brand-blue, #1a5cf0); }
  .logo__os { color:var(--brand-orange, #ff6a13); margin-left:.03em; }
</style>
