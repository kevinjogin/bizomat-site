---
import { render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ReadOSChapterReader from '../../../../components/ReadOSChapterReader.astro';
import { getChapters, readingTime, type Chapter } from '../../../../utils/content.ts';
import { buildReadOSCollections, readosCollectionHref, readosCollectionChapterHref, type ReadOSCollection } from '../../../../utils/reados-collections.ts';

export async function getStaticPaths() {
  const books = buildReadOSCollections(await getChapters());
  return books.flatMap(book => book.chapters.map((chapter,index)=>({
    params:{book:book.slug,chapter:chapter.id},
    props:{book,chapter,index}
  })));
}
interface Props { book:ReadOSCollection;chapter:Chapter;index:number }
const {book,chapter,index}=Astro.props;
const {Content}=await render(chapter);
const href=readosCollectionChapterHref(book,chapter);
---
<BaseLayout title={`${chapter.data.title} (${book.title}) | READOS`} description={chapter.data.description}
  breadcrumbs={[{label:'Home',href:'/'},{label:'READOS',href:'/reados/'},{label:book.title,href:readosCollectionHref(book)},{label:chapter.data.title,href}]}>
  <ReadOSChapterReader bookTitle={book.title} bookHref={readosCollectionHref(book)} home={{label:'READOS',href:'/reados/'}}
    chapters={book.chapters.map(ch=>({href:readosCollectionChapterHref(book,ch),title:ch.data.title}))} index={index}
    title={chapter.data.title} description={chapter.data.description} minutes={readingTime(chapter.body)} searchable>
    <Content />
    <p class="origin" slot="after">Part of <a href={readosCollectionHref(book)}>{book.title}</a> in KEVOS® READOS.</p>
  </ReadOSChapterReader>
</BaseLayout>
<style>.origin{color:var(--muted);font-size:.83rem;margin:3rem 0 0}</style>
