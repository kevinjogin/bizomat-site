# build output
dist/
.astro/

# dependencies
node_modules/

# local secrets and Cloudflare state
.env
.env.*
!.env.example
.dev.vars
.wrangler/

# logs and OS files
*.log
.DS_Store
Thumbs.db

# local upload bundles
*.zip

# real assessment data and reports (customer information): never commit
assessment-private/

# AutoSEO working data (snapshots, reports, IndexNow manifest); kept in Actions cache and artifacts, never committed.
.seo-data/
.seo-build/

# BIZOMAT brand build output (regenerated by shared/brand/build.mjs; the copies in each app are committed)
shared/brand/dist/

# Node server bundle for the BIZOMAT web process (built by npm run build:server)
dist-server/

# Agent worktrees (local only)
.claude/worktrees/

# Data exports, migration archives, database copies and migration reports hold real customer data: never commit.
# (SQL migrations in apps/work/migrations/ are code and stay tracked; only stray .sql files at these roots are ignored.)
*.tar
*.tar.gz
*.tgz
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.dump
/*.sql
/apps/work/*.sql
/apps/cad/*.sql
.data/
migration-report.json
migration-report.md
