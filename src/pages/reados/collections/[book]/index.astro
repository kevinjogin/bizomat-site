---
import { CRUMB } from '../../../../config/site.ts';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Container from '../../../../components/Container.astro';
import ReadOSBookHero from '../../../../components/ReadOSBookHero.astro';
import ReadOSChapterList from '../../../../components/ReadOSChapterList.astro';
import { getChapters } from '../../../../utils/content.ts';
import { buildReadOSCollections, readosCollectionHref, readosCollectionChapterHref, type ReadOSCollection } from '../../../../utils/reados-collections.ts';
import ApplyInPractice from '../../../../components/knowledge/ApplyInPractice.astro';
import LearningPathway from '../../../../components/knowledge/LearningPathway.astro';
import { knowledgeGraph, pathwaysForBook, DISCOVERY_TOPIC } from '../../../../utils/knowledge.ts';

export async function getStaticPaths() {
  const books = buildReadOSCollections(await getChapters());
  return books.map((book) => ({params:{book:book.slug},props:{book}}));
}
interface Props { book: ReadOSCollection }
const { book } = Astro.props;
const href = readosCollectionHref(book);
// Connections are keyed by the collection's permanent topic slug (a long book's parts share it), limited to this part's chapters.
const inThisPart = new Set(book.chapters.map((c) => c.id));
const tools = knowledgeGraph().toolsFor(`collection/${book.topic}`).filter((x) => x.chapters.length === 0 || x.chapters.some((c) => [...inThisPart].some((id) => c.href.endsWith(`/${id}/`))));
const pathways = book.volume === 1 ? pathwaysForBook(`collection/${book.topic}`) : [];
---
<BaseLayout title={`${book.title} (READOS)`} description={`${book.description} Read the full KEVOS® collection in structured chapters.`}
  breadcrumbs={[{label:'Home',href:'/'},{label:CRUMB.library,href:'/reados/'},{label:book.title,href}]}>
  <ReadOSBookHero crumbs={[{label:CRUMB.library,href:'/reados/'},{label:book.category,href:`/reados/#${book.category.toLowerCase()}`}]}
    eyebrow={`READOS / ${book.category}`} title={book.title} description={book.description}
    meta={[`${book.chapters.length} chapters`,`About ${book.minutes} minutes`,'Free to read']}
    startHref={readosCollectionChapterHref(book,book.chapters[0])} cover={{title:book.title,category:book.category,slug:book.slug,chapters:book.chapters.length}} />
  <section class="contents"><Container>
    <ReadOSChapterList items={book.chapters.map((chapter,index)=>({href:readosCollectionChapterHref(book,chapter),number:index+1,title:chapter.data.title,description:chapter.data.description,body:chapter.body,id:chapter.id}))}>
      <p class="note">These topic-based reading collections are organised alphabetically; chapters may be read in any order.</p>
    </ReadOSChapterList>
    <ApplyInPractice items={tools} showChapters discover={DISCOVERY_TOPIC[book.category.toLowerCase()]} />
    {pathways.map((p) => <LearningPathway pathway={p} />)}
    <a class="back" href="/reados/">← All READOS books</a>
  </Container></section>
</BaseLayout>
<style>
.contents{padding:clamp(3rem,6vw,5rem) 0 var(--space-section)}
.note{color:var(--muted);font-size:.9rem;margin:2rem 0}
.back{font-size:.9rem;color:var(--accent)}
</style>
