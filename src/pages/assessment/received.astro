---
// Shown after an assessment enquiry is sent without JavaScript. It is a receipt for the enquiry only:
// not a booking, not a purchase.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Button from '../../components/Button.astro';
import { ASSESSMENT } from '../../config/assessment.ts';
---

<BaseLayout title="Assessment enquiry received" description="Your BIZOMAT Engineering Problem Assessment enquiry has been received. BIZOMAT will confirm whether the problem suits the fixed-price assessment." noindex>
  <Hero eyebrow="Assessment enquiry" title="Enquiry received." lead={ASSESSMENT.successMessage}>
    <p class="note">This is not a booking or a purchase. If the problem is suitable, BIZOMAT will send the confirmed scope and payment instructions.</p>
    <Fragment slot="actions">
      <Button href="/assessment/" arrow>Back to the assessment</Button>
      <Button href="/" variant="secondary">Back to home</Button>
    </Fragment>
  </Hero>
</BaseLayout>

<style>
  .note { margin: 1.5rem 0 0; max-width: 60ch; color: var(--muted); }
</style>
