---
// BIZOMAT homepage: "Connecting Intelligence. Empowering Progress." (the corporate slogan, owner 8 Nov 2026), redesigned
// around BIZOMAT ERP and learning it (owner's brief of 20 Nov 2026).
// 1. Hero: what BIZOMAT is; Open BIZOMAT ERP, Explore modules, Learn BIZOMAT, Tools and Resources.
// 2. Learn: the Knowledge Centre's search (/learn/?q=) and where to start, by who you are (src/config/home.ts).
// 3. Modules: the ERP's module rail, group by group, each module linked to its guide with its status (src/data/learn/).
// 4. Systems: the catalogue (src/config/products.ts, facts from src/data/platform-catalog.ts).
// 5. AI Search: the discovery pipeline (/api/discover, /discovery-index.json) over public products, docs, tools and books.
// 6. Proof: counts read from the code and the catalogues at build time, and a link to the Engine Room (/engine-room/).
// 7. Tools and 8. Library (the free Resources, kept apart from the ERP), then a short close. Every count is computed
//    here; none is typed in.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import LibraryIcon from '../components/library/LibraryIcon.astro';
import DiscoveryBox from '../components/discovery/DiscoveryBox.astro';
import DiscoveryExamples from '../components/discovery/DiscoveryExamples.astro';
import DiscoveryResults from '../components/discovery/DiscoveryResults.astro';
import ConnectedOps from '../components/visuals/ConnectedOps.astro';
import SearchScan from '../components/visuals/SearchScan.astro';
import StatusLabel from '../components/StatusLabel.astro';
import LearnSearch from '../components/learn/LearnSearch.astro';
import '../styles/discovery.css';
import '../styles/learning.css';
import '../styles/library.css';
import '../styles/learn.css';
import { SITE } from '../config/site.ts';
import { PRODUCTS } from '../config/products.ts';
import { APP_LINKS } from '../config/platform.ts';
import { CAD, CRM, FINANCE, WORK } from '../data/platform-catalog.ts';
import { HOME_DISCOVERY_EXAMPLES, HOME_ERP_GROUPS, HOME_FEATURED_BOOKS, HOME_FEATURED_TOOLS, HOME_LEARN_STARTS } from '../config/home.ts';
import { GUIDES, LEARN_HOME, LEARN_TITLE, WORKFLOWS, guideById, guideUrl } from '../data/learn/index.ts';
import { loadWorkosTools, hasStandaloneGuide, toolPageHref, toolAppHref } from '../utils/workos-tools.ts';
import { groupToolsByTopic, subcategoryLabel } from '../utils/workos-topics.ts';
import { buildReadosLibrary } from '../utils/reados-library.ts';
import { knowledgeGraph } from '../utils/knowledge.ts';

const { tools, guides } = loadWorkosTools();
const topics = groupToolsByTopic(tools, 0);
const subjects = await buildReadosLibrary();
const entries = subjects.flatMap((s) => s.entries.map((e) => ({ ...e, subject: s })));
const bookTotal = entries.length;
const chapterTotal = entries.reduce((n, e) => n + e.chapters.length, 0);
const connections = knowledgeGraph().live.length;
const fmt = (n: number) => n.toLocaleString('en-AU');

const pick = <T,>(ids: string[], find: (id: string) => T | undefined, kind: string) => ids.map((id) => {
  const item = find(id);
  if (!item) throw new Error(`src/config/home.ts: no ${kind} "${id}"`);
  return item;
});
const featuredTools = pick(HOME_FEATURED_TOOLS, (id) => tools.find((t) => t.id === id), 'BIZOMAT tool').slice(0, 4);
const featuredBooks = pick(HOME_FEATURED_BOOKS, (id) => entries.find((e) => e.id === id), 'Library book').slice(0, 4);
// Cards link to a tool's own page where one exists, as on /tools/.
const toolHref = (id: string) => (hasStandaloneGuide(guides[id]) ? toolPageHref(id) : toolAppHref(id));

// The Knowledge Centre's size, counted from its content (src/data/learn/).
const learnCounts = {
  guides: GUIDES.length,
  tutorials: GUIDES.reduce((n, g) => n + g.tutorials.length, 0) + WORKFLOWS.length,
  questions: GUIDES.reduce((n, g) => n + g.faqs.length, 0) + WORKFLOWS.reduce((n, w) => n + w.faqs.length, 0),
};
// The module rail's groups, each module with its guide (the build stops on an unknown id).
const erpGroups = HOME_ERP_GROUPS.map((grp) => ({ ...grp, modules: grp.guides.map((id) => guideById(id)) }));

// What each product card lists: three capabilities from the catalogue (facts from each application's code).
const highlights: Record<string, string[]> = {
  erp: ['Sales, finance, projects and engineering in one workspace', 'Your companies, people and departments', 'One sign-in, each tool\'s own permissions'],
  cad: CAD.capabilities.slice(0, 3).map((c) => c.title),
  work: [`${WORK.views.length} views of one project`, 'Teams, roles and permissions', 'Automations and dashboards'],
  crm: ['Contacts, leads and deals', 'A pipeline board with Won and Lost', `${CRM.reports.length} sales reports and automations`],
  finance: ['Personal, household and business workspaces', 'Invoices, bills and bank statement import', `${FINANCE.reports.length} reports from a double-entry ledger`],
  resources: [`${fmt(tools.length)} tools and calculators`, `${fmt(bookTotal)} books, ${fmt(chapterTotal)} chapters`, 'No account needed'],
};
const proof = [
  { n: String(CAD.toolCount), t: 'CAD tools an AI assistant can call', href: '/systems/#engineering-tools' },
  { n: String(WORK.views.length), t: 'views of the same project data', href: '/systems/#projects-views' },
  { n: fmt(tools.length), t: 'tools that show their method', href: '/tools/' },
  { n: fmt(chapterTotal), t: 'Library chapters to read free', href: '/reados/' },
];

const description = SITE.description;
const schema = [{
  '@type': 'WebPage', '@id': `${SITE.url}/#webpage`, url: `${SITE.url}/`, name: SITE.title, description, inLanguage: SITE.locale,
  isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': `${SITE.url}/#organization` },
  hasPart: [
    { '@type': 'SoftwareApplication', name: 'BIZOMAT Engineering Automation', alternateName: 'BIZOMAT CAD Automation', url: `${SITE.url}/systems/#engineering`, description: CAD.headline, applicationCategory: 'DesignApplication', operatingSystem: 'Windows', publisher: { '@id': `${SITE.url}/#organization` } },
    { '@type': 'SoftwareApplication', name: 'BIZOMAT Projects', alternateName: 'BIZOMAT Project Management', url: `${SITE.url}/systems/#projects`, description: WORK.headline, applicationCategory: 'BusinessApplication', operatingSystem: 'Web browser', publisher: { '@id': `${SITE.url}/#organization` } },
    { '@type': 'SoftwareApplication', name: 'BIZOMAT Customer Relationship Management', alternateName: 'BIZOMAT CRM', url: `${SITE.url}/systems/#crm`, description: CRM.headline, applicationCategory: 'BusinessApplication', operatingSystem: 'Web browser', publisher: { '@id': `${SITE.url}/#organization` } },
    { '@type': 'SoftwareApplication', name: 'BIZOMAT Finance', url: `${SITE.url}/systems/#finance`, description: FINANCE.headline, applicationCategory: 'FinanceApplication', operatingSystem: 'Web browser', publisher: { '@id': `${SITE.url}/#organization` } },
    { '@type': 'CollectionPage', name: LEARN_TITLE, url: `${SITE.url}${LEARN_HOME}`, description: 'Guides, step-by-step tutorials and answered questions for every module of BIZOMAT ERP.' },
    { '@type': 'CollectionPage', name: 'BIZOMAT Tools', url: `${SITE.url}/tools/`, description: 'Engineering, manufacturing and business tools.' },
    { '@type': 'CollectionPage', name: 'BIZOMAT Library', url: `${SITE.url}/reados/`, description: 'Technical books, engineering references and structured learning resources.' },
  ],
}];
---
<BaseLayout description={description} imageAlt={`${SITE.name}: ${SITE.statement}`} schema={schema}>
  <section class="home-hero" aria-labelledby="home-title">
    <Container class="home-hero__inner">
      <div class="home-hero__copy">
        <p class="bz-eyebrow">{SITE.tagline}</p>
        <h1 id="home-title"><span class="home-hero__line">Connecting Intelligence.</span> <span class="home-hero__line">Empowering Progress.</span></h1>
        <p class="home-hero__lead">{SITE.introduction}</p>
        <div class="home-hero__actions">
          <Button href={APP_LINKS.erp.home} variant="accent" rel="noopener" data-cta="home-open-erp">Open BIZOMAT ERP</Button>
          <Button href="#modules" variant="secondary" data-cta="home-explore-modules">Explore modules</Button>
          <Button href={LEARN_HOME} variant="secondary" data-cta="home-learn">Learn BIZOMAT</Button>
          <Button href="#tools" variant="text" arrow data-cta="home-tools-resources">Tools and Resources</Button>
        </div>
        <ul class="home-hero__facts" role="list">
          <li><span class="dot"></span>Sales, finance, projects, engineering and operations in one ERP</li>
          <li><span class="dot"></span>One account and one sign-in</li>
          <li><span class="dot"></span>A guide and tutorials for every module</li>
          <li><span class="dot"></span>Free tools and Library, no account needed</li>
        </ul>
      </div>
      <div class="home-hero__visual"><ConnectedOps id="hero-ops" /></div>
    </Container>
  </section>

  <section class="home-learn" id="learn" aria-labelledby="learn-title">
    <Container>
      <div class="home-learn__inner">
        <div class="home-learn__ask">
          <p class="bz-eyebrow">Learn BIZOMAT</p>
          <h2 id="learn-title">Need help using BIZOMAT?</h2>
          <p class="home-learn__lead">Find a tutorial, search a question, or learn any module. The {LEARN_TITLE} has {learnCounts.guides} guides, {learnCounts.tutorials} step-by-step tutorials and {learnCounts.questions} answered questions.</p>
          <LearnSearch />
          <p class="home-learn__links">
            <a href={LEARN_HOME} data-cta="home-learn-centre">Open the Knowledge Centre</a>
            <a href={`${LEARN_HOME}#getting-started`}>Getting started</a>
            <a href="/learn/#workflows">Workflows</a>
            <a href={`${LEARN_HOME}#troubleshooting`}>Troubleshooting</a>
          </p>
        </div>
        <div class="home-learn__starts">
          <h3 class="home-label" id="learn-starts">Start where you are</h3>
          <ul class="start-list" role="list" aria-labelledby="learn-starts">
            {HOME_LEARN_STARTS.map((x) => <li><a href={x.href}><strong>{x.who}</strong><span>{x.what}</span></a></li>)}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <section class="home-section home-section--alt" id="modules" aria-labelledby="modules-title">
    <Container>
      <div class="home-head">
        <p class="bz-eyebrow">BIZOMAT ERP</p>
        <h2 id="modules-title">Every part of your business, in one ERP</h2>
        <p>These are the modules of BIZOMAT ERP, as its module rail shows them. Each one has a guide with step-by-step tutorials and answered questions.</p>
      </div>
      <ul class="erp-grid" role="list">
        {erpGroups.map((grp) => (
          <li class="erp-tile">
            <h3 class="erp-tile__name">{grp.rail}</h3>
            <p class="erp-tile__line">{grp.line}</p>
            <ul class="erp-tile__modules" role="list">
              {grp.modules.map((g) => (
                <li><a href={guideUrl(g.id)}>{grp.modules.length === 1 ? `Learn ${g.short ?? g.title}` : (g.short ?? g.title)}</a>{g.status !== 'live' && g.status !== 'connected' ? <StatusLabel status={g.status} /> : null}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <div class="home-modules__actions">
        <Button href={APP_LINKS.erp.home} variant="accent" rel="noopener" data-cta="home-modules-erp">Open BIZOMAT ERP</Button>
        <Button href={`${LEARN_HOME}#modules`} variant="secondary" arrow data-cta="home-modules-learn">Learn every module</Button>
        <Button href="/systems/#erp" variant="secondary" data-cta="home-modules-system">About BIZOMAT ERP</Button>
      </div>
    </Container>
  </section>

  <section class="home-section" id="products" aria-labelledby="products-title">
    <Container>
      <div class="home-head">
        <p class="bz-eyebrow">Systems</p>
        <h2 id="products-title">One connected platform to manage your business</h2>
        <p>BIZOMAT ERP brings sales, finance, projects and engineering into one workspace, by company. Every system is on <a href="/systems/">one page</a>, and the <a href="/learn/">Knowledge Centre</a> shows how to use each module, step by step. Resources stay free for everyone, with no sign-in.</p>
      </div>
      <ul class="product-grid" role="list">
        {PRODUCTS.map((p) => (
          <li class="product-card" id={`product-${p.id}`}>
            <p class="product-card__meta"><span class:list={['bz-badge', p.signIn ? '' : 'bz-badge--live']}>{p.signIn ? 'Sign-in' : 'Free, no sign-in'}</span></p>
            <div class="product-card__title">
              <h3 class="product-card__name">{p.name}</h3>
              {p.formerly && <p class="product-card__formerly">Formerly {p.formerly}</p>}
            </div>
            <p class="product-card__tagline">{p.tagline}</p>
            <ul class="product-card__list" role="list">{highlights[p.id].map((h) => <li>{h}</li>)}</ul>
            <div class="product-card__action"><Button href={p.url!} variant={p.id === 'resources' ? 'secondary' : 'primary'} arrow data-cta={`home-product-${p.id}`}>{p.action}</Button></div>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <section class="home-section home-section--alt home-ai" id="ai-search" aria-labelledby="ai-title">
    <Container class="home-ai__inner">
      <div class="home-ai__ask">
        <p class="bz-eyebrow">AI Search</p>
        <h2 id="ai-title">Ask BIZOMAT</h2>
        <p class="home-ai__lead">Search tools, calculators, books, guides, product capabilities and documentation in plain language. Every answer links to a real page and says why it matched.</p>
        <DiscoveryBox size="large" autorun rows={2}
          placeholder="What would you like to find or get done?"
          label="What would you like to find or get done?"
          submitLabel="Search"
          support=""
          hint="BIZOMAT AI Search finds BIZOMAT products, documentation, tools and Library chapters that fit your question. It searches public pages only, never anyone's projects or files. Please leave out personal or confidential details." />
        <DiscoveryExamples suggestions={HOME_DISCOVERY_EXAMPLES} heading="Try" />
      </div>
      <div class="home-ai__visual"><SearchScan id="home-search" /></div>
    </Container>
    <DiscoveryResults />
  </section>

  <section class="home-section home-proof" aria-labelledby="proof-title">
    <Container>
      <div class="home-head">
        <p class="bz-eyebrow">From the Engine Room</p>
        <h2 id="proof-title">Working software, not slideware</h2>
        <p>Every number here is read from the products themselves when this site is built.</p>
      </div>
      <dl class="proof-stats">
        {proof.map((x) => <div class="bz-stat proof-stat"><dt><a href={x.href}>{x.t}</a></dt><dd>{x.n}</dd></div>)}
      </dl>
      <p class="home-more"><a href="/engine-room/">Inside the Engine Room: how it is built and how it works <span aria-hidden="true">→</span></a></p>
    </Container>
  </section>

  <section class="home-section" id="tools" aria-labelledby="tools-title">
    <Container class="home-split">
      <div class="home-split__copy">
        <p class="bz-eyebrow">Resources · Tools</p>
        <h2 id="tools-title">Useful tools. Less complexity.</h2>
        <p>{fmt(tools.length)} engineering, manufacturing and business tools that show their method and run in your browser. No account needed.</p>
        <form class="home-search" role="search" action="/tools/" method="get">
          <label class="visually-hidden" for="home-tool-search">Search BIZOMAT tools</label>
          <input id="home-tool-search" name="q" type="search" placeholder="Search tools, e.g. bolt torque" autocomplete="off" />
          <button type="submit">Search</button>
        </form>
        <div class="home-split__actions"><Button href="/tools/" arrow data-cta="home-tools">Explore Tools</Button></div>
      </div>
      <div class="home-split__list">
        <h3 class="home-label" id="tools-topics">Browse by topic</h3>
        <ul class="topic-list" role="list" aria-labelledby="tools-topics">
          {topics.map((t) => (
            <li><a href={`/tools/?topic=${t.slug}`}><span class="topic-list__icon"><LibraryIcon name={t.icon} /></span><span class="topic-list__name">{t.name}</span><span class="topic-list__count" aria-label={`${fmt(t.items.length)} tools`}>{fmt(t.items.length)}</span></a></li>
          ))}
        </ul>
        <h3 class="home-label" id="tools-featured">Popular starting points</h3>
        <ul class="featured-list" role="list" aria-labelledby="tools-featured">
          {featuredTools.map((t) => <li><a href={toolHref(t.id)}>{t.name}</a><span>{subcategoryLabel(t.category)}</span></li>)}
        </ul>
      </div>
    </Container>
  </section>

  <section class="home-section home-section--alt" id="resources" aria-labelledby="resources-title">
    <Container class="home-split">
      <div class="home-split__copy">
        <p class="bz-eyebrow">Resources · Library</p>
        <h2 id="resources-title">Knowledge that moves you forward.</h2>
        <p>The BIZOMAT Library: {fmt(bookTotal)} technical books in {fmt(chapterTotal)} short chapters, with figures and worked numbers. {fmt(connections)} reviewed links connect chapters to the tools that apply them.</p>
        <div class="home-split__actions">
          <Button href="/reados/" arrow data-cta="home-library">Explore Library</Button>
          <Button href="/library/" variant="secondary" data-cta="home-guides">Guides and articles</Button>
        </div>
      </div>
      <div class="home-split__list">
        <h3 class="home-label" id="library-subjects">Subjects</h3>
        <ul class="subject-list" role="list" aria-labelledby="library-subjects">
          {subjects.map((sub) => <li><a href={`/reados/?topic=${sub.slug}`}>{sub.name}</a></li>)}
        </ul>
        <h3 class="home-label" id="library-featured">Featured books</h3>
        <ul class="featured-list" role="list" aria-labelledby="library-featured">
          {featuredBooks.map((e) => <li><a href={e.href}>{e.title}</a><span>{e.subject.name} · {fmt(e.chapters.length)} chapters</span></li>)}
        </ul>
      </div>
    </Container>
  </section>

  <section class="home-close" aria-labelledby="close-title">
    <Container class="home-close__inner">
      <h2 id="close-title">{SITE.support}</h2>
      <p>Open BIZOMAT ERP, learn how it works, search the free resources, or tell us what you need.</p>
      <div class="home-close__actions">
        <Button href={APP_LINKS.erp.home} variant="accent" rel="noopener" data-cta="home-close-erp">Open BIZOMAT ERP</Button>
        <Button href={LEARN_HOME} variant="secondary" data-cta="home-close-learn">Learn BIZOMAT</Button>
        <Button href="/systems/" variant="secondary" data-cta="home-close-systems">Explore the systems</Button>
        <Button href="/contact/" variant="secondary" data-cta="home-close-contact">Contact BIZOMAT</Button>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  // AI Search: quick answers (Your Solution Path) over BIZOMAT products, documentation, tools and the Library.
  import '../scripts/discovery.ts';
</script>

<script>
  // Old links to sections that moved (for example /#pricing, /#case-<id> or the former #ask box) are sent on.
  const moved: Record<string, string> = {
    services: '/services/', 'engineering-cad': '/services/#engineering-cad', manufacturing: '/services/#manufacturing',
    operations: '/services/#operations', 'project-support': '/services/#project-support', pricing: '/services/#packages',
    assessment: '/assessment/', 'factory-fix': '/factory-fix/', 'how-it-works': '/how-it-works/', industries: '/industries/',
    work: '/engine-room/#engineering-record', resources: '/resources/', overview: '#ai-search', ask: '#ai-search',
    workos: '/tools/', reados: '/reados/', connected: '/resources/#pathways', about: '/engine-room/', solutions: '/solutions/',
  };
  const forward = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const to = id.startsWith('case-') ? `/engine-room/#${id}` : moved[id];
    if (to) location.replace(to);
  };
  forward();
  window.addEventListener('hashchange', forward);
</script>

<style>
  .home-section, .home-ai { scroll-margin-top: calc(var(--header-h) + 1rem); }
  /* Hero: the message on the left, the connected-operations scene on the right. */
  .home-hero { padding: clamp(3rem, 7vw, 6rem) 0 clamp(2.5rem, 5vw, 4.5rem); background: radial-gradient(80% 60% at 85% 20%, var(--accent-soft), transparent 70%); }
  :global(.home-hero__inner) { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  /* The statement is three sentences on three lines at every width. The size follows the copy column (11 % of
     it: the longest line, "Get business done.", is 8.65 em in Oxanium and 8.78 em in its fallback face), so the
     lines never wrap differently before and after the web font arrives. */
  .home-hero__copy { container-type: inline-size; }
  .home-hero h1 { font-size: var(--step-5); font-size: min(var(--step-5), 11cqi); line-height: 1.04; }
  /* The slogan's two lines ("Connecting Intelligence." is the longer) each stay on one line beside the scene. */
  @media (min-width: 1001px) { .home-hero h1 { font-size: min(var(--step-5), 7.9cqi); } }
  .home-hero__line { display: block; }
  .home-hero__lead { margin: 1.2rem 0 0; max-width: 46ch; font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); }
  .home-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin-top: 1.9rem; }
  .home-hero__facts { display: grid; gap: .45rem; margin: 1.6rem 0 0; padding: 0; list-style: none; color: var(--muted); font-size: .92rem; }
  .home-hero__facts li { display: inline-flex; align-items: center; gap: .5rem; }
  .home-hero__facts .dot { width: 7px; height: 7px; border-radius: 2px; background: var(--brand-mark); }

  /* Sections share one rhythm: an eyebrow, a heading and one sentence, then the content. */
  .home-section { padding-block: var(--space-section); border-top: 1px solid var(--line); }
  .home-section--alt { background: var(--paper-2); }
  .home-head { max-width: 44rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .home-head > p:last-child { margin: .9rem 0 0; font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); }
  .home-more { margin: 2rem 0 0; }
  .home-more a { color: var(--accent); font-weight: 600; text-decoration: none; }
  .home-more a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* The system cards: as many columns of at least 19rem as fit (three on a laptop or wider, two on a tablet, one on a
     phone), so a long name or button label always has room, and six cards fill whole rows. Each card spans five rows of
     the grid and shares them with its neighbours (subgrid), so the chip, the name (with its former name under it), the
     tagline, the list and the button start at the same height in every card of a row, whatever wraps (design audit,
     15 Nov 2026). */
  .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .product-card { display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0; min-width: 0; padding: clamp(1.4rem, 2.5vw, 2rem); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-1); }
  .product-card > * { min-width: 0; }
  .product-card__meta { grid-row: 1; display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .75rem; margin: 0 0 1.1rem; }
  .product-card__title { grid-row: 2; }
  .product-card__name { font-size: var(--step-2); }
  .product-card__formerly { margin: .35rem 0 0; color: var(--muted); font-size: .84rem; line-height: 1.4; }
  .product-card__tagline { grid-row: 3; margin: .7rem 0 0; font-size: 1.02rem; font-weight: 560; color: var(--ink-2); }
  .product-card__list { grid-row: 4; align-self: start; display: grid; gap: .45rem; margin: 1.1rem 0 0; padding: 0; list-style: none; }
  .product-card__list li { position: relative; padding-left: 1.1rem; color: var(--ink-2); font-size: .94rem; }
  .product-card__list li::before { content: ''; position: absolute; left: 0; top: .62em; width: 7px; height: 2px; background: var(--brand-mark); }
  .product-card__action { grid-row: 5; align-self: end; padding-top: 1.75rem; }

