---
import { CRUMB } from '../../config/site.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadOSAnimatedCover from '../../components/ReadOSAnimatedCover.astro';
import LearningPlanner from '../../components/discovery/LearningPlanner.astro';
import DiscoveryResults from '../../components/discovery/DiscoveryResults.astro';
import { PLANNER_EXAMPLES } from '../../config/home.ts';
import '../../styles/discovery.css';
import '../../styles/learning.css';
import LibraryHero from '../../components/library/LibraryHero.astro';
import LibraryBrowser from '../../components/library/LibraryBrowser.astro';
import LibrarySection from '../../components/library/LibrarySection.astro';
import BookCard from '../../components/library/BookCard.astro';
import '../../styles/library.css';
import { buildReadosLibrary } from '../../utils/reados-library.ts';

// One list of Library books per subject, in the existing order: authored books, featured guides, then collections.
const subjects = await buildReadosLibrary();

const PREVIEW = 6;
const total = subjects.reduce((n, s) => n + s.entries.length, 0);
// Chapter titles and links for search, keyed by card id (read by src/scripts/library-browser.ts).
const chapterIndex = JSON.stringify(Object.fromEntries(subjects.flatMap((s) => s.entries.map((e) => [e.id, e.chapters])))).replace(/</g, '\\u003c');
---
<BaseLayout exactTitle="Engineering, Manufacturing & Business Knowledge Library | KEVOS" breadcrumbs={[{ label: 'Home', href: '/' }, { label: CRUMB.library, href: '/reados/' }]} description="Browse KEVOS® Library books by Engineering, Manufacturing, Operations, Projects, Technology, Business, Products and Ideas.">
  <LibraryHero
    title="Library"
    description="Practical books and guides covering engineering, manufacturing, operations, projects and business."
    action="/reados/"
    placeholder="Search Library books..."
    label="Search Library books"
    total={total}
    noun="book"
  >
    <LearningPlanner slot="planner" title="Plan what to read" lead="Tell KEVOS® what you want to learn. It puts the right chapters in a sensible order, with the tools to practise on." placeholder="e.g. I want to learn mechanical design, from the basics to bearings, shafts and fasteners." examples={PLANNER_EXAMPLES.library} />
  </LibraryHero>
  <DiscoveryResults />
  <LibraryBrowser name="READOS" label={CRUMB.library} searchAll="Search the whole Library" base="/reados/" noun="book" preview={PREVIEW} topics={subjects.map((s) => ({ slug: s.slug, name: s.name, description: s.description, icon: s.icon, count: s.entries.length }))}>
    {subjects.map((s) => (
      <LibrarySection slug={s.slug} name={s.name} description={s.description} count={s.entries.length} noun="book" base="/reados/" preview={PREVIEW}>
        {s.entries.map((e, n) => (
          <BookCard id={e.id} href={e.href} startHref={e.startHref} title={e.title} summary={e.summary} subject={s.name} chapters={e.chapters.length} topic={s.slug} tags={e.tags} chapterTitles={e.chapters.map(([t]) => t).join(' | ')} hidden={n >= PREVIEW}>
            <ReadOSAnimatedCover slot="cover" {...e.cover} chapters={e.chapters.length} compact />
          </BookCard>
        ))}
      </LibrarySection>
    ))}
    <details class="lib-about" slot="after">
      <summary>About Library</summary>
      <div class="lib-about__body">
        <p>The KEVOS® Library brings together structured, practitioner-written guidance on engineering, manufacturing, operations, projects, technology and business, published to help organisations make sound technical and commercial decisions.</p>
        <p>Every title is written to be applied. Read the method in the Library, run the numbers with the matching <a href="/tools/">tools</a>, and when your organisation needs the work delivered, <a href="/contact/">discuss your requirements with KEVOS®</a>.</p>
        <p>Search covers titles, summaries, subjects and chapter headings. It does not search the full text of each chapter.</p>
      </div>
    </details>
  </LibraryBrowser>
  <script type="application/json" id="lib-chapters" set:html={chapterIndex}></script>
</BaseLayout>

<script>
  // The learning-path box in the header (LearningPlanner.astro): same pipeline as the homepage question box.
  import '../../scripts/discovery.ts';
</script>
