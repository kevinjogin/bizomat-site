---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Hero from '../../../../components/Hero.astro';
import Container from '../../../../components/Container.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import InsightsListing from '../../../../components/InsightsListing.astro';
import { INSIGHTS } from '../../../../config/site.ts';
import { tagLabel } from '../../../../config/taxonomy.ts';
import { getInsights, paginate, tagUrl, tagsWithPosts, type Insight } from '../../../../utils/content.ts';

// Tag pages appear only once a tag is shared by enough articles (INSIGHTS.minPostsForTagPage).
export async function getStaticPaths() {
  const all = await getInsights();
  return tagsWithPosts(all).flatMap((t) => {
    const pages = Math.max(1, Math.ceil(t.posts.length / INSIGHTS.pageSize));
    return Array.from({ length: pages }, (_, i) => ({
      params: { tag: t.slug, page: i === 0 ? undefined : `page/${i + 1}` },
      props: { slug: t.slug, posts: t.posts, all, page: i + 1 },
    }));
  });
}

interface Props {
  slug: string;
  posts: Insight[];
  all: Insight[];
  page: number;
}
const { slug, posts, all, page } = Astro.props;
const label = tagLabel(slug);
const { items, pages } = paginate(posts, page);
const base = tagUrl(slug);
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Insights', href: '/insights/' },
  { label, href: base },
];
---

<BaseLayout
  title={page > 1 ? `Insights tagged ${label}, page ${page}` : `Insights tagged ${label}`}
  description={`KEVOS Insights tagged ${label.toLowerCase()}: ${posts.length} article${posts.length === 1 ? '' : 's'} on ${label.toLowerCase()} across engineering, manufacturing, operations and business.`}
  breadcrumbs={crumbs}
>
  <Hero eyebrow="Insights topic" title={label} lead={`${posts.length} article${posts.length === 1 ? '' : 's'} on this topic.`}>
    <Breadcrumb items={crumbs} slot="before" />
  </Hero>
  <Container class="tag-body">
    <h2 class="visually-hidden">Articles tagged {label}</h2>
    <InsightsListing posts={items} all={all} page={page} pages={pages} base={base} activeTag={slug} />
  </Container>
</BaseLayout>

<style>
  :global(.tag-body) { padding-bottom: var(--space-section); }
</style>
