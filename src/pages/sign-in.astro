---
// /sign-in/: the one place to start signing in to BIZOMAT. One account and one sign-in (owner, 20 Nov 2026: "as now
// everything is set under one sign in, remove double account sign in"): BIZOMAT ERP, where every system opens. CAD
// Automation is under Engineering there, and its own page takes the same account (Continue with BIZOMAT;
// its AI assistant connector signs in the same way). Existing accounts work unchanged.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import '../styles/product.css';
import { APP_LINKS, APP_URLS } from '../config/platform.ts';

const host = (u: string) => { const x = new URL(u); return x.host + x.pathname.replace(/\/$/, ''); };
const apps = [
  { name: 'BIZOMAT ERP', button: 'BIZOMAT ERP', text: 'One workspace and one sign-in for every system: Sales and CRM, Finance and Accounting, Project Management, Product Management, Engineering with CAD Automation, Procurement, Warehouse, Maintenance, Health and Safety, your company, Reports and Administration.', signIn: APP_LINKS.erp.signIn, page: '/systems/#erp', host: host(APP_URLS.erp) },
];
---
<BaseLayout title="Sign in" description="Sign in to BIZOMAT ERP with your BIZOMAT account: one sign-in for the CRM, Finance, Projects, CAD Automation and every other system." breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Sign in', href: '/sign-in/' }]}>
  <section class="pp-hero" aria-labelledby="signin-title">
    <Container>
      <p class="bz-eyebrow">BIZOMAT account</p>
      <h1 id="signin-title">Sign in to BIZOMAT</h1>
      <p class="pp-hero__lead">One BIZOMAT account and one sign-in open BIZOMAT ERP, where every system works together. Your existing account and data work unchanged: sign in with the email and password you already use.</p>
      <ul class="pp-cards signin" role="list">
        {apps.map((a) => (
          <li class="pp-card">
            <h2>{a.name}</h2>
            <p>{a.text}</p>
            <div class="pp-hero__actions">
              <Button href={a.signIn} variant="accent" rel="noopener" data-cta={`signin-${a.page.replace(/\//g, '')}`}>Sign in to {a.button}</Button>
              <Button href={a.page} variant="secondary">About {a.button}</Button>
            </div>
            <p class="signin__host">Signs in at <span class="bz-mono">{a.host}</span></p>
          </li>
        ))}
      </ul>
      <div class="bz-alert bz-alert--info signin__note" role="note">
        <strong>CAD Automation uses the same account</strong>
        <span>Open it from BIZOMAT ERP, under Engineering.</span>
      </div>
      <div class="bz-alert bz-alert--info signin__note" role="note">
        <strong>Resources need no account</strong>
        <span>Tools, calculators, the Library and AI search are free to use without signing in. <a href="/resources/">Go to Resources</a>.</span>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .signin { margin-top: clamp(2rem, 4vw, 2.75rem); }
  .signin h2 { font-size: var(--step-2); }
  .signin__host { margin-top: 1rem !important; color: var(--muted) !important; font-size: .86rem !important; }
  .signin__note { margin-top: 1.5rem; max-width: 760px; }

  /* ui-new:generated begin (scripts/ui/gen-overrides.mjs; do not edit) */
  :global(html[data-ui="new"]) .signin__note { margin-top: var(--bz-space-6); }
  /* ui-new:generated end */
</style>
