{
  "name": "bizomat",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node shared/brand/build.mjs && astro build && node scripts/postbuild.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist-server/server.mjs",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run check && npm test && npm run build",
    "brand": "node shared/brand/build.mjs",
    "brand:check": "node shared/brand/build.mjs --check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "description": "BIZOMAT: the website (Astro), CAD MCP and Task Management, deployed together as one Fly.io app (cados)."
}
