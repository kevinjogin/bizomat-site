---
// Page hero: eyebrow, heading, optional lead and actions. Used on the homepage and inner pages.
import Container from './Container.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  size?: 'display' | 'page';
  class?: string;
}
const { eyebrow, title, lead, size = 'page', class: className } = Astro.props;
---

<header class:list={['hero', `hero--${size}`, className]}>
  <Container>
    <slot name="before" />
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="hero__title" set:html={title} />
    {lead && <p class="hero__lead">{lead}</p>}
    {Astro.slots.has('actions') && <div class="hero__actions"><slot name="actions" /></div>}
    <slot />
  </Container>
</header>

<style>
  .hero { padding-block: clamp(3.5rem, 7vw, 7rem) clamp(2.5rem, 5vw, 4.5rem); }
  .hero .eyebrow { margin-bottom: clamp(1.25rem, 2.5vw, 2rem); }
  .hero__title { max-width: 18ch; font-size: var(--step-4); letter-spacing: -0.035em; }
  .hero--display .hero__title { max-width: 13ch; font-size: var(--step-5); font-weight: 540; line-height: 0.98; letter-spacing: -0.045em; }
  .hero__title :global(em) { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.02em; }
  .hero__lead { max-width: 46ch; margin: clamp(1.25rem, 2.5vw, 2rem) 0 0; font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: clamp(1.75rem, 3vw, 2.5rem); }
</style>
