{
  "name": "workos-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WorkOS — an original, self-hosted work management platform on Cloudflare Workers, D1, R2, KV and Durable Objects.",
  "scripts": {
    "dev": "npm run build:client && wrangler dev --local --port 8787",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:worker && npm run build:node",
    "build:client": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "build:node": "node src/node/build.mjs",
    "start:node": "node dist/node/server.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "seed:local": "node scripts/seed-local.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:node": "playwright test --config playwright.node.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:node && npm run build",
    "migrate:import": "node scripts/migrate/import-d1-dump.mjs",
    "migrate:copy-r2": "node scripts/migrate/copy-r2-objects.mjs",
    "migrate:repair-text": "node scripts/migrate/repair-text-from-d1.mjs",
    "migrate:verify": "node scripts/migrate/verify-data-dir.mjs",
    "migrate:export": "node scripts/migrate/export-for-d1.mjs",
    "migrate:backup": "node scripts/migrate/backup-data-dir.mjs",
    "migrate:dry-run": "node scripts/migrate/dry-run.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "~4.1.12",
    "wrangler": "^4.157.0"
  }
}
