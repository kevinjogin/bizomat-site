---
// Indicative service packages with "from" pricing and the mandatory pricing note.
import { PACKAGES, PRICING_NOTE, SERVICE_OPTIONS } from '../data/services.ts';

interface Props {
  /** Show only the first n packages (homepage preview). */
  limit?: number;
}
const { limit } = Astro.props;
const items = limit ? PACKAGES.slice(0, limit) : PACKAGES;
const slugFor = (service: string) => SERVICE_OPTIONS.find((o) => o.value === service)?.slug ?? 'other';
---

<div class="packages">
  <ul class="packages__grid">
    {
      items.map((p) => (
        <li class="package">
          <h3 class="package__title">{p.title}</h3>
          <p class="package__price">{p.price}</p>
          <p class="package__text">{p.description}</p>
          <a class="package__link" href={`/contact/?service=${slugFor(p.service)}`} data-cta="package-quote">
            Request a quote <span aria-hidden="true">→</span>
            <span class="visually-hidden"> for {p.title}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="packages__note">{PRICING_NOTE}</p>
</div>

<style>
  .packages__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .package { display: flex; flex-direction: column; gap: 0.5rem; padding: clamp(1.25rem, 2.5vw, 1.75rem); background: var(--surface); }
  .package__title { font-size: 1.08rem; font-weight: 560; letter-spacing: -0.015em; line-height: 1.25; }
  .package__price { margin: 0; font-size: var(--step-1); font-weight: 560; letter-spacing: -0.02em; color: var(--accent); }
  .package__text { margin: 0; color: var(--ink-2); font-size: 0.95rem; line-height: 1.5; flex: 1; }
  .package__link { margin-top: 0.5rem; font-size: 0.92rem; font-weight: 540; color: var(--ink); text-decoration: none; }
  .package__link:hover { color: var(--accent); }
  .packages__note { margin: 1rem 0 0; font-size: 0.88rem; color: var(--muted); max-width: 70ch; }
  @media (max-width: 1000px) { .packages__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .packages__grid { grid-template-columns: 1fr; } }
</style>
