---
// Shared library browser for WORKOS and READOS: breadcrumb, search results, topic cards and topic sections.
// The page passes its own topics and cards, so each library keeps an independent index.
// Behaviour lives in src/scripts/library-browser.ts (topic, subcategory and search state in ?topic= / ?sub= / ?q=).
import Container from '../Container.astro';
import LibraryIcon from './LibraryIcon.astro';
import type { LibraryIconName } from './icons.ts';

interface Topic { slug: string; name: string; description: string; icon: LibraryIconName; count: number }
interface Props {
  /** Library id, e.g. "WORKOS" (scripts key behaviour on it). */
  name: string;
  /** Plain label for the breadcrumb and buttons, as in the main navigation, e.g. "Tools". Defaults to name. */
  label?: string;
  /** Text of the button that widens a topic search to the whole library. */
  searchAll?: string;
  /** Landing page path, e.g. "/tools/". */
  base: string;
  noun: string;
  topics: Topic[];
  /** Cards shown per topic before "View all". */
  preview: number;
  id?: string;
}
const { name, base, noun, topics, preview, id, label = name, searchAll = `Search all of ${label}` } = Astro.props;
const plural = (n: number) => `${n} ${noun}${n === 1 ? '' : 's'}`;
const cols = topics.length % 4 === 0 ? 4 : topics.length % 3 === 0 ? 3 : 4;
---

<div class="lib" id={id} data-library={name} data-base={base} data-noun={noun} data-preview={preview}>
  <Container>
    <nav class="lib-trail" aria-label="Library breadcrumb" hidden data-lib-trail>
      <a href={base} data-lib-reset>{label}</a><span class="lib-trail__sep" aria-hidden="true">/</span><span aria-current="page" data-lib-trail-current></span>
      <a class="lib-trail__back" href={base} data-lib-reset>← All topics</a>
    </nav>

    <section class="lib-results" id="lib-results" aria-labelledby="lib-results-title" hidden data-lib-results>
      <div class="lib-results__head">
        <h2 class="lib-results__title" id="lib-results-title" tabindex="-1" data-lib-results-title>Results</h2>
        <button class="lib-link-button" type="button" hidden data-lib-search-all>{searchAll}</button>
      </div>
      <p class="lib-ai-note" role="status" hidden data-lib-ai-note></p>
      <div class="lib-grid" data-lib-results-grid></div>
      <div class="lib-empty" hidden data-lib-empty>
        <p>Check the spelling, try a shorter or more general word, or browse a topic below.</p>
        <button class="lib-link-button" type="button" data-lib-clear-search>Clear search</button>
      </div>
    </section>

    <section class="lib-topics" aria-labelledby="lib-topics-title" data-lib-topics>
      <h2 class="lib-label" id="lib-topics-title" tabindex="-1">Browse by topic</h2>
      <ul class:list={['lib-topic-grid', `lib-topic-grid--${cols}`]} role="list">
        {topics.map((t) => (
          <li>
            <a class="lib-topic" href={`${base}?topic=${t.slug}`} data-lib-topic-link={t.slug} data-lib-topic-name={t.name}>
              <span class="lib-topic__icon"><LibraryIcon name={t.icon} /></span>
              <span class="lib-topic__text">
                <span class="lib-topic__name">{t.name}</span>
                <span class="lib-topic__desc">{t.description}</span>
              </span>
              <span class="lib-topic__count" aria-label={plural(t.count)}>{t.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="lib-sections" data-lib-sections>
      <slot />
    </div>

    <slot name="after" />
  </Container>
</div>

<script>
  import '../../scripts/library-browser.ts';
</script>
