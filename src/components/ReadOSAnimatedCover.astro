---
// Library book cover: KEVOS colourway, subject illustration and typeset title, drawn as animated SVG.
// Cover data (motif, tone, composition) comes from src/utils/reados-covers.ts.
import ReadOSCoverShapes from './ReadOSCoverShapes.astro';
import { coverArt, coverLayout, coverSpec } from '../utils/reados-covers.ts';
interface Props { title: string; category: string; slug: string; subtitle?: string; compact?: boolean; motif?: string; publicationLabel?: string; chapters?: number }
const { title, category, slug, motif, publicationLabel = 'LIBRARY COLLECTION', chapters } = Astro.props;
const spec = coverSpec({ slug, title, category, motif });
const uid = `rc-${slug.replace(/[^a-z0-9-]/gi, '-')}`;
const art = coverArt(spec, uid);
const layout = coverLayout(spec.title);
const panelBottom = 60 + layout.panelH;
const marks = `M28 70V60H38M322 60H332V70M28 ${panelBottom - 10}V${panelBottom}H38M322 ${panelBottom}H332V${panelBottom - 10}`;
---
<svg class:list={['reados-cover', `rc-tone-${spec.tone}`, `rc-speed-${spec.seed % 4}`]} viewBox="0 0 360 490" role="img" aria-label={`Cover of ${title}`} data-cover={`${spec.motif}:${spec.tone}`} xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" class="rc-s1" /><stop offset="1" class="rc-s2" /></linearGradient>
    <linearGradient id={`${uid}-sheen`} x1="0" x2="1"><stop offset="0" class="rc-sheen-a" /><stop offset=".5" class="rc-sheen-b" /><stop offset="1" class="rc-sheen-a" /></linearGradient>
    <pattern id={`${uid}-dots`} width="12" height="12" patternUnits="userSpaceOnUse"><circle cx="6" cy="6" r=".8" class="rc-dot" /></pattern>
    <clipPath id={`${uid}-clip`}><rect width="360" height="490" rx="3" /></clipPath>
  </defs>
  <g clip-path={`url(#${uid}-clip)`}>
    <rect width="360" height="490" fill={`url(#${uid}-bg)`} />
    <rect width="10" height="490" class="rc-spine" />
    <path d="M10.5 0V490" class="rc-edge" />
    <text x="28" y="34" class="rc-brand">KEVOS® Library</text>
    <text x="332" y="34" text-anchor="end" class="rc-cat">{category.toUpperCase()}</text>
    <path d="M28 46H332" class="rc-rule" />
    <rect x="28" y="44.5" width="38" height="3" class="fa" />
    <rect x="28" y="60" width="304" height={layout.panelH} class="rc-panel" />
    <rect x="28" y="60" width="304" height={layout.panelH} fill={`url(#${uid}-dots)`} />
    <path d={marks} class="rc-mark" />
    <svg x="28" y="60" width="304" height={layout.panelH} viewBox="0 0 304 204" preserveAspectRatio="xMidYMid meet"><ReadOSCoverShapes shapes={art} /></svg>
    <rect x="28" y={layout.barY} width="30" height="3" class="fa" />
    {spec.series && <text x="68" y={layout.barY + 4} class="rc-series">{spec.series}</text>}
    {layout.lines.map((line, i) => <text x="27" y={layout.firstBaseline + i * layout.lh} font-size={layout.size} class="rc-title">{line}</text>)}
    <path d="M28 446H332" class="rc-rule" />
    <text x="28" y="470" class="rc-foot">{publicationLabel}</text>
    {chapters && <text x="332" y="470" text-anchor="end" class="rc-foot">{chapters} {chapters === 1 ? 'CHAPTER' : 'CHAPTERS'}</text>}
    <g transform="skewX(-16)"><rect class="an-sheen" x="0" y="0" width="120" height="490" fill={`url(#${uid}-sheen)`} /></g>
  </g>
  <rect x=".5" y=".5" width="359" height="489" rx="3" class="rc-edge" />
</svg>

<script>
  // Pause cover animation while a cover is off screen, so long catalogue pages stay light.
  const covers = document.querySelectorAll('.reados-cover');
  if ('IntersectionObserver' in window && covers.length) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.target.classList.toggle('is-idle', !entry.isIntersecting);
    }, { rootMargin: '160px' });
    covers.forEach((cover) => observer.observe(cover));
  }
</script>

<style is:global>
  .reados-cover { --rc-dur: 12s; display: block; width: 100%; height: auto; aspect-ratio: 360 / 490; border-radius: 3px; box-shadow: 0 16px 32px rgb(0 0 0 / 0.24), 0 2px 6px rgb(0 0 0 / 0.14); }
  .reados-cover.rc-speed-0 { --rc-dur: 10s; }
  .reados-cover.rc-speed-1 { --rc-dur: 12s; }
  .reados-cover.rc-speed-2 { --rc-dur: 14s; }
  .reados-cover.rc-speed-3 { --rc-dur: 16s; }

  /* KEVOS colourways */
  .reados-cover.rc-tone-graphite { --rc-bg1: #24272c; --rc-bg2: #101113; --rc-spine: #0b0c0d; --rc-node: #23272c; --rc-ink: #f5f2eb; --rc-sub: #aaa69d; --rc-line: rgb(245 242 235 / 0.16); --rc-line-strong: rgb(245 242 235 / 0.42); --rc-faint: rgb(245 242 235 / 0.06); --rc-accent: #ff6a13; --rc-accent-2: #ffb27a; --rc-accent-text: #ff7a29; }
  .reados-cover.rc-tone-carbon { --rc-bg1: #161616; --rc-bg2: #050505; --rc-spine: #ff6a13; --rc-node: #1b1b1b; --rc-ink: #f5f2eb; --rc-sub: #a19d93; --rc-line: rgb(245 242 235 / 0.14); --rc-line-strong: rgb(245 242 235 / 0.38); --rc-faint: rgb(245 242 235 / 0.05); --rc-accent: #ff6a13; --rc-accent-2: #ffd2b0; --rc-accent-text: #ff7a29; }
  .reados-cover.rc-tone-ember { --rc-bg1: #ff8236; --rc-bg2: #e9560c; --rc-spine: #c2410c; --rc-node: #ff9450; --rc-ink: #151312; --rc-sub: #4d2810; --rc-line: rgb(21 19 18 / 0.22); --rc-line-strong: rgb(21 19 18 / 0.58); --rc-faint: rgb(21 19 18 / 0.08); --rc-accent: #151312; --rc-accent-2: #fff3e8; --rc-accent-text: #151312; }
  .reados-cover.rc-tone-paper { --rc-bg1: #f8f6f1; --rc-bg2: #e7e2d7; --rc-spine: #d9d2c4; --rc-node: #fdfcf9; --rc-ink: #151312; --rc-sub: #67625a; --rc-line: rgb(21 19 18 / 0.16); --rc-line-strong: rgb(21 19 18 / 0.45); --rc-faint: rgb(21 19 18 / 0.05); --rc-accent: #ec5b0c; --rc-accent-2: #c2410c; --rc-accent-text: #c2410c; }

  /* Frame and typography */
  .reados-cover .rc-s1 { stop-color: var(--rc-bg1); }
  .reados-cover .rc-s2 { stop-color: var(--rc-bg2); }
  .reados-cover .rc-sheen-a { stop-color: #ffffff; stop-opacity: 0; }
  .reados-cover .rc-sheen-b { stop-color: #ffffff; stop-opacity: 0.09; }
  .reados-cover .rc-spine { fill: var(--rc-spine); }
  .reados-cover .rc-edge { fill: none; stroke: var(--rc-line); stroke-width: 1; }
  .reados-cover .rc-rule { fill: none; stroke: var(--rc-line); stroke-width: 1; }
  .reados-cover .rc-panel { fill: var(--rc-faint); stroke: var(--rc-line); stroke-width: 1; }
  .reados-cover .rc-dot { fill: var(--rc-line); }
  .reados-cover .rc-mark { fill: none; stroke: var(--rc-accent); stroke-width: 1.6; }
  .reados-cover .rc-brand { fill: var(--rc-ink); font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: 0.2em; }
  .reados-cover .rc-cat, .reados-cover .rc-foot { fill: var(--rc-sub); font-family: var(--font-sans); font-size: 9.5px; font-weight: 650; letter-spacing: 0.16em; }
  .reados-cover .rc-title { fill: var(--rc-ink); font-family: var(--font-display); font-weight: 700; letter-spacing: -0.005em; }
  .reados-cover .rc-series { fill: var(--rc-accent-text); font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: 0.22em; }

  /* Illustration vocabulary */
  .reados-cover .ln { fill: none; stroke: var(--rc-line-strong); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .reados-cover .lf { fill: none; stroke: var(--rc-line); stroke-width: 1; }
  .reados-cover .la { fill: none; stroke: var(--rc-accent); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .reados-cover .cl { fill: none; stroke: var(--rc-line-strong); stroke-width: 0.9; stroke-dasharray: 10 3 2 3; }
  .reados-cover .bx { fill: var(--rc-node); stroke: var(--rc-line-strong); stroke-width: 1.4; stroke-linejoin: round; }
  .reados-cover .bxa { fill: var(--rc-node); stroke: var(--rc-accent); stroke-width: 2.2; stroke-linejoin: round; }
  .reados-cover .rose { fill: var(--rc-faint); stroke: var(--rc-line-strong); stroke-width: 1; }
  .reados-cover .fa { fill: var(--rc-accent); }
  .reados-cover .fs { fill: var(--rc-accent-2); }
  .reados-cover .ff { fill: var(--rc-faint); }
  .reados-cover .fl { fill: var(--rc-line); }
  .reados-cover .fi { fill: var(--rc-ink); }
  .reados-cover .fn { fill: var(--rc-node); }
  .reados-cover .dsh { stroke-dasharray: 4 4; }
  .reados-cover .dsh2 { stroke-dasharray: 14 8; }
  .reados-cover .wide { stroke-width: 3.2; }
  .reados-cover .xbold { stroke-width: 4.2; }
  .reados-cover .arm { stroke-width: 5; }
  .reados-cover .xwide { stroke-width: 7; }
  .reados-cover .thick { stroke-width: 14; stroke-linecap: butt; }
  .reados-cover .lnode { fill: none; stroke: var(--rc-node); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .reados-cover .o15 { opacity: 0.15; }
  .reados-cover .o3 { opacity: 0.3; }
  .reados-cover .o5 { opacity: 0.55; }
  .reados-cover .o85 { opacity: 0.85; }
  .reados-cover .tx { fill: var(--rc-sub); font-family: var(--font-sans); font-size: 8.5px; font-weight: 650; letter-spacing: 0.12em; }
  .reados-cover .txs { fill: var(--rc-ink); font-family: var(--font-display); font-size: 9px; font-weight: 700; }
  .reados-cover .txb, .reados-cover .txa { fill: var(--rc-ink); font-family: var(--font-display); font-size: 14px; font-weight: 700; }
  .reados-cover .txa { fill: var(--rc-accent-text); }

  /* Motion */
  .reados-cover .an-draw { stroke-dasharray: 100 100; animation: rc-draw var(--rc-dur) ease-in-out infinite; }
  .reados-cover .an-flow { stroke-dasharray: 5 6; animation: rc-flow calc(var(--rc-dur) * 0.35) linear infinite; }
  .reados-cover .an-pulse { animation: rc-pulse calc(var(--rc-dur) * 0.3) ease-in-out infinite alternate; }
  .reados-cover .an-glow { animation: rc-glow calc(var(--rc-dur) * 0.3) ease-in-out infinite alternate; }
  .reados-cover .an-blink { animation: rc-blink 1.2s steps(1) infinite; }
  .reados-cover .an-spin, .reados-cover .an-spin-r { transform-box: fill-box; transform-origin: center; animation: rc-spin calc(var(--rc-dur) * 1.6) linear infinite; }
  .reados-cover .an-spin-r { animation-direction: reverse; }
  .reados-cover .an-tilt { transform-box: fill-box; transform-origin: center; animation: rc-tilt calc(var(--rc-dur) * 0.9) ease-in-out infinite alternate; }
  .reados-cover .an-tilt.rev { animation-direction: alternate-reverse; }
  .reados-cover .an-arm { transform-box: fill-box; transform-origin: 0 50%; animation: rc-spin calc(var(--rc-dur) * 2) linear infinite; }
  .reados-cover .an-swing { transform-box: fill-box; transform-origin: 0 50%; animation: rc-swing calc(var(--rc-dur) * 0.7) ease-in-out infinite alternate; }
  .reados-cover .an-needle { transform-box: fill-box; transform-origin: 100% 50%; animation: rc-needle calc(var(--rc-dur) * 0.6) ease-in-out infinite alternate; }
  .reados-cover .an-compass { transform-box: fill-box; transform-origin: center; animation: rc-compass calc(var(--rc-dur) * 0.5) ease-in-out infinite alternate; }
  .reados-cover .an-clamp { transform-box: fill-box; transform-origin: 0 50%; animation: rc-clamp calc(var(--rc-dur) * 0.5) ease-in-out infinite alternate; }
  .reados-cover .an-clamp-r { transform-box: fill-box; transform-origin: 100% 50%; animation: rc-clamp-r calc(var(--rc-dur) * 0.5) ease-in-out infinite alternate; }
  .reados-cover .an-wave { transform-box: fill-box; transform-origin: 0 50%; animation: rc-wave calc(var(--rc-dur) * 0.15) ease-in-out infinite alternate; }
  .reados-cover .an-ripple { transform-box: fill-box; transform-origin: center; animation: rc-ripple calc(var(--rc-dur) * 0.35) ease-out infinite; }
  .reados-cover .an-grow { transform-box: fill-box; transform-origin: 50% 100%; animation: rc-grow var(--rc-dur) ease-in-out infinite; }
  .reados-cover .an-build { transform-box: fill-box; transform-origin: 50% 100%; animation: rc-build var(--rc-dur) ease-in-out infinite; }
  .reados-cover .an-growx { transform-box: fill-box; transform-origin: 0 50%; animation: rc-growx var(--rc-dur) ease-in-out infinite; }
  .reados-cover .an-balance { transform-box: fill-box; transform-origin: 50% 0; animation: rc-balance calc(var(--rc-dur) * 0.5) ease-in-out infinite alternate; }
  .reados-cover .an-busy { animation: rc-busy calc(var(--rc-dur) * 0.4) ease-in-out infinite alternate; }
  .reados-cover .an-bob { animation: rc-bob calc(var(--rc-dur) * 0.4) ease-in-out infinite alternate; }
  .reados-cover .an-up { animation: rc-up calc(var(--rc-dur) * 0.5) ease-in-out infinite alternate; }
  .reados-cover .an-down { animation: rc-down calc(var(--rc-dur) * 0.5) ease-in-out infinite alternate; }
  .reados-cover .an-bubble { animation: rc-bubble calc(var(--rc-dur) * 0.45) ease-in infinite; }
  .reados-cover .an-fall { animation: rc-fall calc(var(--rc-dur) * 0.35) ease-in infinite; }
  .reados-cover .an-plunge { animation: rc-plunge calc(var(--rc-dur) * 0.3) ease-in-out infinite alternate; }
  .reados-cover .an-convey { animation: rc-convey calc(var(--rc-dur) * 0.4) linear infinite; }
  .reados-cover .an-slosh { animation: rc-slosh calc(var(--rc-dur) * 0.25) linear infinite; }
  .reados-cover .an-sun { animation: rc-sun calc(var(--rc-dur) * 0.8) ease-in-out infinite alternate; }
  .reados-cover .an-today { animation: rc-today calc(var(--rc-dur) * 1.2) ease-in-out infinite alternate; }
  .reados-cover .an-inspect { animation: rc-inspect calc(var(--rc-dur) * 0.9) ease-in-out infinite alternate; }
  .reados-cover .an-drift { animation: rc-drift calc(var(--rc-dur) * 0.6) ease-in-out infinite alternate; }
  .reados-cover .an-scan4 { animation: rc-scan4 calc(var(--rc-dur) * 0.5) steps(4) infinite; }
  .reados-cover .an-scan5 { animation: rc-scan5 calc(var(--rc-dur) * 0.5) steps(5) infinite; }
  .reados-cover .an-scan6 { animation: rc-scan6 calc(var(--rc-dur) * 0.5) steps(6) infinite; }
  .reados-cover .an-sheen { animation: rc-sheen calc(var(--rc-dur) * 1.5) ease-in-out infinite; }
  .reados-cover .d1 { animation-delay: calc(var(--rc-dur) * -0.11); }
  .reados-cover .d2 { animation-delay: calc(var(--rc-dur) * -0.22); }
  .reados-cover .d3 { animation-delay: calc(var(--rc-dur) * -0.33); }
  .reados-cover .d4 { animation-delay: calc(var(--rc-dur) * -0.44); }
  .reados-cover .d5 { animation-delay: calc(var(--rc-dur) * -0.55); }
  .reados-cover .d6 { animation-delay: calc(var(--rc-dur) * -0.66); }
  .reados-cover .d7 { animation-delay: calc(var(--rc-dur) * -0.77); }
  .reados-cover .d8 { animation-delay: calc(var(--rc-dur) * -0.88); }
  .reados-cover.is-idle * { animation-play-state: paused; }

  @keyframes rc-draw { 0% { stroke-dashoffset: 100; } 40%, 78% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: -100; } }
  @keyframes rc-flow { to { stroke-dashoffset: -22; } }
  @keyframes rc-pulse { from { opacity: 0.3; } to { opacity: 1; } }
  @keyframes rc-glow { from { opacity: 0.06; } to { opacity: 0.3; } }
  @keyframes rc-blink { 50% { opacity: 0; } }
  @keyframes rc-spin { to { transform: rotate(360deg); } }
  @keyframes rc-tilt { from { transform: rotate(-12deg); } to { transform: rotate(12deg); } }
  @keyframes rc-swing { from { transform: rotate(-20deg); } to { transform: rotate(-160deg); } }
  @keyframes rc-needle { from { transform: rotate(25deg); } to { transform: rotate(150deg); } }
  @keyframes rc-compass { from { transform: rotate(-14deg); } to { transform: rotate(10deg); } }
  @keyframes rc-clamp { from { transform: rotate(-7deg); } to { transform: rotate(0deg); } }
  @keyframes rc-clamp-r { from { transform: rotate(7deg); } to { transform: rotate(0deg); } }
  @keyframes rc-wave { from { transform: skewY(-8deg); } to { transform: skewY(6deg); } }
  @keyframes rc-ripple { from { transform: scale(0.8); opacity: 0.9; } to { transform: scale(1.7); opacity: 0; } }
  @keyframes rc-grow { 0%, 100% { transform: scaleY(0.35); } 45%, 80% { transform: scaleY(1); } }
  @keyframes rc-build { 0%, 100% { transform: scaleY(0.6); } 45%, 85% { transform: scaleY(1); } }
  @keyframes rc-growx { 0%, 100% { transform: scaleX(0.25); } 50%, 85% { transform: scaleX(1); } }
  @keyframes rc-balance { from { transform: rotate(-4deg); } to { transform: rotate(4deg); } }
  @keyframes rc-busy { to { transform: translateY(142px); } }
  @keyframes rc-bob { from { transform: translateY(-4px); } to { transform: translateY(4px); } }
  @keyframes rc-up { from { transform: translateY(2px); } to { transform: translateY(-6px); } }
  @keyframes rc-down { from { transform: translateY(-2px); } to { transform: translateY(6px); } }
  @keyframes rc-bubble { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: 1; } 100% { transform: translateY(-72px); opacity: 0; } }
  @keyframes rc-fall { 0% { transform: translateY(-6px); opacity: 0; } 20% { opacity: 1; } 100% { transform: translateY(34px); opacity: 0; } }
  @keyframes rc-plunge { from { transform: translateY(-6px); } to { transform: translateY(10px); } }
  @keyframes rc-convey { to { transform: translateX(60px); } }
  @keyframes rc-slosh { to { transform: translateX(30px); } }
  @keyframes rc-sun { from { transform: translateY(16px); } to { transform: translateY(-6px); } }
  @keyframes rc-today { to { transform: translateX(150px); } }
  @keyframes rc-inspect { to { transform: translate(150px, 30px); } }
  @keyframes rc-drift { to { transform: translate(46px, 34px); } }
  @keyframes rc-scan4 { to { transform: translateY(80px); } }
  @keyframes rc-scan5 { to { transform: translateY(100px); } }
  @keyframes rc-scan6 { to { transform: translateY(120px); } }
  @keyframes rc-sheen { 0%, 62% { transform: translateX(-200px); } 100% { transform: translateX(640px); } }

  @media (prefers-reduced-motion: reduce) {
    .reados-cover * { animation: none !important; }
  }
</style>
