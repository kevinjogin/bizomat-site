---
// /learn/workflows/<workflow>/: one end-to-end workflow: what it achieves, the modules it passes through, a
// step-by-step tutorial and its common questions. Data: src/data/learn/workflows/<id>.ts.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import StatusLabel from '../../../components/StatusLabel.astro';
import FlowChain from '../../../components/learn/FlowChain.astro';
import TutorialStepper from '../../../components/learn/TutorialStepper.astro';
import Faqs from '../../../components/learn/Faqs.astro';
import LearnSearch from '../../../components/learn/LearnSearch.astro';
import '../../../styles/learn.css';
import { SITE } from '../../../config/site.ts';
import { FEATURE_STATUS } from '../../../config/systems.ts';
import { LEARN_HOME, WORKFLOWS, guideById, guideUrl, workflowUrl } from '../../../data/learn/index.ts';
import type { Workflow } from '../../../data/learn/types.ts';

export function getStaticPaths() {
  return WORKFLOWS.map((w) => ({ params: { workflow: w.id }, props: { w } }));
}
interface Props { w: Workflow }
const { w } = Astro.props;
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Knowledge Centre', href: LEARN_HOME }, { label: 'Workflows', href: '/learn/workflows/' }, { label: w.title, href: workflowUrl(w.id) }];
const clip = (s: string) => (s.length <= 196 ? s : `${s.slice(0, 193).replace(/\s+\S*$/, '')}…`);
const description = clip(`${w.title} in BIZOMAT ERP: ${w.summary}`);
const guides = [...new Set(w.stages.map((s) => s.guide))].map(guideById);
const first = guideById(w.stages[0].guide);
const schema = [{
  '@type': 'HowTo', '@id': `${SITE.url}${workflowUrl(w.id)}#howto`, name: w.title, description, url: `${SITE.url}${workflowUrl(w.id)}`,
  step: w.tutorial.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.body })),
}];
---
<BaseLayout title={`${w.title} | Workflows`} description={description} breadcrumbs={crumbs} schema={schema} type="article">
  <section class="lv-hero lv-hero--guide" aria-labelledby="wf-title">
    <Container>
      <Breadcrumb items={crumbs} />
      <p class="bz-eyebrow">Workflow</p>
      <h1 id="wf-title">{w.title}</h1>
      <p class="lv-hero__status"><StatusLabel status={w.status} /> <span>{FEATURE_STATUS[w.status].meaning}</span></p>
      <p class="lv-hero__lead">{w.summary}</p>
      <LearnSearch compact />
    </Container>
  </section>
  <Container class="lv-narrow">
    <section class="lv-sec" aria-labelledby="stages">
      <h2 id="stages">The stages</h2>
      <FlowChain items={w.stages.map((s) => ({ href: guideUrl(s.guide), title: s.label, detail: s.detail }))} label={w.title} />
    </section>
    <section class="lv-sec" aria-labelledby="tutorial">
      <h2 id="tutorial">Step by step</h2>
      <TutorialStepper tutorial={w.tutorial} open finishHref={first.access?.href} finishLabel={first.access?.label} />
    </section>
    <section class="lv-sec" aria-labelledby="questions">
      <h2 id="questions">Common questions</h2>
      <Faqs faqs={w.faqs} idPrefix={w.id} />
    </section>
    <section class="lv-sec" aria-labelledby="guides">
      <h2 id="guides">The modules in this workflow</h2>
      <ul class="lv-links lv-links--inline">{guides.map((g) => <li><a href={guideUrl(g.id)}>{g.title}</a></li>)}</ul>
      <p><a href="/learn/workflows/">All workflows</a></p>
    </section>
  </Container>
</BaseLayout>

<script>
  import '../../../scripts/learn.ts';
</script>
