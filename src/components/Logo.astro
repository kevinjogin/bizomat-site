---
interface Props {
  class?: string;
  height?: number;
  label?: string;
}
const { class: className, height = 30, label = 'KEVOS' } = Astro.props;
const sizeClass = height <= 22 ? 'logo--compact' : height >= 34 ? 'logo--large' : 'logo--default';
---
<span
  class:list={['logo', sizeClass, className]}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <img class="logo__image" src="/brand/kevos-logo-safe-v2.png" alt="" width="304" height="38" decoding="async" />
</span>

<style>
  .logo {
    --logo-h: 30px;
    display: inline-flex;
    align-items: center;
    height: var(--logo-h);
    max-width: 100%;
    white-space: nowrap;
    padding-block: 3px;
    box-sizing: content-box;
    overflow: visible;
  }
  .logo--compact { --logo-h: 22px; }
  .logo--default { --logo-h: 30px; }
  .logo--large { --logo-h: 34px; }
  .logo__image { display: block; width: auto; height: 100%; object-fit: contain; }
  :global(:root[data-theme='dark']) .logo__image { filter: brightness(0) invert(1); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logo__image { filter: brightness(0) invert(1); }
  }
</style>
