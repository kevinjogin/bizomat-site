---
// Shows one of a chapter's own figures as the featured image beside its entry in a book's
// Contents list. Visual figure types are preferred. The thumbnail repeats content already on
// the chapter page, so it is hidden from assistive technology and cannot take focus.
import { parseFigure, renderFigure } from '../utils/kevos-figures.ts';

interface Props { body?: string; id: string }
const { body = '', id } = Astro.props;

const PREFERRED = ['svg', 'line', 'bars', 'stack', 'range', 'balance', 'cycle', 'venn', 'funnel', 'gauge', 'matrix', 'timeline', 'layers', 'steps', 'stats', 'compare'];
const rank = (type: string) => { const i = PREFERRED.indexOf(type); return i < 0 ? PREFERRED.length : i; };
const specs = [...body.replace(/\r/g, '').matchAll(/^```figure\n([\s\S]*?)^```$/gm)]
  .map((m) => { try { return parseFigure(m[1]); } catch { return null; } })
  .filter((spec) => spec !== null);
const chosen = specs.slice().sort((a, b) => rank(a.type) - rank(b.type))[0];
const html = chosen ? renderFigure(chosen, `toc-${id.replace(/[^a-z0-9]+/gi, '-')}`, specs.indexOf(chosen) + 1) : '';
---
{html ? <span class="toc-thumb" aria-hidden="true" inert><span class="toc-thumb-inner" set:html={html} /></span> : <span class="toc-thumb toc-thumb-empty" aria-hidden="true" />}
<style>
.toc-thumb{position:relative;display:block;width:100%;aspect-ratio:4/3;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);transition:border-color .2s ease,box-shadow .2s ease}
.toc-thumb::before{content:'';position:absolute;z-index:1;top:-1px;left:.6rem;width:1.4rem;height:3px;background:var(--brand-orange)}
.toc-thumb::after{content:'';position:absolute;inset:auto 0 0;height:22%;background:linear-gradient(to bottom,transparent,var(--surface))}
/* The figure renders at twice the frame's width, then scales to half; its main visual comes first. */
.toc-thumb-inner{position:absolute;top:0;left:0;display:block;width:200%;transform:scale(.5);transform-origin:top left;pointer-events:none}
.toc-thumb-inner :global(.kf){margin:0;border:0;border-radius:0;padding:.9rem 1rem;background:transparent}
.toc-thumb-inner :global(.kf::before),.toc-thumb-inner :global(.kf-head),.toc-thumb-inner :global(.kf-cap){display:none}
.toc-thumb-empty{background:linear-gradient(135deg,var(--surface),var(--accent-soft))}</style>
