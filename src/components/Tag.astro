---
import { tagLabel } from '../config/taxonomy.ts';
import { tagUrl } from '../utils/content.ts';

interface Props {
  slug: string;
  /** Link only when a tag page exists (enough articles share the tag). */
  link?: boolean;
  current?: boolean;
}
const { slug, link = false, current = false } = Astro.props;
---

{
  link ? (
    <a class="tag" href={tagUrl(slug)} aria-current={current ? 'page' : undefined}>
      {tagLabel(slug)}
    </a>
  ) : (
    <span class="tag">{tagLabel(slug)}</span>
  )
}

<style>
  .tag {
    display: inline-flex; align-items: center; min-height: 30px; padding: 0 0.75rem;
    border: 1px solid var(--line-strong); border-radius: 999px;
    font-size: 0.84rem; color: var(--ink-2); text-decoration: none; white-space: nowrap;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease), background 0.2s var(--ease);
  }
  a.tag:hover { border-color: var(--ink); color: var(--ink); }
  a.tag[aria-current='page'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
</style>
