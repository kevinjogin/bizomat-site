---
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}
const items = Astro.props.headings.filter((h) => h.depth === 2);
---

<nav class="toc" aria-labelledby="toc-title">
  <p class="toc__title" id="toc-title">Contents</p>
  <ol>
    {items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
  </ol>
</nav>

<style>
  .toc { font-size: 0.92rem; }
  .toc__title { margin-bottom: 0.9rem; font-size: 0.78rem; font-weight: 560; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .toc ol { margin: 0; padding: 0; list-style: none; border-left: 1px solid var(--line); counter-reset: toc; }
  .toc li { counter-increment: toc; }
  .toc a { display: flex; gap: 0.6rem; padding: 0.4rem 0 0.4rem 1rem; margin-left: -1px; border-left: 1px solid transparent; color: var(--muted); text-decoration: none; line-height: 1.4; }
  .toc a::before { content: counter(toc, decimal-leading-zero); font-variant-numeric: tabular-nums; color: var(--line-strong); }
  .toc a:hover { color: var(--ink); border-left-color: var(--accent); }
</style>
