---
// /systems/erp/guide/: how to use BIZOMAT ERP, step by step. Buttons and fields are named as the application labels them
// (apps/work/src/client/system/SystemApp.tsx, components/layout/SuiteRail.tsx, company/Register.tsx, company/Pages.tsx,
// crm/CompanyLinks.tsx); facts come from docs/system/README.md and docs/company/README.md. Registration checks say only
// what they prove (CLAUDE.md): the ABN is looked up on the register only when that lookup is switched on, and phone
// numbers are checked against the numbering plan, never "verified". Screens are real (src/data/screenshots.ts); the
// Operations screen shows the planned modules and is described as such. Quality (Release 4 part A): docs/erp/release-4-quality.md.
// Supply Chain (Release 5 part A): docs/erp/release-5-supply-chain.md, apps/work/src/client/system/erp/SupplyChain.tsx.
// Markup follows the CRM guide.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Button from '../../../components/Button.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import StatusLabel from '../../../components/StatusLabel.astro';
import StatusLegend from '../../../components/StatusLegend.astro';
import '../../../styles/product.css';
import '../../../styles/visuals.css';
import '../../../styles/systems.css';
import { screenshots } from '../../../data/screenshots.ts';
import { SITE } from '../../../config/site.ts';
import { SYSTEMS_HOME, systemById, type FeatureStatus } from '../../../config/systems.ts';

const erp = systemById('erp');
const PAGE = erp.guide ?? '/systems/erp/guide/';
const access = erp.access!;
const shot = (name: string) => screenshots('erp').find((s) => s.src.endsWith(`/${name}.webp`));
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Systems', href: SYSTEMS_HOME }, { label: erp.name, href: erp.url }, { label: 'User guide', href: PAGE }];
const description = 'How to use BIZOMAT ERP, step by step: companies, roles, sales, projects, products, purchasing, stock, manufacturing, quality, shipping, maintenance and reports.';

interface Step { t: string; x: string; st?: FeatureStatus }
interface Part { id: string; title: string; st: FeatureStatus; lead?: string; steps: Step[]; shot?: string; roles?: boolean }
const parts: Part[] = [
  {
    id: 'access', title: 'Open BIZOMAT ERP', st: 'live',
    steps: [
      { t: 'The address', x: 'Go to bizomat.ai/erp. Bookmark it: every module opens from there.' },
      { t: 'From the website', x: 'Choose Sign in at the top of any BIZOMAT page, then BIZOMAT ERP.' },
      { t: 'Old addresses', x: 'bizomat.ai/tasks, /crm, /finance and /company forward to the same page inside the ERP, so older bookmarks and links in emails still work.' },
      { t: 'On a phone', x: 'The ERP works in the browser. The module rail moves to a bar along the bottom of the screen.' },
    ],
  },
  {
    id: 'sign-in', title: 'Sign in or create an account', st: 'live',
    steps: [
      { t: 'Sign in', x: 'Enter your BIZOMAT email and password and choose Sign in. It is the same account for Sales and CRM, Finance and Accounting, Projects and Tasks and your company.' },
      { t: 'New to BIZOMAT?', x: 'Choose Create an account and enter your full name, work email and a password of at least 10 characters, with letters and a number or symbol.' },
      { t: 'Confirm your email', x: 'If BIZOMAT asks you to confirm your email address, open the link in the email it sends, then sign in.' },
      { t: 'Engineering Automation', x: 'CAD Automation, the application of Engineering Automation, opens from Products and Engineering and takes the same BIZOMAT account: on its own page, choose Continue with BIZOMAT.' },
    ],
  },
  {
    id: 'company', title: 'Choose or register a company', st: 'live',
    lead: 'Everything in the ERP belongs to a company. Your own company, in your own name, is ready the first time you sign in.',
    steps: [
      { t: 'The company switcher', x: 'At the top of the screen. It lists your companies, then "Shared with you": companies where someone added you to a tool, with only those tools.' },
      { t: 'Your own company', x: 'It is not registered and has no ABN. It holds the tools you own outside a registered company. You can rename it.' },
      { t: 'Register a company', x: 'Choose Register a company in the switcher. Pick A business, registered with its ABN, or Myself, in my own name, where an ABN is optional.' },
      { t: 'The details', x: 'Business name, ABN, contact email, phone, street address, suburb, state and postcode, and a website if you have one. Company accounts are for Australian businesses for now.' },
      { t: 'What is checked', x: 'The ABN\'s check digits. When the Australian Business Register lookup is switched on, the ABN is also looked up there. The contact email gets a confirmation link, unless it is your own confirmed sign-in address. The phone number is checked against the Australian numbering plan but is never called or texted, and the postcode is checked against the state. Company checks shows what was checked.' },
      { t: 'Its tools', x: 'Registering gives the company a Projects and Tasks workspace, a Sales and CRM organisation and a Finance business workspace. You can bring in tools you already own instead.' },
    ],
    shot: 'erp-dashboard',
  },
  {
    id: 'example', title: 'Explore the example company', st: 'live',
    lead: 'Every account has an example company, Acme Studio, with invented data to learn BIZOMAT before using your own.',
    steps: [
      { t: 'Find it', x: 'Open the company switcher. Acme Studio (example) is listed last, under Example company. It is made the first time you open the ERP.' },
      { t: 'What is in it', x: 'Two example projects with a dashboard and a brief, customers and deals in Sales and CRM, transactions and a draft quote in Finance, an asset register with requests, work orders, preventive schedules, readings, an inspection, a prestart check and a part issued from the store in Maintenance, and in Operations purchasing, stock, manufacturing, quality and a sales order shipped to a customer with its draft invoice and a return.' },
      { t: 'Try anything', x: 'Change, add or delete what you like. Only you can see it, nobody can be invited to it, it sends no email, and nothing in it affects your own companies.' },
      { t: 'Remove it', x: 'In Administration, choose Remove the example company. You can add a new one there later.' },
    ],
  },
  {
    id: 'configure', title: 'Set up departments and tools', st: 'live',
    lead: 'Open Administration in the rail. For a registered company it links to the company area: Company overview, People and roles, Departments, Tools and Company settings.',
    steps: [
      { t: 'New department', x: 'In Departments, choose New department. Give it a name and a head, and under Part of choose the department it sits in, if any.' },
      { t: 'In every tool', x: 'A department becomes a team in Projects and Tasks, a team in Sales and CRM led by its head, and a department in Finance tracking.', st: 'connected' },
      { t: 'Tools', x: 'Tools lists the tools the company runs. The owner can bring in a tool they already own. Personal and household Finance workspaces stay private and are never offered.' },
      { t: 'Each tool\'s settings', x: 'Administration also links to each tool\'s team, roles and settings: Sales and CRM, Finance, and the Projects and Tasks workspace.' },
      { t: 'Company settings', x: 'The registered details and how they were checked. The owner can hand the company to an administrator, or close the company account; closing leaves the tools and their records as they are.' },
    ],
    shot: 'erp-administration',
  },
  {
    id: 'first-record', title: 'Add your first records', st: 'live',
    steps: [
      { t: 'Sales and CRM', x: 'Choose Sales and CRM in the rail. Add a contact, a company or a lead, or import them from a CSV file, then add a deal.' },
      { t: 'Finance and Accounting', x: 'Choose Finance and Accounting. In the company\'s business workspace, record a transaction, import a bank statement, or create a quote or an invoice.' },
      { t: 'Projects and Tasks', x: 'Choose Projects and Tasks. Create a board, from a template or empty, and add items with an owner, a status and a date.' },
      { t: 'Back to the dashboard', x: 'The dashboard shows each tool\'s figures the next time you open it.', st: 'connected' },
    ],
    shot: 'erp-crm',
  },
  {
    id: 'invite', title: 'Invite your people', st: 'live',
    steps: [
      { t: 'Invite someone', x: 'In Administration, open People and roles. Under Invite someone, enter the person\'s email and, if you like, their job title.' },
      { t: 'Company role', x: 'Member, or Administrator if you are the owner.' },
      { t: 'A role in each tool', x: 'Choose their role in Projects and Tasks, Sales and CRM and Finance, or No access. Finance starts at No access, so choose a role only for people who should see the money.' },
      { t: 'Departments', x: 'Tick the departments they belong to, then choose Send invitation.' },
      { t: 'The link', x: 'BIZOMAT emails the invitation when its email service is connected, and shows the link either way, so you can send it yourself. It works only for the invited email address, for 14 days.' },
      { t: 'Accepting', x: 'The person opens the link and signs in, or creates an account, with the invited address. Accepting confirms that address.' },
      { t: 'Already in a tool?', x: 'People who joined a tool directly are listed under "In a tool, not in the company". An administrator can add them to the company, keeping their roles.' },
    ],
  },
  {
    id: 'permissions', title: 'Roles and permissions', st: 'live',
    lead: 'Permissions are set for each person, in each tool. The ERP never gives access to anything: it shows what each tool allows.',
    steps: [
      { t: 'Company roles', x: 'Owner, administrator or member. The owner and administrators manage people, departments and tools; the owner alone can transfer or close the company.' },
      { t: 'Tool roles', x: 'Projects and Tasks: Administrator, Project manager, Member or Viewer. Sales and CRM: Administrator, Manager, Sales Executive, Member or Viewer. Finance: Administrator, Accountant, Finance Manager, Contributor or Viewer.' },
      { t: 'Change a role', x: 'In People, change a person\'s role in a tool and it changes in that tool. No access takes them out of it.' },
      { t: 'Finer control', x: 'Sales and CRM and Finance each let owners and administrators adjust what a role may view, create, edit, delete, import and export, in that tool\'s settings.' },
      { t: 'Departments', x: 'A department\'s head can change who is in it, and sees that department\'s figures in every tool. Departments do not carry permissions of their own.' },
      { t: 'Figures on the dashboard', x: 'Each tool\'s figures show only to people whose role in that tool may see them. Everyone else sees a note instead.', st: 'connected' },
      { t: 'CAD computers', x: 'In Products and Engineering, owners and administrators will see the computers of everyone in the company and members their own, once CAD Automation reports to the ERP.', st: 'in-development' },
    ],
    shot: 'erp-engineering',
  },
  {
    id: 'workflows', title: 'Work across the modules', st: 'connected',
    lead: 'These links work when the company runs both tools. Each makes a record in the other tool only when you ask, and checks your role there first.',
    steps: [
      { t: 'Lead to deal', x: 'In Sales and CRM, open a qualified lead and choose Convert: a contact, a company and a deal at once.', st: 'live' },
      { t: 'Deal to quote', x: 'On the deal, choose Start a quote. A draft quote is made in Finance for the deal\'s company, to price in detail there. Its progress shows on the deal.', st: 'connected' },
      { t: 'Won deal to invoice', x: 'When the deal is won, choose Make a draft invoice: one line with the deal\'s title and value. Check the amount, GST and account in Finance before approving. Once per deal, in the same currency.', st: 'connected' },
      { t: 'Deal to project', x: 'On the deal, choose Start a project: a board named after the deal in the company\'s Projects and Tasks. Once per deal.', st: 'connected' },
      { t: 'Activity to task', x: 'An activity\'s menu has Create a project task, which puts it in a project with a link back to the customer.', st: 'connected' },
      { t: 'My Work', x: 'Choose My Work in the rail to see everything assigned to you in Projects and Tasks.', st: 'live' },
    ],
    shot: 'erp-finance',
  },
  {
    id: 'reports', title: 'Read the dashboard and reports', st: 'live',
    steps: [
      { t: 'The dashboard', x: 'A card for each tool: open tasks, overdue, due in 7 days and projects; open deals, pipeline, won in 30 days and follow-ups due; income, expenses, owed to you and you owe, this financial year.', st: 'connected' },
      { t: 'Reports', x: 'Choose Reports in the rail. It has a card for each tool: Sales and CRM reports, Finance and Accounting reports and Projects and Tasks dashboards.' },
      { t: 'Open a report', x: 'Each card opens the report in its own module, with that module\'s permissions. CRM reports export to CSV; Finance reports to CSV and PDF.' },
      { t: 'By department', x: 'Administration, Company overview shows totals for the company and for each department, from every tool.', st: 'connected' },
    ],
    shot: 'erp-reports',
  },
  {
    id: 'integrations', title: 'Link the tools', st: 'connected',
    steps: [
      { t: 'One customer record', x: 'On a CRM company, under In Finance, link it to the Finance contact it is billed as, or create that contact. Its open invoices and what it owes show in the CRM to people whose Finance role sees sales.', st: 'connected' },
      { t: 'Project costs and budget', x: 'In the company area, open Projects and give a project a Finance tracking project and a budget. Income and costs posted to it show against the budget. Tracking needs a Finance role that manages accounting.', st: 'connected' },
      { t: 'Engineering Automation', x: 'The CAD Automation tab of Products and Engineering gives the four set-up steps: sign in to CAD Automation, install it, pair the computer and connect your AI assistant.', st: 'live' },
      { t: 'A supplier and Finance', x: 'On a supplier in Procurement, under Finance, link it to the supplier it is paid as in the company\'s Finance, or create that supplier there. Linking checks your role in Finance; nothing is copied.', st: 'connected' },
      { t: 'CAD computers and sign-in', x: 'Listing the company\'s computers in the ERP, and signing in to CAD Automation with your BIZOMAT account, are being built. Until then the page says so and links to CAD Automation.', st: 'in-development' },
    ],
    shot: 'erp-projects',
  },
  {
    id: 'maintenance', title: 'Look after assets in Maintenance', st: 'live',
    lead: 'Maintenance in the rail opens the company\'s asset register, maintenance requests and work orders. Everyone in a registered company can raise a request; the company\'s owner and administrators give the other maintenance roles.',
    steps: [
      { t: 'Maintenance roles', x: 'In Maintenance, Settings, give each person a role: Administrator, Supervisor, Technician or Requester. The company\'s owner and administrators start as maintenance administrators, everyone else as requesters. Settings also says whether new requests need approval.' },
      { t: 'Register assets', x: 'In Assets, choose New asset. Give it a number and a name, and put it under another asset to build the hierarchy: a site, an area, a line, a machine, a part. Add its make, model, serial number, location, criticality and specifications.' },
      { t: 'Import a register', x: 'Administrators can choose Import CSV. A preview shows each row as ready, a duplicate or an error before anything is saved.' },
      { t: 'Report a fault', x: 'Choose Report a fault at the foot of the rail, on any screen of the ERP. Say what is wrong, pick the asset if you know it, set the priority and add a photo. You can follow the request under My requests.' },
      { t: 'Approve the request', x: 'A supervisor opens the request in Requests, Awaiting approval, and chooses Approve, Decline (with a reason) or Ask for more information.' },
      { t: 'Make a work order', x: 'On the request, choose Make a work order, or attach the request to a work order already open on the same asset. Give the job type, priority, technician, due dates, instructions, safety requirements, tasks and required parts. A request makes one work order, never two.' },
      { t: 'Do the work', x: 'The technician opens the work order, chooses Start timer, ticks the tasks, adds notes and photos, then Stop timer. Time can also be entered by hand. Each line of labour is priced at the person\'s rate, else the trade\'s, when it is recorded.' },
      { t: 'Issue parts', x: 'On the work order, under Parts used, search the maintenance stores and issue a part; return what was not used. Stock comes from Inventory, never goes below zero, and the parts cost shows on the work order. An administrator marks warehouses as maintenance stores in Settings.' },
      { t: 'Record downtime and readings', x: 'Under Downtime, enter when the asset stopped and started again; under Readings, enter a meter or gauge reading. Breakdowns and corrective work with downtime feed the reliability reports.' },
      { t: 'Complete and close', x: 'Choose Complete and say what was done and what was found. A completed work order is locked; a supervisor closes it, or reopens it with a reason that is kept in the history.' },
      { t: 'Find the history', x: 'An asset\'s page shows the assets under it, its site, meters, preventive schedules, prestart checks, outstanding work, open requests, files and every change, with who made it and when. Work order lists can include the assets under the one you choose.' },
      { t: 'Plan preventive maintenance', x: 'In Preventive, choose New schedule: every so many days, weeks or months (from the last completion or on fixed dates), every so many meter units, or when a reading is below or above a limit. Give the tasks, parts, estimate, technician and an inspection. A template covers a whole class of assets. Work orders are made when due, once each; Calendar shows what is coming.' },
      { t: 'Inspect', x: 'In Checklists, make an inspection template of pass or fail, number and text items. On a work order, record each item and complete the inspection; a failure makes one corrective work order or one request, as the template says.' },
      { t: 'Prestart checks and scanning', x: 'On a phone, open Prestart or Scan, scan the asset\'s QR label or type its number, and answer the checklist with Pass and Fail. A failure raises a request; a failed critical item also sets the asset out of service, which is recorded in its history. Print QR labels from an asset\'s page.' },
      { t: 'Reports', x: 'Supervisors and administrators open Reports: reliability (MTBF, MTTR, downtime and availability), backlog, PM compliance, breakdown trends and asset costs, by period and site, each linked to its work orders and downloadable as CSV.' },
    ],
    shot: 'erp-maintenance-preventive',
  },
  {
    id: 'products', title: 'Products, bills of materials and engineering changes', st: 'live',
    lead: 'Products and Engineering in the rail opens the company\'s products, changes, documents and CAD Automation. What each person may do comes from their ERP roles, set in Administration, ERP roles.',
    steps: [
      { t: 'ERP roles', x: 'In Administration, choose ERP roles and give each person one or more: Engineer, Engineering approver, Buyer, Procurement manager, Warehouse manager, Warehouse operator, Production manager, Production operator, Quality manager, Quality inspector, Sales manager, Executive or Viewer. The company\'s owner and administrators are ERP administrators; everyone else is a viewer until given a role.' },
      { t: 'Add a product', x: 'In Products, choose New product. Give its name and type; the number is given for you (PRD-00001) unless you type one. Add its category, unit, costs, price, physical details, lifecycle and effective dates. It starts with revision A as a draft.' },
      { t: 'Add a variant', x: 'On a product, choose New variant and say what sets it apart: size, model, configuration, material, finish or options. The variant is a product of its own.' },
      { t: 'Build the bill of materials', x: 'Open the product\'s Bill of materials and choose Add a line: the component, quantity per one, unit, scrap allowance, reference designators, alternatives and effective dates. A component that would contain the product itself is refused.' },
      { t: 'See every level', x: 'Structure expands each component\'s released bill of materials, with each component\'s available stock. All levels lists every level with extended quantities; give a build quantity to see what is required, what is available and which lines are short. It exports CSV. Cost roll-up gives the material cost of one and lists any missing costs or other currencies.' },
      { t: 'Request a change', x: 'Choose Request a change on a product, or New change request in Changes. An engineering approver takes it under review and approves or rejects it.' },
      { t: 'Change order', x: 'A change order carries a new revision of each product it changes, with the lines of the released revision to edit. Submit it when the revisions are ready: they lock.' },
      { t: 'Approve and release', x: 'An engineering approver who did not draft the change order approves and releases it. Release makes its revisions released and the earlier ones superseded, in one step. Released revisions cannot change.' },
      { t: 'Compare and trace', x: 'Revisions compares any two revisions line by line. Where used lists every product that uses a component.' },
      { t: 'Engineering documents', x: 'In Documents, add a drawing, model, PDF or specification to a product and revision: upload a file, or reference a CAD file on your own computer by its path and configuration. Each new version is kept; an engineering approver approves it.' },
    ],
  },
  {
    id: 'procurement', title: 'Buy in Procurement', st: 'live',
    lead: 'Procurement (in the side menu, or from Operations) has five tabs: Suppliers, Requisitions, Quotations, Purchase orders and Receipts. An ERP administrator sets the purchase order approval limit in Administration, Purchasing, inventory and manufacturing settings.',
    steps: [
      { t: 'Add a supplier', x: 'Choose New supplier. Give the legal name, ABN, contact details, addresses, payment terms, currency and usual lead time. The ABN is checked for its form only; it is not looked up on the register.' },
      { t: 'Approve it', x: 'A procurement manager who did not add the supplier chooses Approve. Put on hold and Block need a reason. A blocked supplier cannot be added to a product.' },
      { t: 'Contacts and documents', x: 'Add the supplier\'s contacts (one is primary) and documents such as certificates.' },
      { t: 'Who supplies a product', x: 'On a product, Suppliers, choose Add a supplier: their part number, price, lead time, minimum order and whether they are preferred.' },
      { t: 'Raise a requisition', x: 'In Requisitions, choose New requisition: what you need (a product or a described item), how many, by when, the department, a budget reference and why. Submit it; a procurement manager who did not raise it approves or rejects it.' },
      { t: 'Ask for quotations', x: 'On an approved requisition, choose Request quotations and tick approved suppliers. Download each supplier\'s PDF, send it from your own email, and choose Record as sent. Sending by email from BIZOMAT with the PDF attached is not built yet.', st: 'live' },
      { t: 'Compare and choose', x: 'Record each quotation: prices per line, lead time, freight, payment terms, validity and the supplier\'s document. The comparison marks the cheapest and the fastest. Choose Select a supplier and give the reason; a procurement manager who did not select it approves the choice.' },
      { t: 'Make the purchase order', x: 'Choose Make the purchase order on the request, Make a purchase order from a requisition, or New purchase order. Each line has a price, discount and tax code (the company\'s Finance tax codes when it runs Finance); the PDF is drawn beside the form as you type.' },
      { t: 'Approval', x: 'Submit the order. At or below the company\'s limit, in its currency, a buyer\'s order is approved at once; above it a procurement manager who did not submit it approves. The order records which rule applied. Then download the PDF, send it, and choose Record as sent.' },
      { t: 'Amend an order', x: 'Choose Amend on an approved, sent or partly received order and give the reason. The earlier version is kept under Earlier versions; the order goes back to draft and through approval again. What was received cannot be taken off.' },
      { t: 'Receive goods', x: 'A warehouse manager or operator chooses Receive goods on the order (or uses the warehouse screen on a phone): how many arrived, how many were damaged or rejected and why, where they are put away, and lots, serial numbers and expiry dates when the product is tracked. Accepted goods go into stock at once. Products that need inspection are flagged on the receipt.' },
      { t: 'The bill', x: 'On a receipt, choose Make a draft bill in Finance. It is made once, for the supplier\'s Finance contact, by someone whose Finance role may create bills. Finance approves and pays it.', st: 'connected' },
      { t: 'Performance', x: 'Each supplier\'s page shows how often its goods arrived on time and in full, and its average lead time, measured from receipts.' },
    ],
    shot: 'erp-procurement',
  },
  {
    id: 'inventory', title: 'Stock and warehouses in Inventory', st: 'live',
    lead: 'Inventory (in the side menu, or from Operations) shows what is where and every movement of it. A warehouse manager sets up warehouses and locations; operators receive, issue, move and count. Every movement is kept and never changed.',
    steps: [
      { t: 'Set up a warehouse', x: 'In Warehouses, choose New warehouse, then add its locations as a tree: store, zone, rack, shelf and bin. Mark quarantine, receiving, dispatch, work-in-progress and finished-goods locations. Print QR labels for every location from the warehouse\'s page.' },
      { t: 'Choose the costing method', x: 'In Administration, Purchasing, inventory and manufacturing settings: weighted average or first in, first out. It is fixed by the first stock movement. Stock never goes below zero unless you allow it there.' },
      { t: 'Product stock settings', x: 'On a product\'s stock page, choose Stock settings: lot numbers, serial numbers, expiry dates, inspection on receipt, reorder point, minimum, maximum and its usual location.' },
      { t: 'Move stock', x: 'On a product\'s stock page, choose Act on a location: issue, move, reserve, quarantine, release, return to the supplier or scrap. Customer returns come in from the same page.' },
      { t: 'The warehouse screen', x: 'Warehouse screen, on a phone: choose Receive, Issue, Move or Count, then type or scan the location and product codes. The camera reads codes where the browser can; typing always works.' },
      { t: 'Adjust and count', x: 'Adjustments correct stock with a reason; above the company\'s threshold a warehouse manager approves. In Counts, open a stocktake or a cycle count, enter what is on the shelves, submit it, and a warehouse manager who did not count approves: the variances post as movements.' },
      { t: 'Value and trace', x: 'Valuation shows quantity, unit cost and value per product. Click a lot or serial number to trace it from its supplier, order and receipt to every later move and where it is now.' },
      { t: 'Finance postings', x: 'Stock value is kept in the ERP. Posting it to Finance\'s ledger is planned: each movement records it as planned, and nothing is posted.', st: 'planned' },
    ],
    shot: 'erp-inventory',
  },
  {
    id: 'manufacturing', title: 'Making products in Manufacturing', st: 'live',
    lead: 'Manufacturing (in the side menu, or from Operations) has five tabs: Orders, Shop floor, Planning, Work centres and Routings. A production manager plans and releases orders; production operators run them on the shop floor; warehouse staff can issue materials and receive finished goods.',
    steps: [
      { t: 'Set up work centres', x: 'In Work centres, choose New work centre: its working days, hours a day, efficiency and how many machines work in parallel, and its rates for labour, machines and overheads (per labour hour or as a percentage). Add its machines; a machine can be linked to its Maintenance asset, and shows as down while that asset has an open breakdown work order.' },
      { t: 'Write the routing', x: 'In Routings, choose New routing for a product and add its operations: number, work centre and machine, set-up and run time, crew, an inspection point, or an outsourced step with its supplier and cost. Each operation waits for the one before it unless you name others, and may overlap them. An engineering approver who did not draft it chooses Release; Copy to a new draft starts the next revision.' },
      { t: 'Draft the order', x: 'In Orders, choose New order: the product (it needs a released bill of materials and routing), quantity, required date, method, priority and the customer or job. The order lists its materials with their scrap allowance, its operations, and its estimated cost by element.' },
      { t: 'Release it', x: 'Choose Release. Shortages are shown, materials are reserved as far as stock allows, and the operations are scheduled over each work centre\'s calendar. Amend a released order with a reason: the version before is kept.' },
      { t: 'Issue materials', x: 'Choose Issue materials and where each comes from: the order\'s reservations are taken first. Two people cannot both take the last unit. Return unused materials at the cost they went out at.' },
      { t: 'Run the shop floor', x: 'On a phone, open Shop floor and choose your work centre. Start a job, run your timer, and report good output, scrap or downtime with a reason. An inspection point needs a pass or fail before the operation completes: record it here, or choose Full inspection to inspect to a plan in Quality, which records it when completed.', st: 'live' },
      { t: 'Receive and close', x: 'Choose Receive finished goods once the last operation reports them good: they enter stock at the order\'s actual cost, never more than the order allows. Complete the order, then Close it: the costs become final and the variances are recorded.' },
      { t: 'Costs and profitability', x: 'Costs compares estimated and actual by element: materials, labour, machine, outsourcing, overheads, scrap and rework. An order made to order for a sales order line also shows its job profitability: the line\'s revenue before tax against the order\'s actual cost.' },
      { t: 'Finance postings', x: 'Production value is not posted to Finance\'s ledger: each posting is recorded as planned.', st: 'planned' },
    ],
    shot: 'erp-shop-floor',
  },
  {
    id: 'planning', title: 'Planning with MRP', st: 'live',
    lead: 'Manufacturing, Planning holds the master production schedule, MRP and the capacity of each work centre. Confirmed sales orders are demand of their own: enter in the schedule only demand that is not on a sales order, such as a forecast.',
    steps: [
      { t: 'Enter demand', x: 'Choose Add demand: a product, quantity, due date and whether it is confirmed or a forecast.' },
      { t: 'Planning data', x: 'For each product, set whether it is made or bought, its lead times, safety stock, minimum order and order multiple. A product supplier\'s lead time comes before the product\'s, and a routing\'s before the product\'s.' },
      { t: 'Run MRP', x: 'Choose Run MRP. It plans level by level through the released bills of materials, from what confirmed sales orders still need, the schedule\'s demand, stock less reservations, open purchase and manufacturing orders, safety stock and reorder points. Each run is kept with its inputs.' },
      { t: 'Act on the suggestions', x: 'Make suggestions become draft orders, buy suggestions requisitions, through the usual approval. Expedite suggestions name an open order needed sooner. Late means it should already have been ordered or started; overdue means it was needed before today.' },
      { t: 'Check capacity', x: 'Capacity shows the hours planned on each work centre each week against the hours it has, and flags overloads.' },
    ],
    shot: 'erp-mrp',
  },
  {
    id: 'quality', title: 'Checking quality', st: 'live',
    lead: 'Quality (in the side menu, or from Operations) has five tabs: Overview, Inspections, Nonconformances, Corrective actions and Inspection plans. Quality inspectors record inspections; a quality manager releases plans, decides dispositions, and approves and closes corrective actions.',
    steps: [
      { t: 'Write an inspection plan', x: 'In Inspection plans, choose New inspection plan: its kind (incoming, first article, in-process, final, supplier or product) and what it applies to: a product, a supplier, or an operation of a routing. Add its characteristics: a dimension or measured value with its unit, nominal and tolerance or minimum and maximum, an attribute (pass or fail) or a visual check, how many samples, and whether a photo is needed. A quality manager chooses Release; New version starts the next one.' },
      { t: 'Mark what needs checking', x: 'On a product\'s stock page, Stock settings, tick inspection on receipt. Its goods receipts then wait on the Quality overview, with inspection points of operations in progress and finished goods of products with a released final plan.' },
      { t: 'Inspect on a phone', x: 'Choose Start inspection. The best released plan for it is used: each characteristic is a card with a box for each sample. Type each reading, or choose Conforms or Does not, add a photo where asked, and choose Save. Each reading is checked against its limits on the server.' },
      { t: 'Complete it', x: 'Choose Complete. The result is worked out from the readings: passed, or failed when any reading is outside its limits. A failed lot can go into quarantine in the same step. A quality manager can accept a failed lot on condition, with the reason, and release it.' },
      { t: 'Raise a nonconformance', x: 'From a failed inspection choose Raise a nonconformance, or raise one by hand: the product, lot, quantity, supplier, order, a Maintenance asset or a process, and how severe it is. Record the containment, and the root cause by five whys or in your own words.' },
      { t: 'Decide the disposition', x: 'A quality manager decides once how much is used as is, reworked, repaired, scrapped, returned to the supplier or regraded, then carries it out: scrap and returns leave stock, a release moves it out of quarantine, rework is written as a note. Two people cannot carry out the same part twice.' },
      { t: 'Corrective and preventive actions', x: 'Choose Propose an action: what to do, who does it and by when. A quality manager who neither proposed it nor is to do it approves it. The responsible person starts it, adds evidence and marks it done; a quality manager checks it worked and closes it. Overdue actions show on the Quality overview.' },
      { t: 'Verify and close', x: 'Once the disposition is carried out and its actions are verified, choose Ready for verification, then Verify and close, saying how the fix was checked.' },
      { t: 'Trace and report', x: 'A lot\'s traceability lists its inspections and nonconformances. Reports has inspection results, rejection rates by product and supplier, supplier defects, the NCR register with its ageing, corrective actions, rework and the cost of poor quality.' },
    ],
    shot: 'erp-quality-inspection',
  },
  {
    id: 'supply-chain', title: 'Selling and shipping in Supply Chain', st: 'live',
    lead: 'Supply Chain (in the side menu, or from Operations) has seven tabs: Overview, Sales orders, Pick and dispatch, Shipments, Delivery schedule, Returns and Carriers. A sales manager takes the order and authorises returns; the warehouse picks, packs and dispatches; a production manager makes to order.',
    steps: [
      { t: 'Give the roles', x: 'In Administration, ERP roles, give Sales manager to the people who take orders. Warehouse managers and operators pick, pack and dispatch; production managers make to order.' },
      { t: 'Add a carrier', x: 'In Carriers, choose New carrier: its name, its services, and the address of its tracking page with {tracking} where the tracking number goes.' },
      { t: 'Make the sales order', x: 'In Sales orders, choose New sales order. The customer is a company of your CRM with the Finance customer it is billed as: nothing is copied. Add the products, quantities, prices, discounts and tax codes, the requested and promised dates, the delivery address, shipping terms and the customer\'s order number. Save and confirm it.' },
      { t: 'From a won deal', x: 'A won deal in the CRM can become a draft sales order for its customer: the deal\'s items become lines where their code matches a product.', st: 'connected' },
      { t: 'Allocate the stock', x: 'On the order, choose Allocate stock. Stock is reserved for each line, soonest expiry first, then the oldest, outside quarantine. What is short is shown.' },
      { t: 'Make to order', x: 'On a line, a production manager chooses Make to order: a manufacturing order for it, linked both ways. When its finished goods are received, allocate them to the line.' },
      { t: 'Amend, cancel or close', x: 'Amend a confirmed order with a reason: the earlier version is kept. Cancelling releases its stock; closing with a reason ends an order before everything is shipped.' },
      { t: 'Plan the shipment', x: 'Choose Plan a shipment: the carrier and service, the ship date, the delivery window, the freight cost and what the customer is charged for it, and whether the customer gets an email when it leaves. It carries everything allocated, with a pick list.' },
      { t: 'Pick, pack and dispatch on a phone', x: 'Open Pick and dispatch. On a shipment, take each line from its location and choose Picked as listed (or type less). Add its packages with weight, size and contents and choose Packed. Type the tracking number and choose Dispatch: the stock leaves once, and its allocation is used up.' },
      { t: 'Confirm the delivery', x: 'On the shipment, add a photo, a document, or the receiver\'s signature drawn on the phone, type who received it and choose Confirm the delivery.' },
      { t: 'The dispatch email', x: 'When it was asked for, the customer gets an email with the tracking link as the shipment leaves, where email is set up on the service. The shipment says what happened to it. The example company sends none.' },
      { t: 'The invoice', x: 'On a dispatched shipment, a sales manager whose Finance role may create invoices chooses Make the draft invoice in Finance: what was shipped at the order\'s prices, with the freight charge. It is made once; Finance\'s approval posts it.', st: 'connected' },
      { t: 'Returns', x: 'On the order, choose Record a return: what comes back and why. A sales manager authorises it; the warehouse receives it into a location (a quarantine location to inspect it first). Link it to a Quality inspection or nonconformance, then make its draft credit note in Finance, once.' },
      { t: 'Schedule, trace and report', x: 'Delivery schedule shows shipments by date with their windows, and orders due with no shipment. A lot\'s traceability now reaches the customer who received it. Reports has open orders, delivery on time and in full, shipments by carrier, freight, returns, sales by product and customer, and job profitability.' },
      { t: 'Finance postings', x: 'The value of stock sold is not posted to Finance\'s ledger: each dispatch records it as planned.', st: 'planned' },
    ],
    shot: 'erp-shipment',
  },
  {
    id: 'planned', title: 'What is not built yet', st: 'planned',
    lead: 'Operations in the rail shows what waits for you, then lists the modules with their status. Procurement, Inventory, Manufacturing, Quality, Supply Chain, Maintenance and the product and engineering records work today; what is not built within them is listed here.',
    steps: [
      { t: 'Not yet in Supply Chain', x: 'Bookings and labels in a carrier\'s own system, landed costs, demand forecasting, allocating backorders automatically as stock arrives, service lines on sales orders, and posting the value of stock sold to Finance\'s ledger.', st: 'planned' },
      { t: 'Not yet in Quality', x: 'Statistical process control, calibration, quality audits, product compliance, and the appraisal and external failure costs of poor quality.', st: 'planned' },
      { t: 'Later in Maintenance', x: 'Workload planning, an AI scheduling assistant that only proposes schedules for a person to approve, offline field work, and posting maintenance costs to Finance.', st: 'planned' },
      { t: 'Not yet in Manufacturing', x: 'Posting production value to Finance\'s ledger, finite scheduling and a drag-and-drop planning board.', st: 'planned' },
    ],
    shot: 'erp-operations',
  },
];

const questions = [
  { q: 'What is the example company?', a: 'Acme Studio (example) is invented data that every account gets, to learn BIZOMAT safely. Only you can see it, it sends no email, and you can remove it in Administration.' },
  { q: 'Do I need to register a company to use the ERP?', a: 'No. Everyone has their own company in their own name. Register a company when you want to add people, departments and roles.' },
  { q: 'Can I belong to more than one company?', a: 'Yes. Register more than one, or accept invitations, and switch between them with the company switcher.' },
  { q: 'Why can I not see a tool\'s figures on the dashboard?', a: 'Your role in that tool does not show them. Ask the company\'s owner or an administrator to change your role in People.' },
  { q: 'Why are no computers listed under Products and Engineering?', a: 'CAD Automation does not report its computers to the ERP yet. Until it does, see your computers in CAD Automation itself.' },
  { q: 'Can I approve my own change order?', a: 'Not in a company of several people: someone else with the Engineering approver role must approve and release it. In your own company, where you are the only person, you may, and the exception is recorded on the change order.' },
  { q: 'Does the ERP keep my SOLIDWORKS files?', a: 'No. An engineering document can reference a CAD file by its path on your own computer; the file stays there. Uploaded PDF, DXF and STEP files are kept as attachments.' },
  { q: 'Who can raise a maintenance request?', a: 'Everyone in a registered company: choose Report a fault at the foot of the rail. In your own company, you are its only person. People who were only shared a tool with the company cannot see its maintenance.' },
  { q: 'Can a technician see every work order?', a: 'No. A technician sees the work orders assigned to them. Supervisors and administrators see them all; a requester sees the work order made from their own request.' },
  { q: 'Can I use Procurement, Inventory, Manufacturing or Supply Chain?', a: 'Yes: requisitions, quotations, purchase orders, goods receipts, warehouses, stock, counts and valuation work today, and so do manufacturing orders, routings, the shop floor, MRP and job costing, and sales orders, shipments, deliveries and returns. Maintenance works today for assets, requests, work orders, preventive maintenance, inspections, prestart checks, spare parts and reliability reports.' },
  { q: 'Can I approve my own corrective action?', a: 'Not in a company of several people: a quality manager who neither proposed it nor is responsible for it approves it, and one who did not carry it out closes it. In your own company, where you are the only person, you may, and the exception is recorded on the action.' },
  { q: 'Can I approve my own purchase order?', a: 'Within the company\'s approval limit a buyer\'s order is approved when submitted. Above it, someone else with the Procurement manager role approves. In your own company, where you are the only person, you may, and the exception is recorded on the order.' },
];

const shots = Object.fromEntries(parts.filter((p) => p.shot).map((p) => [p.id, shot(p.shot!)]));
const schema = [{
  '@type': 'HowTo', name: 'How to use BIZOMAT ERP', url: `${SITE.url}${PAGE}`, description,
  step: parts.map((p, i) => ({ '@type': 'HowToSection', position: i + 1, name: p.title, url: `${SITE.url}${PAGE}#${p.id}`, itemListElement: p.steps.map((s, j) => ({ '@type': 'HowToStep', position: j + 1, name: s.t, text: s.x })) })),
}];
---
<BaseLayout title="BIZOMAT ERP user guide: step by step" description={description} breadcrumbs={crumbs} schema={schema}>
  <section class="pp-hero" aria-labelledby="guide-title">
    <Container>
      <div class="sys-crumbs"><Breadcrumb items={crumbs} /></div>
      <p class="bz-eyebrow">{erp.name} · User guide</p>
      <h1 id="guide-title">How to use BIZOMAT ERP</h1>
      <p class="pp-hero__lead">Step by step, from signing in and choosing a company to roles, linked tools and reports. Buttons and fields are named as they appear in the application.</p>
      <div class="pp-hero__actions">
        <Button href={access.href} variant="accent" rel="noopener" data-cta="erp-guide-start">{access.label}</Button>
        <Button href={erp.url} variant="secondary" data-cta="erp-guide-about">About {erp.name}</Button>
      </div>
      <div class="sys-legend">
        <h2 class="sys-subhead">What the labels mean</h2>
        <p class="sys-note">Each part and some steps carry one of these labels.</p>
        <StatusLegend />
      </div>
      <nav class="sys-toc" aria-label="In this guide">
        <h2 class="sys-toc__title">In this guide</h2>
        <ol>
          {parts.map((p) => <li><a href={`#${p.id}`}>{p.title}</a></li>)}
          <li><a href="#questions">Common questions</a></li>
        </ol>
      </nav>
    </Container>
  </section>

  {parts.map((p, i) => (
    <section class:list={['pp-section', { 'pp-section--tint': i % 2 === 1 }]} id={p.id} aria-labelledby={`${p.id}-title`}>
      <Container class:list={[{ 'pp-split': Boolean(shots[p.id]) }]}>
        <div>
          <p class="bz-eyebrow">Step {i + 1} of {parts.length}</p>
          <h2 id={`${p.id}-title`}>{p.title}</h2>
          <p class="sys-guide-status"><StatusLabel status={p.st} /></p>
          {p.lead && <p class="sys-lead">{p.lead}</p>}
          <ol class="pp-steps sys-guide-steps">
            {p.steps.map((s) => <li><h3>{s.t}{s.st && <> <StatusLabel status={s.st} /></>}</h3><p>{s.x}</p></li>)}
          </ol>
        </div>
        {shots[p.id] && (
          <figure class="pp-shot sys-guide-shot">
            <img src={shots[p.id]!.src} alt={`${shots[p.id]!.title}. ${shots[p.id]!.caption}`} width="1440" height="900" loading="lazy" decoding="async" />
            <figcaption>
              <span>{shots[p.id]!.caption}</span>
              {p.id === 'planned' ? <StatusLabel status="planned" /> : <span class="viz__tag viz__tag--real">Product screen</span>}
            </figcaption>
          </figure>
        )}
      </Container>
    </section>
  ))}

  <section class="pp-section" id="questions" aria-labelledby="questions-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Common questions</p>
        <h2 id="questions-title">Before you ask</h2>
      </div>
      <dl class="sys-faq sys-faq--wide">
        {questions.map((f) => <div><dt>{f.q}</dt><dd>{f.a}</dd></div>)}
      </dl>
      <p class="pp-table-note">Something not covered here? <a href="/contact/">Contact BIZOMAT</a>.</p>
    </Container>
  </section>

  <section class="pp-section pp-section--inverse" aria-labelledby="guide-cta">
    <Container class="pp-band">
      <h2 id="guide-cta">Ready? Your own company is waiting.</h2>
      <div class="pp-band__actions">
        <Button href={access.href} variant="accent" rel="noopener" data-cta="erp-guide-band-start">{access.label}</Button>
        <Button href={erp.url} variant="secondary" data-cta="erp-guide-band-about">About {erp.name}</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
