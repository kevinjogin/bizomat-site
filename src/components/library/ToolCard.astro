---
// WORKOS tool card: title, one-line purpose, primary category and Open tool. The whole card is the link;
// a plain click opens the calculator in place (public/tools/ui.js reads data-tool-id).
interface Props {
  id: string;
  href: string;
  name: string;
  purpose: string;
  category: string;
  topic: string;
  sub: string;
  collection: string;
  /** Search-only metadata (keywords, category, collection) and supporting text (description, uses, users). */
  tags: string;
  body: string;
  hidden?: boolean;
}
const { id, href, name, purpose, category, topic, sub, collection, tags, body, hidden } = Astro.props;
---

<a class="lib-card" href={href} hidden={hidden} data-tool-id={id} data-lib-item data-topic={topic} data-sub={sub} data-collection={collection} data-lib-tags={tags} data-lib-body={body}>
  <span class="lib-card__meta">{category}{collection === 'MAKEOS' && <span class="lib-card__collection"> · MAKEOS</span>}</span>
  <h3 class="lib-card__title" data-lib-title>{name}</h3>
  <p class="lib-card__desc" data-lib-desc>{purpose}</p>
  <span class="lib-card__action">Open tool <span aria-hidden="true">→</span></span>
</a>
