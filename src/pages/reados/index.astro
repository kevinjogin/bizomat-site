---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadOSAnimatedCover from '../../components/ReadOSAnimatedCover.astro';
import MotionVisual from '../../components/MotionVisual.astro';
import LibraryHero from '../../components/library/LibraryHero.astro';
import LibraryBrowser from '../../components/library/LibraryBrowser.astro';
import LibrarySection from '../../components/library/LibrarySection.astro';
import BookCard from '../../components/library/BookCard.astro';
import type { LibraryIconName } from '../../components/library/icons.ts';
import '../../styles/library.css';
import { LIBRARY_GUIDES } from '../../data/library.ts';
import { getChapters } from '../../utils/content.ts';
import { buildReadOSCollections, readosCollectionHref, readosCollectionChapterHref } from '../../utils/reados-collections.ts';
import { getPublications, publicationHref, publicationChapterHref } from '../../utils/publications.ts';
import { tagLabel } from '../../config/taxonomy.ts';

const books = buildReadOSCollections(await getChapters());
const publications = await getPublications();
const categories: { name: string; slug: string; description: string; icon: LibraryIconName }[] = [
  { name: 'Engineering', slug: 'engineering', icon: 'compass', description: 'Design, CAD and practical engineering methods' },
  { name: 'Manufacturing', slug: 'manufacturing', icon: 'factory', description: 'Tooling, factory production and quality' },
  { name: 'Operations', slug: 'operations', icon: 'flow', description: 'Processes, Lean and operational improvement' },
  { name: 'Projects', slug: 'projects', icon: 'flag', description: 'Planning, control, risk and project delivery' },
  { name: 'Technology', slug: 'technology', icon: 'chip', description: 'AI, databases, software and digital systems' },
  { name: 'Business', slug: 'business', icon: 'briefcase', description: 'Finance, strategy, governance and leadership' },
  { name: 'Products', slug: 'products', icon: 'box', description: 'Product development, validation and launches' },
  { name: 'Ideas', slug: 'ideas', icon: 'bulb', description: 'Innovation, exploration and practical concepts' },
];

// One list of READOS books per subject, in the existing order: authored books, featured guides, then collections.
// Each entry carries its chapter titles and links, so search can point straight to a matching chapter.
interface Entry {
  id: string; title: string; summary: string; href: string; startHref: string; tags: string;
  cover: { title: string; category: string; slug: string; motif?: string; publicationLabel?: string };
  chapters: [string, string][];
}
const subjects = categories.map((c) => {
  const entries: Entry[] = [
    ...publications.filter((p) => p.book.data.category === c.name).map(({ book, chapters }): Entry => ({
      id: `publication-${book.id}`, title: book.data.title, summary: book.data.description, href: publicationHref(book.id),
      startHref: publicationChapterHref(book.id, chapters[0].data.chapterSlug),
      tags: [c.name, 'KEVOS original book', book.data.subtitle, ...book.data.tags.map(tagLabel)].join(' '),
      cover: { title: book.data.title, category: book.data.category, slug: book.id, motif: book.data.coverVariant, publicationLabel: 'KEVOS® ORIGINAL BOOK' },
      chapters: chapters.map((ch) => [ch.data.title, publicationChapterHref(book.id, ch.data.chapterSlug)]),
    })),
    ...(c.name === 'Business' ? LIBRARY_GUIDES : []).map((guide): Entry => ({
      id: `guide-${guide.slug}`, title: guide.title, summary: guide.description, href: `/library/${guide.slug}/`,
      startHref: `/library/${guide.slug}/${guide.chapters[0].slug}/`,
      tags: [c.name, guide.category, 'READOS guide', guide.subtitle].join(' '),
      cover: { title: guide.title, category: guide.category, slug: guide.slug, publicationLabel: 'READOS GUIDE' },
      chapters: guide.chapters.map((ch): [string, string] => [ch.title, `/library/${guide.slug}/${ch.slug}/`]),
    })),
    ...books.filter((book) => book.category === c.name).map((book): Entry => ({
      id: `collection-${book.slug}`, title: book.title, summary: book.description, href: readosCollectionHref(book),
      startHref: readosCollectionChapterHref(book, book.chapters[0]),
      tags: [c.name, 'READOS collection'].join(' '),
      cover: { title: book.title, category: book.category, slug: book.slug },
      chapters: book.chapters.map((ch): [string, string] => [ch.data.title, readosCollectionChapterHref(book, ch)]),
    })),
  ];
  return { ...c, entries };
}).filter((s) => s.entries.length > 0);

const PREVIEW = 6;
const total = subjects.reduce((n, s) => n + s.entries.length, 0);
// Chapter titles and links for search, keyed by card id (read by src/scripts/library-browser.ts).
const chapterIndex = JSON.stringify(Object.fromEntries(subjects.flatMap((s) => s.entries.map((e) => [e.id, e.chapters])))).replace(/</g, '\\u003c');
---
<BaseLayout title="READOS books and guides by topic" description="Browse KEVOS® READOS books by Engineering, Manufacturing, Operations, Projects, Technology, Business, Products and Ideas.">
  <LibraryHero
    title="READOS"
    description="Practical books and guides covering engineering, manufacturing, operations, projects and business."
    action="/reados/"
    placeholder="Search READOS books..."
    label="Search READOS books"
    total={total}
    noun="book"
  >
    <MotionVisual page="reados" slot="visual" compact priority />
  </LibraryHero>
  <LibraryBrowser name="READOS" base="/reados/" noun="book" preview={PREVIEW} topics={subjects.map((s) => ({ slug: s.slug, name: s.name, description: s.description, icon: s.icon, count: s.entries.length }))}>
    {subjects.map((s) => (
      <LibrarySection slug={s.slug} name={s.name} description={s.description} count={s.entries.length} noun="book" base="/reados/" preview={PREVIEW}>
        {s.entries.map((e, n) => (
          <BookCard id={e.id} href={e.href} startHref={e.startHref} title={e.title} summary={e.summary} subject={s.name} chapters={e.chapters.length} topic={s.slug} tags={e.tags} chapterTitles={e.chapters.map(([t]) => t).join(' | ')} hidden={n >= PREVIEW}>
            <ReadOSAnimatedCover slot="cover" {...e.cover} chapters={e.chapters.length} compact />
          </BookCard>
        ))}
      </LibrarySection>
    ))}
    <details class="lib-about" slot="after">
      <summary>About READOS</summary>
      <div class="lib-about__body">
        <p>READOS is the KEVOS® knowledge library: structured, practitioner-written guidance on engineering, manufacturing, operations, projects, technology and business, published to help organisations make sound technical and commercial decisions.</p>
        <p>Every title is written to be applied. Read the method in READOS, run the numbers with the matching <a href="/tools/">WORKOS tools</a>, and when your organisation needs the work delivered, <a href="/contact/">discuss your requirements with KEVOS®</a>.</p>
        <p>Search covers titles, summaries, subjects and chapter headings. It does not search the full text of each chapter.</p>
      </div>
    </details>
  </LibraryBrowser>
  <script type="application/json" id="lib-chapters" set:html={chapterIndex}></script>
</BaseLayout>
