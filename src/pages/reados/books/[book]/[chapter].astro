---
import { render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ReadOSChapterReader from '../../../../components/ReadOSChapterReader.astro';
import { getChapters, readingTime, type Chapter } from '../../../../utils/content.ts';
import { buildReadOSBooks, readosBookHref, readosChapterHref, type ReadOSBook } from '../../../../utils/reados.ts';
import { buildReadOSCollections, readosCollectionChapterHref } from '../../../../utils/reados-collections.ts';

export async function getStaticPaths() {
  const chapters = await getChapters();
  const books = buildReadOSBooks(chapters);
  // The edited READOS book is each chapter's main home; these category volumes point search engines to it.
  const edited = new Map(buildReadOSCollections(chapters).flatMap((c) => c.chapters.map((ch) => [ch.id, readosCollectionChapterHref(c, ch)] as const)));
  return books.flatMap(book => book.chapters.map((chapter,index)=>({
    params:{book:book.slug,chapter:chapter.id},
    props:{book,chapter,index,canonical:edited.get(chapter.id)}
  })));
}
interface Props { book:ReadOSBook;chapter:Chapter;index:number;canonical?:string }
const {book,chapter,index,canonical}=Astro.props;
const {Content}=await render(chapter);
const href=readosChapterHref(book,chapter);
---
<BaseLayout title={`${chapter.data.title} (${book.title}) | READOS`} description={chapter.data.description} canonical={canonical}
  breadcrumbs={[{label:'Home',href:'/'},{label:'READOS',href:'/reados/'},{label:book.title,href:readosBookHref(book)},{label:chapter.data.title,href}]}>
  <ReadOSChapterReader bookTitle={book.title} bookHref={readosBookHref(book)} home={{label:'READOS',href:'/reados/'}}
    chapters={book.chapters.map(ch=>({href:readosChapterHref(book,ch),title:ch.data.title}))} index={index}
    title={chapter.data.title} description={chapter.data.description} minutes={readingTime(chapter.body)}>
    <Content />
    <p class="origin" slot="after">Part of <a href={readosBookHref(book)}>{book.title}</a> in KEVOS® READOS.{canonical && <> Also in its <a href={canonical}>edited READOS book</a>.</>}</p>
  </ReadOSChapterReader>
</BaseLayout>
<style>.origin{color:var(--muted);font-size:.83rem;margin:3rem 0 0}</style>
