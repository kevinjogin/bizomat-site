---
// Resources hub (header "Resources" menu): the Library, guides and articles, the Tools, and the learning pathways that
// connect a Library chapter to the tool that applies it (src/data/learning-pathways.json; moved here from the homepage
// in the 5 Nov 2026 redesign so the content is kept).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Container from '../../components/Container.astro';
import { primaryGuide } from '../../data/library.ts';
import { learningPathways } from '../../utils/knowledge.ts';
import { loadWorkosTools } from '../../utils/workos-tools.ts';
import { buildReadosLibrary } from '../../utils/reados-library.ts';
import SearchScan from '../../components/visuals/SearchScan.astro';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Resources', href: '/resources/' }];
const pathways = learningPathways();
const { tools } = loadWorkosTools();
const subjects = await buildReadosLibrary();
const bookTotal = subjects.reduce((n, s) => n + s.entries.length, 0);
const chapterTotal = subjects.reduce((n, s) => n + s.entries.reduce((m, e) => m + e.chapters.length, 0), 0);
const fmt = (n: number) => n.toLocaleString('en-AU');
---
<BaseLayout
  title="Resources: calculators, tools, books and guides"
  description="BIZOMAT Resources: free engineering, manufacturing and business calculators and tools, a technical Library of books in short chapters, guides and learning paths. No account needed."
  breadcrumbs={crumbs}
>
  <Hero eyebrow="BIZOMAT Resources" title="Resources: <em>tools, books and guides.</em>" lead="Calculators and tools that show their method, a Library of technical books in short chapters, and guides that connect understanding to doing. Free, and no account needed.">
    <Breadcrumb items={crumbs} slot="before" />
  </Hero>

  <section class="res" aria-label="Resources">
    <Container>
      <dl class="res-stats">
        <div class="bz-stat"><dt>tools and calculators</dt><dd>{fmt(tools.length)}</dd></div>
        <div class="bz-stat"><dt>Library books</dt><dd>{fmt(bookTotal)}</dd></div>
        <div class="bz-stat"><dt>chapters to read</dt><dd>{fmt(chapterTotal)}</dd></div>
        <div class="bz-stat"><dt>account needed</dt><dd>None</dd></div>
      </dl>
      <ul class="res-grid" role="list">
        <li><a class="res-card" href="/reados/"><span class="res-card__kind">Books</span><h2>Library</h2><p>Technical books organised by subject, each in short chapters with figures and worked numbers.</p><span class="res-card__go">Explore Library <span aria-hidden="true">→</span></span></a></li>
        <li><a class="res-card" href="/library/"><span class="res-card__kind">Guides</span><h2>Guides and articles</h2><p>Longer original guides with clear chapters, worked examples and quick references.</p><span class="res-card__go">Read the guides <span aria-hidden="true">→</span></span></a></li>
        <li><a class="res-card" href="/tools/"><span class="res-card__kind">Tools</span><h2>Tools</h2><p>Engineering, manufacturing and business tools that show their method and run in your browser.</p><span class="res-card__go">Explore Tools <span aria-hidden="true">→</span></span></a></li>
      </ul>

      <div class="res-feature">
        <img src={primaryGuide.cover} alt={`Cover of ${primaryGuide.title}`} width="900" height="1200" loading="lazy" />
        <div>
          <p class="eyebrow">Featured guide</p>
          <h2>{primaryGuide.title}</h2>
          <p>{primaryGuide.description}</p>
          <a href={`/library/${primaryGuide.slug}/`}>Read the guide <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="res-ai">
        <div>
          <p class="eyebrow">AI Search</p>
          <h2>Ask for what you need in plain words</h2>
          <p>BIZOMAT AI Search finds the tool, chapter or guide that fits your question, and says why each one matched. It searches public pages only.</p>
          <a href="/#ai-search">Search with AI <span aria-hidden="true">→</span></a>
        </div>
        <SearchScan id="res-search" />
      </div>
    </Container>
  </section>

  <section class="res-paths" id="pathways" aria-labelledby="pathways-title">
    <Container>
      <p class="eyebrow">Learning pathways</p>
      <h2 id="pathways-title">From a chapter to a tool.</h2>
      <p class="res-paths__intro">Each pathway pairs a Library chapter that explains the method with the tool that applies it.</p>
      <ul class="pathways" role="list">
        {pathways.map((p) => (
          <li class="pathway">
            <h3>{p.title}</h3>
            <p class="pathway__summary">{p.summary}</p>
            <dl>
              <div><dt>Learn</dt><dd><a href={p.learn.href}>{p.learn.title}</a> <span>in {p.learn.book}</span></dd></div>
              <div><dt>Apply</dt><dd><a href={p.apply.href}>{p.apply.name}</a></dd></div>
            </dl>
          </li>
        ))}
      </ul>
    </Container>
  </section>
</BaseLayout>
<style>
  .res-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin: 0 0 1.5rem; }
  .res-stats :global(dd) { order: -1; }
  .res-ai { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; margin-top: clamp(2.5rem, 5vw, 4rem); padding-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--line); }
  .res-ai h2 { margin-top: .6rem; font-size: var(--step-3); }
  .res-ai p:not(.eyebrow) { color: var(--ink-2); }
  .res-ai a { color: var(--accent); font-weight: 600; text-decoration: none; }
  @media (max-width: 860px) { .res-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } .res-ai { grid-template-columns: 1fr; } }
  .res { padding-bottom: var(--space-section); }
  .res-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .res-card { display: flex; flex-direction: column; height: 100%; padding: clamp(1.4rem, 2.5vw, 2rem); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); color: var(--ink); text-decoration: none; box-shadow: var(--shadow-1); transition: border-color .15s var(--ease); }
  .res-card:hover { border-color: var(--line-strong); color: var(--ink); }
  .res-card__kind { color: var(--muted); font-size: .76rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .res-card h2 { margin: 1rem 0 .6rem; font-size: var(--step-2); }
  .res-card p { color: var(--ink-2); font-size: .97rem; }
  .res-card__go { margin-top: auto; padding-top: 1.25rem; color: var(--accent); font-weight: 600; }
  .res-feature { display: grid; grid-template-columns: 120px minmax(0, 1fr); align-items: center; gap: clamp(1.5rem, 3vw, 2.5rem); margin-top: clamp(2.5rem, 5vw, 4rem); padding-top: 2.4rem; border-top: 1px solid var(--line); }
  .res-feature img { width: 100%; height: auto; border-radius: 4px; box-shadow: var(--shadow-1); }
  .res-feature h2 { font-size: var(--step-2); margin: .75rem 0 .75rem; }
  .res-feature p:not(.eyebrow) { color: var(--ink-2); max-width: 60ch; }
  .res-feature a { color: var(--accent); font-weight: 600; text-decoration: none; }
  .res-paths { padding-block: var(--space-section); background: var(--paper-2); border-top: 1px solid var(--line); scroll-margin-top: var(--header-h); }
  .res-paths h2 { margin-top: .9rem; }
  .res-paths__intro { margin: .9rem 0 2rem; max-width: 60ch; font-size: var(--step-1); color: var(--ink-2); }
  .pathways { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; margin: 0; padding: 0; list-style: none; }
  .pathway { display: flex; flex-direction: column; gap: .6rem; min-width: 0; padding: 1.2rem 1.25rem; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
  .pathway h3 { font-size: 1.05rem; }
  .pathway__summary { margin: 0; color: var(--ink-2); font-size: .9rem; }
  .pathway dl { display: grid; gap: .45rem; margin: auto 0 0; padding-top: .6rem; border-top: 1px solid var(--line); }
  .pathway dl div { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: .5rem; font-size: .86rem; }
  .pathway dt { font-size: .72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); padding-top: .1rem; }
  .pathway dd { margin: 0; }
  .pathway dd a { color: var(--accent); font-weight: 600; }
  .pathway dd span { color: var(--muted); }
  @media (max-width: 1000px) { .pathways { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .res-grid, .pathways { grid-template-columns: 1fr; } .res-feature { grid-template-columns: 90px minmax(0, 1fr); } }
</style>
