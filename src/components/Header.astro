---
// Global header, solid (owner, 21 Nov 2026): BIZOMAT wordmark (home), Home, Systems, Resources, About and Contact, AI Search, the theme switch and
// one Sign in (BIZOMAT ERP, where every system opens; owner, 20 Nov 2026). The Systems menu holds two groups side by
// side, the systems and Learn (the Knowledge Centre), with Open BIZOMAT ERP across its foot (owner, 20 Nov 2026).
// Menus are <details> elements, so they open without JavaScript; the script below adds one-at-a-time behaviour,
// Escape and outside-click closing, and the phone/tablet menu button. Without JavaScript the phone layout shows the
// links as a wrapped row instead of a collapsed menu.
import { NAV, AI_SEARCH, SIGN_IN, menuLinks, type NavItem } from '../config/site.ts';
import Container from './Container.astro';
import SiteWordmark from './SiteWordmark.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const internal = (href?: string) => Boolean(href && href.startsWith('/') && !href.includes('#'));
const isCurrent = (href?: string) => internal(href) && path === href;
const inSection = (item: NavItem) =>
  (item.href !== '/' && path.startsWith(item.href)) || menuLinks(item).some((c) => internal(c.href) && path.startsWith(c.href as string));
// A menu's lists: its groups, or its one list without a heading.
const listsOf = (item: NavItem) => item.groups ?? (item.children ? [{ label: '', children: item.children }] : []);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<header class="site-header" data-header>
  <Container class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="BIZOMAT home">
      <SiteWordmark class="site-header__logo" height={21} />
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main" data-site-nav>
      <ul class="site-nav__list">
        {NAV.map((item) => listsOf(item).length ? (
          <li class="site-nav__item">
            <details class="nav-menu" data-nav-menu>
              <summary class:list={['site-nav__link', { 'is-current': inSection(item) }]}>
                {item.short ? <><span class="site-nav__long">{item.label}</span><abbr class="site-nav__short" title={item.label}>{item.short}</abbr></> : item.label}
                <svg class="nav-menu__chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
              </summary>
              <div class:list={['nav-menu__panel', { 'nav-menu__panel--groups': item.groups }]}>
                <div class="nav-menu__groups">
                  {listsOf(item).map((list) => (
                    <div class="nav-menu__group">
                      {list.label && <p class="nav-menu__group-title" id={`nav-${slug(item.label)}-${slug(list.label)}`}>{list.label}</p>}
                      <ul class="nav-menu__list" aria-labelledby={list.label ? `nav-${slug(item.label)}-${slug(list.label)}` : undefined}>
                        {list.children.map((child) => (
                          <li>
                            {child.href ? (
                              <a class="nav-menu__link" href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined} rel={child.external ? 'noopener' : undefined}>
                                <span class="nav-menu__title">{child.label}{child.status && <span class="nav-menu__status">{child.status}</span>}{child.external && <span class="nav-menu__ext" aria-hidden="true">↗</span>}</span>
                                {child.description && <span class="nav-menu__description">{child.description}</span>}
                              </a>
                            ) : (
                              <span class="nav-menu__link nav-menu__link--disabled">
                                <span class="nav-menu__title">{child.label}{child.status && <span class="nav-menu__status">{child.status}</span>}</span>
                                {child.description && <span class="nav-menu__description">{child.description}</span>}
                              </span>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                {item.action && (
                  <a class="nav-menu__action" href={item.action.href} rel={item.action.external ? 'noopener' : undefined}>
                    <span class="nav-menu__title">{item.action.label}{item.action.external && <span class="nav-menu__ext" aria-hidden="true">↗</span>}</span>
                    {item.action.description && <span class="nav-menu__description">{item.action.description}</span>}
                  </a>
                )}
              </div>
            </details>
          </li>
        ) : (
          <li class="site-nav__item">
            <a class:list={['site-nav__link', { 'is-current': inSection(item) }]} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.short ? <><span class="site-nav__long">{item.label}</span><abbr class="site-nav__short" title={item.label}>{item.short}</abbr></> : item.label}</a>
          </li>
        ))}
      </ul>
      <div class="site-nav__mobile-action">
        <a class="site-nav__cta" href={AI_SEARCH.href} data-cta="header-ai-search-mobile">{AI_SEARCH.label}</a>
        <a class="site-nav__signin" href={SIGN_IN.href} rel="noopener" data-cta="header-sign-in-mobile">{SIGN_IN.label}</a>
      </div>
    </nav>

    <div class="site-header__tools">
      <a class="site-header__search" href={AI_SEARCH.href} data-cta="header-ai-search">
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" /><path class="spark" d="M15.5 2.5v3M14 4h3" /></svg>
        <span>{AI_SEARCH.label}</span>
      </a>
      <ThemeToggle />
      <a class="site-header__cta site-header__signin" href={SIGN_IN.href} rel="noopener" data-cta="header-sign-in">{SIGN_IN.label}</a>
      <button class="site-header__toggle" type="button" aria-controls="site-nav" aria-expanded="false" data-nav-toggle hidden>
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-open" d="M4 7h16M4 12h16M4 17h16" /><path class="i-close" d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </Container>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    header.classList.add('has-js');
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 4);
    window.addEventListener('scroll', update, { passive: true });
    update();

    const menus = [...header.querySelectorAll<HTMLDetailsElement>('[data-nav-menu]')];
    const toggle = header.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const closeMenus = (except?: HTMLDetailsElement) => menus.forEach((m) => { if (m !== except) m.open = false; });
    const setPanel = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      toggle?.querySelector('.visually-hidden')?.replaceChildren(open ? 'Close menu' : 'Menu');
      if (!open) closeMenus();
    };
    menus.forEach((m) => {
      // Close the others as soon as a menu is chosen (the toggle event alone arrives a moment later).
      m.querySelector('summary')?.addEventListener('click', () => { if (!m.open) closeMenus(m); });
      m.addEventListener('toggle', () => { if (m.open) closeMenus(m); });
    });
    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener('click', () => setPanel(!header.classList.contains('is-open')));
    }
    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) { closeMenus(); setPanel(false); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = menus.find((m) => m.open);
      if (open) { open.open = false; open.querySelector('summary')?.focus(); return; }
      if (header.classList.contains('is-open')) { setPanel(false); toggle?.focus(); }
    });
    // A menu link to a place on the current page (for example /#ask on the homepage) closes the menus.
    header.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((a) => a.addEventListener('click', () => setPanel(false)));
    // Back to the wide layout: the phone menu state no longer applies.
    matchMedia('(min-width: 1141px)').addEventListener('change', (e) => { if (e.matches) setPanel(false); });
  }
</script>
<style>
  /* Solid (owner, 21 Nov 2026): the page no longer shows through the header as it scrolls under it. */
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--paper); border-bottom: 1px solid transparent; transition: border-color .2s var(--ease); }
  .site-header.is-scrolled, .site-header.is-open { border-bottom-color: var(--line); }
  :global(.site-header__inner) { display: flex; align-items: center; gap: 1.25rem; min-height: var(--header-h); }
  .site-header__brand { display: inline-flex; align-items: center; flex: none; text-decoration: none; border-radius: 4px; }
  .site-header__brand :global(.site-wordmark) { --wordmark-h: 36px; }

  .site-nav { display: flex; align-items: center; flex: 1; min-width: 0; margin-left: 1rem; }
  .site-nav__list { display: flex; align-items: center; gap: .15rem; margin: 0; padding: 0; list-style: none; }
  .site-nav__item { position: relative; }
  .site-nav__link {
    display: inline-flex; align-items: center; gap: .3rem; min-height: 40px; padding: 0 .75rem; border-radius: 8px;
    color: var(--ink-2); font-size: .94rem; font-weight: 540; text-decoration: none; cursor: pointer; list-style: none; user-select: none; white-space: nowrap;
    transition: color .15s var(--ease), background .15s var(--ease);
  }
  .site-nav__link::-webkit-details-marker { display: none; }
  .site-nav__link:hover, details[open] > .site-nav__link { color: var(--ink); background: var(--paper-2); }
  .site-nav__link.is-current { color: var(--ink); }
  .site-nav__link.is-current::after { content: ''; position: absolute; left: .75rem; right: .75rem; bottom: 2px; height: 2px; border-radius: 2px; background: var(--brand-orange); }
  .nav-menu__chevron { flex: none; width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform .15s var(--ease); }
  details[open] .nav-menu__chevron { transform: rotate(180deg); }

  .nav-menu__panel {
    position: absolute; left: 0; top: calc(100% + .5rem); z-index: 60; width: 320px; padding: .45rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow-menu);
  }
  .nav-menu__list { display: grid; gap: .1rem; margin: 0; padding: 0; list-style: none; }
  /* A menu with groups (Systems: the systems and Learn) shows them side by side, each under a small heading, with its
     action across the foot. It never runs past the bottom of the window. */
  .nav-menu__groups { display: grid; gap: .1rem; }
  .nav-menu__panel--groups { width: 600px; max-height: calc(100dvh - var(--header-h) - 1.25rem); overflow-y: auto; overscroll-behavior: contain; }
  .nav-menu__panel--groups .nav-menu__groups { grid-template-columns: 1fr 1fr; gap: 0 .35rem; }
  .nav-menu__panel--groups .nav-menu__group + .nav-menu__group { padding-left: .35rem; border-left: 1px solid var(--line); }
  .nav-menu__panel--groups .nav-menu__link { padding: .5rem .8rem; }
  .nav-menu__group-title { margin: .4rem .8rem .3rem; color: var(--muted); font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .nav-menu__action { display: flex; flex-wrap: wrap; align-items: baseline; gap: .15rem .6rem; margin-top: .35rem; padding: .7rem .8rem; border-top: 1px solid var(--line); border-radius: 0 0 8px 8px; color: var(--ink); text-decoration: none; }
  .nav-menu__action .nav-menu__title { color: var(--accent); }
  .nav-menu__action:hover, .nav-menu__action:focus-visible { background: var(--paper-2); }
  .nav-menu__link { display: grid; gap: .15rem; padding: .7rem .8rem; border-radius: 8px; color: var(--ink); text-decoration: none; }
  a.nav-menu__link:hover, a.nav-menu__link:focus-visible, a.nav-menu__link[aria-current='page'] { background: var(--paper-2); color: var(--ink); }
  .nav-menu__title { display: inline-flex; align-items: center; gap: .45rem; font-size: .94rem; font-weight: 600; }
  .nav-menu__ext { color: var(--muted); font-size: .8rem; font-weight: 400; }
  .nav-menu__description { color: var(--muted); font-size: .84rem; line-height: 1.4; }
  .nav-menu__link--disabled { cursor: default; }
  .nav-menu__link--disabled .nav-menu__title { color: var(--ink-2); }
  .nav-menu__status { padding: .1rem .45rem; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--muted); font-size: .7rem; font-weight: 600; letter-spacing: .04em; }
  /* The last entry of a menu ("All products") is the overview link: set apart by a rule. */
  .nav-menu__list > li:last-child:not(:first-child) .nav-menu__link:not(:has(.nav-menu__description)) { margin-top: .25rem; border-top: 1px solid var(--line); border-radius: 0 0 8px 8px; padding-block: .65rem; color: var(--accent); }
  .nav-menu__list > li:last-child:not(:first-child) .nav-menu__link:not(:has(.nav-menu__description)) .nav-menu__title { font-size: .88rem; }

  .site-header__tools { display: flex; align-items: center; gap: .5rem; margin-left: auto; flex: none; }
  .site-header__cta, .site-nav__cta {
    display: inline-flex; align-items: center; min-height: 38px; padding: 0 1rem; border-radius: 8px;
    background: var(--accent); color: var(--on-accent); font-size: .92rem; font-weight: 600; text-decoration: none; white-space: nowrap;
    transition: background .15s var(--ease);
  }
  .site-header__cta:hover, .site-nav__cta:hover { background: var(--accent-strong); color: var(--on-accent); }
  .site-nav__mobile-action { display: none; }
  .site-header__search { display: inline-flex; align-items: center; gap: .4rem; min-height: 38px; padding: 0 .7rem; border-radius: 8px; color: var(--ink-2); font-size: .92rem; font-weight: 560; text-decoration: none; white-space: nowrap; }
  .site-header__search:hover { color: var(--ink); background: var(--paper-2); }
  .site-header__search svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .site-header__search .spark { stroke: var(--brand-mark); }
  .site-nav__signin { display: block; margin-top: 1rem; padding: .6rem .25rem; color: var(--ink); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--line); }
  .site-header__toggle { display: none; place-items: center; width: 40px; height: 40px; padding: 0; background: transparent; color: var(--ink); border: 1px solid var(--line); border-radius: 8px; }
  .site-header__toggle svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
  .site-header__toggle .i-close { display: none; }
  .is-open .site-header__toggle .i-open { display: none; }
  .is-open .site-header__toggle .i-close { display: inline; }

  /* Tablet, phone and narrow laptop windows (up to 1140 px, where six products and the tools no longer fit in one row):
     the links move into a panel under the header, opened by the menu button. The `js` class is set on
     <html> by the inline script in BaseLayout's head, before the first paint, so the header never renders expanded and
     then collapses when this component's script runs (that was a layout shift of the whole page on slow phones). */
  @media (max-width: 1140px) {
    :global(.js) .site-header .site-header__toggle { display: inline-grid; }
    :global(.js) .site-header .site-nav {
      display: none; position: absolute; left: 0; right: 0; top: 100%; margin: 0;
      max-height: calc(100dvh - var(--header-h)); overflow-y: auto; overscroll-behavior: contain;
      padding: .75rem var(--gutter) 1.5rem; background: var(--paper); border-bottom: 1px solid var(--line); box-shadow: var(--shadow-menu);
    }
    :global(.js) .site-header.is-open .site-nav { display: block; }
    :global(.js) .site-header .site-nav__list { flex-direction: column; align-items: stretch; gap: 0; }
    :global(.js) .site-header .site-nav__item { border-bottom: 1px solid var(--line); }
    :global(.js) .site-header .site-nav__link { display: flex; justify-content: space-between; width: 100%; min-height: 52px; padding: 0 .25rem; font-size: 1.02rem; border-radius: 0; background: none; }
    :global(.js) .site-header .site-nav__link.is-current::after { display: none; }
    :global(.js) .site-header .site-nav__link.is-current { color: var(--accent); }
    :global(.js) .site-header .nav-menu__panel { position: static; width: auto; padding: 0 0 .6rem; border: 0; border-radius: 0; box-shadow: none; background: none; }
    :global(.js) .site-header .nav-menu__link { padding: .6rem .25rem; }
    :global(.js) .site-header .nav-menu__panel--groups { max-height: none; overflow: visible; }
    :global(.js) .site-header .nav-menu__group-title { margin: .6rem .25rem .2rem; }
    :global(.js) .site-header .nav-menu__action { margin-top: .25rem; padding: .6rem .25rem; border-radius: 0; }
    :global(.js) .site-header .site-nav__mobile-action { display: block; margin: 1.25rem 0 0; }
    :global(.js) .site-header .site-nav__cta { width: 100%; justify-content: center; min-height: 48px; font-size: 1rem; }
  }
  @media (max-width: 1300px) and (min-width: 1141px) {
    .site-header__search span { display: none; }
  }
  /* A long label (Customer Relationship Management) shows its short form (CRM) in the desktop row, which has no room for
     it at any width; the full label stays its accessible name and tooltip, heads its menu, and is shown in the phone
     menu. Between 1141 and 1300 px the links sit closer, and AI Search shows its icon only, so that the row stays on one
     line (measured with menus on every product, 13 Nov 2026). */
  .site-nav__short { display: none; text-decoration: none; }
  @media (min-width: 1141px) {
    .site-nav__long { display: none; }
    .site-nav__short { display: inline; }
  }
  @media (max-width: 1300px) and (min-width: 1141px) {
    .site-nav { margin-left: .5rem; }
    .site-nav__list { gap: 0; }
    .site-nav__link { padding: 0 .45rem; gap: .25rem; }
    .site-nav__link.is-current::after { left: .45rem; right: .45rem; }
  }
  @media (max-width: 1140px) {
    :global(.js) .site-header .site-header__search { display: none; }
  }
  @media (max-width: 560px) {
    :global(.js) .site-header .site-header__signin { display: none; }
  }
  /* Tablets and phones: a menu's groups stack in one column (in the menu panel, or in the open menu without JavaScript). */
  @media (max-width: 1140px) {
    .nav-menu__panel--groups { width: min(340px, calc(100vw - 2 * var(--gutter))); }
    .nav-menu__panel--groups .nav-menu__groups { grid-template-columns: 1fr; }
    .nav-menu__panel--groups .nav-menu__group + .nav-menu__group { margin-top: .35rem; padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
  }
  /* Without JavaScript on small screens: keep every link reachable as a wrapped row. */
  @media (max-width: 1140px) {
    :global(html:not(.js)) .site-header :global(.site-header__inner) { flex-wrap: wrap; padding-block: .5rem; }
    :global(html:not(.js)) .site-header .site-nav { order: 3; flex: 1 0 100%; margin: 0; }
    :global(html:not(.js)) .site-header .site-nav__list { flex-wrap: wrap; }
    :global(html:not(.js)) .site-header .site-nav__link { padding: 0 .5rem; font-size: .9rem; }
  }
  @media (prefers-reduced-motion: reduce) { .nav-menu__chevron { transition: none; } }

  /* ui-new:generated begin (scripts/ui/gen-overrides.mjs; do not edit) */
  :global(html[data-ui="new"]) :global(.site-header__inner) { gap: var(--bz-space-5); }
  :global(html[data-ui="new"]) .site-header__brand { border-radius: var(--bz-radius-sm); }
  :global(html[data-ui="new"]) .site-nav { margin-left: var(--bz-space-4); }
  :global(html[data-ui="new"]) .site-nav__link { gap: var(--bz-space-1); padding: 0 var(--bz-space-3); border-radius: var(--bz-radius-md); font-size: var(--bz-text-md); }
  :global(html[data-ui="new"]) .site-nav__link.is-current::after { border-radius: var(--bz-radius-sm); }
  :global(html[data-ui="new"]) .nav-menu__panel { padding: var(--bz-space-2); border-radius: var(--bz-radius-lg); }
  :global(html[data-ui="new"]) .nav-menu__panel--groups .nav-menu__groups { gap: 0 var(--bz-space-1); }
  :global(html[data-ui="new"]) .nav-menu__panel--groups .nav-menu__group + .nav-menu__group { padding-left: var(--bz-space-1); }
  :global(html[data-ui="new"]) .nav-menu__panel--groups .nav-menu__link { padding: var(--bz-space-2) var(--bz-space-3); }
  :global(html[data-ui="new"]) .nav-menu__group-title { margin: var(--bz-space-2) var(--bz-space-3) var(--bz-space-1); font-size: var(--bz-text-xs); }
  :global(html[data-ui="new"]) .nav-menu__action { gap: .15rem var(--bz-space-2); margin-top: var(--bz-space-1); padding: var(--bz-space-3) var(--bz-space-3); border-radius: 0 0 var(--bz-radius-md) var(--bz-radius-md); }
  :global(html[data-ui="new"]) .nav-menu__link { padding: var(--bz-space-3) var(--bz-space-3); border-radius: var(--bz-radius-md); }
  :global(html[data-ui="new"]) .nav-menu__title { gap: var(--bz-space-2); font-size: var(--bz-text-md); }
  :global(html[data-ui="new"]) .nav-menu__ext { font-size: var(--bz-text-sm); }
  :global(html[data-ui="new"]) .nav-menu__description { font-size: var(--bz-text-sm); }
  :global(html[data-ui="new"]) .nav-menu__status { padding: .1rem var(--bz-space-2); border-radius: var(--bz-radius-full); font-size: var(--bz-text-2xs); }
  :global(html[data-ui="new"]) .nav-menu__list > li:last-child:not(:first-child) .nav-menu__link:not(:has(.nav-menu__description)) { margin-top: var(--bz-space-1); border-radius: 0 0 var(--bz-radius-md) var(--bz-radius-md); padding-block: var(--bz-space-3); }
  :global(html[data-ui="new"]) .nav-menu__list > li:last-child:not(:first-child) .nav-menu__link:not(:has(.nav-menu__description)) .nav-menu__title { font-size: var(--bz-text-base); }
  :global(html[data-ui="new"]) .site-header__tools { gap: var(--bz-space-2); }
  :global(html[data-ui="new"]) .site-header__cta, :global(html[data-ui="new"]) .site-nav__cta { padding: 0 var(--bz-space-4); border-radius: var(--bz-radius-md); font-size: var(--bz-text-base); }
  :global(html[data-ui="new"]) .site-header__search { gap: var(--bz-space-2); padding: 0 var(--bz-space-3); border-radius: var(--bz-radius-md); font-size: var(--bz-text-base); }
  :global(html[data-ui="new"]) .site-nav__signin { margin-top: var(--bz-space-4); padding: var(--bz-space-2) var(--bz-space-1); }
  :global(html[data-ui="new"]) .site-header__toggle { border-radius: var(--bz-radius-md); }
