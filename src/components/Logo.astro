---
interface Props {
  class?: string;
  height?: number;
  label?: string;
}
const { class: className, height = 22, label = 'KEVOS' } = Astro.props;
const sizeClass =
  height <= 18
    ? 'logo--hero-small'
    : height <= 24
      ? 'logo--hero'
      : height >= 34
        ? 'logo--large'
        : 'logo--default';
---
<span
  class:list={['logo', sizeClass, className]}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <img
    class="logo__image"
    src="/brand/kevos-logo-light-full.png"
    alt=""
    width="600"
    height="78"
    decoding="async"
  />
</span>

<style>
  .logo {
    --logo-h: 30px;
    display: inline-grid;
    place-items: center;
    max-width: 100%;
    line-height: 0;
    overflow: visible;
    white-space: nowrap;
  }

  .logo--hero-small { --logo-h: 18px; }
  .logo--hero { --logo-h: 22px; }
  .logo--default { --logo-h: 30px; }
  .logo--large { --logo-h: 34px; }

  .logo__image {
    display: block;
    width: auto;
    height: var(--logo-h);
    max-width: 100%;
    object-fit: contain;
    object-position: center;
  }

  :global(:root[data-theme='dark']) .logo__image {
    filter: brightness(0) invert(1);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logo__image {
      filter: brightness(0) invert(1);
    }
  }
</style>
