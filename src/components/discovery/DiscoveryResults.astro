---
// Where discovery answers appear, under the homepage hero. Filled by src/scripts/discovery.ts; hidden until the
// first question, so the page reads exactly as before for visitors who never ask.
---

<section class="dr" id="discover" aria-labelledby="discover-title" hidden data-discover-results>
  <div class="dr__inner">
    <div class="dr__head">
      <h2 id="discover-title" class="dr__title" tabindex="-1">Your resources</h2>
      <button class="dr__new" type="button" data-discover-again>Ask another question</button>
    </div>
    <div class="dr__thread" data-discover-thread></div>
    <p class="dr__note">Recommendations come only from the tools and Library books on this site. Calculations are done by the tools themselves, never by AI.</p>
  </div>
</section>
