---
// Branded, animated BIZOMAT illustrations for projects that have no shareable project image.
// They are illustrative only and are labelled that way wherever they appear (see WorkVisual.astro).
// The product-development scenes are generic mechanisms, never the real product geometry, drawings or CAD.
import type { ProjectIllustration } from '../data/projects.ts';
interface Props { kind: ProjectIllustration; uid: string; tag?: string; final?: string }
const { kind, uid, tag, final = 'RELEASED' } = Astro.props;
const train = (count: number, gap: number, start: number) => Array.from({ length: count }, (_, i) => start + i * gap);

/** Product-development scenes share one frame: a product label and the development stages along the bottom. */
const PRODUCT_TAGS: Partial<Record<ProjectIllustration, string>> = {
  chainwinder: 'CHAINWINDER · AWNING SASH',
  'program-lanes': 'R5.6 · PROGRAM DEPENDENCIES',
  'housing-retool': 'DN400 · HOUSING RETOOL',
  'base-retool': 'DN450 · BASE RETOOL',
  'side-latch': 'AWS 756 · SIDE LATCH KEEPER',
  keeper: 'DS209 NZ · KEEPER',
  roller: 'DR2210 · ROLLER ON TRACK',
  'push-lock': 'ASCEND · DH PUSH LOCK',
  'lift-handle': 'BRADNAM’S · DH LIFT HANDLE',
  'lock-handle': 'DS776 / DS777 · MKII HANDLE',
};
const isProduct = kind in PRODUCT_TAGS;
const productTag = tag ?? PRODUCT_TAGS[kind];
const stages = ['CONCEPT', 'PROTOTYPE', 'TOOLING', 'OFF-TOOL', final];
const stageX = [44, 102, 160, 218, 276];
/** x position on the 2021–2024 program timeline. */
const at = (year: number, month: number) => +(92 + (year - 2021 + (month - 1) / 12) * 52).toFixed(1);
---
{kind === 'jig-stripping' && (
  <svg class="wi" viewBox="0 0 320 200" aria-hidden="true" focusable="false">
    <text class="wi-tag" x="28" y="22">DUAL-LINE ULTRASONIC STRIPPING</text>
    <path class="wi-grey" d="M10 172H310" />
    <path class="wi-orange wi-thick" d="M24 172V36M296 172V36M16 36H304" />
    <path class="wi-grey" d="M24 58l16-22M296 58l-16-22" />
    <rect class="wi-well" x="40" y="100" width="100" height="70" />
    <rect class="wi-well" x="180" y="100" width="100" height="70" />
    {[90, 230].map((cx) => [0, 1, 2].map((k) => <path class:list={['wi-orange', 'wi-wave', `wi-d${k + 1}`]} d={`M${cx - 22 + k * 4} ${164 - k * 10}Q${cx} ${154 - k * 10} ${cx + 22 - k * 4} ${164 - k * 10}`} />))}
    <g class="wi-hoist-x">
      <rect class="wi-fill-orange" x="80" y="31" width="20" height="10" rx="1.5" />
      <rect class="wi-fill-orange wi-cable" x="89.4" y="41" width="1.2" height="31" />
      <g class="wi-hoist-y">
        <path class="wi-orange" d="M70 72H110M76 72V80M86 72V80M94 72V80M104 72V80" />
        {[76, 86, 94, 104].map((x) => <rect class="wi-part" x={x - 3} y="80" width="6" height="11" rx="1" />)}
      </g>
    </g>
    <rect class="wi-liquid" x="40" y="116" width="100" height="54" />
    <rect class="wi-liquid" x="180" y="116" width="100" height="54" />
    <path class="wi-orange wi-thin" d="M40 116q12.5-3 25 0t25 0 25 0 25 0M180 116q12.5-3 25 0t25 0 25 0 25 0" />
    <rect class="wi-orange" x="40" y="100" width="100" height="70" />
    <rect class="wi-orange" x="180" y="100" width="100" height="70" />
    <text class="wi-label" x="90" y="164" text-anchor="middle">STRIP</text>
    <text class="wi-label" x="230" y="164" text-anchor="middle">WASH</text>
    <path class="wi-orange wi-flow" d="M58 170V184H124" />
    <path class="wi-grey wi-flow wi-flow--slow" d="M262 170V184H196" />
    <circle class="wi-orange" cx="130" cy="184" r="6" />
    <circle class="wi-grey" cx="190" cy="184" r="6" />
    <text class="wi-label" x="160" y="197" text-anchor="middle">SEGREGATED TRANSFER</text>
  </svg>
)}

{kind === 'louvre-lines' && (
  <svg class="wi" viewBox="0 0 320 200" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id={`${uid}-belt-a`}><rect x="24" y="56" width="226" height="22" /></clipPath>
      <clipPath id={`${uid}-belt-b`}><rect x="24" y="124" width="226" height="22" /></clipPath>
    </defs>
    <text class="wi-tag" x="28" y="22">SINGLE + DOUBLE LOUVRE LINES</text>
    <path class="wi-orange wi-flow" d="M248 40V32H36V40" />
    <path class="wi-orange" d="M32 36l4 5 4-5" />
    <text class="wi-label" x="142" y="45" text-anchor="middle">KANBAN PULL</text>
    {[78, 146].map((y) => <rect class="wi-belt" x="24" y={y} width="226" height="8" />)}
    <g clip-path={`url(#${uid}-belt-a)`}>
      <g class="wi-convey">{train(10, 28, -28).map((x) => <path class="wi-fill-orange" d={`M${x} 78l6-12h4l-6 12z`} />)}</g>
    </g>
    <g clip-path={`url(#${uid}-belt-b)`}>
      <g class="wi-convey wi-convey--slow">{train(10, 28, -28).map((x) => <path class="wi-fill-orange" d={`M${x} 146l6-12h4l-6 12zM${x + 8} 146l6-12h4l-6 12z`} />)}</g>
    </g>
    {[50, 105, 160, 215].map((x, i) => [52, 120].map((y) => (
      <g>
        <rect class="wi-station" x={x - 16} y={y} width="32" height="24" />
        <text class="wi-label" x={x} y={y + 15} text-anchor="middle">{`0${i + 1}`}</text>
      </g>
    )))}
    <text class="wi-label" x="26" y="100">SINGLE</text>
    <text class="wi-label" x="26" y="168">DOUBLE</text>
    <rect class="wi-orange" x="262" y="44" width="44" height="124" />
    {Array.from({ length: 9 }, (_, i) => <rect class:list={['wi-fill-orange', 'wi-slat', `wi-d${(i % 3) + 1}`]} x="266" y={54 + i * 12.5} width="36" height="3" />)}
    <path class="wi-orange wi-check" d="M252 186l5 5 10-11" />
    <text class="wi-label" x="270" y="190">QUALIFIED</text>
  </svg>
)}

{kind === 'powdercoat' && (
  <svg class="wi" viewBox="0 0 320 200" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id={`${uid}-raw`}><rect x="0" y="36" width="140" height="70" /></clipPath>
      <clipPath id={`${uid}-coated`}><rect x="140" y="36" width="180" height="70" /></clipPath>
    </defs>
    <text class="wi-tag" x="28" y="22">CUSTOM-COLOUR POWDERCOAT</text>
    <path class="wi-orange wi-thick" d="M0 40H320" />
    <g clip-path={`url(#${uid}-raw)`}>
      <g class="wi-convey wi-convey--hang">{train(10, 40, -40).map((x) => <g><path class="wi-grey" d={`M${x} 40V70M${x - 8} 70H${x + 8}`} /><rect class="wi-part" x={x - 7} y="72" width="14" height="22" rx="2" /></g>)}</g>
    </g>
    <g clip-path={`url(#${uid}-coated)`}>
      <g class="wi-convey wi-convey--hang">{train(10, 40, -40).map((x) => <g><path class="wi-grey" d={`M${x} 40V70M${x - 8} 70H${x + 8}`} /><rect class="wi-fill-orange" x={x - 7} y="72" width="14" height="22" rx="2" /></g>)}</g>
    </g>
    <rect class="wi-booth" x="108" y="52" width="64" height="100" />
    <path class="wi-grey" d="M114 120h12l4-4h6v10h-6l-4-4" />
    {[0, 1, 2, 3, 4, 5].map((k) => <circle class:list={['wi-fill-orange', 'wi-spray', `wi-d${(k % 3) + 1}`]} cx="138" cy={112 + (k % 3) * 8} r={1.4 + (k % 2) * 0.6} />)}
    <rect class="wi-oven" x="204" y="52" width="80" height="100" />
    {[222, 244, 266].map((x, k) => <path class:list={['wi-orange', 'wi-heat', `wi-d${k + 1}`]} d={`M${x} 140q-5-8 0-16t0-16 0-16`} />)}
    <text class="wi-label" x="140" y="164" text-anchor="middle">SPRAY</text>
    <text class="wi-label" x="244" y="164" text-anchor="middle">CURE</text>
    <path class="wi-grey" d="M10 172H310" />
    {['#14b8a6', '#e6f4f2', '#9c9385', '#0f766e'].map((colour, i) => <rect class="wi-swatch" x={24 + i * 13} y="180" width="10" height="10" fill={colour} />)}
    <text class="wi-label" x="80" y="189">CUSTOM COLOUR</text>
  </svg>
)}

{isProduct && (
  <svg class="wi" viewBox="0 0 320 200" aria-hidden="true" focusable="false">
    <text class="wi-tag" x="28" y="22">{productTag}</text>

    {kind === 'chainwinder' && (
      <>
        <text class="wi-label" x="36" y="48">INSIDE</text>
        <text class="wi-label" x="248" y="48">OUTSIDE</text>
        <path class="wi-grey" d="M118 40H174M146 40V160M154 40V160M96 160H186" />
        <g class="wi-sash">
          <rect class="wi-station" x="155" y="44" width="7" height="112" />
          <path class="wi-orange" d="M155 44h7v112h-7z" />
          <path class="wi-grey wi-thin" d="M158.5 52V148" />
        </g>
        <circle class="wi-fill-orange" cx="158.5" cy="44" r="2.2" />
        <path class="wi-chain" d="M146 150H204.2" />
        <rect class="wi-station" x="112" y="144" width="34" height="16" />
        <path class="wi-orange" d="M112 144h34v16h-34z" />
        <g class="wi-crank">
          <path class="wi-orange" d="M104 152V139" />
          <circle class="wi-fill-orange" cx="104" cy="137" r="2.6" />
        </g>
        <circle class="wi-part" cx="104" cy="152" r="3.4" />
        <text class="wi-label" x="129" y="172" text-anchor="middle">WINDER</text>
        <text class="wi-label" x="196" y="172" text-anchor="middle">CHAIN</text>
        <text class="wi-label" x="222" y="100">SASH</text>
      </>
    )}

    {kind === 'program-lanes' && (
      <>
        {[2021, 2022, 2023, 2024].map((y) => (
          <g>
            <path class="wi-grey wi-thin" d={`M${at(y, 1)} 42V146`} />
            <text class="wi-label" x={at(y, 1) + 2} y="40">{y}</text>
          </g>
        ))}
        <text class="wi-label" x="28" y="63">DS1W</text>
        <text class="wi-label" x="28" y="99">BRADNAM’S</text>
        <text class="wi-label wi-label--on" x="28" y="135">R5.6</text>
        <path class="wi-grey wi-hold" d={`M92 60H${at(2021, 12)}`} />
        <path class="wi-grey wi-lane" d={`M${at(2021, 12)} 60H${at(2024, 6)}`} />
        <path class="wi-grey wi-lane" d={`M${at(2021, 12)} 96H${at(2022, 9)}`} />
        <path class="wi-grey wi-hold" d={`M${at(2022, 9)} 96H${at(2024, 8)}`} />
        <path class="wi-grey wi-lane" d={`M${at(2024, 8)} 96H${at(2024, 11)}`} />
        <path class="wi-orange wi-lane" d={`M${at(2021, 6)} 132H${at(2023, 6)}`} />
        <path class="wi-orange wi-hold" d={`M${at(2023, 6)} 132H${at(2024, 8)}`} />
        <path class="wi-orange wi-lane" d={`M${at(2024, 8)} 132H${at(2024, 11)}`} />
        <text class="wi-label" x="222" y="89">HOLD</text>
        <text class="wi-label" x="236" y="125">HOLD</text>
        <path class="wi-orange wi-release" d={`M${at(2024, 8)} 48V146`} />
        <path class="wi-orange wi-check" d={`M${at(2024, 11) - 4} 86l3 3 6-7`} />
        <path class="wi-orange wi-check" d={`M${at(2024, 11) - 4} 122l3 3 6-7`} />
        <text class="wi-label" x="300" y="160" text-anchor="end">DS1W COVER CHANGES DONE</text>
        <g class="wi-playhead"><path class="wi-orange wi-thin" d="M92 44V150" /></g>
      </>
    )}

    {(kind === 'housing-retool' || kind === 'base-retool') && (
      <>
        <text class="wi-label" x="92" y="42" text-anchor="middle">NEW TOOL</text>
        <g class="wi-mould-l">
          <rect class="wi-station" x="40" y="48" width="44" height="76" />
          <path class="wi-orange" d="M84 70h-6v32h6" />
        </g>
        <g class="wi-mould-r">
          <rect class="wi-station" x="100" y="48" width="44" height="76" />
          <path class="wi-orange" d="M100 70h6v32h-6" />
        </g>
        <g class="wi-eject">
          {kind === 'housing-retool' ? (
            <g>
              <rect class="wi-fill-orange" x="85" y="72" width="14" height="28" rx="3" />
              <circle class="wi-hole" cx="92" cy="80" r="2.4" />
              <circle class="wi-hole" cx="92" cy="92" r="2.4" />
            </g>
          ) : (
            <g>
              <rect class="wi-fill-orange" x="80" y="88" width="24" height="10" rx="1.5" />
              <circle class="wi-hole" cx="86" cy="93" r="1.8" />
              <circle class="wi-hole" cx="98" cy="93" r="1.8" />
            </g>
          )}
        </g>
        <path class="wi-grey" d="M72 136v16h40v-16" />
        <text class="wi-label" x="92" y="166" text-anchor="middle">GAUGE</text>
        <path class="wi-orange wi-flow" d="M152 96H194" />
        <path class="wi-orange" d="M190 92l5 4-5 4" />
        <circle class="wi-grey wi-dash" cx="246" cy="98" r="36" />
        <g class="wi-orbit"><circle class="wi-fill-orange" cx="246" cy="62" r="3.6" /></g>
        <text class="wi-label wi-label--on" x="246" y="101" text-anchor="middle">OTS LOOP</text>
        <text class="wi-label" x="246" y="53" text-anchor="middle">TEST</text>
        <text class="wi-label" x="288" y="140" text-anchor="middle">CORRECT</text>
        <text class="wi-label" x="204" y="140" text-anchor="middle">RE-TEST</text>
        <path class="wi-orange wi-check" d="M240 156l5 5 10-11" />
      </>
    )}

    {kind === 'side-latch' && (
      <>
        <rect class="wi-station" x="236" y="36" width="24" height="132" />
        <text class="wi-label" x="248" y="162" text-anchor="middle">FRAME</text>
        <path class="wi-orange" d="M236 88H220V124H236M236 98H226V114H236" />
        <text class="wi-label" x="228" y="82" text-anchor="middle">KEEPER</text>
        <g class="wi-slide">
          <rect class="wi-station" x="60" y="40" width="146" height="124" />
          <path class="wi-grey wi-thin" d="M72 52H178V152H72zM90 70l24-14M90 92l50-30" />
          <text class="wi-label" x="96" y="132">SASH</text>
          <g class="wi-bolt"><rect class="wi-fill-orange" x="196" y="101" width="10" height="10" /></g>
          <path class="wi-orange" d="M186 94h20v24h-20z" />
          <text class="wi-label" x="184" y="88">LATCH</text>
        </g>
        <g class="wi-engage">
          <path class="wi-orange" d="M266 74l4 4 8-9" />
          <text class="wi-label" x="264" y="92">ENGAGED</text>
        </g>
      </>
    )}

    {kind === 'keeper' && (
      <>
        <rect class="wi-station" x="60" y="40" width="116" height="124" />
        <text class="wi-label" x="72" y="56">STILE</text>
        <path class="wi-orange" d="M146 70h30v54h-30z" />
        <text class="wi-label" x="150" y="64">LOCK</text>
        <g class="wi-hook"><path class="wi-orange wi-thick" d="M172 108H206V98" /></g>
        <circle class="wi-fill-orange" cx="172" cy="108" r="2.6" />
        <rect class="wi-station" x="222" y="40" width="74" height="124" />
        <text class="wi-label" x="259" y="156" text-anchor="middle">FRAME</text>
        <path class="wi-orange" d="M222 78H200V102M200 114V138H222M200 114h14V88h-8" />
        <text class="wi-label" x="211" y="150" text-anchor="middle">KEEPER</text>
        <g class="wi-align"><path class="wi-grey" d="M236 92v30M232 96l4-4 4 4M232 118l4 4 4-4" /></g>
        <text class="wi-label" x="244" y="110">ALIGN</text>
      </>
    )}

    {kind === 'roller' && (
      <>
        <rect class="wi-belt" x="24" y="150" width="272" height="4" />
        <path class="wi-grey" d="M18 160H302" />
        <text class="wi-label" x="276" y="172" text-anchor="middle">TRACK</text>
        <g class="wi-panel">
          <rect class="wi-station" x="70" y="40" width="160" height="86" />
          <path class="wi-grey wi-thin" d="M80 48H220V116H80zM98 66l22-12M98 86l48-28" />
          <text class="wi-label" x="150" y="60" text-anchor="middle">SLIDING PANEL</text>
          <path class="wi-orange" d="M150 72v26M146 93l4 5 4-5" />
          <text class="wi-label" x="157" y="88">LOAD</text>
          {[104, 196].map((cx) => (
            <g>
              <path class="wi-orange" d={`M${cx - 16} 126h32v8h-32z`} />
              <g class="wi-wheel">
                <circle class="wi-part" cx={cx} cy="140" r="10" />
                <path class="wi-orange" d={`M${cx - 10} 140h20M${cx} 130v20`} />
              </g>
            </g>
          ))}
          <text class="wi-label" x="150" y="146" text-anchor="middle">ROLLERS</text>
        </g>
      </>
    )}

    {kind === 'push-lock' && (
      <>
        <text class="wi-label" x="26" y="70">UPPER SASH</text>
        <text class="wi-label" x="26" y="140">LOWER SASH</text>
        <rect class="wi-station" x="96" y="32" width="128" height="136" />
        <rect class="wi-well" x="102" y="36" width="116" height="66" />
        <path class="wi-grey" d="M102 36h116v66H102zM110 44h100v50H110z" />
        <path class="wi-orange" d="M128 92h16v6h-16z" />
        <g class="wi-lower">
          <rect class="wi-well" x="102" y="98" width="116" height="66" />
          <path class="wi-grey" d="M102 98h116v66H102zM110 108h100v48H110z" />
          <rect class="wi-belt" x="102" y="98" width="116" height="8" />
          <path class="wi-orange" d="M148 90h26v8h-26z" />
          <g class="wi-button"><rect class="wi-fill-orange" x="166" y="85" width="6" height="5" /></g>
          <g class="wi-latch"><rect class="wi-fill-orange" x="150" y="92" width="10" height="4" /></g>
        </g>
        <text class="wi-label" x="230" y="100">MEETING RAIL</text>
        <g class="wi-engage">
          <path class="wi-orange" d="M232 122l4 4 8-9" />
          <text class="wi-label" x="248" y="127">LOCKED</text>
        </g>
      </>
    )}

    {kind === 'lift-handle' && (
      <>
        <rect class="wi-station" x="40" y="32" width="100" height="136" />
        <path class="wi-grey" d="M46 36h88v66H46zM54 44h72v50H54z" />
        <g class="wi-lift">
          <rect class="wi-well" x="46" y="98" width="88" height="66" />
          <path class="wi-grey" d="M46 98h88v66H46zM54 106h72v46H54z" />
          <path class="wi-orange wi-thick" d="M80 155v5h20v-5" />
        </g>
        <path class="wi-orange" d="M154 150V112M149 118l5-6 5 6" />
        <text class="wi-label" x="160" y="134">LIFT</text>
        <path class="wi-grey wi-thin wi-dash" d="M140 150L194 118" />
        <circle class="wi-grey wi-dash" cx="240" cy="98" r="50" />
        <rect class="wi-belt" x="206" y="70" width="68" height="22" />
        <text class="wi-label" x="240" y="84" text-anchor="middle">SASH RAIL</text>
        <path class="wi-orange wi-thick" d="M220 92v14q0 12 12 12h16q12 0 12-12V92" />
        <g class="wi-grip"><path class="wi-orange" d="M240 96v16M236 100l4-4 4 4M236 108l4 4 4-4" /></g>
        <text class="wi-label" x="240" y="134" text-anchor="middle">GRIP</text>
      </>
    )}

    {kind === 'lock-handle' && (
      <>
        <rect class="wi-station" x="70" y="44" width="32" height="112" rx="10" />
        <path class="wi-orange" d="M80 44h12q10 0 10 10v92q0 10-10 10H80q-10 0-10-10V54q0-10 10-10z" />
        <circle class="wi-part" cx="86" cy="130" r="5" />
        <path class="wi-grey" d="M86 127v6" />
        <path class="wi-grey wi-dash" d="M86 80h48v7H86zM134 83.5m-6 0a6 6 0 1 0 12 0a6 6 0 1 0-12 0" transform="rotate(-16 86 83)" />
        <g class="wi-lever"><path class="wi-fill-orange" d="M86 77h66q8 0 8 6t-8 6H86z" /></g>
        <circle class="wi-part" cx="86" cy="83" r="6" />
        <path class="wi-orange" d="M30 168h12" />
        <text class="wi-label wi-label--on" x="46" y="171">MKII</text>
        <path class="wi-grey wi-dash" d="M74 168h12" />
        <text class="wi-label" x="90" y="171">EARLIER</text>
        <text class="wi-label" x="246" y="66" text-anchor="middle">EXPLODED VIEW</text>
        <path class="wi-grey wi-dash" d="M188 108H306" />
        <path class="wi-orange" d="M194 82h6v52h-6z" />
        <g class="wi-asm-b"><path class="wi-orange" d="M214 108l3-6 3 12 3-12 3 12 3-12 3 6" /></g>
        <g class="wi-asm-c"><rect class="wi-part" x="244" y="100" width="12" height="16" /></g>
        <g class="wi-asm-d"><path class="wi-orange" d="M266 103h30q5 0 5 5t-5 5h-30z" /></g>
      </>
    )}

    <path class="wi-grey" d="M44 180H276" />
    <path class="wi-orange wi-stage-fill" d="M44 180H276" />
    {stageX.map((x, i) => (
      <g>
        <circle class="wi-part" cx={x} cy="180" r="2.6" />
        <text class="wi-label" x={x} y="195" text-anchor="middle">{stages[i]}</text>
