---
// KEVOS® homepage: the technology and knowledge platform, led by KEVOS® Tools (tools) and the Library (books).
// Every count, topic, tool and book here is read from the KEVOS® register and the Library at build time.
// Services, pricing, the assessment and Factory Fix live on their own pages (/services/, /assessment/, /factory-fix/).
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ServiceMap from '../components/ServiceMap.astro';
import LibraryIcon from '../components/library/LibraryIcon.astro';
import DiscoveryBox from '../components/discovery/DiscoveryBox.astro';
import DiscoveryExamples from '../components/discovery/DiscoveryExamples.astro';
import DiscoveryResults from '../components/discovery/DiscoveryResults.astro';
import '../styles/discovery.css';
import '../styles/library.css';
import { SITE } from '../config/site.ts';
import { HOME_DISCOVERY_EXAMPLES, HOME_FEATURED_BOOKS, HOME_FEATURED_TOOLS, HOME_ORBIT } from '../config/home.ts';
import { loadWorkosTools, hasStandaloneGuide, toolPageHref, toolAppHref } from '../utils/workos-tools.ts';
import { groupToolsByTopic, subcategoryLabel } from '../utils/workos-topics.ts';
import { buildReadosLibrary } from '../utils/reados-library.ts';
import { knowledgeGraph, learningPathways } from '../utils/knowledge.ts';

const { tools, guides } = loadWorkosTools();
const topics = groupToolsByTopic(tools, 0);
const subjects = await buildReadosLibrary();
const entries = subjects.flatMap((s) => s.entries.map((e) => ({ ...e, subject: s })));
const bookTotal = entries.length;
const chapterTotal = entries.reduce((n, e) => n + e.chapters.length, 0);
const pathways = learningPathways();
const connections = knowledgeGraph().live.length;
const fmt = (n: number) => n.toLocaleString('en-AU');

const pick = <T,>(ids: string[], find: (id: string) => T | undefined, kind: string) => ids.map((id) => {
  const item = find(id);
  if (!item) throw new Error(`src/config/home.ts: no ${kind} "${id}"`);
  return item;
});
const featuredTools = pick(HOME_FEATURED_TOOLS, (id) => tools.find((t) => t.id === id), 'KEVOS® tool');
const featuredBooks = pick(HOME_FEATURED_BOOKS, (id) => entries.find((e) => e.id === id), 'Library book');
// Cards link to a tool's own page where one exists, as on /tools/.
const toolHref = (id: string) => (hasStandaloneGuide(guides[id]) ? toolPageHref(id) : toolAppHref(id));

const orbit = HOME_ORBIT.map((o) => {
  const topic = topics.find((t) => t.slug === o.topic);
  const subject = subjects.find((s) => s.slug === o.subject);
  if (!topic || !subject) throw new Error(`src/config/home.ts: orbit node ${o.verb} names an unknown topic or subject`);
  return { verb: o.verb, label: topic.name.replace('&', '&amp;'), tags: `${fmt(topic.items.length)} tools · ${fmt(subject.entries.length)} books`, href: `/tools/?topic=${topic.slug}` };
});

const description = 'Describe a problem and KEVOS® finds the engineering and business tools and the technical books in its Library that help you solve it.';
const schema = [{
  '@type': 'WebPage', '@id': `${SITE.url}/#webpage`, url: `${SITE.url}/`, name: SITE.title, description, inLanguage: SITE.locale,
  isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': `${SITE.url}/#organization` },
  hasPart: [
    { '@type': 'CollectionPage', name: 'KEVOS® Tools', url: `${SITE.url}/tools/`, description: 'Practical engineering, manufacturing and business tools.' },
    { '@type': 'CollectionPage', name: 'KEVOS® Library', url: `${SITE.url}/reados/`, description: 'Technical books, engineering references and structured learning resources.' },
  ],
}];
---
<BaseLayout description={description} imageAlt="KEVOS®: practical tools and a library of technical knowledge" schema={schema}>
  <section class="home-hero" id="overview" aria-labelledby="home-title">
    <Container class="home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow">Tools · Library</p>
        <h1 id="home-title">What would you like to <em>solve</em> today?</h1>
        <p class="home-hero__lead">Describe a problem, ask a question or tell us what you're trying to achieve. KEVOS® will help you discover the right tools, knowledge and practical solutions.</p>
        <DiscoveryBox />
      </div>
      <div class="home-hero__visual"><ServiceMap variant="platform" nodes={orbit} /></div>
      <div class="home-hero__wide">
        <DiscoveryExamples suggestions={HOME_DISCOVERY_EXAMPLES} />
        <div class="home-hero__actions">
          <Button href="/tools/" arrow data-cta="hero-workos">Explore Tools</Button>
          <Button href="/reados/" variant="secondary" data-cta="hero-reados">Explore Library</Button>
        </div>
        <dl class="home-stats">
          <div><dt>Tools</dt><dd>{fmt(tools.length)}</dd></div>
          <div><dt>Books</dt><dd>{fmt(bookTotal)}</dd></div>
          <div><dt>Chapters</dt><dd>{fmt(chapterTotal)}</dd></div>
        </dl>
      </div>
    </Container>
  </section>

  <DiscoveryResults />

  <section class="home-libs" aria-label="Tools and Library">
    <Container class="home-libs__grid">
      <div class="home-lib" id="workos" aria-labelledby="workos-title">
        <p class="home-lib__index"><span>01</span> Tools</p>
        <h2 id="workos-title">Practical tools for <em>better decisions.</em></h2>
        <p class="home-lib__intro">Engineering, manufacturing and business calculators that show their method and run in your browser. No account needed.</p>
        <h3 class="home-label" id="workos-topics">Browse by topic</h3>
        <ul class="lib-topic-grid home-lib__topics" role="list" aria-labelledby="workos-topics">
          {topics.map((t) => (
            <li>
              <a class="lib-topic" href={`/tools/?topic=${t.slug}`}>
                <span class="lib-topic__icon"><LibraryIcon name={t.icon} /></span>
                <span class="lib-topic__text"><span class="lib-topic__name">{t.name}</span></span>
                <span class="lib-topic__count" aria-label={`${fmt(t.items.length)} tools`}>{fmt(t.items.length)}</span>
              </a>
            </li>
          ))}
        </ul>
        <h3 class="home-label" id="workos-featured">Featured tools</h3>
        <ul class="home-lib__featured" role="list" aria-labelledby="workos-featured">
          {featuredTools.map((t) => <li><a href={toolHref(t.id)}>{t.name}</a><span>{subcategoryLabel(t.category)}</span></li>)}
        </ul>
        <div class="home-lib__cta"><Button href="/tools/" arrow data-cta="home-workos">All {fmt(tools.length)} tools</Button></div>
      </div>

      <div class="home-lib" id="reados" aria-labelledby="reados-title">
        <p class="home-lib__index"><span>02</span> Library</p>
        <h2 id="reados-title">Knowledge worth <em>applying.</em></h2>
        <p class="home-lib__intro">Technical books in short chapters with figures and worked numbers, many linked to the tools that apply them.</p>
        <h3 class="home-label" id="reados-subjects">Browse by subject</h3>
        <ul class="lib-topic-grid home-lib__topics" role="list" aria-labelledby="reados-subjects">
          {subjects.map((sub) => (
            <li>
              <a class="lib-topic" href={`/reados/?topic=${sub.slug}`}>
                <span class="lib-topic__icon"><LibraryIcon name={sub.icon} /></span>
                <span class="lib-topic__text"><span class="lib-topic__name">{sub.name}</span></span>
                <span class="lib-topic__count" aria-label={`${fmt(sub.entries.length)} books`}>{fmt(sub.entries.length)}</span>
              </a>
            </li>
          ))}
        </ul>
        <h3 class="home-label" id="reados-featured">Featured books</h3>
        <ul class="home-lib__featured" role="list" aria-labelledby="reados-featured">
          {featuredBooks.map((e) => <li><a href={e.href}>{e.title}</a><span>{e.subject.name} · {fmt(e.chapters.length)} chapters</span></li>)}
        </ul>
        <div class="home-lib__cta"><Button href="/reados/" arrow data-cta="home-reados">All {fmt(bookTotal)} books</Button></div>
      </div>
    </Container>
  </section>

  <Section index="03" label="The connected KEVOS® ecosystem" id="connected" labelledby="connected-title">
    <div class="section-head">
      <div>
        <h2 id="connected-title">Learn. Apply. <em>Improve.</em></h2>
        <p class="section-intro">KEVOS® connects technical knowledge with practical tools, helping people move from understanding a concept to applying it in real-world situations.</p>
      </div>
    </div>
    <ol class="flow">
      <li class="flow__step">
        <p class="flow__name"><a href="/reados/">Library</a></p>
        <h3>Learn and understand</h3>
        <p>Read the method, the reasoning and the worked numbers behind a decision.</p>
      </li>
      <li class="flow__step">
        <p class="flow__name"><a href="/tools/">Tools</a></p>
        <h3>Calculate, analyse and apply</h3>
        <p>Enter your own figures, check the result and keep a report of what you decided.</p>
      </li>
      <li class="flow__step">
        <p class="flow__name"><a href="#overview">Ask KEVOS®</a></p>
        <h3>Describe it, discover it</h3>
        <p>Describe a problem in your own words at the top of this page. KEVOS® suggests the tools and Library chapters that fit; the tools do the calculating.</p>
      </li>
    </ol>
    <p class="flow__note">Today, {fmt(connections)} reviewed links connect Library books and chapters with the tools that apply them. These learning pathways take you from a chapter to a tool:</p>
    <ul class="pathways">
      {pathways.map((p) => (
        <li class="pathway">
          <h3>{p.title}</h3>
          <p class="pathway__summary">{p.summary}</p>
          <dl>
            <div><dt>Learn</dt><dd><a href={p.learn.href}>{p.learn.title}</a> <span>in {p.learn.book}</span></dd></div>
            <div><dt>Apply</dt><dd><a href={p.apply.href}>{p.apply.name}</a></dd></div>
          </dl>
        </li>
      ))}
    </ul>
  </Section>

  <Section index="04" label="About KEVOS®" tone="alt" id="about" labelledby="about-title">
    <div class="about-intro">
      <h2 id="about-title">Building a connected ecosystem.</h2>
      <div>
        <p class="section-intro">KEVOS® is building a connected technology, engineering and knowledge ecosystem, bringing together practical digital tools and structured technical resources.</p>
        <p class="about-intro__link"><a href="/about/">About KEVOS® <span aria-hidden="true">→</span></a></p>
        <p class="fineprint">KEVOS® also takes on defined engineering assignments. See <a href="/services/">services</a> or <a href="/contact/">get in touch</a>.</p>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  // "What would you like to solve today?": discovery over the KEVOS® and the Library catalogue.
  import '../scripts/discovery.ts';
</script>

<script>
  // The homepage used to hold the services, pricing and proof of work. Old links to those sections
  // (for example /#pricing or /#case-<id>) are sent to the page that now holds them.
  const moved: Record<string, string> = {
    services: '/services/', 'engineering-cad': '/services/#engineering-cad', manufacturing: '/services/#manufacturing',
    operations: '/services/#operations', 'project-support': '/services/#project-support', pricing: '/services/#pricing',
    assessment: '/assessment/', 'factory-fix': '/factory-fix/', 'how-it-works': '/how-it-works/', industries: '/industries/',
    work: '/about/#work', resources: '#workos',
  };
  const forward = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const to = id.startsWith('case-') ? `/about/#${id}` : moved[id];
    if (to) location.replace(to);
  };
  forward();
  window.addEventListener('hashchange', forward);
</script>

<style>
  :global(#overview), :global(#connected), :global(#about) { scroll-margin-top:calc(var(--header-h) + 4.2rem); }
  .home-hero{padding:clamp(3rem,6vw,6.5rem) 0}
  :global(.home-hero__inner){display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.8fr);gap:1.5rem 4rem;align-items:start}
  .home-hero__copy h1{margin:1rem 0 1rem;max-width:15ch;font-size:clamp(2.1rem,4.4vw,4.4rem);line-height:1.04}
  .home-hero__lead{font-size:var(--step-1);line-height:1.5;max-width:48ch;color:var(--ink-2)}
  .home-hero__actions{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:2rem}
  .home-hero__visual{min-width:0;padding-top:.35rem}
  .home-hero__wide{grid-column:1/-1;min-width:0}
  .home-stats{display:flex;flex-wrap:wrap;gap:1rem 2.5rem;margin:2.2rem 0 0;padding-top:1.2rem;border-top:1px solid var(--line)}
  .home-stats dt{font-size:.78rem;font-weight:560;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .home-stats dd{margin:.3rem 0 0;font-family:var(--font-display);font-size:clamp(1.5rem,2.6vw,2.1rem);font-weight:700;line-height:1.1;color:var(--ink);font-variant-numeric:tabular-nums}
  .section-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:2.2rem}
  .section-head h2{max-width:28ch}
  .section-intro{margin:1rem 0 0;max-width:74ch;font-size:var(--step-1);color:var(--ink-2)}
  .fineprint{color:var(--muted);font-size:.88rem;margin:1.75rem 0 0}
  .fineprint a{color:var(--ink-2)}
  .home-libs{padding:0 0 clamp(3rem,6vw,5rem)}
  :global(.home-libs__grid){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}
  .home-lib{display:flex;flex-direction:column;min-width:0;padding:clamp(1.3rem,2.5vw,2rem);border:1px solid var(--line);border-radius:16px;background:var(--surface);scroll-margin-top:calc(var(--header-h) + 1rem)}
  .home-lib__index{margin:0 0 .8rem;font-size:.78rem;font-weight:650;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-2)}
  .home-lib__index span{color:var(--accent);margin-right:.4rem;font-variant-numeric:tabular-nums}
  .home-lib h2{font-size:clamp(1.5rem,2.4vw,2.1rem);max-width:20ch}
  .home-lib__intro{margin:.75rem 0 0;color:var(--ink-2);max-width:56ch}
  .home-lib__topics{gap:.5rem;grid-template-columns:1fr}
  @media(min-width:1180px){.home-lib__topics{grid-template-columns:repeat(2,minmax(0,1fr))}}
  .home-lib__topics .lib-topic{padding:.6rem .75rem}
  .home-lib__featured{display:grid;gap:.1rem;margin:0;padding:0;list-style:none}
  .home-lib__featured li{display:flex;flex-direction:column;gap:.1rem;padding:.55rem 0;border-bottom:1px solid var(--line)}
  .home-lib__featured a{color:var(--ink);font-weight:600;text-decoration:none}
  .home-lib__featured a:hover{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
  .home-lib__featured span{color:var(--muted);font-size:.85rem}
  .home-lib__cta{margin-top:auto;padding-top:1.5rem}
  .home-label{margin:1.75rem 0 .75rem;font-family:var(--font-sans);font-size:.78rem;font-weight:560;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .flow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin:0;padding:0;list-style:none;border:1px solid var(--line);background:var(--line);counter-reset:flow}
  .flow__step{background:var(--surface);padding:clamp(1.3rem,3vw,2rem);counter-increment:flow}
  .flow__step::before{content:counter(flow,decimal-leading-zero);display:block;margin-bottom:.9rem;color:var(--accent);font-size:.85rem;font-variant-numeric:tabular-nums}
  .flow__name{margin:0 0 .4rem;font-size:.78rem;font-weight:650;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
  .flow__name a{color:inherit;text-decoration:none}
  .flow__name a:hover{text-decoration:underline;text-underline-offset:3px}
  .flow__step h3{font-size:var(--step-1)}
  .flow__step p:not(.flow__name){margin:.6rem 0 0;color:var(--ink-2);font-size:.94rem}
  .flow__note{margin:2.5rem 0 1.2rem;max-width:74ch;color:var(--ink-2)}
  .pathways{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin:0;padding:0;list-style:none}
  .pathway{display:flex;flex-direction:column;gap:.6rem;min-width:0;padding:1.2rem 1.25rem;border:1px solid var(--line);border-left:3px solid var(--accent);background:var(--surface)}
  .pathway h3{font-size:1.05rem}
  .pathway__summary{margin:0;color:var(--ink-2);font-size:.9rem}
  .pathway dl{display:grid;gap:.45rem;margin:auto 0 0;padding-top:.6rem;border-top:1px solid var(--line)}
  .pathway dl div{display:grid;grid-template-columns:4rem minmax(0,1fr);gap:.5rem;font-size:.86rem}
  .pathway dt{font-size:.72rem;font-weight:650;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding-top:.1rem}
  .pathway dd{margin:0}
  .pathway dd a{color:var(--accent);font-weight:600}
  .pathway dd span{color:var(--muted)}
  .about-intro{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1fr);gap:1.5rem 5rem}
  .about-intro h2{max-width:16ch}
  .about-intro .section-intro{margin-top:0}
  .about-intro__link{margin:1.25rem 0 0}
  .about-intro__link a{color:var(--accent);font-weight:600;text-decoration:none}
  .about-intro__link a:hover{text-decoration:underline;text-underline-offset:3px}
  @media(max-width:1050px){.pathways{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){:global(.home-libs__grid){grid-template-columns:1fr}}
  @media(max-width:860px){:global(.home-hero__inner){grid-template-columns:1fr}.home-hero__visual{max-width:580px;order:3;padding-top:0}.home-hero__wide{order:2}.about-intro{grid-template-columns:1fr}.flow{grid-template-columns:1fr}}
  @media(max-width:640px){.pathways{grid-template-columns:1fr}.section-head{flex-direction:column;align-items:flex-start}}
</style>
