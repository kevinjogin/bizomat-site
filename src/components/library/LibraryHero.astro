---
// Shared compact header for the KEVOS® and the Library libraries: one title, one sentence, the library's compact
// brand animation (the "visual" slot) beside them, then the library search across the full width.
import Container from '../Container.astro';
import LibrarySearch from './LibrarySearch.astro';

interface Props {
  title: string;
  description: string;
  /** Page path the search form submits to (works without JavaScript through ?q=). */
  action: string;
  placeholder: string;
  label: string;
  /** Total items, e.g. 504, and the noun used for counts ("tool" / "book"). */
  total: number;
  noun: string;
}
const { title, description, ...search } = Astro.props;
const visual = Astro.slots.has('visual');
---

<header class="lib-hero" data-library-intro>
  <Container>
    <div class:list={['lib-hero__top', visual && 'lib-hero__top--visual']}>
      <div class="lib-hero__copy">
        <h1 class="lib-hero__title">{title}</h1>
        <p class="lib-hero__lead">{description}</p>
      </div>
      {visual && <div class="lib-hero__visual"><slot name="visual" /></div>}
    </div>
    <LibrarySearch {...search} />
  </Container>
</header>
