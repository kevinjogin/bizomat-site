---
// The learning-path box in the Tools and Library page headers, in place of the header animation: the same question
// box and pipeline as the homepage (src/scripts/discovery.ts), with examples for the page. The course appears in
// DiscoveryResults, which the page places under its header.
import DiscoveryBox from './DiscoveryBox.astro';
import DiscoveryExamples from './DiscoveryExamples.astro';

interface Props {
  title: string;
  lead: string;
  placeholder: string;
  examples: readonly string[];
}
const { title, lead, placeholder, examples } = Astro.props;
---

<section class="lp" aria-labelledby="lp-title">
  <div class="lp__intro">
    <p class="lp__eyebrow">BIZOMAT AI · learning path</p>
    <h2 class="lp__title" id="lp-title">{title}</h2>
    <p class="lp__lead">{lead}</p>
    <DiscoveryExamples suggestions={examples} />
  </div>
  <div class="lp__ask"><DiscoveryBox size="compact" placeholder={placeholder} /></div>
</section>
