---
// Global footer: the BIZOMAT identity, then Products, Resources, Company and Applications, then the legal links that
// every page carries (Privacy, Terms, Disclaimer). The registered trade mark is the former name's (KEVOS®); the
// footer never calls BIZOMAT a registered trade mark.
import { FOOTER_NAV, SITE } from '../config/site.ts';
import Container from './Container.astro';
import SiteWordmark from './SiteWordmark.astro';

const year = new Date().getFullYear();
const tm = SITE.formerName;
---

<footer class="site-footer" id="site-footer">
  <Container>
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo" aria-label="BIZOMAT home"><SiteWordmark height={28} label="" /></a>
        <p class="site-footer__tagline">{SITE.tagline}</p>
        <p>{SITE.statement}</p>
        <a class="site-footer__cta" href="/contact/" data-cta="footer-contact">Tell us what you need <span aria-hidden="true">→</span></a>
      </div>
      <nav class="site-footer__col" aria-label="Products">
        <h2 class="site-footer__heading">Products</h2>
        <ul>{FOOTER_NAV.products.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </nav>
      <nav class="site-footer__col" aria-label="Resources">
        <h2 class="site-footer__heading">Resources</h2>
        <ul>{FOOTER_NAV.resources.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </nav>
      <nav class="site-footer__col" aria-label="Company">
        <h2 class="site-footer__heading">Company</h2>
        <ul>
          {FOOTER_NAV.company.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href={SITE.booking.url} target="_blank" rel="noopener noreferrer" data-cta="footer-meeting">{SITE.booking.label}<span class="visually-hidden"> (opens in a new tab)</span></a></li>
          {SITE.email && <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>}
          {SITE.social.map((s) => <li><a href={s.href} rel="noopener me">{s.label}</a></li>)}
        </ul>
      </nav>
      <nav class="site-footer__col" aria-label="Applications">
        <h2 class="site-footer__heading">Applications</h2>
        <ul>{FOOTER_NAV.apps.map((item) => <li><a href={item.href} rel="noopener">{item.label}</a></li>)}</ul>
      </nav>
    </div>
    <div class="site-footer__base">
      <p>© {year} {SITE.name}. All rights reserved. {SITE.name} was formerly {tm.name}; {tm.name}® is a registered Australian trade mark, <a href={tm.record} target="_blank" rel="noopener noreferrer" data-cta="footer-trade-mark">No. {tm.tradeMark}<span class="visually-hidden"> (IP Australia record, opens in a new tab)</span></a>.</p>
      <nav aria-label="Legal">
        <ul class="site-footer__legal">{FOOTER_NAV.legal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </nav>
    </div>
  </Container>
</footer>

<style>
  .site-footer { margin-top: auto; border-top: 1px solid var(--line); background: var(--paper); padding-top: clamp(3rem, 5vw, 4.5rem); font-size: .93rem; }
  .site-footer__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) repeat(4, minmax(0, 1fr)); gap: 2.5rem 2rem; padding-bottom: clamp(2.5rem, 4vw, 3.5rem); }
  .site-footer__logo { display: inline-flex; align-items: center; text-decoration: none; border-radius: 4px; }
  .site-footer__logo :global(.site-wordmark) { --wordmark-h: 22px; }
  .site-footer__tagline { margin: 1rem 0 0; font-weight: 600; color: var(--ink); }
  .site-footer__brand p:not(.site-footer__tagline) { max-width: 32ch; margin: .4rem 0 0; color: var(--muted); }
  .site-footer__cta { display: inline-flex; gap: .4rem; margin-top: 1.1rem; font-weight: 600; color: var(--accent); text-decoration: none; }
  .site-footer__cta:hover { color: var(--accent-strong); text-decoration: underline; text-underline-offset: 3px; }
  .site-footer__heading { margin-bottom: .9rem; font-family: var(--font-mono) !important; font-size: .74rem !important; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .site-footer ul { display: grid; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .site-footer ul a { color: var(--ink-2); text-decoration: none; }
  .site-footer ul a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .site-footer__base { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .75rem 1.5rem; padding-block: 1.25rem 1.75rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .84rem; }
  .site-footer__base p { margin: 0; max-width: 80ch; }
  .site-footer__base a { color: inherit; }
  .site-footer .site-footer__legal { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
  .site-footer .site-footer__legal a { color: var(--muted); }
  @media (max-width: 1000px) {
    .site-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer__brand { grid-column: 1 / -1; }
  }
</style>
