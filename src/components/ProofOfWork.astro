---
// Proof of work on the About page: keyword search, featured and sector filters, and expandable case studies
// (data in src/data/projects.ts). Without JavaScript every project is listed; with it, the list starts at nine
// and can be searched and filtered. Each case study opens from a deep link: /engine-room/#case-<id>
// (old /#case-<id> links are forwarded there by the homepage).
import WorkVisual from './WorkVisual.astro';
import { NAMED_ORGANISATIONS, PROJECTS, PROJECT_SECTORS, PROJECT_SERVICES, projectEnquiryHref } from '../data/projects.ts';
const INITIAL = 9;
const sectorLabel = Object.fromEntries(PROJECT_SECTORS.map((s) => [s.id, s.label]));
const sectors = PROJECT_SECTORS.map((s) => ({ ...s, count: PROJECTS.filter((p) => p.sector === s.id).length }));
const featured = PROJECTS.filter((p) => p.featured).length;
const byId = Object.fromEntries(PROJECTS.map((p) => [p.id, p]));
const finalStage = (p: (typeof PROJECTS)[number]) => (p.status === 'approved' ? 'APPROVED' : 'RELEASED');
const earliest = PROJECTS[PROJECTS.length - 1].years.slice(0, 4);
const latest = PROJECTS[0].years.slice(-4);
---
<div class="work" data-work data-initial={INITIAL}>
  <dl class="work-stats">
    <div><dt>Project records</dt><dd>{PROJECTS.length}</dd></div>
    <div><dt>Years</dt><dd>{earliest}–{latest}</dd></div>
    <div><dt>Sectors</dt><dd>{sectors.length}</dd></div>
    <div><dt>Named organisations</dt><dd>{NAMED_ORGANISATIONS.length}</dd></div>
  </dl>

  <div class="work-tools" data-work-tools hidden>
    <div class="work-search">
      <label for="work-search">Search the work</label>
      <input id="work-search" type="search" data-work-search placeholder="Try chainwinder, tooling, conveyor or Orica" autocomplete="off" spellcheck="false" />
    </div>
    <div class="work-filter" role="group" aria-label="Filter projects">
      <button type="button" data-sector="all" data-label="projects" aria-pressed="true">All <span>{PROJECTS.length}</span></button>
      <button type="button" data-sector="featured" data-label="featured projects" aria-pressed="false">Featured <span>{featured}</span></button>
      {sectors.map((s) => <button type="button" data-sector={s.id} data-label={s.label.toLowerCase()} aria-pressed="false">{s.label} <span>{s.count}</span></button>)}
    </div>
  </div>
  <p class="work-count" aria-live="polite" data-work-count></p>
  <p class="work-empty" data-work-empty hidden>No projects match that search. Try a broader word, or <button type="button" data-work-clear>show every project</button>.</p>

  <ol class="work-list">
    {PROJECTS.map((p) => (
      <li class="work-card" id={`case-${p.id}`} data-sector={p.sector} data-featured={p.featured ? 'true' : undefined}>
        <article aria-labelledby={`work-${p.id}`}>
          <div class="work-card__top">
            <WorkVisual id={p.id} alt={p.visualAlt} illustration={p.illustration} tag={p.illustrationTag} final={finalStage(p)} />
            <div class="work-card__lead">
              <p class="work-card__meta"><span>{p.years}</span><span>{sectorLabel[p.sector]}</span>{p.featured && <span class="work-card__featured">Featured</span>}</p>
              <h3 id={`work-${p.id}`}>{p.headline}</h3>
              <p class="work-card__name">{p.title}</p>
              <p class="work-card__client">{p.client}{p.customer && ` · ${p.customer}`} <span>· {p.industry}{p.location && ` · ${p.location}`}</span></p>
              <p class="work-card__summary">{p.summary}</p>
            </div>
            <div class="work-card__aside">
              <p class:list={['work-status', `work-status--${p.status}`]}>{p.statusLabel}</p>
              <ul class="work-card__skills" aria-label="Capabilities">{p.skills.map((s) => <li>{s}</li>)}</ul>
            </div>
          </div>

          <details class="case">
            <summary><span>Read the full case study</span></summary>
            <div class="case__body">
              <div class="case__main">
                <WorkVisual id={p.id} alt={p.visualAlt} size="large" illustration={p.illustration} tag={p.illustrationTag} final={finalStage(p)} caption={p.illustration ? 'Illustrative BIZOMAT visual. Not an image of the actual project, product, drawing or CAD.' : 'Image from the published project record, converted to BIZOMAT colours.'} />
                {p.employment && <p class="case__context"><span>Employment context</span>{p.employment}</p>}
                <section>
                  <h4>The brief</h4>
                  <p>{p.brief}</p>
                </section>
                {p.objectives && (
                  <section>
                    <h4>Objectives</h4>
                    <ul class="case__list">{p.objectives.map((o) => <li>{o}</li>)}</ul>
                  </section>
                )}
                {p.contribution && (
                  <section>
                    <h4>Role in the work</h4>
                    <p>As {p.role}, the founder’s contribution covered:</p>
                    <ul class="case__list case__list--tick">{p.contribution.map((c) => <li>{c}</li>)}</ul>
                  </section>
                )}
                <section>
                  <h4>How the work was approached</h4>
                  <ol class="case__steps">
                    {p.approach.map((step) => <li><strong>{step.title}</strong><p>{step.text}</p></li>)}
                  </ol>
                </section>
                {p.path && (
                  <section>
                    <h4>Development path</h4>
                    <ol class="case__path">
                      {p.path.map((stage) => <li><span class="case__path-period">{stage.period}</span><strong>{stage.stage}</strong><p>{stage.detail}</p></li>)}
                    </ol>
                  </section>
                )}
                {p.challenges && (
                  <section>
                    <h4>Challenges and how they were handled</h4>
                    <dl class="case__challenges">
                      {p.challenges.map((c) => <div><dt>{c.problem}</dt><dd>{c.response}</dd></div>)}
                    </dl>
                  </section>
                )}
                {p.validation && (
                  <section>
                    <h4>Testing and validation</h4>
                    <p>{p.validation}</p>
                  </section>
                )}
                <section>
                  <h4>Outcome</h4>
                  <p>{p.outcome}</p>
                  <p class="case__value"><span>Why it matters</span>{p.value}</p>
                  {p.note && <p class="case__note">{p.note}</p>}
                </section>
              </div>
              <aside class="case__side" aria-label={`${p.title}: client snapshot and deliverables`}>
                <section class="case__panel">
                  <h4>Client snapshot</h4>
                  <dl class="case__facts">
                    <div><dt>Organisation</dt><dd>{p.client}</dd></div>
                    {p.customer && <div><dt>Product for</dt><dd>{p.customer}</dd></div>}
                    <div><dt>About</dt><dd>{p.about}</dd></div>
                    <div><dt>Industry</dt><dd>{p.industry}</dd></div>
                    {p.location && <div><dt>Location</dt><dd>{p.location}</dd></div>}
                    <div><dt>Period</dt><dd>{p.years}</dd></div>
                    <div><dt>Role</dt><dd>{p.role}</dd></div>
                    <div><dt>Status</dt><dd>{p.statusLabel}</dd></div>
                  </dl>
                </section>
                <section class="case__panel">
                  <h4>Deliverables</h4>
                  <ul class="case__deliverables">{p.deliverables.map((d) => <li>{d}</li>)}</ul>
                </section>
                {p.related && (
                  <section class="case__panel">
                    <h4>Related case studies</h4>
                    <ul class="case__related">{p.related.map((id) => <li><a href={`#case-${id}`}>{byId[id].title}</a> <span>{byId[id].years}</span></li>)}</ul>
                  </section>
                )}
                <section class="case__panel case__cta">
                  <h4>Planning something similar?</h4>
                  <p>This experience is directly relevant if:</p>
                  <ul>{p.relevantIf.map((r) => <li>{r}</li>)}</ul>
                  <a class="case__button" href={projectEnquiryHref(p)}>Discuss a similar project <span aria-hidden="true">→</span></a>
                  <a class="case__service" href={`/services/#${p.service}`}>Explore {PROJECT_SERVICES[p.service]} →</a>
                  <a class="case__service" href={`#case-${p.id}`}>Link to this case study</a>
                </section>
              </aside>
            </div>
          </details>
        </article>
      </li>
    ))}
  </ol>
  <button class="work-more" type="button" data-work-more hidden>Show all {PROJECTS.length} projects</button>

  <div class="work-invite">
    <div>
      <h3>Have a project like these?</h3>
      <p>Send a drawing, photos or a short description. BIZOMAT will come back with a clear scope, deliverables and an appropriate next step before any substantial work begins.</p>
    </div>
    <a class="case__button" href="/contact/">Get in touch <span aria-hidden="true">→</span></a>
  </div>

  <p class="work-note">Organisation names show where the work took place and do not imply endorsement of BIZOMAT. Work carried out while employed, including the Alchin Long Group product-development and capital projects, is the founder’s professional track record, not BIZOMAT client work. Product-development dates come from the project schedules, and a product is described as released to production only where its schedule records it. Organisation descriptions are general background. Engineering calculations, certification and statutory approvals remained with the responsible engineers and authorities. Projects that ended at concept or design stage are labelled that way, and visuals marked “Illustrative” are not images of the actual project. Commercial figures and client-confidential information are not shown.</p>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-work]')) {
    const cards = [...root.querySelectorAll<HTMLElement>('.work-card')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.work-filter button')];
    const tools = root.querySelector<HTMLElement>('[data-work-tools]');
    const search = root.querySelector<HTMLInputElement>('[data-work-search]');
    const more = root.querySelector<HTMLButtonElement>('[data-work-more]');
    const count = root.querySelector<HTMLElement>('[data-work-count]');
    const empty = root.querySelector<HTMLElement>('[data-work-empty]');
    const initial = Number(root.dataset.initial) || 9;
    const fold = (value: string) => value.toLowerCase().replace(/[’‘`]/g, "'").replace(/\s+/g, ' ');
    const text = new Map(cards.map((card) => [card, fold(card.textContent ?? '')]));
    let sector = 'all';
    let query = '';
    let expanded = false;
    const inSector = (card: HTMLElement) => sector === 'all' || (sector === 'featured' ? card.dataset.featured === 'true' : card.dataset.sector === sector);
    const render = () => {
      const terms = fold(query).split(' ').filter(Boolean);
      const matches = cards.filter((card) => inSector(card) && terms.every((t) => text.get(card)?.includes(t)));
      const limit = sector === 'all' && !terms.length && !expanded ? initial : matches.length;
      cards.forEach((card) => { card.hidden = true; });
      matches.forEach((card, i) => { card.hidden = i >= limit; });
      if (more) more.hidden = limit >= matches.length;
      if (empty) empty.hidden = matches.length > 0;
      const active = buttons.find((b) => b.dataset.sector === sector);
      const label = active?.dataset.label ?? '';
      const noun = sector === 'all' ? 'projects' : label.endsWith('projects') ? label : `${label} projects`;
      if (count) count.textContent = terms.length
        ? `${matches.length} ${matches.length === 1 ? noun.replace(/projects$/, 'project') : noun} matching “${query.trim()}”`
        : `Showing ${Math.min(limit, matches.length)} of ${matches.length} ${noun}`;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sector === sector)));
    };
    const reset = () => { sector = 'all'; query = ''; if (search) search.value = ''; };
    // Deep links (/engine-room/#case-<id>) reveal the card, open its case study and scroll to it: instantly on page load,
    // and with the page's own scroll behaviour (which respects reduced motion) for in-page links.
    const openFromHash = (behavior: ScrollBehavior) => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id.startsWith('case-')) return;
      const card = cards.find((c) => c.id === id);
      if (!card) return;
      if (card.hidden) { reset(); expanded = true; render(); }
      const details = card.querySelector<HTMLDetailsElement>('details.case');
      if (details) details.open = true;
      card.scrollIntoView({ block: 'start', behavior });
      card.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
    };
    if (tools) tools.hidden = false;
    buttons.forEach((b) => b.addEventListener('click', () => { sector = b.dataset.sector ?? 'all'; render(); }));
    search?.addEventListener('input', () => { query = search.value; render(); });
    root.querySelector('[data-work-clear]')?.addEventListener('click', () => { reset(); render(); search?.focus(); });
    more?.addEventListener('click', () => {
      expanded = true;
      render();
      cards[initial]?.querySelector<HTMLElement>('summary')?.focus();
    });
    window.addEventListener('hashchange', () => openFromHash('auto'));
    render();
    openFromHash('instant');
  }
</script>

<style>
  .work-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;margin:0 0 2rem;background:var(--line);border:1px solid var(--line)}
  .work-stats div{background:var(--surface);padding:1.1rem 1.25rem}
  .work-stats dt{font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .work-stats dd{margin:.35rem 0 0;font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2.2rem);font-weight:700;color:var(--ink);line-height:1.1}
  .work-tools{display:grid;gap:.9rem;margin-bottom:.9rem}
  .work-tools[hidden]{display:none}
  .work-search{display:grid;gap:.35rem;max-width:34rem}
  .work-search label{font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .work-search input{font:inherit;font-size:.95rem;color:var(--ink);background:var(--surface);border:1px solid var(--line-strong);padding:.65rem .85rem;width:100%;min-width:0}
  .work-search input::placeholder{color:var(--muted)}
  .work-search input:focus-visible{outline:2px solid var(--accent);outline-offset:1px;border-color:var(--accent)}
  .work-filter{display:flex;flex-wrap:wrap;gap:.5rem}
  .work-filter button{font:inherit;font-size:.84rem;font-weight:600;color:var(--ink-2);background:var(--surface);border:1px solid var(--line-strong);padding:.5rem .85rem;cursor:pointer;display:inline-flex;gap:.45rem;align-items:center}
  .work-filter button span{color:var(--muted);font-weight:500}
  .work-filter button:hover{border-color:var(--accent);color:var(--accent)}
  .work-filter button[aria-pressed="true"]{border-color:var(--accent);color:var(--accent);background:var(--accent-soft)}
  .work-filter button[aria-pressed="true"] span{color:var(--accent)}
  .work-filter button:focus-visible,.work-more:focus-visible,.case summary:focus-visible,.case__button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .work-count{font-size:.85rem;color:var(--muted);margin:0 0 1.2rem;min-height:1.2em}
  .work-empty{margin:0 0 1.2rem;padding:1rem 1.2rem;border:1px dashed var(--line-strong);color:var(--ink-2);font-size:.92rem}
  .work-empty[hidden]{display:none}
  .work-empty button{font:inherit;color:var(--accent);background:none;border:0;padding:0;text-decoration:underline;cursor:pointer}

  .work-list{display:grid;gap:1px;padding:0;margin:0;list-style:none;background:var(--line);border:1px solid var(--line)}
  .work-card{background:var(--surface);min-width:0;scroll-margin-top:calc(var(--header-h) + 1rem)}
  .work-card[hidden]{display:none}
  .work-card article{padding:clamp(1.3rem,2.6vw,2rem)}
  .work-card__top{display:grid;grid-template-columns:minmax(0,15rem) minmax(0,1fr) minmax(0,13rem);gap:1rem 2rem;align-items:start}
  .work-card__meta{display:flex;flex-wrap:wrap;gap:.4rem 1rem;margin:0 0 .55rem;font-size:.76rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .work-card__meta span:first-child{color:var(--accent);font-weight:650}
  .work-card__meta .work-card__featured{color:var(--ink);border:1px solid var(--accent);padding:0 .35rem;font-weight:650}
  .work-card h3{font-size:clamp(1.18rem,2vw,1.45rem);line-height:1.25;margin:0;max-width:34ch}
  .work-card__name{margin:.45rem 0 0;font-size:.9rem;font-weight:600;color:var(--ink-2)}
  .work-card__client{margin:.2rem 0 0;font-size:.86rem;font-weight:600;color:var(--ink)}
  .work-card__client span{font-weight:400;color:var(--muted)}
  .work-card__summary{margin:.7rem 0 0;font-size:.94rem;color:var(--ink-2);max-width:70ch}
  .work-card__aside{display:flex;flex-direction:column;gap:.8rem;align-items:flex-start}
  .work-card__skills{display:flex;flex-wrap:wrap;gap:.35rem;list-style:none;padding:0;margin:0}
  .work-card__skills li{border:1px solid var(--line-strong);padding:.2rem .5rem;font-size:.74rem;color:var(--ink-2)}
  .work-status{margin:0;font-size:.75rem;font-weight:650;letter-spacing:.04em;padding:.22rem .55rem;border:1px solid var(--line-strong);color:var(--ink-2)}
  .work-status--delivered{border-color:var(--accent);color:var(--accent)}
  .work-status--paused{border-style:dashed;color:var(--muted)}
  .work-status--approved{border-color:var(--accent);border-style:dashed;color:var(--accent)}

  .case{margin-top:1.1rem;border-top:1px solid var(--line);padding-top:.9rem}
  .case summary{cursor:pointer;list-style:none;display:inline-flex;align-items:center;gap:.6rem;font-size:.9rem;font-weight:650;color:var(--accent)}
  .case summary::-webkit-details-marker{display:none}
  .case summary::before{content:'+';display:inline-grid;place-items:center;width:1.4rem;height:1.4rem;border:1px solid var(--accent);font-weight:700;line-height:1}
  .case[open] summary::before{content:'−'}
  .case[open] summary span::after{content:' (close)';color:var(--muted);font-weight:500}
  .case__body{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:2rem 3rem;margin-top:1.4rem}
  .case h4{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin:0 0 .6rem}
  .case__main section{margin-top:1.6rem}
  .case__main p{margin:0;color:var(--ink-2);font-size:.95rem;line-height:1.65}
  .case__steps{counter-reset:step;list-style:none;padding:0;margin:0;display:grid;gap:.9rem}
  .case__steps li{counter-increment:step;display:grid;grid-template-columns:2rem 1fr;gap:0 .8rem}
  .case__steps li::before{content:counter(step,decimal-leading-zero);grid-row:span 2;font-family:var(--font-display);font-weight:700;color:var(--accent);font-size:.95rem}
  .case__steps strong{font-size:.97rem;color:var(--ink)}
  .case__steps p{margin:.2rem 0 0;font-size:.92rem}
  .case__main .case__value{margin-top:.9rem;padding:.85rem 1rem;border-left:3px solid var(--accent);background:var(--accent-soft);color:var(--ink)}
  .case__value span{display:block;font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);font-weight:650;margin-bottom:.2rem}
  .case__main .case__note{margin-top:.8rem;font-size:.85rem;color:var(--muted)}
  .case__main .case__context{margin-top:1.2rem;padding:.8rem 1rem;border:1px solid var(--line-strong);font-size:.88rem;color:var(--ink-2)}
  .case__context span{display:block;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:650;margin-bottom:.2rem}
  .case__list{margin:0;padding-left:1.1rem;display:grid;gap:.3rem;font-size:.93rem;color:var(--ink-2)}
  .case__main p + .case__list{margin-top:.5rem}
  .case__list--tick{list-style:none;padding-left:0}
  .case__list--tick li{position:relative;padding-left:1.3rem}
  .case__list--tick li::before{content:'';position:absolute;left:.15rem;top:.45em;width:.45rem;height:.25rem;border-left:2px solid var(--accent);border-bottom:2px solid var(--accent);transform:rotate(-45deg)}
  .case__path{list-style:none;margin:0;padding:0 0 0 1.1rem;border-left:2px solid var(--line-strong);display:grid;gap:.85rem}
  .case__path li{position:relative}
  .case__path li::before{content:'';position:absolute;left:calc(-1.1rem - 6px);top:.35rem;width:10px;height:10px;background:var(--surface);border:2px solid var(--accent)}
  .case__path li:last-child::before{background:var(--accent)}
  .case__path-period{display:block;font-size:.76rem;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);font-weight:650}
  .case__path strong{font-size:.95rem;color:var(--ink)}
  .case__main .case__path p{font-size:.9rem;margin-top:.1rem}
  .case__challenges{margin:0;display:grid;gap:.8rem}
  .case__challenges div{border-left:3px solid var(--line-strong);padding-left:.85rem}
  .case__challenges dt{font-weight:650;color:var(--ink);font-size:.93rem}
  .case__challenges dd{margin:.2rem 0 0;color:var(--ink-2);font-size:.92rem;line-height:1.6}
  .case__related{list-style:none;margin:0;padding:0;display:grid;gap:.45rem;font-size:.88rem}
  .case__related a{color:var(--accent);text-decoration:none;font-weight:600}
  .case__related a:hover{text-decoration:underline}
  .case__related span{color:var(--muted)}
  .case__side{display:grid;gap:1rem;align-content:start}
  .case__panel{border:1px solid var(--line-strong);padding:1.1rem 1.2rem;background:var(--paper)}
  .case__facts{margin:0;display:grid;gap:.6rem}
  .case__facts div{display:grid;grid-template-columns:6.5rem 1fr;gap:.6rem;font-size:.86rem}
  .case__facts dt{color:var(--muted)}
  .case__facts dd{margin:0;color:var(--ink)}
  .case__deliverables{margin:0;padding-left:1.1rem;font-size:.88rem;color:var(--ink-2);display:grid;gap:.3rem}
  .case__cta{border-color:var(--accent)}
  .case__cta p{margin:0 0 .4rem;font-size:.86rem;color:var(--muted)}
  .case__cta ul{margin:0 0 1rem;padding-left:1.1rem;font-size:.88rem;color:var(--ink-2);display:grid;gap:.3rem}
  .case__button{display:inline-flex;align-items:center;gap:.5rem;background:var(--accent);color:var(--paper);font-weight:650;font-size:.9rem;padding:.7rem 1.1rem;text-decoration:none}
  .case__button:hover{filter:brightness(1.08)}
  .case__service{display:block;margin-top:.75rem;font-size:.86rem;color:var(--accent);text-decoration:none}
  .case__service:hover{text-decoration:underline}

  .work-more{display:block;margin:1.5rem auto 0;font:inherit;font-size:.9rem;font-weight:650;color:var(--ink);background:transparent;border:1px solid var(--line-strong);padding:.75rem 1.4rem;cursor:pointer}
  .work-more:hover{border-color:var(--accent);color:var(--accent)}
  .work-more[hidden]{display:none}
  .work-invite{display:flex;justify-content:space-between;align-items:center;gap:1.5rem 3rem;margin-top:2.5rem;padding:clamp(1.3rem,3vw,2rem);border:1px solid var(--accent);background:var(--accent-soft)}
  .work-invite h3{font-size:var(--step-1);margin:0}
