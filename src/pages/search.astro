---
// Static full-text search powered by Pagefind. The index is generated at build time into
// /pagefind/, so no server or database is involved.
//
// The search script is an inline module on purpose. When Astro bundles a small script it inlines it into
// the page, and a dynamic import() inside it is wrapped in Vite's preload helper whose __VITE_PRELOAD__
// placeholder is never filled in. That threw at runtime, so search always fell back to its error message in
// production. An inline module is emitted verbatim, so the browser imports /pagefind/pagefind.js directly.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Container from '../components/Container.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Search', href: '/search/' },
];
---

<BaseLayout title="Search" description="Find KEVOS® articles, books and chapters on engineering, manufacturing, operations and business." noindex breadcrumbs={crumbs}>
  <Hero eyebrow="Search" title="Search KEVOS® knowledge">
    <Breadcrumb items={crumbs} slot="before" />
  </Hero>
  <Container class="search-page">
    <form class="search-form" role="search" action="/search/" method="get" data-search-form>
      <label for="q" class="visually-hidden">Search terms</label>
      <input id="q" name="q" type="search" placeholder="Search by topic, idea or keyword" autocomplete="off" />
      <button type="submit">Search</button>
    </form>
    <p class="search-status" role="status" aria-live="polite" data-search-status></p>
    <ol class="search-results" data-search-results></ol>
    <noscript><p class="search-status">Search needs JavaScript. You can browse every book in the <a href="/reados/">Library</a> instead.</p></noscript>
  </Container>
  <script is:inline type="module">
    const form = document.querySelector('[data-search-form]');
    const input = form.querySelector('input');
    const status = document.querySelector('[data-search-status]');
    const list = document.querySelector('[data-search-results]');
    let pagefind = null;

    const escape = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    // Pagefind excerpts contain only <mark> tags; strip anything else defensively.
    const safeExcerpt = (s) => escape(s.replace(/<(?!\/?mark>)[^>]*>/g, '')).replace(/&lt;(\/?)mark&gt;/g, '<$1mark>');

    async function load() {
      if (pagefind) return pagefind;
      try {
        pagefind = await import('/pagefind/pagefind.js');
        await pagefind.init();
        return pagefind;
      } catch {
        pagefind = null;
        status.textContent = 'Search could not be loaded. Browse every book in the Library instead.';
        return null;
      }
    }

    async function run(query) {
      const q = query.trim();
      const url = new URL(location.href);
      q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
      history.replaceState(null, '', url);
      if (!q) {
        list.innerHTML = '';
        status.textContent = '';
        return;
      }
      const pf = await load();
      if (!pf) return;
      const search = await pf.debouncedSearch(q);
      if (!search) return; // superseded by a newer query
      const results = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
      status.textContent = `${search.results.length} result${search.results.length === 1 ? '' : 's'} for “${q}”`;
      list.innerHTML = results
        .map(
          (r) => `<li><a href="${escape(r.url)}">
            ${r.filters?.category?.[0] ? `<span class="search-results__cat">${escape(r.filters.category[0])}</span>` : ''}
            <strong>${escape(r.meta.title ?? r.url)}</strong>
            <p>${safeExcerpt(r.excerpt)}</p></a></li>`,
        )
        .join('');
    }

    input.addEventListener('input', () => run(input.value));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      run(input.value);
    });
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) {
      input.value = initial;
      run(initial);
    }
    input.focus();
  </script>
</BaseLayout>

<style>
  :global(.search-page) { padding-bottom: var(--space-section); min-height: 40vh; }
  .search-form { display: flex; gap: 0.5rem; max-width: 760px; padding-bottom: 0.5rem; border-bottom: 1px solid var(--ink); }
  .search-form input { flex: 1; min-width: 0; min-height: 56px; padding: 0; background: transparent; border: 0; font-size: var(--step-2); letter-spacing: -0.02em; }
  .search-form input:focus { outline: none; }
  .search-form button { padding: 0 1.25rem; background: var(--ink); color: var(--paper); border: 0; border-radius: 999px; font-weight: 540; }
  .search-form button:hover { background: var(--accent); color: var(--on-accent); }
  .search-status { margin: 1.5rem 0; color: var(--muted); }
  .search-results { max-width: 760px; margin: 0; padding: 0; list-style: none; }
  .search-results :global(li) { border-top: 1px solid var(--line); }
  .search-results :global(a) { display: block; padding: 1.5rem 0; text-decoration: none; }
  .search-results :global(strong) { display: block; margin: 0.4rem 0; font-size: var(--step-1); font-weight: 560; letter-spacing: -0.015em; }
  .search-results :global(a:hover strong) { color: var(--accent); }
  .search-results :global(p) { margin: 0; color: var(--muted); }
  .search-results :global(mark) { background: var(--accent-soft); color: var(--ink); padding: 0 0.1em; }
  .search-results :global(.search-results__cat) { font-size: 0.75rem; font-weight: 580; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
</style>
