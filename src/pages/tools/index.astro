---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';

const description = 'Free professional decision tools for projects, operations, manufacturing, quoting, money and business. No account or software installation required.';
---

<BaseLayout title="Free Tools" description={description} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }]}>
  <section class="tools-shell">
    <Container>
      <div class="tools-intro">
        <p class="eyebrow">GoCore Tools</p>
        <h1>Tools for better decisions.</h1>
        <p class="lead">Practical calculators and decision utilities for engineering, manufacturing, projects and business. Free to use, with calculations performed in your browser.</p>
        <div class="tools-meta" aria-label="Tool collection features"><span class="tools-pill free">57 free tools</span><span class="tools-pill">No account</span><span class="tools-pill">Mobile friendly</span><span class="tools-pill">Browser-first calculations</span></div>
        <div class="tools-search"><input id="tool-search" type="search" placeholder="What are you trying to work out?" aria-label="Search GoCore tools" autocomplete="off" /><span class="tools-count" id="tool-count">57 tools</span></div>
        <div class="chips" aria-label="Filter tools by category"><button class="chip active" type="button" data-cat="All">All</button>
          <button class="chip" type="button" data-cat="Decide">Decide</button>
          <button class="chip" type="button" data-cat="Money">Money</button>
          <button class="chip" type="button" data-cat="Projects">Projects</button>
          <button class="chip" type="button" data-cat="Operations">Operations</button>
          <button class="chip" type="button" data-cat="Manufacturing">Manufacturing</button>
          <button class="chip" type="button" data-cat="Quoting">Quoting</button>
          <button class="chip" type="button" data-cat="Inventory">Inventory</button>
          <button class="chip" type="button" data-cat="Improvement">Improvement</button>
          <button class="chip" type="button" data-cat="Planning">Planning</button>
          <button class="chip" type="button" data-cat="Business">Business</button>
        </div>
      </div>

      <div id="tool-directory">
        <div class="tool-grid" id="tool-grid">
          <button class="tool-card" type="button" data-tool-id="make-buy" data-category="Decide" data-search="make / buy decide should you make it yourself or outsource it? compare total internal and supplier cost, then see the volume where the decision changes.">
            <span class="card-top"><span class="category-label">Decide</span><span class="badge">Free</span></span>
            <h2>Make / Buy</h2><p>Should you make it yourself or outsource it?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="tool-card" type="button" data-tool-id="project-gate" data-category="Decide" data-search="projectgate decide is this project worth proceeding with? balance financial value, strategic fit, urgency, risk and resource readiness into a transparent gate score.">
            <span class="card-top"><span class="category-label">Decide</span><span class="badge">Free</span></span>
            <h2>ProjectGate</h2><p>Is this project worth proceeding with?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="tool-card" type="button" data-tool-id="priority" data-category="Decide" data-search="priority decide what should go first? score work by impact, urgency, risk exposure and effort so competing priorities are easier to discuss.">
            <span class="card-top"><span class="category-label">Decide</span><span class="badge">Free</span></span>
            <h2>Priority</h2><p>What should go first?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="tool-card" type="button" data-tool-id="option-compare" data-category="Decide" data-search="optioncompare decide which of two options gives the stronger overall outcome? compare value, cost, delivery time and risk across two alternatives.">
            <span class="card-top"><span class="category-label">Decide</span><span class="badge">Free</span></span>
            <h2>OptionCompare</h2><p>Which of two options gives the stronger overall outcome?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="tool-card" type="button" data-tool-id="change-impact" data-category="Decide" data-search="changeimpact decide how disruptive is this proposed change? turn cost, schedule, risk, quality and expected benefit into a change-impact rating.">
            <span class="card-top"><span class="category-label">Decide</span><span class="badge">Free</span></span>
            <h2>ChangeImpact</h2><p>How disruptive is this proposed change?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="tool-card" type="button" data-tool-id="risk-score" data-category="Decide" data-search="riskscore decide how serious is this risk? use a classic likelihood × consequence assessment with a clear response band.">
            <span class="card-top"><span class="category-label">Decide</span><span class="badge">Free</span></span>
            <h2>RiskScore</h2><p>How serious is this risk?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="tool-card" type="button" data-tool-id="roi" data-category="Money" data-search="roi money is this investment financially worthwhile? calculate roi, annual net benefit and simple payback.">
            <span class="card-top"><span class="category-label">Money</span><span class="badge">Free</span></span>
            <h2>ROI</h2><p>Is this investment financially worthwhile?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="tool-card" type="button" data-tool-id="break-even" data-category="Money" data-search="breakeven money how much must you sell before you break even? calculate contribution per unit and break-even volume / revenue.">
            <span class="card-top"><span class="category-label">Money</span><span class="badge">Free</span></span>
            <h2>BreakEven</h2><p>How much must you sell before you break even?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="tool-card" type="button" data-tool-id="margin" data-category="Money" data-search="margin money what margin are you actually making? see gross profit, margin and markup from cost and selling price.">
            <span class="card-top"><span class="category-label">Money</span><span class="badge">Free</span></span>
            <h2>Margin</h2><p>What margin are you actually making?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="tool-card" type="button" data-tool-id="true-cost" data-category="Money" data-search="truecost money what does this work really cost? combine material, labour, overhead and other cost into a realistic unit cost.">
            <span class="card-top"><span class="category-label">Money</span><span class="badge">Free</span></span>
            <h2>TrueCost</h2><p>What does this work really cost?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="tool-card" type="button" data-tool-id="investment-check" data-category="Money" data-search="investmentcheck money does the investment clear a simple commercial hurdle? compare payback and roi against your minimum acceptable thresholds.">
            <span class="card-top"><span class="category-label">Money</span><span class="badge">Free</span></span>
            <h2>InvestmentCheck</h2><p>Does the investment clear a simple commercial hurdle?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="tool-card" type="button" data-tool-id="savings-check" data-category="Money" data-search="savingscheck money what is this improvement worth over a year? annualise recurring time or cost savings and subtract implementation cost.">
            <span class="card-top"><span class="category-label">Money</span><span class="badge">Free</span></span>
            <h2>SavingsCheck</h2><p>What is this improvement worth over a year?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="tool-card" type="button" data-tool-id="project-health" data-category="Projects" data-search="projecthealth projects how healthy is this project right now? combine schedule, cost, scope, risk and resource signals into a project-health score.">
            <span class="card-top"><span class="category-label">Projects</span><span class="badge">Free</span></span>
            <h2>ProjectHealth</h2><p>How healthy is this project right now?</p><span class="card-link">Open tool →</span>
          </button>
          <button class="