---
import { categorySlug } from '../config/taxonomy.ts';
import { categoryUrl } from '../utils/content.ts';

interface Props {
  name: string;
  /** Render as a link to the category page (only when that page exists). */
  link?: boolean;
}
const { name, link = false } = Astro.props;
const href = categoryUrl(categorySlug(name));
---

{
  link ? (
    <a class="category" href={href}>
      {name}
    </a>
  ) : (
    <span class="category">{name}</span>
  )
}

<style>
  .category {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: 0.78rem; font-weight: 580; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-2); text-decoration: none;
  }
  .category::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  a.category:hover { color: var(--accent); }
</style>
