---
/**
 * Factory Fix hero illustration: PROBLEM → REVIEW → OPPORTUNITIES → ACTION PLAN.
 * A four-station production line jams at assembly (work-in-progress queues up); the review measures each
 * station's cycle time against takt; the assembly step is rebalanced so work flows; and the findings become a
 * prioritised action plan with one supporting document. Pure SVG and CSS on one 16-second timeline: no scripts,
 * images or libraries. With reduced motion, the diagnosis and the plan are shown together as a still.
 */
import Logo from './Logo.astro';

const stations = [
  { x: 26, n: '01', name: 'CUT' },
  { x: 128, n: '02', name: 'WELD' },
  { x: 248, n: '03', name: 'ASSEMBLE' },
  { x: 350, n: '04', name: 'PACK' },
];
const bars = [
  { c: 68, h: 40 },
  { c: 170, h: 46 },
  { c: 290, h: 78, hot: true },
  { c: 392, h: 34 },
];
const queue = [174, 160, 146, 132, 118, 104];
const plan = [
  { x: 40, text: 'QUICK SET-UP' },
  { x: 164, text: 'BALANCE WORK' },
  { x: 288, text: 'STANDARD WORK' },
];
const stages = ['Problem', 'Review', 'Opportunities', 'Action plan'];
---

<figure class="ffa" aria-labelledby="ffa-caption">
  <figcaption id="ffa-caption" class="visually-hidden">
    Illustration: a four-station production line where work queues up before a slow assembly step; the review compares each station's
    cycle time with takt time and marks three observations; the assembly step is rebalanced so work flows; and the findings become a
    prioritised action plan with a standard operating procedure.
  </figcaption>
  <div class="ffa__panel">
    <div class="ffa__top" aria-hidden="true">
      <span>KEVOS® FACTORY FIX</span>
      <span class="ffa__brand"><Logo label="" height={14} /></span>
    </div>

    <svg class="ffa__svg" viewBox="0 80 480 296" aria-hidden="true" focusable="false">
      <defs>
        <marker id="ffa-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0 0 8 4 0 8z" class="ffa-fill-orange" />
        </marker>
      </defs>

      <text x="26" y="96" class="ffa-t ffa-t--o ffa-l1">01 · BOTTLENECK AT ASSEMBLY</text>
      <text x="454" y="96" class="ffa-t ffa-t--o ffa-l3" text-anchor="end">03 · FLOW BALANCED</text>

      <!-- Conveyor -->
      <path d="M12 190H468" class="ffa-conveyor" />
      <path d="M12 196H468" class="ffa-thin" />

      <!-- Work in progress queuing before assembly -->
      {queue.map((y, i) => <rect x="224" y={y} width="12" height="12" rx="1.5" class:list={['ffa-wip', `ffa-wip--${i + 1}`]} />)}

      <!-- Stations -->
      {
        stations.map((s, i) => (
          <g class:list={['ffa-station', { 'ffa-station--hot': i === 2 }]}>
            <rect x={s.x} y="146" width="84" height="54" rx="4" class="ffa-box" />
            <text x={s.x + 8} y="160" class="ffa-t">{s.n}</text>
            <text x={s.x + 42} y="181" class="ffa-t ffa-t--b" text-anchor="middle">{s.name}</text>
          </g>
        ))
      }

      <!-- Balanced flow after the fix -->
      <g class="ffa-flow">
        <rect x="0" y="182" width="8" height="8" rx="1.5" class="ffa-token ffa-token--1" />
        <rect x="0" y="182" width="8" height="8" rx="1.5" class="ffa-token ffa-token--2" />
        <rect x="0" y="182" width="8" height="8" rx="1.5" class="ffa-token ffa-token--3" />
      </g>

      <!-- 02 Review: cycle time against takt -->
      <g class="ffa-review">
        <text x="26" y="224" class="ffa-t ffa-t--o">02 · CYCLE TIME vs TAKT</text>
        <path d="M20 292H446" class="ffa-thin" />
        {bars.map((b) => <rect x={b.c - 14} y={292 - b.h} width="28" height={b.h} class:list={['ffa-bar', { 'ffa-bar--hot': b.hot }]} />)}
        <path d="M20 234H440" class="ffa-takt ffa-draw" pathLength="1" />
        <text x="444" y="237" class="ffa-t ffa-t--o">TAKT</text>
        <path d="M68 200V250M170 200V244M290 200V212M392 200V256" class="ffa-lead" />
      </g>

      <!-- Observations -->
      <g class="ffa-mark ffa-mark--1"><circle cx="336" cy="146" r="7" class="ffa-markdot" /><text x="336" y="148.6" class="ffa-t ffa-t--w" text-anchor="middle">1</text></g>
      <g class="ffa-mark ffa-mark--2"><circle cx="246" cy="100" r="7" class="ffa-markdot" /><text x="246" y="102.6" class="ffa-t ffa-t--w" text-anchor="middle">2</text></g>
      <g class="ffa-mark ffa-mark--3"><circle cx="314" cy="214" r="7" class="ffa-markdot" /><text x="314" y="216.6" class="ffa-t ffa-t--w" text-anchor="middle">3</text></g>

      <!-- 03 Opportunity: assembly brought under takt -->
      <g class="ffa-delta">
        <path d="M322 218V244" class="ffa-vec" marker-end="url(#ffa-arrow)" />
        <text x="330" y="236" class="ffa-t ffa-t--o">Δ</text>
      </g>

      <!-- 04 Action plan -->
      <g class="ffa-plan">
        <rect x="26" y="306" width="428" height="62" rx="5" class="ffa-card" />
        <text x="40" y="324" class="ffa-t ffa-t--o">04 · ACTION PLAN</text>
        {
          plan.map((p, i) => (
            <g>
              <rect x={p.x} y="336" width="12" height="12" rx="2" class="ffa-check-box" />
              <path d={`M${p.x + 2.5} ${342} l3 3 5-6`} class:list={['ffa-check', `ffa-check--${i + 1}`]} pathLength="1" />
              <text x={p.x + 18} y="345.5" class="ffa-t ffa-t--b">{`${i + 1} · ${p.text}`}</text>
            </g>
          ))
        }
        <path d="M410 330H432L442 340V360H410Z" class="ffa-doc" />
        <path d="M432 330V340H442" class="ffa-thin" />
        <text x="426" y="353" class="ffa-t ffa-t--b" text-anchor="middle">SOP</text>
      </g>
    </svg>

    <div class="ffa__bottom">
      <ol class="ffa__rail">
        {stages.map((s, i) => (
          <li class:list={['ffa__stage', `ffa__stage--${i + 1}`]}><span class="ffa__dot" aria-hidden="true"></span><span>{String(i + 1).padStart(2, '0')} {s}</span></li>
        ))}
      </ol>
      <span class="ffa__progress" aria-hidden="true"><span></span></span>
    </div>
  </div>
</figure>

<style>
  .ffa {
    --f-panel: #ffffff;
    --f-card: rgb(255 255 255 / 0.94);
    --f-line: rgb(18 18 17 / 0.16);
    --f-line-strong: rgb(18 18 17 / 0.4);
    --f-grid: rgb(255 106 19 / 0.075);
    --f-ink: #121211;
    --f-muted: #67645d;
    --f-orange: #c2410c;
    --f-soft: rgb(255 106 19 / 0.1);
    --f-bar: rgb(18 18 17 / 0.28);
    --cycle: 16s;
    display: block; margin: 0; width: 100%; max-width: 560px; color: var(--f-ink);
  }
  :global(:root[data-theme='dark']) .ffa {
    --f-panel: #131412;
    --f-card: rgb(28 29 27 / 0.94);
    --f-line: rgb(238 236 230 / 0.18);
    --f-line-strong: rgb(238 236 230 / 0.44);
    --f-grid: rgb(255 140 71 / 0.08);
    --f-ink: #f1efea;
    --f-muted: #a9a49c;
    --f-orange: #ff8c47;
    --f-soft: rgb(255 140 71 / 0.12);
    --f-bar: rgb(238 236 230 / 0.34);
  }
  .ffa__panel {
    position: relative; display: flex; flex-direction: column; gap: 0.4rem; width: 100%; container-type: inline-size;
    padding: clamp(0.85rem, 2.6vw, 1.25rem); border: 1px solid var(--f-line); border-radius: 20px; overflow: hidden;
    background-color: var(--f-panel);
    background-image: linear-gradient(var(--f-grid) 1px, transparent 1px), linear-gradient(90deg, var(--f-grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .ffa__top, .ffa__rail {
    font-family: var(--font-mono); font-size: clamp(0.56rem, 0.42rem + 0.4vw, 0.7rem); font-weight: 550; letter-spacing: 0.08em; color: var(--f-muted);
  }
  .ffa__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .ffa__brand { display: inline-flex; flex: none; max-width: 30%; }
  .ffa__svg { width: 100%; height: auto; overflow: visible; }

  /* Drawing primitives */
  .ffa-t { font-family: var(--font-mono); font-size: 7.4px; letter-spacing: 0.06em; fill: var(--f-muted); }
  .ffa-t--b { fill: var(--f-ink); font-weight: 600; }
  .ffa-t--o { fill: var(--f-orange); font-weight: 650; }
  .ffa-t--w { fill: var(--f-panel); font-weight: 700; font-size: 7px; }
  .ffa-fill-orange { fill: var(--f-orange); }
  .ffa-thin { fill: none; stroke: var(--f-line-strong); stroke-width: 0.9; }
  .ffa-conveyor { fill: none; stroke: var(--f-ink); stroke-width: 1.4; stroke-dasharray: 10 4; }
  .ffa-box { fill: var(--f-card); stroke: var(--f-ink); stroke-width: 1.3; }
  .ffa-station--hot .ffa-box { stroke: var(--f-orange); fill: var(--f-soft); stroke-width: 1.6; }
  .ffa-wip { fill: var(--f-soft); stroke: var(--f-orange); stroke-width: 1.1; }
  .ffa-token { fill: var(--f-orange); }
  .ffa-flow { opacity: 0; }
  .ffa-bar { fill: var(--f-bar); transform-box: fill-box; transform-origin: center bottom; }
  .ffa-bar--hot { fill: var(--f-orange); }
  .ffa-takt { fill: none; stroke: var(--f-orange); stroke-width: 1.1; stroke-dasharray: 6 4; }
  .ffa-lead { fill: none; stroke: var(--f-line); stroke-width: 0.8; stroke-dasharray: 2 3; }
  .ffa-markdot { fill: var(--f-orange); }
  .ffa-vec { fill: none; stroke: var(--f-orange); stroke-width: 1.4; }
  .ffa-delta, .ffa-l3 { opacity: 0; }
  .ffa-card { fill: var(--f-card); stroke: var(--f-ink); stroke-width: 1.2; }
  .ffa-check-box { fill: var(--f-soft); stroke: var(--f-orange); stroke-width: 1.1; }
  .ffa-check { fill: none; stroke: var(--f-orange); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ffa-doc { fill: var(--f-soft); stroke: var(--f-orange); stroke-width: 1.1; stroke-linejoin: round; }

  /* Stage rail */
  .ffa__bottom { display: grid; gap: 0.55rem; }
  .ffa__rail { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.35rem 0.9rem; margin: 0; padding: 0; list-style: none; }
  .ffa__stage { display: flex; align-items: center; gap: 0.4rem; color: var(--f-ink); text-transform: uppercase; white-space: nowrap; }
  .ffa__dot { flex: none; width: 0.55rem; height: 0.55rem; border: 1px solid var(--f-orange); border-radius: 50%; background: var(--f-orange); }
  .ffa__progress { display: block; height: 2px; background: var(--f-line); border-radius: 2px; overflow: hidden; }
  .ffa__progress span { display: block; height: 100%; width: 100%; background: var(--f-orange); transform-origin: left; }
  @container (max-width: 440px) {
    .ffa__rail { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Motion: one calm 16-second sequence, only for visitors who have not asked for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .ffa-wip { animation: ffa-wip var(--cycle) ease-out infinite both; }
    .ffa-wip--2 { animation-delay: 0.3s; }
    .ffa-wip--3 { animation-delay: 0.6s; }
    .ffa-wip--4 { animation-delay: 0.9s; }
    .ffa-wip--5 { animation-delay: 1.2s; }
    .ffa-wip--6 { animation-delay: 1.5s; }
    .ffa-station--hot .ffa-box { animation: ffa-hot var(--cycle) ease-in-out infinite; }
    .ffa-l1 { animation: ffa-l1 var(--cycle) ease-in-out infinite; }
    .ffa-l3 { animation: ffa-l3 var(--cycle) ease-in-out infinite; }
    .ffa-review { animation: ffa-review var(--cycle) ease-in-out infinite; }
    .ffa-bar { animation: ffa-bar var(--cycle) cubic-bezier(0.22, 0.61, 0.36, 1) infinite; }
    .ffa-bar--hot { animation: ffa-bar-hot var(--cycle) cubic-bezier(0.22, 0.61, 0.36, 1) infinite; }
    .ffa-draw { stroke-dasharray: 1; animation: ffa-draw var(--cycle) ease-in-out infinite; }
    .ffa-mark { animation: ffa-mark var(--cycle) ease-out infinite both; }
    .ffa-mark--2 { animation-delay: 0.4s; }
    .ffa-mark--3 { animation-delay: 0.8s; }
    .ffa-delta { animation: ffa-delta var(--cycle) ease-in-out infinite; }
    .ffa-flow { animation: ffa-flow var(--cycle) ease-in-out infinite; }
    .ffa-token { animation: ffa-token 3s linear infinite; }
    .ffa-token--2 { animation-delay: -1s; }
    .ffa-token--3 { animation-delay: -2s; }
    .ffa-plan { animation: ffa-plan var(--cycle) cubic-bezier(0.22, 0.61, 0.36, 1) infinite; }
    .ffa-check { stroke-dasharray: 1; animation: ffa-check var(--cycle) ease-out infinite both; }
    .ffa-check--2 { animation-delay: 0.35s; }
    .ffa-check--3 { animation-delay: 0.7s; }
    .ffa__stage { animation: ffa-stage var(--cycle) linear infinite; }
    .ffa__stage .ffa__dot { animation: ffa-dot var(--cycle) linear infinite; }
    .ffa__stage--2, .ffa__stage--2 .ffa__dot { animation-delay: -12s; }
    .ffa__stage--3, .ffa__stage--3 .ffa__dot { animation-delay: -8s; }
    .ffa__stage--4, .ffa__stage--4 .ffa__dot { animation-delay: -4s; }
    .ffa__progress span { animation: ffa-progress var(--cycle) linear infinite; }
  }
  @keyframes ffa-wip { 0% { opacity: 0; transform: translateY(-6px); } 5%, 55% { opacity: 1; transform: translateY(0); } 61%, 100% { opacity: 0; transform: translateY(0); } }
  @keyframes ffa-hot {
    0%, 56% { stroke: var(--f-orange); fill: var(--f-soft); }
    64%, 100% { stroke: var(--f-ink); fill: var(--f-card); }
  }
  @keyframes ffa-l1 { 0%, 50% { opacity: 1; } 56%, 96% { opacity: 0; } 100% { opacity: 1; } }
  @keyframes ffa-l3 { 0%, 58% { opacity: 0; } 64%, 94% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes ffa-review { 0%, 21% { opacity: 0; } 27%, 95% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes ffa-bar { 0%, 22% { transform: scaleY(0); } 32%, 95% { transform: scaleY(1); } 100% { transform: scaleY(0); } }
  @keyframes ffa-bar-hot {
    0%, 22% { transform: scaleY(0); fill: var(--f-orange); }
    32%, 56% { transform: scaleY(1); fill: var(--f-orange); }
    66%, 95% { transform: scaleY(0.56); fill: var(--f-bar); }
    100% { transform: scaleY(0); fill: var(--f-orange); }
  }
  @keyframes ffa-draw { 0%, 26% { stroke-dashoffset: 1; } 38%, 95% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 1; } }
  @keyframes ffa-mark { 0%, 34% { opacity: 0; } 38%, 95% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes ffa-delta { 0%, 58% { opacity: 0; } 64%, 94% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes ffa-flow { 0%, 58% { opacity: 0; } 64%, 95% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes ffa-token { 0% { transform: translateX(10px); } 100% { transform: translateX(462px); } }
  @keyframes ffa-plan { 0%, 72% { opacity: 0; transform: translateY(10px); } 78%, 96% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(10px); } }
  @keyframes ffa-check { 0%, 80% { stroke-dashoffset: 1; } 86%, 96% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 1; } }
  @keyframes ffa-stage { 0%, 24% { color: var(--f-ink); } 25%, 100% { color: var(--f-muted); } }
  @keyframes ffa-dot { 0%, 24% { background: var(--f-orange); } 25%, 100% { background: transparent; } }
  @keyframes ffa-progress { 0% { transform: scaleX(0); } 100% { transform: scaleX(1); } }
</style>
