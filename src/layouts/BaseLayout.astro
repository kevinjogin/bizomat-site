---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '../styles/global.css';
import interTight from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { SITE } from '../config/site.ts';

type Props = SEOProps;
const props = Astro.props;
---

<!doctype html>
<html lang="en-AU" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0f0f0e" />
    <script is:inline>
      // KEVOS® opens in the dark theme. Light applies only when the visitor switches to it,
      // and only for the current browser session (sessionStorage), never permanently.
      (function () {
        var d = document.documentElement, t = 'dark';
        try { if (sessionStorage.getItem('kevos-theme') === 'light') t = 'light'; } catch (e) {}
        try { localStorage.removeItem('kevos-theme'); } catch (e) {}
        d.dataset.theme = t;
        if (t === 'light') { var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', '#f6f5f1'); }
      })();
    </script>
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/oxanium-variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="icon" href="/brand/kevos-favicon-k-orange.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/kevos-favicon-k-orange-32.png" type="image/png" sizes="32x32" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/brand/kevos-favicon-k-orange-180.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="KEVOS® READOS" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline src="/js/kevos-context-protection-v1.js"></script>
    {SITE.assistant.enabled && <ChatWidget />}
  </body>
</html>

<style>
  main:focus { outline: none; }
  /* iOS/iPadOS long-press callouts do not always dispatch contextmenu. */
  :global(body) { -webkit-touch-callout: none; }
  :global(input), :global(textarea), :global([contenteditable]) { -webkit-touch-callout: default; }
</style>
