---
interface Props {
  class?: string;
  height?: number;
  label?: string;
}
const { class: className, height = 30, label = 'KEVOS' } = Astro.props;
const sizeClass = height <= 22 ? 'logo--compact' : height >= 34 ? 'logo--large' : 'logo--default';
---
<span
  class:list={['logo', sizeClass, className]}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <span class="logo__art" aria-hidden="true">
    <img class="logo__image logo__image--light" src="/brand/kevos-logo-navy-padded.png" alt="" width="432" height="80" decoding="async" />
    <img class="logo__image logo__image--dark" src="/brand/kevos-logo-white-padded.png" alt="" width="432" height="80" decoding="async" />
  </span>
</span>

<style>
  .logo {
    --logo-canvas-h: 44px;
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    line-height: 0;
    white-space: nowrap;
    overflow: visible;
  }
  .logo--compact { --logo-canvas-h: 36px; }
  .logo--default { --logo-canvas-h: 44px; }
  .logo--large { --logo-canvas-h: 50px; }

  .logo__art {
    display: grid;
    place-items: center;
    height: var(--logo-canvas-h);
    overflow: visible;
  }
  .logo__image {
    grid-area: 1 / 1;
    display: block;
    width: auto;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }
  .logo__image--dark { display: none; }

  :global(:root[data-theme='dark']) .logo__image--light { display: none; }
  :global(:root[data-theme='dark']) .logo__image--dark { display: block; }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logo__image--light { display: none; }
    :global(:root:not([data-theme='light'])) .logo__image--dark { display: block; }
  }
</style>
