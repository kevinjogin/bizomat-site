---
import { NAV, QUOTE_CTA } from '../config/site.ts';
import Container from './Container.astro';
import SiteWordmark from './SiteWordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
const path=Astro.url.pathname;
const isCurrent=(href:string)=>path===href;
---
<header class="site-header" data-header>
  <Container class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="KEVOS home"><SiteWordmark class="site-header__logo" height={36}/></a>
    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {NAV.map(item=><li><a href={item.href} aria-current={isCurrent(item.href)?'page':undefined}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="site-header__tools">
      <ThemeToggle/>
      <a class="header-cta" href={QUOTE_CTA.href} data-cta="header-quote"><span>{QUOTE_CTA.label}</span><span aria-hidden="true">↗</span></a>
    </div>
  </Container>
</header>
<script>
  const header=document.querySelector<HTMLElement>('[data-header]');
  const update=()=>header?.classList.toggle('is-scrolled',window.scrollY>8);
  window.addEventListener('scroll',update,{passive:true});update();
</script>
<style>
  .site-header{position:sticky;top:0;z-index:50;background:var(--paper);border-bottom:1px solid transparent;transition:border-color .25s var(--ease)}
  .site-header.is-scrolled{border-bottom-color:var(--line)}
  :global(.site-header__inner){display:flex;align-items:center;gap:clamp(.45rem,1.8vw,1.5rem);min-height:var(--header-h)}
  .site-header__brand{display:inline-flex;align-items:center;margin-right:auto;min-width:0;max-width:100%;overflow:visible;text-decoration:none}
  .site-header__brand:hover{color:inherit}
  .site-nav__list{display:flex;gap:.2rem;list-style:none;padding:0;margin:0}
  .site-nav__list a{display:block;padding:.5rem .7rem;text-decoration:none;font-size:.95rem;font-weight:560;color:var(--ink-2)}
  .site-nav__list a:hover,.site-nav__list a[aria-current='page']{color:var(--accent)}
  .site-header__tools{display:flex;align-items:center;gap:.5rem}
  .header-cta{display:inline-flex;align-items:center;justify-content:space-between;gap:1rem;min-height:46px;padding:0 1.3rem;background:var(--ink);color:var(--paper);border:1px solid var(--ink);border-radius:999px;text-decoration:none;font-weight:640;font-size:.9rem;white-space:nowrap}
  .header-cta:hover{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
  @media(max-width:700px){.header-cta{display:none}}
  @media(max-width:480px){
    .site-header__brand{max-width:150px}
    .site-header__brand :global(.site-wordmark){--wordmark-h:26px}
    .site-nav__list a{padding:.4rem .2rem;font-size:.85rem}
    .site-header__tools{gap:.15rem}
  }
</style>
