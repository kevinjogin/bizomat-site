---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '../styles/bizomat/tokens.css';
import '../styles/bizomat/components.css';
import '../styles/global.css';
import interTight from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { SITE } from '../config/site.ts';

type Props = SEOProps;
const props = Astro.props;
---

<!doctype html>
<html lang="en-AU" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f9fb" />
    <script is:inline>
      // BIZOMAT opens in the light theme (owner decision, 5 Nov 2026; kept for BIZOMAT). Dark applies only when the visitor switches to it,
      // and only for the current browser session (sessionStorage), never permanently. The OS preference is not followed.
      (function () {
        var d = document.documentElement, t = 'light';
        try { if (sessionStorage.getItem('bizomat-theme') === 'dark') t = 'dark'; sessionStorage.removeItem('kevos-theme'); } catch (e) {}
        try { localStorage.removeItem('kevos-theme'); localStorage.removeItem('bizomat-theme'); } catch (e) {}
        d.dataset.theme = t;
        if (t === 'dark') { var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', '#0a111c'); }
      })();
    </script>
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/oxanium-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/bizomat-icon-32.png" type="image/png" sizes="32x32" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/brand/bizomat-icon-180.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="BIZOMAT Library" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Casual-copy deterrence shared by every page; see the file for what it does and never does.
      import '../scripts/content-guard.ts';
    </script>
    {SITE.assistant.enabled && <ChatWidget />}
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
