---
// Indicative service packages with "from" pricing and the mandatory pricing note.
import { PACKAGES, PRICING_NOTE, SERVICE_OPTIONS } from '../data/services.ts';
import { ASSESSMENT } from '../config/assessment.ts';

interface Props {
  /** Show only the first n packages (homepage preview). */
  limit?: number;
}
const { limit } = Astro.props;
const items = limit ? PACKAGES.slice(0, limit) : PACKAGES;
const slugFor = (service: string) => SERVICE_OPTIONS.find((o) => o.value === service)?.slug ?? 'other';
---

<div class="packages">
  <a class="packages__fixed" href={`${ASSESSMENT.path}#included`} data-cta="package-assessment">
    <span class="packages__fixed-tag">Fixed price</span>
    <span class="packages__fixed-title">{ASSESSMENT.shortName}</span>
    <span class="packages__fixed-price">{ASSESSMENT.priceLabel}</span>
    <span class="packages__fixed-text">One defined problem: a 30-minute remote discussion, a preliminary review, up to three options and a one-page PDF.</span>
    <span class="packages__fixed-link">See what you receive <span aria-hidden="true">→</span></span>
  </a>
  <ul class="packages__grid">
    {
      items.map((p) => (
        <li class="package">
          <h3 class="package__title">{p.title}</h3>
          <p class="package__price">{p.price}</p>
          <p class="package__text">{p.description}</p>
          <a class="package__link" href={`/contact/?service=${slugFor(p.service)}`} data-cta="package-quote">
            Request a quote <span aria-hidden="true">→</span>
            <span class="visually-hidden"> for {p.title}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="packages__note">{PRICING_NOTE}</p>
</div>

<style>
  .packages__fixed {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: 'tag title price' 'text text link'; gap: 0.4rem 1.5rem; align-items: baseline;
    margin-bottom: 1rem; padding: clamp(1.1rem, 2.5vw, 1.5rem) clamp(1.25rem, 2.5vw, 1.75rem); background: var(--surface); color: var(--ink); text-decoration: none;
    border: 1px solid var(--line-strong); border-left: 4px solid var(--brand-orange); border-radius: var(--radius); transition: border-color 0.2s var(--ease);
  }
  .packages__fixed:hover { border-color: var(--accent); color: var(--ink); }
  .packages__fixed-tag { grid-area: tag; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .packages__fixed-title { grid-area: title; font-family: var(--font-display); font-weight: 700; font-size: 1.12rem; }
  .packages__fixed-price { grid-area: price; font-family: var(--font-display); font-weight: 700; font-size: var(--step-2); color: var(--accent); }
  .packages__fixed-text { grid-area: text; color: var(--ink-2); font-size: 0.95rem; }
  .packages__fixed-link { grid-area: link; font-size: 0.92rem; font-weight: 540; white-space: nowrap; }
  @media (max-width: 700px) { .packages__fixed { grid-template-columns: 1fr auto; grid-template-areas: 'tag price' 'title title' 'text text' 'link link'; } }
  .packages__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .package { display: flex; flex-direction: column; gap: 0.5rem; padding: clamp(1.25rem, 2.5vw, 1.75rem); background: var(--surface); }
  .package__title { font-size: 1.08rem; letter-spacing: -0.015em; line-height: 1.25; }
  .package__price { margin: 0; font-size: var(--step-1); font-weight: 560; letter-spacing: -0.02em; color: var(--accent); }
  .package__text { margin: 0; color: var(--ink-2); font-size: 0.95rem; line-height: 1.5; flex: 1; }
  .package__link { margin-top: 0.5rem; font-size: 0.92rem; font-weight: 540; color: var(--ink); text-decoration: none; }
  .package__link:hover { color: var(--accent); }
  .packages__note { margin: 1rem 0 0; font-size: 0.88rem; color: var(--muted); max-width: 70ch; }
  @media (max-width: 1000px) { .packages__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .packages__grid { grid-template-columns: 1fr; } }
</style>
