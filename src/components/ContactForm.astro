---
// Quote and contact form UI. Delivery is handled by submitContact() (src/lib/contact-client.ts), so the
// provider (Web3Forms today, a Cloudflare Worker later) can change without touching this component.
// Without JavaScript the form still posts directly to the configured provider.
// A ?service=<slug> query string (e.g. from "Discuss a Factory Fix") preselects the service.
import { SITE } from '../config/site.ts';
import { CONTACT_LIMITS, CONTACT_METHODS, HONEYPOT_FIELD } from '../lib/contact.ts';
import { SERVICE_OPTIONS } from '../data/services.ts';
import Button from './Button.astro';

const L = CONTACT_LIMITS;
const { provider, web3formsAccessKey, web3formsEndpoint, workerEndpoint } = SITE.contact;
const action = provider === 'web3forms' ? web3formsEndpoint : workerEndpoint;
---

<form class="contact-form" action={action} method="post" novalidate data-contact-form data-email={SITE.email}>
  {
    provider === 'web3forms' && (
      <Fragment>
        <input type="hidden" name="access_key" value={web3formsAccessKey} />
        <input type="hidden" name="subject" value="KEVOS® website enquiry" />
        <input type="hidden" name="from_name" value="KEVOS® website" />
        <input type="hidden" name="redirect" value={new URL('/contact/sent/', SITE.url).href} />
      </Fragment>
    )
  }
  <div class="contact-form__row">
    <div class="field">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required minlength={L.name.min} maxlength={L.name.max} aria-describedby="cf-name-error" />
      <p class="field__error" id="cf-name-error" data-error-for="name"></p>
    </div>
    <div class="field">
      <label for="cf-company">Company</label>
      <input id="cf-company" name="company" type="text" autocomplete="organization" required maxlength={L.company.max} aria-describedby="cf-company-error" />
      <p class="field__error" id="cf-company-error" data-error-for="company"></p>
    </div>
  </div>
  <div class="contact-form__row">
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength={L.email.max} aria-describedby="cf-email-error" />
      <p class="field__error" id="cf-email-error" data-error-for="email"></p>
    </div>
    <div class="field">
      <label for="cf-phone">Phone <span class="field__optional">(optional)</span></label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength={L.phone.max} aria-describedby="cf-phone-error" />
      <p class="field__error" id="cf-phone-error" data-error-for="phone"></p>
    </div>
  </div>
  <div class="field">
    <label for="cf-service">Service required</label>
    <select id="cf-service" name="service" required aria-describedby="cf-service-hint cf-service-error" data-service-select>
      <option value="">Choose a service</option>
      {SERVICE_OPTIONS.map((o) => <option value={o.value} data-slug={o.slug}>{o.value}</option>)}
    </select>
    <p class="field__hint" id="cf-service-hint">Not sure which service you need? Choose “Other”, describe the problem, and KEVOS® can help define the scope.</p>
    <p class="field__error" id="cf-service-error" data-error-for="service"></p>
  </div>
  <div class="field">
    <label for="cf-message">Project description</label>
    <textarea
      id="cf-message"
      name="message"
      rows="7"
      required
      minlength={L.message.min}
      maxlength={L.message.max}
      aria-describedby="cf-message-hint cf-message-error"
      placeholder="What needs to be done, what is happening now, any deadlines, and whether a site visit may be needed."></textarea>
    <p class="field__hint" id="cf-message-hint">Drawings, photos or documents can be shared after KEVOS® replies. Please don’t include confidential information here.</p>
    <p class="field__error" id="cf-message-error" data-error-for="message"></p>
  </div>
  <fieldset class="field field--radios" aria-describedby="cf-method-error">
    <legend>Preferred contact method</legend>
    <div class="radios">
      {
        CONTACT_METHODS.map((m, i) => (
          <label class="radio">
            <input type="radio" name="contactMethod" value={m} checked={i === 0} />
            <span>{m}</span>
          </label>
        ))
      }
    </div>
    <p class="field__error" id="cf-method-error" data-error-for="contactMethod"></p>
  </fieldset>

  <div class="contact-form__hp" aria-hidden="true">
    <label for="cf-hp">Leave this field empty</label>
    <input id="cf-hp" name={HONEYPOT_FIELD} type="checkbox" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field field--check">
    <input id="cf-consent" name="consent" type="checkbox" required aria-describedby="cf-consent-error" />
    <label for="cf-consent">
      I understand KEVOS® will use these details only to respond to my enquiry, as described in the <a href="/privacy/">privacy policy</a>.
    </label>
    <p class="field__error" id="cf-consent-error" data-error-for="consent"></p>
  </div>

  <div class="field field--captcha">
    <p class="field__hint">A quick spam check protects this form.</p>
    <div class="captcha" data-captcha></div>
    <p class="field__error" data-captcha-error></p>
  </div>
  <noscript><p class="field__hint">This form needs JavaScript for its spam check. If it is turned off, please use “Book a meeting” instead.</p></noscript>

  <div class="contact-form__status" role="status" aria-live="polite" tabindex="-1" data-status></div>

  <div class="contact-form__actions">
    <Button type="submit" arrow data-submit data-cta="contact-submit">Send enquiry</Button>
  </div>
</form>

<script>
  import { HONEYPOT_FIELD, normalise, validate, type ContactErrors } from '../lib/contact.ts';
  import { submitContact } from '../lib/contact-client.ts';
  import { mountCaptcha, type Captcha } from '../lib/captcha.ts';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const select = form.querySelector<HTMLSelectElement>('[data-service-select]');
    const captchaEl = form.querySelector<HTMLElement>('[data-captcha]')!;
    const captchaError = form.querySelector<HTMLElement>('[data-captcha-error]')!;
    let startedAt = Date.now();

    // Load the spam check only once the form is nearly in view or the visitor starts typing.
    let captcha: Promise<Captcha | null> | null = null;
    const ensureCaptcha = () => (captcha ??= mountCaptcha(captchaEl));
    form.addEventListener('focusin', ensureCaptcha, { once: true });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((en) => en.isIntersecting)) {
          ensureCaptcha();
          io.disconnect();
        }
      }, { rootMargin: '200px' });
      io.observe(captchaEl);
    }
    const fallbackEmail = form.dataset.email;
    const check = (input: ReturnType<typeof normalise>) => validate(input, { requireCompany: true });

    // Preselect the service from ?service=<slug>, e.g. links from the Factory Fix page.
    const wanted = new URLSearchParams(location.search).get('service');
    if (select && wanted) {
      const match = Array.from(select.options).find((o) => o.dataset.slug === wanted);
      if (match) select.value = match.value;
    }

    const showErrors = (errors: ContactErrors) => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        const field = el.dataset.errorFor as keyof ContactErrors;
        const input = form.elements.namedItem(field) as HTMLInputElement | null;
        const message = errors[field] ?? '';
        el.textContent = message;
        if (input && 'setAttribute' in input) input.setAttribute('aria-invalid', message ? 'true' : 'false');
      });
      const first = Object.keys(errors)[0];
      if (first) {
        const el = form.elements.namedItem(first) as HTMLElement | RadioNodeList | null;
        (el instanceof RadioNodeList ? (el[0] as HTMLElement) : el)?.focus();
      }
    };

    const setStatus = (kind: 'success' | 'error' | 'pending', text: string) => {
      status.dataset.kind = kind;
      status.textContent = text;
    };

    // Re-validate a field once the visitor has left it, so errors clear as they type.
    form.addEventListener('focusout', (e) => {
      const target = e.target as HTMLInputElement;
      const errorEl = form.querySelector<HTMLElement>(`[data-error-for="${target.name}"]`);
      if (!errorEl || !errorEl.textContent) return;
      const errors = check(normalise(Object.fromEntries(new FormData(form))));
      errorEl.textContent = errors[target.name as keyof ContactErrors] ?? '';
      target.setAttribute('aria-invalid', errorEl.textContent ? 'true' : 'false');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const input = normalise(data);
      const errors = check(input);
      showErrors(errors);
      if (Object.keys(errors).length) {
        setStatus('error', 'Please check the highlighted fields.');
        return;
      }
      const check2 = await ensureCaptcha();
      const token = check2?.token() ?? '';
      captchaError.textContent = check2
        ? token
          ? ''
          : 'Please complete the spam check above.'
        : 'The spam check could not load. Please refresh the page, or use “Book a meeting” instead.';
      if (!token) {
        setStatus('error', captchaError.textContent);
        return;
      }
      submit.disabled = true;
      setStatus('pending', 'Sending your enquiry');
      try {
        const result = await submitContact({ ...input, source: 'Contact page', honeypot: data[HONEYPOT_FIELD] ? 'yes' : '', startedAt, captcha: token });
        check2?.reset();
        if (result.ok) {
          form.reset();
          startedAt = Date.now();
          setStatus('success', result.message ?? 'Thank you. Your enquiry has been sent.');
        } else {
          if (result.errors) showErrors(result.errors);
          setStatus('error', `${result.message ?? 'Your enquiry could not be sent.'}${fallbackEmail ? ` You can also email ${fallbackEmail}.` : ''}`);
        }
      } finally {
        submit.disabled = false;
        status.focus();
      }
    });
  }
</script>

<style>
  .contact-form { display: grid; gap: 1.5rem; }
  .contact-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .field { display: grid; gap: 0.45rem; align-content: start; min-width: 0; }
  .field label, .field legend { font-size: 0.92rem; font-weight: 540; color: var(--ink); }
  .field__optional, .field__hint { font-weight: 400; color: var(--muted); }
  .field__hint { margin: 0; font-size: 0.84rem; }
  .field input[type='text'], .field input[type='email'], .field input[type='tel'], .field select, .field textarea {
    width: 100%; min-height: 50px; padding: 0.75rem 0.9rem;
    background: var(--surface); color: var(--ink); border: 1px solid var(--line-strong); border-radius: var(--radius);
    font: inherit; font-size: 1rem; line-height: 1.5; transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .field select { appearance: none; padding-right: 2.5rem; background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%); background-position: calc(100% - 1.15rem) 50%, calc(100% - 0.8rem) 50%; background-size: 0.35rem 0.35rem; background-repeat: no-repeat; }
  .field textarea { min-height: 180px; resize: vertical; }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: var(--muted); }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px var(--accent-soft); }
  .field [aria-invalid='true'] { border-color: var(--danger); }
  .field__error { margin: 0; font-size: 0.86rem; color: var(--danger); }
  .field__error:empty { display: none; }
  .captcha { min-height: 78px; }
  .field--radios { margin: 0; padding: 0; border: 0; }
  .field--radios legend { margin-bottom: 0.5rem; padding: 0; }
  .radios { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .radio { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.55rem 0.95rem; border: 1px solid var(--line-strong); border-radius: 999px; cursor: pointer; font-weight: 450; }
  .radio:has(input:checked) { border-color: var(--ink); background: var(--paper-2); }
  .radio:has(input:focus-visible) { box-shadow: 0 0 0 3px var(--accent-soft); }
  .radio input { width: 16px; height: 16px; margin: 0; accent-color: var(--ink); }
  .field--check { grid-template-columns: auto 1fr; column-gap: 0.75rem; align-items: start; }
  .field--check input { width: 20px; height: 20px; margin: 0.15rem 0 0; accent-color: var(--ink); }
  .field--check label { font-weight: 400; color: var(--ink-2); line-height: 1.5; }
  .field--check .field__error { grid-column: 2; }
  .contact-form__hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .contact-form__status { padding: 0.9rem 1rem; border-radius: var(--radius); border: 1px solid var(--line); font-size: 0.95rem; }
  .contact-form__status:empty { display: none; }
  .contact-form__status:focus { outline: none; }
  .contact-form__status[data-kind='success'] { border-color: var(--success); color: var(--success); }
  .contact-form__status[data-kind='error'] { border-color: var(--danger); color: var(--danger); }
  .contact-form__actions { display: flex; justify-content: flex-start; }
  @media (max-width: 640px) { .contact-form__row { grid-template-columns: 1fr; } }
</style>
