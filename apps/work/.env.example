# BIZOMAT Project Management — environment reference. Copy values into the right place; never commit real secrets.
#
# --- GitHub Actions secrets (repository/environment settings) ---
CLOUDFLARE_API_TOKEN=            # scoped token (see DEPLOYMENT.md)
CLOUDFLARE_ACCOUNT_ID=
#
# --- GitHub Actions variables ---
CLOUDFLARE_DEPLOY_ENABLED=false  # set to true once resources are provisioned
PRODUCTION_URL=https://workos-platform-production.<subdomain>.workers.dev
#
# --- Worker secrets (wrangler secret put <NAME> --env <env>) / local .dev.vars ---
GOOGLE_CLIENT_ID=                # optional: enables "Continue with Google"
GOOGLE_CLIENT_SECRET=
#
# --- Worker vars (wrangler.jsonc, per environment; not secret) ---
# APP_NAME=BIZOMAT Project Management
# APP_URL=https://...
# ALLOW_SIGNUP=false
# SESSION_TTL_HOURS=336
#
# --- Email (Brevo). Names only: values live in Fly secrets or local .dev.vars, never here. ---
# On the Fly app `bizomat` set them with the WORK_ prefix (WORK_BREVO_API_KEY ...): the entrypoint passes them to the
# work role only, under the names below (infrastructure/fly/entrypoint.sh). docs/email/brevo-setup.md.
BREVO_API_KEY=                   # secret; without it production sends no email (invitations show a link instead)
BREVO_WEBHOOK_TOKEN=             # secret; the bearer token configured on the Brevo transactional webhook
EMAIL_PROVIDER=                  # brevo | log (development: stored, not sent) | none. Default: brevo with a key
EMAIL_FROM_NAME=                 # default BIZOMAT
EMAIL_FROM_ADDRESS=              # default notifications@bizomat.ai (must be a verified sender in Brevo)
EMAIL_REPLY_TO=                  # optional
APP_BASE_URL=                    # default APP_URL, e.g. https://bizomat.ai/tasks
EMAIL_DAILY_LIMIT=               # default 250 (Brevo Free allows 300 per day)
EMAIL_CRITICAL_RESERVE=          # default 40, extra sends per day kept for invitations and tests
EMAIL_SANDBOX=                   # 1: Brevo accepts and drops every message (integration test)
