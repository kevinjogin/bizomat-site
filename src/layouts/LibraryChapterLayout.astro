---
import BaseLayout from './BaseLayout.astro';
import ReadOSChapterReader from '../components/ReadOSChapterReader.astro';
import { primaryGuide as guide, chapterHref } from '../data/library.ts';
import { readingTime } from '../utils/content.ts';
const { frontmatter }=Astro.props;
const number=Number(frontmatter.chapterNumber);
const current=guide.chapters[number-1];
if(!current)throw new Error('Invalid KEVOS® Library chapter');
const currentURL=chapterHref(current.slug);
const description=`Chapter ${number} of ${guide.chapters.length} in ${guide.title}. Learn ${current.title.toLowerCase()} with clear explanations and quick references.`;
const sources=import.meta.glob<string>('../pages/library/read-the-numbers-understand-the-business/*.md',{query:'?raw',import:'default',eager:true});
const source=Object.entries(sources).find(([path])=>path.endsWith(`/${current.slug}.md`))?.[1];
const minutes=source?readingTime(source.replace(/^---[\s\S]*?---/,'')):undefined;
---
<BaseLayout title={`${current.title} (${guide.title})`} description={description} canonical={currentURL}
  breadcrumbs={[{label:'Home',href:'/'},{label:'Library',href:'/library/'},{label:guide.title,href:`/library/${guide.slug}/`},{label:current.title,href:currentURL}]}
  schema={[{'@type':'Article',headline:current.title,description,author:{'@id':'https://kevos.com/#organization'},publisher:{'@id':'https://kevos.com/#organization'},isPartOf:{'@type':'Book',name:guide.title,url:`https://kevos.com/library/${guide.slug}/`}}]}>
  <ReadOSChapterReader bookTitle={guide.title} bookHref={`/library/${guide.slug}/`} home={{label:'Library',href:'/library/'}}
    chapters={guide.chapters.map(ch=>({href:chapterHref(ch.slug),title:ch.title}))} index={number-1}
    title={current.title} minutes={minutes} searchable finish={{href:'/library/',label:'Browse the library',small:'Finished →'}}>
    <slot />
    <aside class="chapter-note" slot="after" data-pagefind-ignore>General educational information only, not personal financial advice. Figures and company names in examples are fictional unless otherwise identified. Refer to original company filings before making decisions.</aside>
  </ReadOSChapterReader>
</BaseLayout>
<style>.chapter-note{margin:4rem 0 0;padding:1.3rem 0 0;border-top:1px solid var(--line);font-size:.84rem;color:var(--muted)}</style>
