---
// Shared compact header for the BIZOMAT Tools and Library directories: one title, one sentence, the learning-path box
// (the "planner" slot, LearningPlanner.astro) or another visual beside them, then the directory search across the full
// width.
import Container from '../Container.astro';
import LibrarySearch from './LibrarySearch.astro';

interface Props {
  title: string;
  description: string;
  /** Page path the search form submits to (works without JavaScript through ?q=). */
  action: string;
  placeholder: string;
  label: string;
  /** Total items, e.g. 504, and the noun used for counts ("tool" / "book"). */
  total: number;
  noun: string;
}
const { title, description, ...search } = Astro.props;
const planner = Astro.slots.has('planner');
const visual = planner || Astro.slots.has('visual');
---

<header class="lib-hero" data-library-intro>
  <Container>
    <div class:list={['lib-hero__top', visual && !planner && 'lib-hero__top--visual']}>
      <div class="lib-hero__copy">
        <h1 class="lib-hero__title">{title}</h1>
        <p class="lib-hero__lead">{description}</p>
      </div>
      {!planner && visual && <div class="lib-hero__visual"><slot name="visual" /></div>}
    </div>
    {planner && <div class="lib-hero__planner"><slot name="planner" /></div>}
    <LibrarySearch {...search} />
  </Container>
</header>
