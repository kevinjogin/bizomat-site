---
// Animated BIZOMAT-coloured project visual: a charcoal duotone base with orange linework that scans
// across it. Both layers are built from the project-record image by scripts/build-work-visuals.mjs.
// Projects without a shareable image use a branded illustration, labelled as illustrative.
import WorkIllustration from './WorkIllustration.astro';
import dimensions from '../data/work-visuals.json';
import type { ProjectIllustration } from '../data/projects.ts';
interface Props { id: string; alt: string; size?: 'card' | 'large'; caption?: string; illustration?: ProjectIllustration; tag?: string; final?: string }
const { id, alt, size = 'card', caption, illustration, tag, final } = Astro.props;
const [width, height] = (dimensions as Record<string, number[]>)[id] ?? [960, 600];
const src = (layer: 'base' | 'lines') => ({
  src: `/proof-of-work/${id}-${layer}-480.webp`,
  srcset: `/proof-of-work/${id}-${layer}-480.webp 480w, /proof-of-work/${id}-${layer}-960.webp 960w`,
});
const sizes = size === 'card' ? '(max-width: 640px) 92vw, (max-width: 1050px) 13rem, 15rem' : '(max-width: 860px) 92vw, 40rem';
---
<figure class:list={['work-visual', `work-visual--${size}`]} data-work-visual>
  <div class="work-visual__frame">
    {illustration ? (
      <div class="work-visual__art" role="img" aria-label={`${alt} (illustrative, not an image of the actual project)`}>
        <WorkIllustration kind={illustration} uid={`wi-${id}-${size}`} tag={tag} final={final} />
        <span class="work-visual__badge" aria-hidden="true">Illustrative</span>
      </div>
    ) : (
      <div class="work-visual__stage">
        <img class="work-visual__base" {...src('base')} sizes={sizes} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
        <img class="work-visual__lines" {...src('lines')} sizes={sizes} width={width} height={height} alt="" aria-hidden="true" loading="lazy" decoding="async" />
      </div>
    )}
    <span class="work-visual__grid" aria-hidden="true"></span>
    <span class="work-visual__scan" aria-hidden="true"></span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  // Pause visuals while they are off screen so long lists stay light.
  const visuals = document.querySelectorAll('[data-work-visual]');
  if ('IntersectionObserver' in window && visuals.length) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.target.classList.toggle('is-idle', !entry.isIntersecting);
    }, { rootMargin: '120px' });
    visuals.forEach((visual) => observer.observe(visual));
  }
</script>

<style>
  .work-visual{margin:0;min-width:0}
  .work-visual__frame{position:relative;aspect-ratio:16/10;overflow:hidden;background:#0a111c;border:1px solid var(--line-strong)}
  .work-visual__frame::before,.work-visual__frame::after{content:'';position:absolute;z-index:3;width:12px;height:12px;border:1.5px solid var(--brand-orange);pointer-events:none}
  .work-visual__frame::before{top:6px;left:6px;border-right:0;border-bottom:0}
  .work-visual__frame::after{right:6px;bottom:6px;border-left:0;border-top:0}
  .work-visual__stage{position:absolute;inset:0;animation:work-drift 18s ease-in-out infinite alternate}
  .work-visual__stage img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
  .work-visual__art{position:absolute;inset:0}
  .work-visual__badge{position:absolute;z-index:4;right:8px;top:7px;padding:.12rem .4rem;font-family:var(--font-sans);font-size:.6rem;font-weight:650;letter-spacing:.1em;text-transform:uppercase;color:#0a111c;background:#9c9385}
  .work-visual__lines{clip-path:inset(0 100% 0 0);animation:work-reveal 9s cubic-bezier(.55,.05,.3,1) infinite}
  .work-visual__grid{position:absolute;inset:0;z-index:1;pointer-events:none;background-image:linear-gradient(rgb(255 255 255 / .04) 1px,transparent 1px),linear-gradient(90deg,rgb(255 255 255 / .04) 1px,transparent 1px);background-size:24px 24px}
  .work-visual__scan{position:absolute;z-index:2;top:0;bottom:0;left:0;width:2px;background:var(--brand-orange);box-shadow:0 0 14px 3px rgb(20 184 166 / .5);animation:work-scan 9s cubic-bezier(.55,.05,.3,1) infinite;pointer-events:none}
  .work-visual--large .work-visual__grid{background-size:32px 32px}
  .work-visual figcaption{margin-top:.55rem;font-size:.8rem;color:var(--muted)}
  :global(.work-card:nth-child(3n+2)) .work-visual__lines,:global(.work-card:nth-child(3n+2)) .work-visual__scan{animation-delay:-3s}
  :global(.work-card:nth-child(3n+3)) .work-visual__lines,:global(.work-card:nth-child(3n+3)) .work-visual__scan{animation-delay:-6s}
  .work-visual.is-idle .work-visual__stage,.work-visual.is-idle .work-visual__lines,.work-visual.is-idle .work-visual__scan{animation-play-state:paused}
  @keyframes work-reveal{0%{clip-path:inset(0 100% 0 0);opacity:1}50%,84%{clip-path:inset(0 0 0 0);opacity:1}100%{clip-path:inset(0 0 0 0);opacity:0}}
  @keyframes work-scan{0%{left:0;opacity:1}50%{left:calc(100% - 2px);opacity:1}53%,100%{left:calc(100% - 2px);opacity:0}}
  @keyframes work-drift{from{transform:scale(1)}to{transform:scale(1.05) translate(-1%,-1%)}}
  @media (prefers-reduced-motion: reduce){
    .work-visual__stage,.work-visual__lines,.work-visual__scan{animation:none}
    .work-visual__lines{clip-path:none}
    .work-visual__scan{display:none}
  }
</style>
