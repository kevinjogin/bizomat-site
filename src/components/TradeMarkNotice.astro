---
import { SITE } from '../config/site.ts';
---
<p>
  {SITE.name} is a registered Australian word trade mark, number {SITE.tradeMark.number},
  in class {SITE.tradeMark.class} for the engineering, design and related services specified in the register.
  It is registered from {SITE.tradeMark.registeredFrom} and was entered on the register on {SITE.tradeMark.enteredOnRegister}.{' '}
  <a href={SITE.tradeMark.record} rel="noopener noreferrer" target="_blank">View the IP Australia registration record</a>.
</p>
