---
// Shown after a successful submission when JavaScript is unavailable.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Button from '../../components/Button.astro';
---

<BaseLayout title="Message sent" description="Thank you for contacting BIZOMAT. Your message has been sent and you will receive a reply as soon as possible." noindex>
  <Hero eyebrow="Message sent" title="Thank you." lead="Your message has been sent. BIZOMAT will reply as soon as possible.">
    <Fragment slot="actions">
      <Button href="/" arrow>Back to home</Button>
      <Button href="/engine-room/" variant="secondary">The Engine Room</Button>
    </Fragment>
  </Hero>
</BaseLayout>
