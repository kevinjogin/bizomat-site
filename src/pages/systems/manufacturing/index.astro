---
// /systems/manufacturing/: BIZOMAT Manufacturing and Operations (src/config/systems.ts), a family of BIZOMAT ERP modules.
// Live: Maintenance (stage 1 in production; stages 2 and 3, ERP Release 4 part B, live once deployed:
// apps/work/src/worker/maintenance, apps/work/test/maintenance.test.ts and maintenance-m2-m3.test.ts), ERP Release 2's
// Procurement and Inventory (apps/work/src/worker/erp, apps/work/test/erp-r2.test.ts) and ERP Release 3's Manufacturing
// and production planning (apps/work/src/worker/erp, apps/work/test/erp-r3.test.ts), and ERP Release 4 part A's Quality
// (apps/work/src/worker/erp/quality.ts and ncr.ts, apps/work/test/erp-r4-quality.test.ts) and ERP Release 5 part A's
// Supply Chain (apps/work/src/worker/erp/sales.ts, logistics.ts and returns.ts, apps/work/test/erp-r5-supply-chain.test.ts;
// live once Release 5 is deployed). With it every module of the system works, so the system is Available; what is not
// built inside a module is labelled Planned. The product screens are of working modules, with the example company's
// invented data.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Button from '../../../components/Button.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import StatusLabel from '../../../components/StatusLabel.astro';
import StatusLegend from '../../../components/StatusLegend.astro';
import '../../../styles/product.css';
import '../../../styles/visuals.css';
import '../../../styles/systems.css';
import { SITE } from '../../../config/site.ts';
import { APP_LINKS } from '../../../config/platform.ts';
import { SYSTEMS_HOME, systemById, type FeatureStatus } from '../../../config/systems.ts';
import { screenshots } from '../../../data/screenshots.ts';

const sys = systemById('manufacturing');
const erp = systemById('erp');
// Product screens of modules that work today: Manufacturing's shop floor and Maintenance's overview, calendar and work order.
const maintenanceShot = screenshots('erp').find((s) => s.src.endsWith('/erp-maintenance.webp'));
const pmShots = screenshots('erp').filter((s) => s.src.endsWith('/erp-maintenance-preventive.webp') || s.src.endsWith('/erp-maintenance-inspection.webp'));
const floorShot = screenshots('erp').find((s) => s.src.endsWith('/erp-shop-floor.webp'));
const qualityShot = screenshots('erp').find((s) => s.src.endsWith('/erp-quality-inspection.webp'));
const supplyShots = screenshots('erp').filter((s) => s.src.endsWith('/erp-sales-order.webp') || s.src.endsWith('/erp-shipment.webp'));
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Systems', href: SYSTEMS_HOME }, { label: sys.short, href: sys.url }];
const description = 'Procurement, inventory, manufacturing, quality, maintenance and supply chain in BIZOMAT ERP: purchasing, stock, production, inspections, shipments.';

interface Item { t: string; st: FeatureStatus }
interface Module { id: string; name: string; st: FeatureStatus; x: string; items?: Item[]; today?: Item[]; where?: string }
const modules: Module[] = [
  {
    id: 'manufacturing', name: 'Manufacturing', st: 'live', where: 'Manufacturing',
    x: 'Work centres and machines with a capacity calendar and cost rates, routings with revisions, and manufacturing orders made from a released bill of materials and routing: materials reserved and issued from stock, each operation started, timed and reported (output, scrap, rework, downtime and inspection results) from a shop-floor screen for phones, and finished goods received at actual cost.',
    items: [
      { t: 'Work centres and machines, linked to their Maintenance assets', st: 'live' },
      { t: 'Routings with revisions, released by someone other than their author', st: 'live' },
      { t: 'Manufacturing orders with materials, operations and amendments', st: 'live' },
      { t: 'Labour and machine time, output, scrap, rework and downtime', st: 'live' },
      { t: 'A shop-floor screen for phones', st: 'live' },
      { t: 'Estimated against actual cost by element, with variances', st: 'live' },
      { t: 'Orders made to order from a sales order line, linked both ways', st: 'live' },
      { t: 'Job profitability: the order\'s revenue against its actual cost', st: 'live' },
      { t: 'Production value posted to Finance', st: 'planned' },
    ],
  },
  {
    id: 'planning', name: 'Production planning', st: 'live', where: 'Manufacturing, Planning',
    x: 'A master production schedule of forecast and confirmed demand, confirmed sales orders as demand of their own, MRP that plans level by level through the bills of materials with lead times, open orders, reservations, safety stock and reorder points, and rough-cut capacity per work centre per week.',
    items: [
      { t: 'Master production schedule', st: 'live' },
      { t: 'MRP: make, buy and expedite suggestions, marked late or overdue', st: 'live' },
      { t: 'Suggestions turned into requisitions and draft orders', st: 'live' },
      { t: 'Rough-cut capacity with overloads flagged', st: 'live' },
      { t: 'Finite scheduling and a drag-and-drop planning board', st: 'planned' },
    ],
  },
  {
    id: 'inventory', name: 'Inventory', st: 'live', where: 'Inventory',
    x: 'Stock on hand by product, location, lot and serial, kept by a ledger of stock movements that is never edited: issues, transfers, reservations, quarantine, returns, scrap, adjustments with approval, stocktakes and cycle counts, and valuation by weighted average or first in, first out.',
    items: [{ t: 'Stock by lot and serial, with traceability', st: 'live' }, { t: 'Movements, reservations, returns, quarantine and scrap', st: 'live' }, { t: 'Adjustments, stocktakes and cycle counts with approval', st: 'live' }, { t: 'Weighted average or FIFO valuation', st: 'live' }, { t: 'Stock value posted to Finance', st: 'planned' }],
  },
  {
    id: 'warehouse', name: 'Warehouse management', st: 'live', where: 'Inventory',
    x: 'Warehouses and a tree of locations, goods received and put away, transfers between locations, and QR labels made by BIZOMAT with a warehouse screen for phones that takes typed or scanned codes.',
    items: [{ t: 'Warehouses and locations, with quarantine, receiving and dispatch', st: 'live' }, { t: 'Receiving, issuing, moving and counting on a phone', st: 'live' }, { t: 'Pick lists, packing and dispatch on a phone', st: 'live' }],
  },
  {
    id: 'procurement', name: 'Procurement', st: 'live', where: 'Procurement',
    x: 'Purchase requisitions with approval, requests for quotation to approved suppliers with a comparison of their quotations, purchase orders with an approval limit and amendments, goods receipts with lots, serial numbers and damaged or rejected quantities, supplier performance, and one draft bill in Finance per receipt.',
    items: [{ t: 'Suppliers, requisitions and quotations', st: 'live' }, { t: 'Purchase orders with approval limits and amendments', st: 'live' }, { t: 'Goods receipts and supplier performance', st: 'live' }, { t: 'A draft bill in Finance from each receipt', st: 'connected' }, { t: 'Matching against the supplier\'s own invoice', st: 'planned' }],
  },
  {
    id: 'quality', name: 'Quality management', st: 'live', where: 'Quality',
    x: 'Inspection plans with versions, and inspections of goods received, manufacturing operations, finished goods and suppliers, recorded on a phone, with the pass or fail worked out from the limits. A failed lot goes into quarantine; a nonconformance report records containment, the root cause and the disposition, carried out through stock; corrective and preventive actions follow it to closure.',
    items: [
      { t: 'Inspection plans: dimensions with limits, attributes, visual checks, samples and photos', st: 'live' },
      { t: 'Incoming, in-process, final, first article and supplier inspections', st: 'live' },
      { t: 'Quarantine and release of a failed lot', st: 'live' },
      { t: 'Nonconformance reports: containment, five whys and disposition', st: 'live' },
      { t: 'Corrective and preventive actions, approved and closed by someone else', st: 'live' },
      { t: 'Inspections and nonconformances in a lot\'s traceability', st: 'live' },
      { t: 'Reports: rejection rates, supplier defects, NCR ageing, cost of poor quality', st: 'live' },
      { t: 'Statistical process control, calibration and audits', st: 'planned' },
    ],
  },
  {
    id: 'maintenance', name: 'Maintenance', st: 'live', where: 'Maintenance',
    x: 'A maintenance management system (CMMS) inside BIZOMAT ERP, with its own module in the rail, called Maintenance. The asset register, requests, work orders, preventive maintenance, readings, inspections, prestart checks, parts from Inventory, sites and reliability reports work today. An AI scheduling assistant and offline field work are planned.',
    items: [
      { t: 'Asset register and hierarchy, in several sites', st: 'live' },
      { t: 'Asset import from a CSV file, with a preview', st: 'live' },
      { t: 'Maintenance requests with approval, and "Report a fault" from any ERP screen', st: 'live' },
      { t: 'Work orders with tasks, parts, safety notes, photos and documents', st: 'live' },
      { t: 'Technicians, trades and labour rates; a labour timer and time entered by hand, with its cost', st: 'live' },
      { t: 'Preventive maintenance by time, meter or condition, with templates for classes of assets', st: 'live' },
      { t: 'A calendar of preventive work, made into work orders when due, once', st: 'live' },
      { t: 'Meters and gauges with readings and expected ranges', st: 'live' },
      { t: 'Inspection templates on work orders; a failure makes its follow-up', st: 'live' },
      { t: 'Prestart checks on a phone; a critical failure sets the asset out of service', st: 'live' },
      { t: 'Spare parts issued from maintenance stores through Inventory, and stocktakes', st: 'live' },
      { t: 'QR labels and scanning', st: 'live' },
      { t: 'Downtime, MTBF, MTTR, PM compliance, backlog, breakdown trends and asset costs', st: 'live' },
      { t: 'Maintenance costs posted to Finance', st: 'planned' },
      { t: 'Workload planning', st: 'planned' },
      { t: 'An AI scheduling assistant that only proposes schedules, for a person to approve', st: 'planned' },
      { t: 'Offline field work', st: 'planned' },
    ],
  },
  {
    id: 'supply-chain', name: 'Supply chain', st: 'live', where: 'Supply Chain',
    x: 'Sales orders for the company\'s one customer record in the CRM and Finance, with stock allocated or a manufacturing order made to order, then shipments: a pick list, packages, dispatch and delivery confirmation on a phone, with carriers, tracking links and a delivery schedule. Each shipment makes one draft invoice in Finance; returns come back into stock with a draft credit note.',
    items: [
      { t: 'Sales orders priced as Finance prices lines, with amendments and their history', st: 'live' },
      { t: 'A draft sales order from a won CRM deal', st: 'connected' },
      { t: 'Stock allocated soonest expiry first, then the oldest', st: 'live' },
      { t: 'Pick lists, packages with weight and size, and dispatch, once', st: 'live' },
      { t: 'Delivery confirmed with a photo, a signature or a document', st: 'live' },
      { t: 'Carriers, services, tracking links and a delivery schedule', st: 'live' },
      { t: 'An optional dispatch email with the tracking link', st: 'live' },
      { t: 'One draft invoice per shipment in Finance, with the freight charge', st: 'connected' },
      { t: 'Returns authorised, received back into stock or quarantine, with a draft credit note', st: 'live' },
      { t: 'Reports: open orders, on time and in full, carriers, freight, returns, sales, job profitability', st: 'live' },
      { t: 'Bookings and labels in a carrier\'s own system', st: 'planned' },
      { t: 'Landed costs and demand forecasting', st: 'planned' },
      { t: 'The value of stock sold posted to Finance', st: 'planned' },
    ],
  },
];

const today: { name: string; url: string; items: Item[] }[] = [
  { name: 'BIZOMAT ERP', url: '/systems/erp/', items: [{ t: 'Procurement: requisitions, quotations, purchase orders and receipts', st: 'live' }, { t: 'Inventory: warehouses, stock, counts and valuation', st: 'live' }, { t: 'Manufacturing: orders, routings, the shop floor, MRP and job costing', st: 'live' }, { t: 'Quality: inspections, nonconformances and corrective actions', st: 'live' }, { t: 'Supply Chain: sales orders, shipments, deliveries and returns', st: 'live' }, { t: 'Bills of materials with stock availability', st: 'live' }] },
  { name: 'BIZOMAT Finance', url: '/systems/finance/', items: [{ t: 'Supplier bills, approved and paid', st: 'live' }, { t: 'A draft bill from each goods receipt', st: 'connected' }, { t: 'A draft invoice from each shipment, and a draft credit note from each return', st: 'connected' }, { t: 'Budgets by category, department or project', st: 'live' }] },
  { name: 'BIZOMAT Projects', url: '/systems/projects/', items: [{ t: 'Boards, timelines and workload to plan the work', st: 'live' }, { t: 'Tasks with owners, statuses and dates', st: 'live' }] },
  { name: 'BIZOMAT Engineering Automation', url: '/systems/engineering/', items: [{ t: 'SOLIDWORKS parts and assemblies from your AI assistant', st: 'live' }, { t: 'Drawings with views, dimensions and a bill of materials', st: 'live' }] },
  { name: 'BIZOMAT CRM', url: '/systems/crm/', items: [{ t: 'Customers, deals and follow-ups', st: 'live' }, { t: 'The customer record a sales order is made for', st: 'connected' }, { t: 'A draft sales order from a won deal', st: 'connected' }] },
];

// The flows, as they work today (Scenario G and Scenario B of the owner's brief).
const sellFlow = ['Won deal or order', 'Sales order', 'Stock or work order', 'Final inspection', 'Pick, pack and dispatch', 'Delivery', 'Invoice in Finance'];
const buyFlow = ['Requisition', 'Purchase order', 'Goods receipt', 'Incoming inspection', 'Supplier bill in Finance'];

const faqs = [
  { q: 'Can it manage manufacturing today?', a: 'Yes. Manufacturing orders, routings and work centres, a shop-floor screen, the master production schedule, MRP, rough-cut capacity, job costing and the job profitability of orders made to order work inside BIZOMAT ERP, with purchasing, inventory and warehouses. Production value is not posted to Finance\'s ledger yet.' },
  { q: 'Can it take a customer order to delivery?', a: 'Yes. A sales order for a customer of your CRM and Finance is confirmed, its stock allocated or made to order, then picked, packed and dispatched from a phone, with the carrier\'s tracking link, and the delivery confirmed with a photo or signature. Each shipment makes one draft invoice in Finance, which Finance\'s approval posts. Returns come back into stock with a draft credit note. Bookings in a carrier\'s own system are planned.' },
  { q: 'Can it manage quality?', a: 'Yes. Inspection plans, inspections of goods received, manufacturing operations, finished goods and suppliers, nonconformance reports with their disposition, and corrective and preventive actions work inside BIZOMAT ERP. Statistical process control, calibration and quality audits are planned.' },
  { q: 'Is Inventory available?', a: 'Yes. Warehouses and locations, stock by lot and serial, every movement, reservations, returns, adjustments, stocktakes, cycle counts, weighted average or FIFO valuation, QR labels and a warehouse screen for phones work today inside BIZOMAT ERP. Posting stock value to Finance\'s ledger is planned.' },
  { q: 'Is Maintenance available?', a: 'Yes, inside BIZOMAT ERP: the asset register and hierarchy in several sites, maintenance requests with approval, work orders, technicians and labour costs, preventive maintenance by time, meter or condition, readings, inspections, prestart checks on a phone, spare parts from Inventory, QR labels and the reliability reports. An AI scheduling assistant and offline field work are planned.' },
  { q: 'Can I sign up or pay for it now?', a: 'Procurement, Inventory, Manufacturing, Quality, Supply Chain and Maintenance come with BIZOMAT ERP: sign in and open them from Operations. For what is planned there is nothing to sign up for, download or buy.' },
  { q: 'What can I use today instead?', a: 'BIZOMAT ERP for products, bills of materials, engineering changes, purchasing and stock; BIZOMAT Finance for bills and payments; BIZOMAT Projects to plan the work; BIZOMAT Engineering Automation for SOLIDWORKS parts, assemblies and drawings. All of them, except Engineering Automation\'s own application, open inside BIZOMAT ERP.' },
  { q: 'What is still planned?', a: 'Posting stock, production and maintenance value to Finance\'s ledger (each is recorded as planned; nothing is posted), Maintenance\'s AI scheduling assistant and offline field work, statistical process control, calibration and quality audits, and in Supply Chain connections to carriers\' own systems, landed costs and demand forecasting. There is no date yet: each is labelled Planned until it is built and tested.' },
];

const schema = [
  { '@type': 'WebPage', name: sys.name, url: `${SITE.url}${sys.url}`, description, isPartOf: { '@id': `${SITE.url}/#website` }, publisher: { '@id': `${SITE.url}/#organization` } },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<BaseLayout title="Manufacturing, procurement, inventory, quality, maintenance and supply chain ERP" description={description} imageAlt="BIZOMAT Manufacturing and Operations: ERP modules that work today" breadcrumbs={crumbs} schema={schema}>
  <section class="pp-hero" aria-labelledby="mfg-title">
    <Container>
      <div class="sys-crumbs"><Breadcrumb items={crumbs} /></div>
      <p class="bz-eyebrow">{sys.name} · {sys.kind}</p>
      <h1 id="mfg-title">Manufacturing and Operations</h1>
      <p class="sys-planned__status sys-hero-status"><StatusLabel status="live" /> Procurement, Inventory, Manufacturing, Quality, Supply Chain and Maintenance work today in BIZOMAT ERP.</p>
      <p class="pp-hero__lead">A family of BIZOMAT ERP modules for making, buying, storing, checking, maintaining and shipping goods. Procurement (requisitions, quotations, purchase orders and goods receipts), Inventory (warehouses, stock, counts and valuation), Manufacturing (orders, routings, the shop floor, MRP, job costing and job profitability), Quality (inspections, nonconformances and corrective actions), Supply Chain (sales orders, picking, packing, dispatch, deliveries and returns) and Maintenance, a maintenance management system (CMMS), work today inside BIZOMAT ERP.</p>
      <div class="pp-hero__actions">
        <Button href={sys.access?.href ?? APP_LINKS.erp.home} variant="accent" rel="noopener" data-cta="mfg-use-erp">{sys.access?.label ?? 'Use BIZOMAT ERP today'}</Button>
        <Button href={sys.guide} variant="secondary" data-cta="mfg-guide">Read the user guide</Button>
      </div>
      <p class="pp-hero__note">{sys.statusNote}</p>
    </Container>
  </section>

  <section class="pp-section" id="modules" aria-labelledby="modules-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">The modules</p>
        <h2 id="modules-title">What each module does</h2>
        <p>Every module below is labelled. Manufacturing, Production planning, Procurement, Inventory, Warehouse management, Quality management, Maintenance and Supply chain are Live. Within a module, what is not built yet is labelled Planned.</p>
      </div>
      <div class="sys-legend">
        <h3 class="sys-subhead">What the labels mean</h3>
        <StatusLegend />
      </div>
      <ul class="sys-features sys-features--spaced" role="list">
        {modules.map((m) => (
          <li class:list={['sys-feature', { 'sys-feature--planned': m.st === 'planned' }]} id={m.id}>
            <div class="sys-feature__head"><h3>{m.name}</h3><StatusLabel status={m.st} /></div>
            <p class="sys-feature__state">{m.st === 'planned' ? 'Planned: not available yet.' : m.st === 'live' ? `Live: works today in BIZOMAT ERP, under ${m.where ?? 'Operations'}.` : 'In development: not available yet.'}</p>
            <p>{m.x}</p>
            {m.items && <ul class="pp-list sys-items sys-feature__items">{m.items.map((i) => <li><span>{i.t}</span> <StatusLabel status={i.st} /></li>)}</ul>}
            {m.today && (
              <p class="sys-feature__today">Today: {m.today.map((i) => <><span>{i.t}</span> <StatusLabel status={i.st} /></>)}</p>
            )}
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="today" aria-labelledby="today-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">What exists today</p>
        <h2 id="today-title">What you can use now, in BIZOMAT ERP</h2>
        <p>These systems work today: production, purchasing, stock and deliveries in the ERP, with the customers, money, plans and drawings around them.</p>
      </div>
      <div class="pp-tools">
        {today.map((g) => (
          <section aria-labelledby={`today-${g.url.split('/')[2]}`}>
            <h3 id={`today-${g.url.split('/')[2]}`}><a href={g.url}>{g.name}</a></h3>
            <ul class="pp-list sys-items">{g.items.map((i) => <li><span>{i.t}</span> <StatusLabel status={i.st} /></li>)}</ul>
          </section>
        ))}
      </div>
    </Container>
  </section>

  <section class="pp-section" id="design" aria-labelledby="design-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">How it fits together</p>
        <h2 id="design-title">Working through the systems you already use</h2>
        <p>The modules use the CRM and Finance for customers, Finance for bills, invoices and credit notes, and Projects for the work around an order. Nothing is copied: each record stays in its own system. Posting stock and production value to Finance’s ledger is planned.</p>
      </div>
      <div class="sys-concepts">
        <figure class="sys-concept">
          <h3 class="sys-subhead">Selling and making</h3>
          <ol aria-label="Flow for selling and making">{sellFlow.map((s) => <li><span>{s}</span></li>)}</ol>
          <figcaption><span>From a customer’s order to an invoice. Every step works today; the invoice is a draft that Finance’s approval posts.</span><span class="viz__tag viz__tag--real">Working flow</span></figcaption>
        </figure>
        <figure class="sys-concept">
          <h3 class="sys-subhead">Buying and receiving</h3>
          <ol aria-label="Flow for buying and receiving">{buyFlow.map((s) => <li><span>{s}</span></li>)}</ol>
          <figcaption><span>From a requisition to a supplier bill. Every step works today; the bill is a draft that Finance’s approval posts.</span><span class="viz__tag viz__tag--real">Working flow</span></figcaption>
        </figure>
      </div>
      {supplyShots.map((shot) => (
        <figure class="pp-shot sys-preview">
          <img src={shot.src} alt={`${shot.title}. ${shot.caption}`} width="1440" height="900" loading="lazy" decoding="async" />
          <figcaption><span>Supply Chain, with the example company's invented data. {shot.caption}</span><span class="viz__tag viz__tag--real">Product screen</span></figcaption>
        </figure>
      ))}
      {floorShot && (
        <figure class="pp-shot sys-preview">
          <img src={floorShot.src} alt={`${floorShot.title}. ${floorShot.caption}`} width="1440" height="900" loading="lazy" decoding="async" />
          <figcaption><span>Manufacturing, which works today. {floorShot.caption}</span><span class="viz__tag viz__tag--real">Product screen</span></figcaption>
        </figure>
      )}
      {qualityShot && (
        <figure class="pp-shot sys-preview">
          <img src={qualityShot.src} alt={`${qualityShot.title}. ${qualityShot.caption}`} width="1440" height="900" loading="lazy" decoding="async" />
          <figcaption><span>Quality, which works today. {qualityShot.caption}</span><span class="viz__tag viz__tag--real">Product screen</span></figcaption>
        </figure>
      )}
      {maintenanceShot && (
        <figure class="pp-shot sys-preview">
          <img src={maintenanceShot.src} alt={`${maintenanceShot.title}. ${maintenanceShot.caption}`} width="1440" height="900" loading="lazy" decoding="async" />
          <figcaption><span>Maintenance, which works today. {maintenanceShot.caption}</span><span class="viz__tag viz__tag--real">Product screen</span></figcaption>
        </figure>
      )}
      {pmShots.map((shot) => (
        <figure class="pp-shot sys-preview">
          <img src={shot.src} alt={`${shot.title}. ${shot.caption}`} width="1440" height="900" loading="lazy" decoding="async" />
          <figcaption><span>Maintenance, with the example company's invented data. {shot.caption}</span><span class="viz__tag viz__tag--real">Product screen</span></figcaption>
        </figure>
      ))}
    </Container>
  </section>

  <section class="pp-section pp-section--tint" id="faq" aria-labelledby="faq-title">
    <Container>
      <div class="pp-head">
        <p class="bz-eyebrow">Questions</p>
        <h2 id="faq-title">About Manufacturing and Operations</h2>
      </div>
      <dl class="sys-faq sys-faq--wide">
        {faqs.map((f) => <div><dt>{f.q}</dt><dd>{f.a}</dd></div>)}
      </dl>
      <p class="pp-table-note">Step by step: the <a href={sys.guide}>Manufacturing and Operations user guide</a>. Missing something? <a href="/contact/?service=feedback#enquiry">Tell us what you need it for</a>.</p>
    </Container>
  </section>

  <section class="pp-section pp-section--inverse" aria-labelledby="mfg-cta">
    <Container class="pp-band">
      <div>
        <h2 id="mfg-cta">Make, buy, store, check, maintain and ship in one workspace.</h2>
        <p>{erp.access?.note}</p>
      </div>
      <div class="pp-band__actions">
        <Button href={APP_LINKS.erp.home} variant="accent" rel="noopener" data-cta="mfg-band-erp">Use BIZOMAT ERP today</Button>
        <Button href={sys.guide} variant="secondary" data-cta="mfg-band-guide">User guide</Button>
        <Button href={erp.url} variant="secondary" data-cta="mfg-band-about">About {erp.name}</Button>
        <Button href={SYSTEMS_HOME} variant="secondary" data-cta="mfg-band-all">All systems</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
