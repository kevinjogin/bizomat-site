---
// /assessment/: KEVOS® Engineering Problem Assessment, a fixed-price A$195 remote review of one defined problem.
// Content comes from src/config/assessment.ts; the PDFs, QR code and images come from scripts/assessment/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Button from '../../components/Button.astro';
import CallToAction from '../../components/CallToAction.astro';
import AssessmentHeroArt from '../../components/assessment/AssessmentHeroArt.astro';
import AssessmentIcon from '../../components/assessment/AssessmentIcon.astro';
import AssessmentExamples from '../../components/assessment/AssessmentExamples.astro';
import AssessmentJourney from '../../components/assessment/AssessmentJourney.astro';
import AssessmentReportPreview from '../../components/assessment/AssessmentReportPreview.astro';
import AssessmentForm from '../../components/assessment/AssessmentForm.astro';
import { SITE } from '../../config/site.ts';
import { ASSESSMENT, ASSETS, CHOOSING, CONDITIONS, EXCLUSIONS, FAQ_ITEMS, INCLUSIONS } from '../../config/assessment.ts';
import { FACTORY_FIX } from '../../data/services.ts';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Engineering Problem Assessment', href: ASSESSMENT.path },
];
const url = new URL(ASSESSMENT.path, SITE.url).href;
const service = {
  '@type': 'Service',
  '@id': `${url}#service`,
  name: ASSESSMENT.name,
  serviceType: 'Engineering problem assessment',
  description: ASSESSMENT.summary,
  url,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'Australia' },
  availableChannel: { '@type': 'ServiceChannel', serviceUrl: `${url}#request`, availableLanguage: 'en-AU' },
  offers: {
    '@type': 'Offer',
    name: ASSESSMENT.name,
    price: ASSESSMENT.price.toFixed(2),
    priceCurrency: ASSESSMENT.currency,
    url,
    availability: 'https://schema.org/InStock',
    eligibleRegion: { '@type': 'Country', name: 'Australia' },
    seller: { '@id': `${SITE.url}/#organization` },
  },
};
const icons = ['understand', 'discussion', 'review', 'options', 'report'] as const;
const facts = [
  { value: '1', label: 'defined problem' },
  { value: '30', label: 'minute remote discussion' },
  { value: '3', label: 'improvement options, at most' },
  { value: '1', label: 'page PDF recommendation' },
];
const included = ['One defined problem', 'Up to 30 minutes of remote technical discussion', 'Preliminary review of supplied information', 'Up to three improvement options', 'One-page PDF recommendation'];
---

<BaseLayout
  title={ASSESSMENT.seo.title}
  description={ASSESSMENT.seo.description}
  canonical={ASSESSMENT.path}
  image={ASSETS.social}
  imageAlt="KEVOS® Engineering Problem Assessment: A$195 for one defined engineering or manufacturing problem"
  breadcrumbs={crumbs}
  schema={[service]}
>
  <section class="ah" aria-labelledby="ah-title">
    <Container class="ah__inner">
      <div class="ah__copy">
        <Breadcrumb items={crumbs} />
        <p class="eyebrow ah__eyebrow">{ASSESSMENT.name}</p>
        <h1 id="ah-title" class="ah__title" set:html={ASSESSMENT.heroTitle} />
        <p class="ah__sub">{ASSESSMENT.heroLines.map((line) => <span>{line}</span>)}</p>
        <div class="ah__price" aria-label={`Price: ${ASSESSMENT.priceLabel}, ${ASSESSMENT.priceCaption}`}>
          <span class="ah__amount">{ASSESSMENT.priceLabel}</span>
          <span class="ah__caption">{ASSESSMENT.priceCaption}<small>{ASSESSMENT.gstNote}</small></span>
        </div>
        <div class="ah__actions">
          <Button href="#request" arrow data-cta="assessment-hero-request">Request an Assessment</Button>
          <Button href="#included" variant="secondary" data-cta="assessment-hero-included">See What You Receive</Button>
        </div>
        <p class="ah__tertiary">Already know what you need? <a href="/contact/" data-cta="assessment-hero-quote">Request a Free Quote</a>.</p>
      </div>
      <div class="ah__visual"><AssessmentHeroArt /></div>
    </Container>
  </section>

  <Section index="01" label="The service" labelledby="about-title">
    <div class="intro">
      <div>
        <h2 id="about-title">A focused engineering view, before a bigger commitment.</h2>
      </div>
      <div class="intro__text">
        {ASSESSMENT.description.map((p) => <p>{p}</p>)}
        <p class="muted">
          It suits manufacturers, fabricators, equipment builders and product businesses across Australia that need a mechanical design review,
          practical manufacturing problem solving, a jig and fixture assessment or a first view on manufacturing process improvement. KEVOS® is an
          engineering consultancy based in Sydney, and the assessment is delivered remotely anywhere in Australia.
        </p>
      </div>
    </div>
    <ul class="facts">
      {facts.map((f) => <li><span class="facts__value">{f.value}</span><span class="facts__label">{f.label}</span></li>)}
    </ul>
  </Section>

  <Section index="02" label="What you receive" id="included" tone="alt" labelledby="included-title">
    <div class="section-head">
      <h2 id="included-title">Five things, for one fixed price.</h2>
      <p>Everything below is included in {ASSESSMENT.priceLabel}. The assessment gives a preliminary view; it does not promise root-cause identification, certification or a guaranteed solution.</p>
    </div>
    <ol class="inc">
      {
        INCLUSIONS.map((item, i) => (
          <li class:list={['inc__card', { 'inc__card--wide': i === 4 }]}>
            <div class="inc__top">
              <span class="inc__num">{item.number}</span>
              <span class="inc__icon"><AssessmentIcon name={icons[i]} /></span>
            </div>
            <h3 class="inc__title">{item.title}</h3>
            <p class="inc__text">{item.text}</p>
            {item.points && <ul class="inc__points">{item.points.map((p) => <li>{p}</li>)}</ul>}
          </li>
        ))
      }
    </ol>
  </Section>

  <Section index="03" label="Examples" id="examples" labelledby="examples-title">
    <div class="section-head">
      <h2 id="examples-title">What can we help you assess?</h2>
      <p>Eight common types of engineering and manufacturing problem. Choose one to see the information that helps and what a preliminary review might identify.</p>
    </div>
    <AssessmentExamples />
  </Section>

  <Section index="04" label="How it works" id="process" tone="alt" labelledby="process-title">
    <div class="section-head">
      <h2 id="process-title">Submit. Confirm. Pay. Book. Receive.</h2>
      <p>Twelve clear steps. Nothing is paid until KEVOS® confirms the problem suits the assessment, and nothing is booked until the calendar confirms it.</p>
    </div>
    <AssessmentJourney />
  </Section>

  <Section index="05" label="Sample report" id="sample" labelledby="sample-title">
    <div class="section-head">
      <h2 id="sample-title">See what the written recommendation looks like.</h2>
      <p>This sample is fictional. It shows the format only; it is not client work and contains no real engineering evidence. Final findings in every real report are prepared or reviewed by the responsible KEVOS® professional.</p>
    </div>
    <AssessmentReportPreview />
  </Section>

  <Section index="06" label="Price and conditions" id="terms" tone="alt" labelledby="terms-title">
    <div class="pricing">
      <div class="price-card">
        <p class="price-card__eyebrow">{ASSESSMENT.shortName}</p>
        <p class="price-card__amount">{ASSESSMENT.priceLabel}</p>
        <p class="price-card__caption">{ASSESSMENT.priceCaption}, one defined problem</p>
        <ul class="price-card__list">{included.map((i) => <li>{i}</li>)}</ul>
        <Button href="#request" arrow data-cta="assessment-price-request">Request an Assessment</Button>
        <p class="price-card__note">{ASSESSMENT.gstNote} No payment is taken through this website.</p>
      </div>
      <div class="conditions">
        <h2 id="terms-title">Price, exclusions and conditions, before you enquire.</h2>
        <h3 class="conditions__label">Not included</h3>
        <ul class="exclusions">{EXCLUSIONS.map((e) => <li>{e}</li>)}</ul>
        <p class="muted">Further engineering services require separate scoping and a written quote.</p>
        <h3 class="conditions__label">Conditions</h3>
        <dl class="cond">
          {
            CONDITIONS.map((c) => (
              <div>
                <dt>{c.title}</dt>
                <dd>{c.text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="muted">These conditions form part of the <a href="/terms/#assessment">website terms</a>. Read how enquiry information is handled in the <a href="/privacy/">privacy policy</a>.</p>
      </div>
    </div>
  </Section>

  <Section index="07" label="Choosing" id="choose" labelledby="choose-title">
    <div class="section-head">
      <h2 id="choose-title">Assessment or Factory Fix?</h2>
      <p>Start small when you need a view and a next step. Go further when the problem is known to be worth solving now.</p>
    </div>
    <div class="choose">
      <article class="choose__card choose__card--a">
        <p class="choose__price">{ASSESSMENT.priceLabel} · fixed</p>
        <h3>{ASSESSMENT.shortName}</h3>
        <ul>{CHOOSING.assessment.map((c) => <li>{c}</li>)}</ul>
        <Button href="#request" arrow>Request an Assessment</Button>
      </article>
      <article class="choose__card">
        <p class="choose__price">{FACTORY_FIX.price} · scoped</p>
        <h3>{FACTORY_FIX.name}</h3>
        <ul>{CHOOSING.factoryFix.map((c) => <li>{c}</li>)}</ul>
        <Button href="/factory-fix/" variant="secondary" arrow>Explore Factory Fix</Button>
      </article>
    </div>
    <p class="choose__quote">{CHOOSING.quote} <a href="/contact/">Request a Free Quote</a>.</p>
  </Section>

  <Section index="08" label="Request" id="request" tone="alt" labelledby="request-title">
    <div class="request">
      <div class="request__intro">
        <h2 id="request-title">Request an assessment.</h2>
        <p class="request__lead">Tell KEVOS® about the problem. You will hear back whether it suits the fixed-price assessment before anything is paid or booked.</p>
        <ol class="request__next">
          <li>KEVOS® reviews your enquiry and may ask for more information.</li>
          <li>If it is suitable, you receive the confirmed scope and payment instructions.</li>
          <li>After payment is verified, you receive booking instructions for the 30-minute meeting.</li>
        </ol>
        <p class="request__note">Drawings, photographs and documents are shared after KEVOS® replies, never through this form. A confidentiality agreement can be arranged first.</p>
      </div>
      <div class="request__form">
        <AssessmentForm />
      </div>
    </div>
  </Section>

  <Section index="09" label="Questions" id="faq" labelledby="faq-title">
    <h2 id="faq-title" class="faq-title">Assessment questions.</h2>
    <div class="faq">
      {
        FAQ_ITEMS.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <Section index="10" label="Share and print" id="share" tone="alt" labelledby="share-title">
    <div class="share">
      <div>
        <h2 id="share-title">Take the assessment with you.</h2>
        <p class="muted">A one-page brochure for email or print, the fictional sample report and a printable QR code that opens this page.</p>
      </div>
      <ul class="share__list">
        <li><a href={ASSETS.brochure} download>Service brochure <span>PDF · A4</span></a></li>
        <li><a href={ASSETS.sampleReport} download>Sample report <span>PDF · A4 · fictional</span></a></li>
        <li><a href={ASSETS.qrCard} download>Printable QR card <span>PDF · A6</span></a></li>
        <li><a href={ASSETS.qrPng} download>QR code <span>PNG · high resolution</span></a></li>
        <li><a href={ASSETS.qrSvg} download>QR code <span>SVG · vector</span></a></li>
      </ul>
      <img class="share__qr" src={ASSETS.qrSvg} alt="QR code that opens kevos.com/assessment/" width="180" height="180" loading="lazy" decoding="async" />
    </div>
  </Section>

  <CallToAction
    title="One problem. A clear next step."
    text={`Describe the problem. KEVOS® confirms whether it suits the ${ASSESSMENT.priceLabel} assessment before anything is paid or booked.`}
    href="#request"
    label="Request an Assessment"
  />
</BaseLayout>

<style>
  :global(#included), :global(#examples), :global(#process), :global(#sample), :global(#terms), :global(#choose), :global(#request), :global(#faq), :global(#share) { scroll-margin-top: calc(var(--header-h) + 1rem); }
  .ah { padding-block: clamp(2.5rem, 5vw, 5rem) clamp(3rem, 6vw, 5.5rem); }
  :global(.ah__inner) { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(2rem, 4vw, 4.5rem); align-items: center; }
  .ah__eyebrow { margin-top: 1.5rem; }
  .ah__title { margin: 1rem 0 0; font-size: clamp(2.3rem, 1.6rem + 3.4vw, 4.6rem); line-height: 1.02; max-width: 15ch; }
  .ah__title :global(em) { display: block; }
  .ah__sub { display: grid; gap: 0.15rem; margin: 1.5rem 0 0; font-size: var(--step-1); line-height: 1.45; color: var(--ink-2); }
  .ah__price { display: flex; align-items: center; gap: 1rem 1.25rem; flex-wrap: wrap; margin-top: 1.75rem; padding: 1rem 1.25rem; border: 1px solid var(--line-strong); border-left: 4px solid var(--brand-orange); border-radius: var(--radius); background: var(--surface); max-width: 34rem; }
  .ah__amount { font-family: var(--font-display); font-size: clamp(2.4rem, 1.9rem + 2vw, 3.4rem); font-weight: 700; line-height: 1; letter-spacing: -0.02em; color: var(--ink); }
  .ah__caption { display: grid; gap: 0.2rem; font-weight: 600; color: var(--ink); }
  .ah__caption small { font-size: 0.8rem; font-weight: 400; color: var(--muted); max-width: 34ch; }
  .ah__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .ah__tertiary { margin: 1.1rem 0 0; color: var(--muted); font-size: 0.95rem; }
  .ah__tertiary a { color: var(--ink); text-decoration-color: var(--accent); }
  .ah__visual { min-width: 0; justify-self: end; width: 100%; max-width: 560px; }
  @media (max-width: 960px) { :global(.ah__inner) { grid-template-columns: 1fr; } .ah__visual { justify-self: start; } }

  .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 2rem 5rem; }
  .intro h2 { max-width: 18ch; }
  .intro__text p:first-child { font-size: var(--step-1); color: var(--ink); }
  .intro__text p { color: var(--ink-2); max-width: 62ch; }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 2.5rem 0 0; padding: 0; list-style: none; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .facts li { display: grid; gap: 0.3rem; padding: 1.25rem 1.4rem; background: var(--surface); }
  .facts__value { font-family: var(--font-display); font-size: var(--step-3); font-weight: 700; line-height: 1; color: var(--accent); }
  .facts__label { color: var(--ink-2); font-size: 0.95rem; }
  @media (max-width: 860px) { .intro { grid-template-columns: 1fr; } .facts { grid-template-columns: 1fr 1fr; } }

  .section-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem 4rem; align-items: end; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .section-head h2 { max-width: 20ch; }
  .section-head p { margin: 0; color: var(--ink-2); max-width: 58ch; }
  @media (max-width: 860px) { .section-head { grid-template-columns: 1fr; } }

  .inc { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .inc__card { display: flex; flex-direction: column; gap: 0.6rem; padding: clamp(1.25rem, 2.5vw, 1.75rem); background: var(--surface); border: 1px solid var(--line); border-radius: 14px; position: relative; overflow: hidden; }
  .inc__card::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--brand-orange); transform: scaleX(0.18); transform-origin: left; transition: transform 0.4s var(--ease); }
  .inc__card:hover::after { transform: scaleX(1); }
  .inc__card--wide { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); grid-template-areas: 'top points' 'title points' 'text points'; column-gap: 3rem; align-items: start; }
  .inc__card--wide .inc__top { grid-area: top; }
  .inc__card--wide .inc__title { grid-area: title; }
  .inc__card--wide .inc__text { grid-area: text; }
  .inc__card--wide .inc__points { grid-area: points; columns: 2; }
  .inc__top { display: flex; justify-content: space-between; align-items: start; }
  .inc__num { font-family: var(--font-mono); font-size: 0.85rem; color: var(--accent); }
  .inc__icon { display: block; width: 3.4rem; color: var(--ink); }
  .inc__title { font-size: var(--step-1); }
  .inc__text { margin: 0; color: var(--ink-2); font-size: 0.97rem; line-height: 1.55; }
  .inc__points { margin: 0.25rem 0 0; padding: 0; list-style: none; }
  .inc__points li { position: relative; padding: 0.4rem 0 0.4rem 1.3rem; border-bottom: 1px solid var(--line); color: var(--ink-2); font-size: 0.94rem; break-inside: avoid; }
  .inc__points li::before { content: ''; position: absolute; left: 0; top: 0.95rem; width: 0.6rem; height: 1px; background: var(--accent); }
  @media (max-width: 1050px) { .inc { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) { .inc__card--wide { display: flex; } .inc__card--wide .inc__points { columns: 1; } }
  @media (max-width: 560px) { .inc { grid-template-columns: 1fr; } }

  .pricing { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.3fr); gap: 2.5rem 4.5rem; align-items: start; }
  .price-card { position: sticky; top: calc(var(--header-h) + 1.5rem); padding: clamp(1.5rem, 3vw, 2.25rem); background: var(--inverse-bg); color: var(--inverse-ink); border-radius: 14px; }
  .price-card__eyebrow { margin: 0; font-size: 0.78rem; font-weight: 560; letter-spacing: 0.12em; text-transform: uppercase; color: var(--inverse-muted); }
  .price-card__amount { margin: 0.6rem 0 0; font-family: var(--font-display); font-size: clamp(3rem, 2.2rem + 3vw, 4.6rem); font-weight: 700; line-height: 1; letter-spacing: -0.02em; }
  .price-card__caption { margin: 0.5rem 0 1.25rem; color: var(--inverse-muted); }
  .price-card__list { margin: 0 0 1.5rem; padding: 0; list-style: none; border-top: 1px solid var(--inverse-line); }
  .price-card__list li { position: relative; padding: 0.7rem 0 0.7rem 1.6rem; border-bottom: 1px solid var(--inverse-line); }
  .price-card__list li::before { content: ''; position: absolute; left: 0.1rem; top: 1.05rem; width: 0.8rem; height: 0.45rem; border-left: 2px solid var(--brand-orange); border-bottom: 2px solid var(--brand-orange); transform: rotate(-45deg); }
  .price-card :global(.button) { --b-bg: var(--inverse-ink); --b-fg: var(--inverse-bg); --b-border: var(--inverse-ink); }
  .price-card :global(.button:hover) { --b-bg: var(--brand-orange); --b-border: var(--brand-orange); --b-fg: #121211; }
  .price-card__note { margin: 1rem 0 0; font-size: 0.85rem; color: var(--inverse-muted); }
  .conditions h2 { font-size: var(--step-2); max-width: 26ch; margin-bottom: 1.75rem; }
  .conditions__label { margin: 1.75rem 0 0.75rem; font-family: var(--font-sans) !important; font-size: 0.78rem; font-weight: 560; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .exclusions { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0 0 1rem; padding: 0; list-style: none; }
  .exclusions li { padding: 0.35rem 0.75rem 0.35rem 1.9rem; position: relative; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.88rem; color: var(--ink-2); }
  .exclusions li::before, .exclusions li::after { content: ''; position: absolute; left: 0.8rem; top: 50%; width: 0.6rem; height: 1.5px; background: var(--muted); }
  .exclusions li::before { transform: rotate(45deg); }
  .exclusions li::after { transform: rotate(-45deg); }
  .cond { margin: 0; border-top: 1px solid var(--line-strong); }
  .cond div { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.5fr); gap: 0.4rem 2rem; padding: 0.95rem 0; border-bottom: 1px solid var(--line); }
  .cond dt { font-weight: 620; }
  .cond dd { margin: 0; color: var(--ink-2); line-height: 1.55; }
  .conditions > p.muted { margin-top: 1rem; font-size: 0.92rem; }
  @media (max-width: 960px) { .pricing { grid-template-columns: 1fr; } .price-card { position: static; } }
  @media (max-width: 600px) { .cond div { grid-template-columns: 1fr; } }

  .choose { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .choose__card { display: flex; flex-direction: column; gap: 0.9rem; align-items: start; padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--line-strong); border-radius: 14px; background: var(--surface); }
  .choose__card--a { border-color: var(--accent); box-shadow: inset 0 4px 0 var(--brand-orange); }
  .choose__price { margin: 0; font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .choose__card h3 { font-size: var(--step-2); }
  .choose__card ul { margin: 0 0 0.5rem; padding-left: 1.1rem; color: var(--ink-2); }
  .choose__card li { margin-bottom: 0.45rem; }
  .choose__quote { margin: 1.5rem 0 0; color: var(--ink-2); }
  .choose__quote a { color: var(--ink); text-decoration-color: var(--accent); font-weight: 560; }
  @media (max-width: 760px) { .choose { grid-template-columns: 1fr; } }

  .request { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: 2.5rem 4.5rem; align-items: start; }
  .request__intro { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .request__lead { margin: 1rem 0 1.5rem; font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); }
  .request__next { margin: 0; padding: 0; list-style: none; counter-reset: next; border-top: 1px solid var(--line); }
  .request__next li { counter-increment: next; display: grid; grid-template-columns: 2rem 1fr; padding: 0.85rem 0; border-bottom: 1px solid var(--line); color: var(--ink-2); }
  .request__next li::before { content: counter(next, decimal-leading-zero); font-size: 0.85rem; color: var(--accent); padding-top: 0.15rem; }
  .request__note { margin-top: 1.25rem; padding: 1rem 1.1rem; border-left: 3px solid var(--brand-orange); background: var(--paper); color: var(--ink-2); font-size: 0.94rem; }
  .request__form { padding: clamp(1.5rem, 3.5vw, 2.75rem); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  @media (max-width: 960px) { .request { grid-template-columns: 1fr; } .request__intro { position: static; } }

  .faq-title { margin-bottom: 2rem; max-width: 20ch; }
  .faq { border-top: 1px solid var(--line-strong); }
  .faq__item { border-bottom: 1px solid var(--line); }
