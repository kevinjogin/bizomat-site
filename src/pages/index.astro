---
// KEVOS® homepage: the technology and knowledge platform, led by WORKOS (tools) and READOS (books).
// Every count, topic, tool and book here is read from the WORKOS register and the READOS library at build time.
// Services, pricing, the assessment and Factory Fix live on their own pages (/services/, /assessment/, /factory-fix/).
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ServiceMap from '../components/ServiceMap.astro';
import HomeResourceVisual from '../components/HomeResourceVisual.astro';
import ReadOSAnimatedCover from '../components/ReadOSAnimatedCover.astro';
import LibraryIcon from '../components/library/LibraryIcon.astro';
import ToolCard from '../components/library/ToolCard.astro';
import BookCard from '../components/library/BookCard.astro';
import DiscoveryBox from '../components/discovery/DiscoveryBox.astro';
import DiscoveryResults from '../components/discovery/DiscoveryResults.astro';
import '../styles/discovery.css';
import '../styles/library.css';
import { SITE } from '../config/site.ts';
import { HOME_DISCOVERY_EXAMPLES, HOME_FEATURED_BOOKS, HOME_FEATURED_TOOLS, HOME_ORBIT } from '../config/home.ts';
import { loadWorkosTools, hasStandaloneGuide, toolPageHref, toolAppHref } from '../utils/workos-tools.ts';
import { groupToolsByTopic, subcategoryLabel, subcategorySlug, topicForCategory } from '../utils/workos-topics.ts';
import { buildReadosLibrary } from '../utils/reados-library.ts';
import { knowledgeGraph, learningPathways } from '../utils/knowledge.ts';

const { tools, guides } = loadWorkosTools();
const topics = groupToolsByTopic(tools, 0);
const subjects = await buildReadosLibrary();
const entries = subjects.flatMap((s) => s.entries.map((e) => ({ ...e, subject: s })));
const bookTotal = entries.length;
const chapterTotal = entries.reduce((n, e) => n + e.chapters.length, 0);
const pathways = learningPathways();
const connections = knowledgeGraph().live.length;
const fmt = (n: number) => n.toLocaleString('en-AU');

const pick = <T,>(ids: string[], find: (id: string) => T | undefined, kind: string) => ids.map((id) => {
  const item = find(id);
  if (!item) throw new Error(`src/config/home.ts: no ${kind} "${id}"`);
  return item;
});
const featuredTools = pick(HOME_FEATURED_TOOLS, (id) => tools.find((t) => t.id === id), 'WORKOS tool');
const featuredBooks = pick(HOME_FEATURED_BOOKS, (id) => entries.find((e) => e.id === id), 'READOS book');
// Cards link to a tool's own page where one exists, as on /tools/.
const toolHref = (id: string) => (hasStandaloneGuide(guides[id]) ? toolPageHref(id) : toolAppHref(id));

const orbit = HOME_ORBIT.map((o) => {
  const topic = topics.find((t) => t.slug === o.topic);
  const subject = subjects.find((s) => s.slug === o.subject);
  if (!topic || !subject) throw new Error(`src/config/home.ts: orbit node ${o.verb} names an unknown topic or subject`);
  return { verb: o.verb, label: topic.name.replace('&', '&amp;'), tags: `${fmt(topic.items.length)} tools · ${fmt(subject.entries.length)} books`, href: `/tools/?topic=${topic.slug}` };
});

const sections = [
  { id: 'workos', label: 'WORKOS' },
  { id: 'reados', label: 'READOS' },
  { id: 'connected', label: 'Learn, apply, improve' },
  { id: 'about', label: 'About KEVOS®' },
];
const description = 'Describe a problem and KEVOS® finds the WORKOS engineering and business tools and READOS technical books that help you solve it.';
const schema = [{
  '@type': 'WebPage', '@id': `${SITE.url}/#webpage`, url: `${SITE.url}/`, name: SITE.title, description, inLanguage: SITE.locale,
  isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': `${SITE.url}/#organization` },
  hasPart: [
    { '@type': 'CollectionPage', name: 'WORKOS', url: `${SITE.url}/tools/`, description: 'Practical engineering, manufacturing and business tools.' },
    { '@type': 'CollectionPage', name: 'READOS', url: `${SITE.url}/reados/`, description: 'Technical books, engineering references and structured learning resources.' },
  ],
}];
---
<BaseLayout description={description} imageAlt="KEVOS®: practical tools and technical knowledge with WORKOS and READOS" schema={schema} assistant={false}>
  <section class="home-hero" id="overview" aria-labelledby="home-title">
    <Container class="home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow">WORKOS tools · READOS knowledge</p>
        <h1 id="home-title">What would you like to <em>solve</em> today?</h1>
        <p class="home-hero__lead">Describe a problem, ask a question or tell us what you're trying to achieve. KEVOS® will help you discover the right tools, knowledge and practical solutions.</p>
        <DiscoveryBox suggestions={HOME_DISCOVERY_EXAMPLES} />
        <div class="home-hero__actions">
          <Button href="/tools/" arrow data-cta="hero-workos">Explore WORKOS</Button>
          <Button href="/reados/" variant="secondary" data-cta="hero-reados">Explore READOS</Button>
        </div>
        <dl class="home-stats">
          <div><dt>WORKOS tools</dt><dd>{fmt(tools.length)}</dd></div>
          <div><dt>READOS books</dt><dd>{fmt(bookTotal)}</dd></div>
          <div><dt>Chapters</dt><dd>{fmt(chapterTotal)}</dd></div>
        </dl>
      </div>
      <div class="home-hero__visual"><ServiceMap variant="platform" nodes={orbit} /></div>
    </Container>
  </section>

  <DiscoveryResults />

  <nav class="section-navigation" aria-label="Homepage sections">
    <Container>
      <ul>{sections.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ul>
    </Container>
  </nav>

  <Section index="01" label="WORKOS" id="workos" labelledby="workos-title">
    <div class="product">
      <div class="product__intro">
        <h2 id="workos-title">Practical tools. <em>Better decisions.</em></h2>
        <p class="section-intro">Explore practical engineering and business tools designed to calculate, analyse, evaluate and solve real-world problems.</p>
        <ul class="product__points">
          <li>Engineering calculators, manufacturing and production tools, technical analysis and business decisions in one directory.</li>
          <li>Every tool shows its method, checks feasibility and tests how sensitive the answer is.</li>
          <li>Download, print or share a report of your result. No account needed; calculations run in your browser.</li>
        </ul>
        <form class="lib-search home-search" role="search" action="/tools/" method="get">
          <label class="visually-hidden" for="home-workos-search">Search WORKOS tools</label>
          <div class="lib-search__field">
            <svg class="lib-search__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM15.3 15.3 20 20" /></svg>
            <input id="home-workos-search" name="q" type="search" placeholder={`Search ${fmt(tools.length)} tools...`} autocomplete="off" spellcheck="false" enterkeyhint="search" />
          </div>
          <Button type="submit" variant="secondary">Search</Button>
        </form>
        <div class="product__cta"><Button href="/tools/" arrow data-cta="home-workos">Explore WORKOS</Button></div>
      </div>
      <div class="product__visual"><HomeResourceVisual kind="workos" /></div>
    </div>

    <h3 class="home-label" id="workos-topics">Browse by topic</h3>
    <ul class="lib-topic-grid lib-topic-grid--3" role="list" aria-labelledby="workos-topics">
      {topics.map((t) => (
        <li>
          <a class="lib-topic" href={`/tools/?topic=${t.slug}`}>
            <span class="lib-topic__icon"><LibraryIcon name={t.icon} /></span>
            <span class="lib-topic__text"><span class="lib-topic__name">{t.name}</span><span class="lib-topic__desc">{t.description}</span></span>
            <span class="lib-topic__count" aria-label={`${fmt(t.items.length)} tools`}>{fmt(t.items.length)}</span>
          </a>
        </li>
      ))}
    </ul>

    <h3 class="home-label" id="workos-featured">Featured tools</h3>
    <div class="lib-grid" role="list" aria-labelledby="workos-featured">
      {featuredTools.map((t) => (
        <div role="listitem" class="home-card">
          <ToolCard id={t.id} href={toolHref(t.id)} name={t.name} purpose={t.question} category={subcategoryLabel(t.category)} topic={topicForCategory(t.category).slug} sub={subcategorySlug(t.category)} collection={t.collection === 'MAKEOS' ? 'MAKEOS' : 'WORKOS'} tags="" body="" />
        </div>
      ))}
    </div>
  </Section>

  <Section index="02" label="READOS" tone="alt" id="reados" labelledby="reados-title">
    <div class="product">
      <div class="product__intro">
        <h2 id="reados-title">Knowledge worth <em>applying.</em></h2>
        <p class="section-intro">Explore technical books, engineering references and structured learning resources that turn knowledge into practical understanding.</p>
        <ul class="product__points">
          <li>Engineering and technical subjects, manufacturing and operations, and technology and business knowledge.</li>
          <li>Books are organised into chapters you can read in one sitting, with figures and worked numbers.</li>
          <li>Many chapters link to the WORKOS tools that put the method to work.</li>
        </ul>
        <form class="lib-search home-search" role="search" action="/reados/" method="get">
          <label class="visually-hidden" for="home-reados-search">Search READOS books</label>
          <div class="lib-search__field">
            <svg class="lib-search__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM15.3 15.3 20 20" /></svg>
            <input id="home-reados-search" name="q" type="search" placeholder={`Search ${fmt(bookTotal)} books...`} autocomplete="off" spellcheck="false" enterkeyhint="search" />
          </div>
          <Button type="submit" variant="secondary">Search</Button>
        </form>
        <div class="product__cta"><Button href="/reados/" arrow data-cta="home-reados">Explore READOS</Button></div>
      </div>
      <div class="product__visual"><HomeResourceVisual kind="reados" /></div>
    </div>

    <h3 class="home-label" id="reados-subjects">Browse by subject</h3>
    <ul class="lib-topic-grid lib-topic-grid--4" role="list" aria-labelledby="reados-subjects">
      {subjects.map((s) => (
        <li>
          <a class="lib-topic" href={`/reados/?topic=${s.slug}`}>
            <span class="lib-topic__icon"><LibraryIcon name={s.icon} /></span>
            <span class="lib-topic__text"><span class="lib-topic__name">{s.name}</span><span class="lib-topic__desc">{s.description}</span></span>
            <span class="lib-topic__count" aria-label={`${fmt(s.entries.length)} books`}>{fmt(s.entries.length)}</span>
          </a>
        </li>
      ))}
    </ul>

    <h3 class="home-label" id="reados-featured">Featured books</h3>
    <div class="lib-grid" role="list" aria-labelledby="reados-featured">
      {featuredBooks.map((e) => (
        <div role="listitem" class="home-card">
          <BookCard id={e.id} href={e.href} startHref={e.startHref} title={e.title} summary={e.summary} subject={e.subject.name} chapters={e.chapters.length} topic={e.subject.slug} tags="" chapterTitles="">
            <ReadOSAnimatedCover slot="cover" {...e.cover} chapters={e.chapters.length} compact />
          </BookCard>
        </div>
      ))}
    </div>
  </Section>

  <Section index="03" label="The connected KEVOS® ecosystem" id="connected" labelledby="connected-title">
    <div class="section-head">
      <div>
        <h2 id="connected-title">Learn. Apply. <em>Improve.</em></h2>
        <p class="section-intro">KEVOS® connects technical knowledge with practical tools, helping people move from understanding a concept to applying it in real-world situations.</p>
      </div>
    </div>
    <ol class="flow">
      <li class="flow__step">
        <p class="flow__name"><a href="/reados/">READOS</a></p>
        <h3>Learn and understand</h3>
        <p>Read the method, the reasoning and the worked numbers behind a decision.</p>
      </li>
      <li class="flow__step">
        <p class="flow__name"><a href="/tools/">WORKOS</a></p>
        <h3>Calculate, analyse and apply</h3>
        <p>Enter your own figures, check the result and keep a report of what you decided.</p>
      </li>
      <li class="flow__step">
        <p class="flow__name"><a href="#overview">Ask KEVOS®</a></p>
        <h3>Describe it, discover it</h3>
        <p>Describe a problem in your own words at the top of this page. KEVOS® suggests the WORKOS tools and READOS chapters that fit; the tools do the calculating.</p>
      </li>
    </ol>
    <p class="flow__note">Today, {fmt(connections)} reviewed links connect READOS books and chapters with the WORKOS tools that apply them. These learning pathways take you from a chapter to a tool:</p>
    <ul class="pathways">
      {pathways.map((p) => (
        <li class="pathway">
          <h3>{p.title}</h3>
          <p class="pathway__summary">{p.summary}</p>
          <dl>
            <div><dt>Learn</dt><dd><a href={p.learn.href}>{p.learn.title}</a> <span>in {p.learn.book}</span></dd></div>
            <div><dt>Apply</dt><dd><a href={p.apply.href}>{p.apply.name}</a></dd></div>
          </dl>
        </li>
      ))}
    </ul>
  </Section>

  <Section index="04" label="About KEVOS®" tone="alt" id="about" labelledby="about-title">
    <div class="about-intro">
      <h2 id="about-title">Building a connected ecosystem.</h2>
      <div>
        <p class="section-intro">KEVOS® is building a connected technology, engineering and knowledge ecosystem, bringing together practical digital tools and structured technical resources.</p>
        <p class="about-intro__link"><a href="/about/">About KEVOS® <span aria-hidden="true">→</span></a></p>
        <p class="fineprint">KEVOS® also takes on defined engineering assignments. See <a href="/services/">services</a> or get in touch through <a href="/contact/">REACHOS</a>.</p>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  // "What would you like to solve today?": discovery over the WORKOS and READOS catalogue.
  import '../scripts/discovery.ts';
</script>

<script>
  // The homepage used to hold the services, pricing and proof of work. Old links to those sections
  // (for example /#pricing or /#case-<id>) are sent to the page that now holds them.
  const moved: Record<string, string> = {
    services: '/services/', 'engineering-cad': '/services/#engineering-cad', manufacturing: '/services/#manufacturing',
    operations: '/services/#operations', 'project-support': '/services/#project-support', pricing: '/services/#pricing',
    assessment: '/assessment/', 'factory-fix': '/factory-fix/', 'how-it-works': '/how-it-works/', industries: '/industries/',
    work: '/about/#work', resources: '#workos',
  };
  const forward = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const to = id.startsWith('case-') ? `/about/#${id}` : moved[id];
    if (to) location.replace(to);
  };
  forward();
  window.addEventListener('hashchange', forward);
</script>

<style>
  :global(#overview), :global(#workos), :global(#reados), :global(#connected), :global(#about) { scroll-margin-top:calc(var(--header-h) + 4.2rem); }
  .home-hero{padding:clamp(3rem,6vw,6.5rem) 0}
  :global(.home-hero__inner){display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.8fr);gap:3rem 4rem;align-items:center}
  .home-hero__copy h1{margin:1rem 0 1rem;max-width:15ch;font-size:clamp(2.1rem,4.4vw,4.4rem);line-height:1.04}
  .home-hero__lead{font-size:var(--step-1);line-height:1.5;max-width:48ch;color:var(--ink-2)}
  .home-hero__actions{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:2rem}
  .home-hero__visual{min-width:0}
  .home-stats{display:flex;flex-wrap:wrap;gap:1rem 2.5rem;margin:2.2rem 0 0;padding-top:1.2rem;border-top:1px solid var(--line)}
  .home-stats dt{font-size:.78rem;font-weight:560;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .home-stats dd{margin:.3rem 0 0;font-family:var(--font-display);font-size:clamp(1.5rem,2.6vw,2.1rem);font-weight:700;line-height:1.1;color:var(--ink);font-variant-numeric:tabular-nums}
  .section-navigation{position:sticky;top:var(--header-h);z-index:19;background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line-strong)}
  .section-navigation ul{display:flex;gap:clamp(1rem,2.5vw,2.2rem);align-items:center;overflow-x:auto;scrollbar-width:thin;list-style:none;padding:.85rem 0;margin:0}
  .section-navigation a{white-space:nowrap;font-size:.83rem;font-weight:560;color:var(--ink-2);text-decoration:none}
  .section-navigation a:hover{color:var(--accent)}
  .section-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:2.2rem}
  .section-head h2{max-width:24ch}
  .section-intro{margin:1rem 0 0;max-width:74ch;font-size:var(--step-1);color:var(--ink-2)}
  .fineprint{color:var(--muted);font-size:.88rem;margin:1.75rem 0 0}
  .fineprint a{color:var(--ink-2)}
  .product{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:2.5rem 4rem;align-items:center}
  .product__intro{min-width:0}
  .product__intro h2{max-width:18ch}
  .product__points{display:grid;gap:.6rem;margin:1.5rem 0 0;padding:0;list-style:none;max-width:60ch}
  .product__points li{border-left:2px solid var(--accent);padding-left:1rem;color:var(--ink-2);font-size:.95rem}
  .home-search{margin-top:1.75rem;max-width:36rem}
  .product__cta{margin-top:1.25rem}
  .product__visual{min-width:0;border:1px solid var(--line)}
  .home-label{margin:clamp(2.5rem,5vw,3.5rem) 0 1rem;font-family:var(--font-sans);font-size:.78rem;font-weight:560;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .home-card{display:flex;min-width:0}
  .home-card > :global(*){flex:1;min-width:0}
  .flow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin:0;padding:0;list-style:none;border:1px solid var(--line);background:var(--line);counter-reset:flow}
  .flow__step{background:var(--surface);padding:clamp(1.3rem,3vw,2rem);counter-increment:flow}
  .flow__step::before{content:counter(flow,decimal-leading-zero);display:block;margin-bottom:.9rem;color:var(--accent);font-size:.85rem;font-variant-numeric:tabular-nums}
  .flow__name{margin:0 0 .4rem;font-size:.78rem;font-weight:650;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
  .flow__name a{color:inherit;text-decoration:none}
  .flow__name a:hover{text-decoration:underline;text-underline-offset:3px}
  .flow__step h3{font-size:var(--step-1)}
  .flow__step p:not(.flow__name){margin:.6rem 0 0;color:var(--ink-2);font-size:.94rem}
  .flow__note{margin:2.5rem 0 1.2rem;max-width:74ch;color:var(--ink-2)}
  .pathways{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin:0;padding:0;list-style:none}
  .pathway{display:flex;flex-direction:column;gap:.6rem;min-width:0;padding:1.2rem 1.25rem;border:1px solid var(--line);border-left:3px solid var(--accent);background:var(--surface)}
  .pathway h3{font-size:1.05rem}
  .pathway__summary{margin:0;color:var(--ink-2);font-size:.9rem}
  .pathway dl{display:grid;gap:.45rem;margin:auto 0 0;padding-top:.6rem;border-top:1px solid var(--line)}
  .pathway dl div{display:grid;grid-template-columns:4rem minmax(0,1fr);gap:.5rem;font-size:.86rem}
  .pathway dt{font-size:.72rem;font-weight:650;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding-top:.1rem}
  .pathway dd{margin:0}
  .pathway dd a{color:var(--accent);font-weight:600}
  .pathway dd span{color:var(--muted)}
  .about-intro{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1fr);gap:1.5rem 5rem}
  .about-intro h2{max-width:16ch}
  .about-intro .section-intro{margin-top:0}
  .about-intro__link{margin:1.25rem 0 0}
  .about-intro__link a{color:var(--accent);font-weight:600;text-decoration:none}
  .about-intro__link a:hover{text-decoration:underline;text-underline-offset:3px}
  @media(max-width:1050px){.pathways{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:860px){:global(.home-hero__inner){grid-template-columns:1fr}.home-hero__visual{max-width:580px}.product,.about-intro{grid-template-columns:1fr}.product__visual{max-width:640px}.flow{grid-template-columns:1fr}}
  @media(max-width:640px){.pathways{grid-template-columns:1fr}.home-search{grid-template-columns:minmax(0,1fr) auto}}
</style>
