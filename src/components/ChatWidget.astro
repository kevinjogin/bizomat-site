---
// KEVOS Assistant: floating receptionist chat (bottom-right on every page), with minimise and
// pop-out. In "page" mode it fills the /chat/ pop-out window instead of floating.
// Answers come from /api/chat (Cloudflare Workers AI), grounded only in this website's content.
import { SITE } from '../config/site.ts';

interface Props {
  mode?: 'floating' | 'page';
}
const { mode = 'floating' } = Astro.props;
const name = SITE.assistant.name;
const prompts = ['Can KEVOS support my project?', 'I need engineering or CAD support', 'I need manufacturing support', 'I want to improve a process or operation'];
---

<div class:list={['assistant', `assistant--${mode}`]} data-assistant data-mode={mode} data-endpoint={SITE.assistant.endpoint}>
  {
    mode === 'floating' && (
      <button class="assistant__launcher" type="button" aria-expanded="false" aria-controls="assistant-panel" data-assistant-open>
        <img src={SITE.icon} alt="" width="28" height="28" loading="lazy" />
        <span>Ask KEVOS</span>
      </button>
    )
  }

  <section class="assistant__panel" id="assistant-panel" role="dialog" aria-modal="false" aria-labelledby="assistant-title" hidden={mode === 'floating'} data-assistant-panel>
    <header class="assistant__header">
      <img class="assistant__avatar" src={SITE.icon} alt="" width="36" height="36" loading="lazy" />
      <div class="assistant__heading">
        {mode === 'page' ? <h1 id="assistant-title">{name}</h1> : <h2 id="assistant-title">{name}</h2>}
        <p><span class="assistant__dot" aria-hidden="true"></span>Engineering &amp; project enquiry support</p>
      </div>
      <div class="assistant__actions">
        {
          mode === 'floating' ? (
            <Fragment>
              <button class="assistant__icon assistant__expand" type="button" data-assistant-expand aria-pressed="false" aria-label="Expand the assistant" title="Expand">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <a class="assistant__icon" href="/chat/" target="gocore-assistant" data-assistant-popout aria-label="Open the assistant in a new window" title="Pop out">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 4h6v6M20 4l-8 8M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
              <button class="assistant__icon" type="button" data-assistant-minimise aria-label="Minimise the assistant" title="Minimise">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 12h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
              </button>
            </Fragment>
          ) : (
            <button class="assistant__icon" type="button" data-assistant-close-window aria-label="Close this window" title="Close">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            </button>
          )
        }
      </div>
    </header>

    <div class="assistant__log" role="log" aria-live="polite" aria-relevant="additions" tabindex="0" aria-label="Conversation" data-assistant-log>
      <div class="msg msg--assistant">
        <p>Welcome to KEVOS. I can help identify the most relevant engineering, manufacturing, operations or project support for your requirement, explain how engagement works, and guide you to the right next step.</p>
      </div>
    </div>

    <div class="assistant__prompts" data-assistant-prompts>
      {prompts.map((p) => <button type="button" class="chip" data-prompt={p}>{p}</button>)}
      <a class="chip chip--link" href="/contact/" data-cta="assistant-quote">Request a quote</a>
      <a class="chip" href={SITE.booking.url} target="_blank" rel="noopener noreferrer" data-cta="assistant-meeting">Book a meeting</a>
      <button type="button" class="chip chip--accent" data-assistant-handoff>Leave a message</button>
    </div>

    <form class="assistant__handoff" data-assistant-handoff-form hidden novalidate>
      <p class="assistant__handoff-title">Leave a message for the KEVOS team</p>
      <label>Name<input name="name" type="text" autocomplete="name" required maxlength="100" /></label>
      <label>Email<input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
      <label>Message<textarea name="message" rows="3" required maxlength="2000"></textarea></label>
      <input class="assistant__hp" name="botcheck" type="checkbox" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <label class="assistant__consent"><input name="consent" type="checkbox" required /> I agree to KEVOS using these details to reply, as set out in the <a href="/privacy/">privacy policy</a>.</label>
      <div class="assistant__captcha" data-handoff-captcha></div>
      <p class="assistant__handoff-error" role="alert" data-handoff-error></p>
      <div class="assistant__handoff-actions">
        <button type="button" class="assistant__text-btn" data-handoff-cancel>Cancel</button>
        <button type="submit" class="assistant__send-btn">Send message</button>
      </div>
    </form>

    <form class="assistant__composer" data-assistant-form>
      <label for={`assistant-input-${mode}`} class="visually-hidden">Ask a question about KEVOS</label>
      <textarea id={`assistant-input-${mode}`} rows="1" maxlength="600" placeholder="Describe your requirement or project…" autocomplete="off" data-assistant-input></textarea>
      <button type="submit" class="assistant__submit" aria-label="Send question">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </form>
    <p class="assistant__note">AI-assisted guidance based on published KEVOS information. For project scope, pricing or availability, <a href="/contact/" data-cta="assistant-note-quote">request a quote</a>. Please don’t share sensitive information. <a href="/privacy/">Privacy</a></p>
  </section>
</div>

<script>
  import { normalise, validate } from '../lib/contact.ts';
  import { submitContact } from '../lib/contact-client.ts';
  import { mountCaptcha, type Captcha } from '../lib/captcha.ts';

  type Msg = { role: 'user' | 'assistant'; content: string };
  type State = { open: boolean; messages: Msg[] };
  const KEY = 'kevos-assistant';

  const root = document.querySelector<HTMLElement>('[data-assistant]');
  if (root) {
    const mode = root.dataset.mode as 'floating' | 'page';
    const endpoint = root.dataset.endpoint!;
    const panel = root.querySelector<HTMLElement>('[data-assistant-panel]')!;
    const launcher = root.querySelector<HTMLButtonElement>('[data-assistant-open]');
    const log = root.querySelector<HTMLElement>('[data-assistant-log]')!;
    const prompts = root.querySelector<HTMLElement>('[data-assistant-prompts]')!;
    const form = root.querySelector<HTMLFormElement>('[data-assistant-form]')!;
    const input = root.querySelector<HTMLTextAreaElement>('[data-assistant-input]')!;
    const handoff = root.querySelector<HTMLFormElement>('[data-assistant-handoff-form]')!;
    const handoffError = root.querySelector<HTMLElement>('[data-handoff-error]')!;
    let busy = false;
    let handoffStarted = 0;
    let handoffCaptcha: Promise<Captcha | null> | null = null;
    const ensureHandoffCaptcha = () => (handoffCaptcha ??= mountCaptcha(root.querySelector<HTMLElement>('[data-handoff-captcha]')!));

    const load = (): State => {
      try {
        return { open: false, messages: [], ...JSON.parse(sessionStorage.getItem(KEY) ?? '{}') };
      } catch {
        return { open: false, messages: [] };
      }
    };
    const state = load();
    const save = () => {
      try {
        sessionStorage.setItem(KEY, JSON.stringify({ open: state.open, messages: state.messages.slice(-30) }));
      } catch {
        /* storage unavailable */
      }
    };

    // Render assistant text safely: escape everything, then allow internal links, bold and bullets.
    const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const isSafeHref = (h: string) => /^\/(?!\/)[\w\-/#.?=&]*$/.test(h) || /^https:\/\/(www\.)?kevos\.com(\/|$)/.test(h);
    const format = (text: string) => {
      const lines = escapeHtml(text)
        .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_m, label, href) => (isSafeHref(href) ? `<a href="${href}">${label}</a>` : label))
        .replace(/(^|[\s(])(\/(?:about|services|factory-fix|how-it-works|industries|tools|insights|contact|privacy|terms|search)\/[\w\-/]*)/g, '$1<a href="$2">$2</a>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .split(/\n+/);
      let html = '';
      let inList = false;
      for (const line of lines) {
        const item = line.match(/^\s*[-*•]\s+(.*)/);
        if (item) {
          if (!inList) html += '<ul>';
          inList = true;
          html += `<li>${item[1]}</li>`;
        } else {
          if (inList) html += '</ul>';
          inList = false;
          if (line.trim()) html += `<p>${line}</p>`;
        }
      }
      return inList ? `${html}</ul>` : html;
    };

    const addBubble = (role: Msg['role'] | 'error' | 'typing', content = '') => {
      const el = document.createElement('div');
      el.className = `msg msg--${role}`;
      if (role === 'typing') {
        el.setAttribute('aria-label', 'The assistant is typing');
        el.innerHTML = '<span></span><span></span><span></span>';
      } else if (role === 'user') {
        el.innerHTML = `<p>${escapeHtml(content)}</p>`;
      } else {
        el.innerHTML = format(content);
      }
      log.append(el);
      log.scrollTop = log.scrollHeight;
      return el;
    };

    // When the assistant cannot answer from approved content, offer a direct route to the team.
    const UNSURE = /enough approved|don.t have (that|enough)|not able to answer|send the team an enquiry/i;
    const addContactButton = () => {
      const el = document.createElement('div');
      el.className = 'msg msg--action';
      el.innerHTML = '<a class="msg__button" href="/contact/" data-cta="assistant-contact">Contact KEVOS</a>';
      log.append(el);
      log.scrollTop = log.scrollHeight;
    };

    const restore = () => {
      state.messages.forEach((m) => addBubble(m.role, m.content));
      prompts.hidden = state.messages.length > 0;
    };

    const setOpen = (open: boolean, focus = true) => {
      if (mode === 'page') return;
      state.open = open;
      panel.hidden = !open;
      launcher?.setAttribute('aria-expanded', String(open));
      launcher?.classList.toggle('is-hidden', open);
      save();
      if (open && focus) input.focus();
      if (!open && focus) launcher?.focus();
    };

    async function ask(question: string) {
      const q = question.trim().slice(0, 600);
      if (!q || busy) return;
      busy = true;
      prompts.hidden = true;
      state.messages.push({ role: 'user', content: q });
      addBubble('user', q);
      save();
      const typing = addBubble('typing');
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ messages: state.messages.slice(-8) }),
        });
        const data = (await res.json().catch(() => null)) as { ok?: boolean; reply?: string; error?: string } | null;
        typing.remove();
        if (data?.ok && data.reply) {
          state.messages.push({ role: 'assistant', content: data.reply });
          addBubble('assistant', data.reply);
          if (UNSURE.test(data.reply)) addContactButton();
          save();
        } else {
          addBubble(
            'error',
            data?.error ?? 'The assistant is available on the live site. You can still [leave a message](/contact/) for the team.',
          );
        }
      } catch {
        typing.remove();
        addBubble('error', 'Connection problem. Please try again, or use the [contact page](/contact/).');
      } finally {
        busy = false;
      }
    }

    // ----- Events -----
    launcher?.addEventListener('click', () => setOpen(true));
    const expand = root.querySelector<HTMLButtonElement>('[data-assistant-expand]');
    expand?.addEventListener('click', () => {
      const on = !root.classList.contains('is-expanded');
      root.classList.toggle('is-expanded', on);
      expand.setAttribute('aria-pressed', String(on));
      expand.setAttribute('aria-label', on ? 'Restore the assistant size' : 'Expand the assistant');
      expand.title = on ? 'Restore size' : 'Expand';
    });
    root.querySelector('[data-assistant-minimise]')?.addEventListener('click', () => setOpen(false));
    root.querySelector('[data-assistant-close-window]')?.addEventListener('click', () => (window.opener ? window.close() : (location.href = '/')));
    root.querySelector<HTMLAnchorElement>('[data-assistant-popout]')?.addEventListener('click', (e) => {
      save();
      const win = window.open('/chat/', 'kevos-assistant', 'popup,width=420,height=680');
      if (win) {
        e.preventDefault();
        setOpen(false);
      }
    });
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mode === 'floating') setOpen(false);
    });

    prompts.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-prompt]');
      if (b) ask(b.dataset.prompt!);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value;
      input.value = '';
      input.style.height = '';
      ask(q);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });
    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 120)}px`;
    });

    // ----- Leave a message (handoff to the team) -----
    const showHandoff = (show: boolean) => {
      handoff.hidden = !show;
      form.hidden = show;
      prompts.hidden = show || state.messages.length > 0;
      handoffError.textContent = '';
      if (show) {
        handoffStarted = Date.now();
        ensureHandoffCaptcha();
        handoff.querySelector<HTMLInputElement>('input[name="name"]')!.focus();
      } else input.focus();
    };
    root.querySelectorAll('[data-assistant-handoff]').forEach((b) => b.addEventListener('click', () => showHandoff(true)));
    root.querySelector('[data-handoff-cancel]')!.addEventListener('click', () => showHandoff(false));
    handoff.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(handoff));
      const transcript = state.messages.map((m) => `${m.role === 'user' ? 'Visitor' : 'Assistant'}: ${m.content}`).join('\n');
      const contact = normalise({ ...data, service: 'Other' });
      const first = Object.values(validate(contact))[0];
      if (first) {
        handoffError.textContent = first;
        return;
      }
      const captcha = await ensureHandoffCaptcha();
      const token = captcha?.token() ?? '';
      if (!token) {
        handoffError.textContent = captcha
          ? 'Please complete the spam check above.'
          : 'The spam check could not load. Please use the contact page instead.';
        return;
      }
      const submit = handoff.querySelector<HTMLButtonElement>('[type="submit"]')!;
      submit.disabled = true;
      handoffError.textContent = '';
      const result = await submitContact({
        ...contact,
        message: transcript ? `${contact.message}\n\n--- Chat transcript ---\n${transcript}` : contact.message,
        source: 'Website assistant',
        honeypot: data.botcheck ? 'yes' : '',
        startedAt: handoffStarted,
        captcha: token,
      });
      captcha?.reset();
      submit.disabled = false;
      if (result.ok) {
        handoff.reset();
        showHandoff(false);
        const thanks = 'Thanks. Your message has been passed to the KEVOS team, who will reply by email as soon as possible.';
        state.messages.push({ role: 'assistant', content: thanks });
        addBubble('assistant', thanks);
        save();
      } else {
        handoffError.textContent = result.message ?? 'Your message could not be sent. Please try the contact page.';
      }
    });

    restore();
    if (mode === 'page') input.focus();
    else if (state.open) setOpen(true, false);
  }
</script>

<style>
  .assistant { --a-w: 384px; font-size: 0.95rem; }
  .assistant--floating { position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 60; }

  .assistant__launcher {
    display: inline-flex; align-items: center; gap: 0.55rem; min-height: 50px; padding: 0 1.15rem 0 0.6rem;
    background: var(--ink); color: var(--paper); border: 0; border-radius: 999px;
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.45); font-size: 0.95rem; font-weight: 560;
    transition: transform 0.25s var(--ease), background 0.2s var(--ease);
  }
  .assistant__launcher img { width: 34px; height: 34px; padding: 4px; border: 1px solid #d7dce6; border-radius: 9px; background: #f8f9fb; object-fit: contain; }
  .assistant__launcher:hover { transform: translateY(-2px); }
  .assistant__launcher.is-hidden { display: none; }

  .assistant__panel {
    display: flex; flex-direction: column; width: var(--a-w); height: min(640px, calc(100dvh - 2rem));
    background: var(--surface); color: var(--ink); border: 1px solid var(--line-strong); border-radius: 16px;
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.45); overflow: hidden;
  }
  .assistant__panel[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .assistant--floating .assistant__panel:not([hidden]) { animation: rise 0.25s var(--ease); }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }
  .assistant--page .assistant__panel { width: 100%; height: 100dvh; border: 0; border-radius: 0; box-shadow: none; }

  .assistant__header { display: flex; align-items: center; gap: 0.75rem; padding: 0.85rem 0.85rem 0.85rem 1rem; border-bottom: 1px solid var(--line); }
  .assistant__avatar { width: 46px; height: 46px; flex: none; padding: 5px; border: 1px solid #d7dce6; border-radius: 10px; background: #f8f9fb; object-fit: contain; }
  .assistant__heading { flex: 1; min-width: 0; }
  .assistant__heading h1, .assistant__heading h2 { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
  .assistant__heading p { display: flex; align-items: center; gap: 0.4rem; margin: 0.15rem 0 0; font-size: 0.78rem; color: var(--muted); }
  .assistant__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); }
  .assistant__actions { display: flex; gap: 0.25rem; }
  .assistant__icon { display: grid; place-items: center; width: 36px; height: 36px; padding: 0; color: var(--ink-2); background: transparent; border: 1px solid transparent; border-radius: 50%; }
  .assistant__icon:hover { color: var(--ink); border-color: var(--line-strong); }
  .assistant__icon svg { width: 18px; height: 18px; }

  .assistant__log { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 0.6rem; padding: 1rem; scroll-behavior: smooth; overscroll-behavior: contain; }
  .assistant__log:focus-visible { outline-offset: -3px; }
  .assistant__log :global(.msg) { max-width: 88%; padding: 0.65rem 0.85rem; border-radius: 14px; line-height: 1.5; overflow-wrap: anywhere; }
  .assistant__log :global(.msg p) { margin: 0; }
  .assistant__log :global(.msg p + p) { margin-top: 0.5rem; }
  .assistant__log :global(.msg ul) { margin: 0.35rem 0 0; padding-left: 1.1rem; }
  .assistant__log :global(.msg a) { color: inherit; text-decoration-color: var(--accent); }
  .assistant__log :global(.msg--assistant) { align-self: flex-start; background: var(--paper-2); border-bottom-left-radius: 4px; }
  .assistant__log :global(.msg--user) { align-self: flex-end; background: var(--ink); color: var(--paper); border-bottom-right-radius: 4px; }
  .assistant__log :global(.msg--error) { align-self: flex-start; background: transparent; border: 1px solid var(--danger); color: var(--ink-2); }
  .assistant__log :global(.msg--typing) { align-self: flex-start; display: flex; gap: 4px; padding: 0.85rem; background: var(--paper-2); }
  .assistant__log :global(.msg--typing span) { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); animation: blink 1.2s infinite; }
  .assistant__log :global(.msg--typing span:nth-child(2)) { animation-delay: 0.15s; }
  .assistant__log :global(.msg--typing span:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes blink { 50% { opacity: 0.25; } }

  .assistant__prompts { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0 1rem 0.75rem; }
  .assistant__prompts[hidden] { display: none; }
  .chip { min-height: 34px; padding: 0 0.8rem; background: transparent; color: var(--ink-2); border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.84rem; }
  .chip:hover { border-color: var(--ink); color: var(--ink); }
  .chip--accent { border-color: var(--accent); color: var(--accent); }
  .chip--link { display: inline-flex; align-items: center; background: var(--ink); color: var(--paper); border-color: var(--ink); text-decoration: none; }
  .chip--link:hover { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .assistant__log :global(.msg--action) { align-self: flex-start; padding: 0; background: none; }
  .assistant__log :global(.msg__button) { display: inline-flex; align-items: center; min-height: 36px; padding: 0 0.95rem; background: var(--ink); color: var(--paper); border-radius: 999px; font-weight: 560; text-decoration: none; }
  .assistant__log :global(.msg__button:hover) { background: var(--accent); color: var(--on-accent); }
  .assistant--floating.is-expanded .assistant__panel { width: min(760px, calc(100vw - 2rem)); height: min(860px, calc(100dvh - 2rem)); }

  .assistant__composer { display: flex; align-items: flex-end; gap: 0.5rem; margin: 0 0.75rem; padding: 0.4rem 0.4rem 0.4rem 0.85rem; border: 1px solid var(--line-strong); border-radius: 14px; background: var(--paper); }
  .assistant__composer[hidden] { display: none; }
  .assistant__composer:focus-within { border-color: var(--ink); }
  .assistant__composer textarea { flex: 1; min-height: 38px; max-height: 120px; padding: 0.5rem 0; background: transparent; border: 0; resize: none; font-size: 1rem; line-height: 1.4; }
  .assistant__composer textarea:focus { outline: none; }
  .assistant__submit { display: grid; place-items: center; width: 38px; height: 38px; flex: none; padding: 0; background: var(--ink); color: var(--paper); border: 0; border-radius: 10px; }
  .assistant__submit:hover { background: var(--accent); color: var(--on-accent); }
  .assistant__submit svg { width: 18px; height: 18px; }
  .assistant__note { margin: 0; padding: 0.55rem 1rem 0.75rem; font-size: 0.72rem; line-height: 1.4; color: var(--muted); }
  .assistant__note a { color: inherit; }

  .assistant__handoff { display: grid; gap: 0.55rem; margin: 0 0.75rem 0.5rem; padding: 0.9rem; border: 1px solid var(--line-strong); border-radius: 14px; background: var(--paper); }
  .assistant__handoff[hidden] { display: none; }
