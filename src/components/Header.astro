---
import { NAV, QUOTE_CTA } from '../config/site.ts';
import Container from './Container.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header" data-header>
  <Container class="site-header__inner">
    <a class="site-header__brand" href="/">
      <Logo class="site-header__logo" />
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list" id="site-menu">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="site-nav__cta"><a href={QUOTE_CTA.href} data-cta="menu-quote">{QUOTE_CTA.label}</a></li>
      </ul>
    </nav>
    <div class="site-header__tools">
      <ThemeToggle />
      <a class="header-cta" href={QUOTE_CTA.href} data-cta="header-quote">{QUOTE_CTA.label}</a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-button>
        <span class="visually-hidden" data-menu-label>Open menu</span>
        <span class="menu-button__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </Container>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const menu = document.getElementById('site-menu');

  const setOpen = (open: boolean) => {
    if (!button || !header || !label) return;
    button.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Close menu' : 'Open menu';
    header.classList.toggle('is-open', open);
    document.body.classList.toggle('menu-open', open);
  };

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) {
      setOpen(false);
      button?.focus();
    }
  });
  window.matchMedia('(min-width: 1100px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // A hairline appears under the header once the page scrolls.
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s var(--ease);
  }
  .site-header.is-scrolled { border-bottom-color: var(--line); }
  :global(.site-header__inner) { display: flex; align-items: center; gap: 1.5rem; min-height: var(--header-h); }
  .site-header__brand { display: inline-flex; text-decoration: none; margin-right: auto; border-radius: 4px; }
  .site-header__brand:hover { color: inherit; }
  @media (max-width: 480px) { .site-header__brand :global(img) { height: 26px; width: auto; } }
  .site-nav__list { display: flex; gap: 0.1rem; margin: 0; padding: 0; list-style: none; }
  .site-nav__list a {
    position: relative; display: block; padding: 0.5rem 0.7rem;
    font-size: 0.95rem; font-weight: 480; color: var(--ink-2); text-decoration: none; white-space: nowrap;
  }
  .site-nav__list a::after {
    content: ''; position: absolute; left: 0.7rem; right: 0.7rem; bottom: 0.3rem; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 0.3s var(--ease);
  }
  .site-nav__list a:hover { color: var(--ink); }
  .site-nav__list a:hover::after { transform: scaleX(1); }
  .site-nav__list a[aria-current='page'] { color: var(--ink); }
  .site-nav__list a[aria-current='page']::after { transform: scaleX(1); background: var(--accent); }
  .site-header__tools { display: flex; align-items: center; gap: 0.5rem; }
  .menu-button { display: none; }
  .site-nav__cta { display: none; }
  .header-cta {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 1.05rem;
    background: var(--ink); color: var(--paper); border: 1px solid var(--ink); border-radius: 999px;
    font-size: 0.92rem; font-weight: 560; text-decoration: none; white-space: nowrap;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .header-cta:hover { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }

  @media (max-width: 1099px) {
    .site-nav { order: 3; }
    .menu-button {
      display: inline-grid; place-items: center; width: 40px; height: 40px; padding: 0;
      background: transparent; border: 1px solid var(--line); border-radius: 50%;
    }
    .menu-button__bars { display: grid; gap: 5px; width: 16px; }
    .menu-button__bars span { display: block; height: 1.5px; background: var(--ink); transition: transform 0.25s var(--ease); }
    .is-open .menu-button__bars span:first-child { transform: translateY(3.25px) rotate(45deg); }
    .is-open .menu-button__bars span:last-child { transform: translateY(-3.25px) rotate(-45deg); }
    .site-nav__list {
      position: fixed; inset: var(--header-h) 0 0 0; z-index: 49;
      flex-direction: column; gap: 0; padding: 1rem var(--gutter) 2rem;
      background: var(--paper); border-top: 1px solid var(--line);
      visibility: hidden; opacity: 0; transform: translateY(-6px);
      transition: opacity 0.22s var(--ease), transform 0.22s var(--ease), visibility 0.22s;
    }
    .is-open .site-nav__list { visibility: visible; opacity: 1; transform: none; }
    .site-nav__list a {
      padding: 0.85rem 0; font-size: var(--step-2); font-weight: 520; letter-spacing: -0.02em;
      color: var(--ink); border-bottom: 1px solid var(--line);
    }
    .site-nav__list a::after { display: none; }
    .site-nav__list a[aria-current='page'] { color: var(--accent); }
    .site-nav__cta { display: block; margin-top: 1.5rem; }
    .site-nav__cta a {
      display: flex; justify-content: center; padding: 0.95rem 1rem; border: 0; border-radius: 999px;
      background: var(--ink); color: var(--paper); font-size: 1.05rem; letter-spacing: 0;
    }
  }
  @media (max-width: 420px) { .header-cta { display: none; } }
  :global(body.menu-open) { overflow: hidden; }
</style>
