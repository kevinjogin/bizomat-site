---
// Renders READOS cover illustration data (see src/utils/reados-covers.ts) as SVG elements.
import type { Shape } from '../utils/reados-covers.ts';
interface Props { shapes: Shape[] }
const { shapes } = Astro.props;
const Self = Astro.self;
---
{shapes.map((s) =>
  s.t === 'path' ? <path d={s.d} class={s.c} pathLength={s.len ? 100 : undefined} /> :
  s.t === 'circle' ? <circle cx={s.cx} cy={s.cy} r={s.r} class={s.c} /> :
  s.t === 'ellipse' ? <ellipse cx={s.cx} cy={s.cy} rx={s.rx} ry={s.ry} class={s.c} /> :
  s.t === 'rect' ? <rect x={s.x} y={s.y} width={s.w} height={s.h} rx={s.rx} class={s.c} /> :
  s.t === 'text' ? <text x={s.x} y={s.y} class={s.c} text-anchor={s.anchor} transform={s.tf}>{s.s}</text> :
  s.t === 'clip' ? <clipPath id={s.id}><Self shapes={s.kids} /></clipPath> :
  <g class={s.c} transform={s.tf} clip-path={s.clip ? `url(#${s.clip})` : undefined}><Self shapes={s.kids} /></g>
)}
