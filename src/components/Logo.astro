---
// The BIZOMAT wordmark for panels and diagrams (the word alone, with the teal forward arrow in its B).
import { WORDMARK_VIEWBOX } from '../data/bizomat-brand.ts';
const [, , wordW, wordH] = WORDMARK_VIEWBOX.split(' ').map(Number);
interface Props {
  class?: string;
  height?: number;
  label?: string;
}
const { class: className, height = 18, label = 'BIZOMAT' } = Astro.props;
const sizeClass = height <= 14 ? 'logo--hero-small' : height <= 18 ? 'logo--hero' : height >= 28 ? 'logo--large' : 'logo--default';
---
<span
  class:list={['logo', sizeClass, className]}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <img class="logo__image logo__image--light" src="/brand/bizomat-logo-light.svg" alt="" width={wordW} height={wordH} decoding="async" />
  <img class="logo__image logo__image--dark" src="/brand/bizomat-logo-dark.svg" alt="" width={wordW} height={wordH} decoding="async" />
</span>

<style>
  .logo { --logo-h: 22px; display: inline-grid; place-items: center; max-width: 100%; line-height: 0; overflow: visible; white-space: nowrap; }
  .logo--hero-small { --logo-h: 13px; }
  .logo--hero { --logo-h: 17px; }
  .logo--default { --logo-h: 22px; }
  .logo--large { --logo-h: 28px; }
  .logo__image { display: block; width: auto; height: var(--logo-h); max-width: 100%; object-fit: contain; object-position: center; }
  .logo__image--dark { display: none; }
  :global(:root[data-theme='dark']) .logo__image--light { display: none; }
  :global(:root[data-theme='dark']) .logo__image--dark { display: block; }
</style>
