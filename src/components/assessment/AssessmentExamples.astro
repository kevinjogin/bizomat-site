---
// "What can we help you assess?" An accessible tab interface over the eight example problem types.
// Without JavaScript every example is shown in full, one after another.
import AssessmentIcon from './AssessmentIcon.astro';
import { EXAMPLES } from '../../config/assessment.ts';
---

<div class="ex" data-examples>
  <div class="ex__tabs" role="tablist" aria-label="Example engineering problems" aria-orientation="vertical">
    {
      EXAMPLES.map((e, i) => (
        <button
          type="button"
          class="ex__tab"
          role="tab"
          id={`ex-tab-${e.id}`}
          aria-controls={`ex-panel-${e.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="ex__tab-icon"><AssessmentIcon name={e.id as 'alignment'} /></span>
          <span class="ex__tab-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="ex__tab-title">{e.title}</span>
        </button>
      ))
    }
  </div>
  <div class="ex__panels">
    {
      EXAMPLES.map((e, i) => (
        <section class="ex__panel" role="tabpanel" id={`ex-panel-${e.id}`} aria-labelledby={`ex-tab-${e.id}`} tabindex="0" data-index={i}>
          <div class="ex__head">
            <span class="ex__art"><AssessmentIcon name={e.id as 'alignment'} /></span>
            <div>
              <p class="ex__kicker">Example {String(i + 1).padStart(2, '0')}</p>
              <h3 class="ex__title">{e.title}</h3>
            </div>
          </div>
          <dl class="ex__grid">
            <div class="ex__item ex__item--wide">
              <dt>Typical problem</dt>
              <dd>{e.problem}</dd>
            </div>
            <div class="ex__item">
              <dt>Information you can provide</dt>
              <dd><ul>{e.provide.map((p) => <li>{p}</li>)}</ul></dd>
            </div>
            <div class="ex__item">
              <dt>What the preliminary review might identify</dt>
              <dd><ul>{e.identify.map((p) => <li>{p}</li>)}</ul></dd>
            </div>
            <div class="ex__item ex__item--wide ex__item--next">
              <dt>Potential next step</dt>
              <dd>{e.next}</dd>
            </div>
          </dl>
        </section>
      ))
    }
  </div>
</div>
<p class="ex__note">These are examples of the kind of problems that suit the assessment, not guaranteed outcomes. What a review can identify depends on the problem and the information available.</p>

<script>
  const root = document.querySelector<HTMLElement>('[data-examples]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };
    root.classList.add('is-enhanced');
    select(0);
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: last }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select(next < 0 ? last : next > last ? 0 : next, true);
      });
    });
  }
</script>

<style>
  .ex { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr); gap: 1.5rem; align-items: start; }
  .ex__tabs { display: none; }
  .ex.is-enhanced .ex__tabs { display: grid; gap: 0.4rem; position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .ex__tab {
    display: grid; grid-template-columns: 2.4rem auto 1fr; align-items: center; gap: 0.75rem; width: 100%;
    padding: 0.7rem 0.9rem; text-align: left; background: transparent; color: var(--ink-2);
    border: 1px solid var(--line); border-radius: 10px; transition: border-color 0.2s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .ex__tab:hover { border-color: var(--line-strong); color: var(--ink); }
  .ex__tab[aria-selected='true'] { border-color: var(--accent); background: var(--accent-soft); color: var(--ink); }
  .ex__tab-icon { display: block; width: 2.4rem; color: var(--ink); }
  .ex__tab-num { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); }
  .ex__tab-title { font-weight: 560; font-size: 0.95rem; line-height: 1.3; }
  .ex__panels { display: grid; gap: 1.25rem; }
  .ex.is-enhanced .ex__panels { display: block; }
  .ex:not(.is-enhanced) { grid-template-columns: 1fr; }
  .ex__panel {
    padding: clamp(1.25rem, 3vw, 2.25rem); background: var(--surface); border: 1px solid var(--line-strong); border-radius: 14px;
    position: relative; overflow: hidden;
  }
  .ex__panel::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--brand-orange); }
  .ex__panel:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .ex__head { display: grid; grid-template-columns: clamp(4rem, 9vw, 5.5rem) 1fr; gap: 1.25rem; align-items: center; margin-bottom: 1.5rem; }
  .ex__art { display: block; padding: 0.6rem; border: 1px solid var(--line); border-radius: 12px; background: var(--paper-2); color: var(--ink); }
  .ex__kicker { margin: 0 0 0.35rem; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .ex__title { font-size: var(--step-2); }
  .ex__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 2rem; margin: 0; }
  .ex__item { border-top: 1px solid var(--line-strong); padding-top: 0.85rem; }
  .ex__item--wide { grid-column: 1 / -1; }
  .ex__item dt { margin-bottom: 0.45rem; font-size: 0.78rem; font-weight: 560; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .ex__item dd { margin: 0; color: var(--ink-2); line-height: 1.55; }
  .ex__item ul { margin: 0; padding-left: 1.1rem; }
  .ex__item li { margin-bottom: 0.3rem; }
  .ex__item--next dd { color: var(--ink); font-weight: 520; }
  .ex__item--next dt { color: var(--accent); }
  .ex__note { margin: 1.5rem 0 0; max-width: 80ch; color: var(--muted); font-size: 0.92rem; }
  @media (max-width: 900px) {
    .ex, .ex.is-enhanced { grid-template-columns: 1fr; }
    .ex.is-enhanced .ex__tabs { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ex__tab { grid-template-columns: 1.9rem 1fr; }
    .ex__tab-icon { width: 1.9rem; }
    .ex__tab-num { display: none; }
  }
  @media (max-width: 560px) {
    .ex__grid { grid-template-columns: 1fr; }
    .ex__tab-title { font-size: 0.86rem; }
  }
</style>
