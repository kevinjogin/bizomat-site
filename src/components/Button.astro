---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'text' | 'inverse';
  type?: 'button' | 'submit';
  arrow?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', type = 'button', arrow = false, class: className, ...rest } = Astro.props;
const classes = ['button', `button--${variant}`, className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
      {arrow && <span class="button__arrow" aria-hidden="true">→</span>}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
      {arrow && <span class="button__arrow" aria-hidden="true">→</span>}
    </button>
  )
}

<style>
  .button {
    --b-bg: var(--ink); --b-fg: var(--paper); --b-border: var(--ink);
    display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
    min-height: 48px; padding: 0 1.4rem;
    background: var(--b-bg); color: var(--b-fg); border: 1px solid var(--b-border); border-radius: 999px;
    font-size: 0.98rem; font-weight: 540; letter-spacing: -0.005em; text-decoration: none; white-space: nowrap;
    transition: background 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .button:hover { --b-bg: var(--accent); --b-border: var(--accent); --b-fg: var(--on-accent); color: var(--b-fg); }
  .button--secondary { --b-bg: transparent; --b-fg: var(--ink); --b-border: var(--line-strong); }
  .button--secondary:hover { --b-bg: transparent; --b-fg: var(--ink); --b-border: var(--ink); }
  .button--inverse { --b-bg: var(--inverse-ink); --b-fg: var(--inverse-bg); --b-border: var(--inverse-ink); }
  .button--inverse:hover { --b-bg: var(--accent); --b-border: var(--accent); --b-fg: var(--on-accent); }
  .button--text { --b-bg: transparent; --b-fg: var(--ink); --b-border: transparent; min-height: 0; padding: 0.25rem 0; border-radius: 0; }
  .button--text:hover { --b-bg: transparent; --b-border: transparent; --b-fg: var(--accent); }
  .button[disabled] { opacity: 0.55; cursor: progress; }
  .button__arrow { display: inline-block; transition: transform 0.25s var(--ease); }
  .button:hover .button__arrow { transform: translateX(3px); }
</style>
