---
// /sign-in/: the one place to start signing in to BIZOMAT. BIZOMAT ERP is the one sign-in for the CRM, Finance, Projects
// and company accounts (email and password, or Google where configured); CAD Automation keeps its own accounts and
// sign-in for now (plus OAuth for AI apps). Existing accounts work unchanged.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import '../styles/product.css';
import { APP_LINKS, APP_URLS } from '../config/platform.ts';

const host = (u: string) => { const x = new URL(u); return x.host + x.pathname.replace(/\/$/, ''); };
const apps = [
  // One sign-in for the CRM, Finance, Projects and company accounts: BIZOMAT ERP (owner, 14 Nov 2026).
  { name: 'BIZOMAT ERP', button: 'BIZOMAT ERP', text: 'One workspace and one sign-in for Sales and CRM, Finance and Accounting, Projects and Tasks, your company, Reports and Administration.', signIn: APP_LINKS.erp.signIn, home: APP_LINKS.erp.dashboard, page: '/systems/erp/', host: host(APP_URLS.erp) },
  { name: 'Engineering Automation (CAD Automation)', button: 'CAD Automation', text: 'Your AI assistant connector, paired computers and SOLIDWORKS commands. It keeps its own sign-in for now.', signIn: APP_LINKS.cad.signIn, home: APP_LINKS.cad.dashboard, page: '/systems/engineering/', host: host(APP_URLS.cad) },
];
---
<BaseLayout title="Sign in" description="Sign in to BIZOMAT ERP, one workspace for the CRM, Finance and Projects, or to CAD Automation, with your existing account." breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Sign in', href: '/sign-in/' }]}>
  <section class="pp-hero" aria-labelledby="signin-title">
    <Container>
      <p class="bz-eyebrow">BIZOMAT account</p>
      <h1 id="signin-title">Sign in to BIZOMAT</h1>
      <p class="pp-hero__lead">One sign-in opens BIZOMAT ERP, where the CRM, Finance and Projects work together. Your existing account and data work unchanged: sign in with the email and password you already use.</p>
      <ul class="pp-cards signin" role="list">
        {apps.map((a) => (
          <li class="pp-card">
            <h2>{a.name}</h2>
            <p>{a.text}</p>
            <div class="pp-hero__actions">
              <Button href={a.signIn} variant="accent" rel="noopener" data-cta={`signin-${a.page.replace(/\//g, '')}`}>Sign in to {a.button}</Button>
              <Button href={a.page} variant="secondary">About {a.button}</Button>
            </div>
            <p class="signin__host">Signs in at <span class="bz-mono">{a.host}</span></p>
          </li>
        ))}
      </ul>
      <div class="bz-alert bz-alert--info signin__note" role="note">
        <strong>Resources need no account</strong>
        <span>Tools, calculators, the Library and AI search are free to use without signing in. <a href="/resources/">Go to Resources</a>.</span>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .signin { margin-top: clamp(2rem, 4vw, 2.75rem); }
  .signin h2 { font-size: var(--step-2); }
  .signin__host { margin-top: 1rem !important; color: var(--muted) !important; font-size: .86rem !important; }
  .signin__note { margin-top: 1.5rem; max-width: 760px; }
</style>
