---
import { Picture } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Button from '../../components/Button.astro';
import CallToAction from '../../components/CallToAction.astro';
import { SITE } from '../../config/site.ts';
import { getInsights, getWork, hasWorkDetail, type Work } from '../../utils/content.ts';

export async function getStaticPaths() {
  const work = await getWork();
  return work.filter(hasWorkDetail).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Work };
const { Content } = await render(entry);
const { title, summary, type, status, date, image, imageAlt, gallery, externalUrl } = entry.data;
const visible = new Set((await getInsights()).map((p) => p.id));
const related = (await getEntries(entry.data.relatedInsights)).filter((p) => p && visible.has(p.id));
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work/' },
  { label: title, href: `/work/${entry.id}/` },
];
const schema = [
  {
    '@type': 'CreativeWork',
    name: title,
    description: summary,
    url: `${SITE.url}/work/${entry.id}/`,
    dateCreated: date.toISOString().slice(0, 10),
    creator: { '@id': `${SITE.url}/#organization` },
  },
];
---

<BaseLayout title={title} description={summary} breadcrumbs={crumbs} schema={schema}>
  <article>
    <header class="work-hero">
      <Container>
        <Breadcrumb items={crumbs} />
        <p class="work-hero__meta">
          <span>{type}</span>
          <StatusBadge status={status} />
          <FormattedDate date={date} />
        </p>
        <h1>{title}</h1>
        <p class="work-hero__summary">{summary}</p>
        {externalUrl && <Button href={externalUrl} variant="secondary" rel="noopener">Visit project ↗</Button>}
      </Container>
    </header>
    {
      image && (
        <Container size="wide" class="work-image">
          <Picture src={image} alt={imageAlt ?? ''} formats={['avif', 'webp']} widths={[640, 1024, 1600, 2200]} sizes="100vw" loading="eager" />
        </Container>
      )
    }
    <Container class="work-body">
      <div class="prose" data-pagefind-body>
        <Content />
      </div>
      {
        gallery.length > 0 && (
          <div class="gallery">
            {gallery.map((g) => (
              <figure>
                <Picture src={g.src} alt={g.alt} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" />
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )
      }
    </Container>
  </article>

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <Container>
          <h2 id="related-title">Related Insights</h2>
          <div class="related__grid">
            {related.map((post) => (
              <ArticleCard post={post} />
            ))}
          </div>
        </Container>
      </section>
    )
  }

  <CallToAction />
</BaseLayout>

<style>
  .work-hero { padding-block: clamp(3rem, 6vw, 5.5rem) clamp(2rem, 4vw, 3.5rem); }
  .work-hero__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem; margin: 2rem 0 1.25rem; font-size: 0.78rem; font-weight: 560; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .work-hero h1 { max-width: 18ch; }
  .work-hero__summary { max-width: 48ch; margin: 1.5rem 0 2rem; font-size: var(--step-1); color: var(--ink-2); line-height: 1.5; }
  :global(.work-image) { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  :global(.work-image img) { width: 100%; border-radius: var(--radius); }
  :global(.work-body) { padding-bottom: var(--space-section); }
  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 3rem; }
  .gallery figure { margin: 0; }
  .gallery :global(img) { width: 100%; border-radius: var(--radius); }
  .gallery figcaption { margin-top: 0.5rem; font-size: 0.88rem; color: var(--muted); }
  @media (max-width: 700px) { .gallery { grid-template-columns: 1fr; } }
  .related { padding-block: var(--space-section); border-top: 1px solid var(--line); }
  .related h2 { font-size: var(--step-2); margin-bottom: 2rem; }
  .related__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  @media (max-width: 900px) { .related__grid { grid-template-columns: 1fr; } }
</style>
