{
  "id": "/",
  "name": "OpenSketch",
  "short_name": "OpenSketch",
  "description": "Parametric CAD in the browser, with an AI that builds while you watch.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0c0d0e",
  "theme_color": "#0c0d0e",
  "categories": ["design", "productivity", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Files", "short_name": "Files", "url": "/?view=files", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New part", "short_name": "New part", "url": "/?new=part", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New assembly", "short_name": "New assembly", "url": "/?new=assembly", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "file_handlers": [
    {
      "action": "/?source=file",
      "accept": {
        "application/vnd.opensketch+json": [".osk"],
        "model/step": [".step", ".stp"]
      },
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] }
}
