---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Hero from '../../../../components/Hero.astro';
import Container from '../../../../components/Container.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import InsightsListing from '../../../../components/InsightsListing.astro';
import { INSIGHTS } from '../../../../config/site.ts';
import { categoriesWithPosts, categoryUrl, getInsights, paginate, type Insight } from '../../../../utils/content.ts';

// One page per category with published articles; empty categories never get a page.
export async function getStaticPaths() {
  const all = await getInsights();
  return categoriesWithPosts(all).flatMap((c) => {
    const pages = Math.max(1, Math.ceil(c.posts.length / INSIGHTS.pageSize));
    return Array.from({ length: pages }, (_, i) => ({
      params: { category: c.slug, page: i === 0 ? undefined : `page/${i + 1}` },
      props: { slug: c.slug, name: c.name, description: c.description, posts: c.posts, all, page: i + 1 },
    }));
  });
}

interface Props {
  slug: Parameters<typeof categoryUrl>[0];
  name: string;
  description: string;
  posts: Insight[];
  all: Insight[];
  page: number;
}
const { slug, name, description, posts, all, page } = Astro.props;
const { items, pages } = paginate(posts, page);
const base = categoryUrl(slug);
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Insights', href: '/insights/' },
  { label: name, href: base },
];
---

<BaseLayout
  title={page > 1 ? `${name} Insights, page ${page}` : `${name} Insights`}
  description={`GoCore Insights on ${name.toLowerCase()}: ${description}`}
  breadcrumbs={crumbs}
>
  <Hero eyebrow="Insights category" title={name} lead={description}>
    <Breadcrumb items={crumbs} slot="before" />
  </Hero>
  <Container class="category-body">
    <h2 class="visually-hidden">Articles in {name}</h2>
    <InsightsListing posts={items} all={all} page={page} pages={pages} base={base} activeCategory={slug} />
  </Container>
</BaseLayout>

<style>
  :global(.category-body) { padding-bottom: var(--space-section); }
</style>
